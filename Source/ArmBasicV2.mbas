    GPIO_Digital_Output(@GPIOD_BASE, _GPIO_PINMASK_3 or _GPIO_PINMASK_4)       ' RS485_RTS2/3
    GPIO_Digital_Input(@GPIOE_BASE, _GPIO_PINMASK_All)                         ' dig Inputs 0...15 
    GPIO_Digital_Input(@GPIOD_BASE, _GPIO_PINMASK_15)                          ' Touch-Int
    GPIO_Analog_Input(@GPIOC_BASE, _GPIO_PINMASK_0 or _GPIO_PINMASK_1 or _GPIO_PINMASK_2 or _GPIO_PINMASK_3)  'Analog Inputs  Basic
    USER_LED=1                                                                 ' Lebenslicht aus
    RTS1=1   RTS2=1    RTS3=1                                                  ' RS485 Senderichtungen von Strang1, Strang2, Strang3
    relay = (RTC_BKP6R and 0xFFFF)                                             ' Relais-Konfiguration Zustand setzen
    opendrain = (RTC_BKP6R >>  16) and 0xFFFF                                  ' Relais-Konfiguration OpenDrain setzen
    set_diginp_resistors(RTC_BKP7R and 0xFFFF,0)                               ' dig. Eingangs-Konfiguration setzen
    input_resistors = RTC_BKP7R    and 0xFFFF
    SYSCFGEN_bit    = 1
    SYSCFG_EXTICR1  = word(0x4444)                                             ' Sys-Config  3-E,  2-E,  1-E,  0-E
    SYSCFG_EXTICR2  = word(0x4444)                                             ' Sys-Config  7-H,  6-H,  5-E,  4-E
    SYSCFG_EXTICR3  = word(0x4444)                                             ' Sys-Config 11-E, 10-E,  9-E,  8-E
    SYSCFG_EXTICR4  = word(0x3444)                                             ' Sys-Config 15-D, 14-E, 13-E, 12-E
    inputdelay_on   = 0
    inputdelay_on.0 = RTC_BKP7R.16
    inputdelay_on.1 = RTC_BKP7R.17
    inputdelay_on.2 = RTC_BKP7R.18
    inputdelay_on.3 = RTC_BKP7R.19
    inputdelay_on.4 = RTC_BKP7R.20
end sub
#endif

#ifdef 411 then
sub procedure init_gpios()
    RCC_AHB1ENR.0=1   RCC_AHB1ENR.1=1   RCC_AHB1ENR.2=1   'RCC_AHB1ENR.3=1   RCC_AHB1ENR.4=1   RCC_AHB1ENR.7=1
    GPIO_Digital_Output(@GPIOC_BASE, _GPIO_PINMASK_13)                         ' LED
    GPIO_Digital_Output(@GPIOA_BASE, _GPIO_PINMASK_4 or _GPIO_PINMASK_5 or _GPIO_PINMASK_6 or _GPIO_PINMASK_7)  ' Relais 1,2,3,4
    GPIO_Digital_Input(@GPIOB_BASE,  _GPIO_PINMASK_2 or _GPIO_PINMASK_3 or _GPIO_PINMASK_4 or _GPIO_PINMASK_5)  ' DIG 1, 2, 3
    if testbit(RTC_BKP16R,5) then
       GPIO_Digital_Input(@GPIOB_BASE,  _GPIO_PINMASK_0)                       ' digital Input 1
       setbit(diginpMask,0)
    else
        GPIO_Analog_Input(@GPIOB_BASE, _GPIO_PINMASK_0)                        ' Analog Input 1
        clearbit(diginpMask,0)
    end if
    if testbit(RTC_BKP16R,6) then
       GPIO_Digital_Input(@GPIOB_BASE,  _GPIO_PINMASK_1)                       ' digital Input 2
       setbit(diginpMask,1)
    else
        GPIO_Analog_Input(@GPIOB_BASE, _GPIO_PINMASK_1)                        ' Analog Input 2
        clearbit(diginpMask,1)
    end if
    set_diginp_resistors(RTC_BKP7R and 63, 0)                                  ' dig. Eingangs-Konfiguration setzen
    input_resistors = RTC_BKP7R and 63
    GPIO_Digital_Output(@GPIOA_BASE, _GPIO_PINMASK_8 or _GPIO_PINMASK_9 or _GPIO_PINMASK_10 or _GPIO_PINMASK_11 or _GPIO_PINMASK_12)    'TFT control, Touch
    GPIO_Digital_Output(@GPIOB_BASE, _GPIO_PINMASK_12)                         ' SD_Card_CS
    GPIO_Digital_Output(@GPIOB_BASE, _GPIO_PINMASK_10)                         ' SF_CS
    asm
       MOVW  R0, #lo_addr(T_IRRPT)
       MOVT  R0, #hi_addr(T_IRRPT)
       MOV   R1, #1
       LSL   R1, R1, #bitPos(T_IRRPT)
    end asm
    GPIO_Config(R0, R1, _GPIO_CFG_DIGITAL_INPUT)                               ' Touch_Int Eingang
    'set_pull_up_down(Port_A, 15, 0, 1)                                         ' Touch_Int Pullup
    USER_LED        = 1
    SYSCFGEN_bit    = 1
    SYSCFG_EXTICR1  = word(0x1111)                                             ' Sys-Config  3-B,  2-B,  1-B,  0-B
    SYSCFG_EXTICR2  = word(0x4441)                                             ' Sys-Config  7-E,  6-E,  5-E,  4-B
    SYSCFG_EXTICR3  = word(0x4444)                                             ' Sys-Config 11-E, 10-E,  9-E,  8-E
    SYSCFG_EXTICR4  = word(0x0444)                                             ' Sys-Config 15-A, 14-E, 13-E, 12-E
    inputdelay_on   = 0
    inputdelay_on.0 = RTC_BKP7R.16
    inputdelay_on.1 = RTC_BKP7R.17
    inputdelay_on.2 = RTC_BKP7R.18
    inputdelay_on.3 = RTC_BKP7R.19
    inputdelay_on.4 = RTC_BKP7R.20
    modstart=0
end sub
#endif

#ifndef 411 then
sub function init_rng as word                                                  ' Random-Number-Generator
    seis_bit=0  ceis_bit=0
    RCC_AHB2ENR.6=0                                                            ' clock ausschalten
    RNG_CR.2=0                                                                 ' RNG ausschalten
    nop nop nop nop nop
    RCC_AHB2ENR.6=1                                                            ' clock einschalten
    RNG_CR.2=1                                                                 ' RNG einschalten
    while secs_bit=1 wend
    if (seis_bit=0) and (ceis_bit=0) then  result=0 else  result=1 end if      ' Erfolg?
end sub
#endif

sub procedure fadenkreuz(dim xp, yp as word)
    if ((xp > 19) and (xp < (TFT_WITH -19))) and ((yp > 19) and (yp < (TFT_HIGHT - 19))) then
       TFT_Circle(xp, yp, 10)
       TFT_H_Line(xp -20, xp + 20, yp)
       TFT_V_Line(yp -20, yp + 20, xp)
    end if
end sub

#ifdef 407ZG then
sub procedure wait_osk_invisible
    if osk_started then
       NVIC_IntDisable(IVT_INT_EXTI15_10)
       while  T_IRRPT=1  wend
       start_osk
    end if
end sub
#endif
#ifdef VG then
sub procedure wait_osk_invisible
    if osk_started then
       NVIC_IntDisable(IVT_INT_EXTI15_10)
       while  T_IRRPT=1  wend
       start_osk
    end if
end sub
#endif

sub procedure wait_touch_press
dim a as word volatile

     a=0
     while T_IRRPT=1
           delay10   'prn(T_IRRPT)
           IWDG_KR=0xAAAA
           if mvar=3 then  exit end if
     wend
     while (T_IRRPT=0) and (a< 10)
           delay01
           IWDG_KR=0xAAAA
           inc(a)
           if mvar=3 then  exit end if
     wend
end sub

sub procedure wait_touch_release
dim n, k, x, y as longword volatile

    n=0   x=0   y=0
    while T_IRRPT=0
          get_coord_raw
          inc(n)
          x = x + x_raw   y = y + y_raw   k = n
          if mvar=3 then  exit end if
          delay10
          IWDG_KR=0xAAAA
    wend
    if k=0 then  perror=19  exit end if
    x_coord_raw = x div k     y_coord_raw = y div k
    'prn(k)
    'prn(x_coord)  prn(y_coord)   cnl
end sub

sub procedure draw_free_hand
dim x1, y1, x2, y2 as word volatile

    if konsole_uart>6 then
       tft_cls9
    end if
    x1=0  y1=0
    wait_touch_press
    TFT_CS=0
    if use_palette then  TFT_Set_Pen(9, 3) else  TFT_Set_Pen(cl_palette[9], 3) end if
    while ser_zeiger=0
          IWDG_KR=0xAAAA
          delay15
          get_coord_raw
          if T_IRRPT=0  then
             x2 = word(float(x_raw) * X_factor) + x_offset
             y2 = word(float(y_raw) * Y_factor) + y_offset
             if ((x1>0) or (y1>0)) then
                TFT_CS=0
                TFT_line(x1, y1, x2, y2)
             end if
             x1=x2   y1=y2
          else
              x1=0   y1=0
          end if
    wend
end sub

sub procedure bitte_kreuz
    delay300
    tft_write_constant_text(bittekreuz,80,120)
    wait_touch_press
end sub

sub procedure Calibrate_Touch()
dim xfaktor as float  volatile                                                 ' ideal value  display/touch ratio x-direction
dim yfaktor as float  volatile                                                 ' ideal value  display/touch ratio y-direction
dim xc1, yc1, xc2, yc2, xc3, yc3, xc4, yc4, mx1, mx2, my1, my2 as word volatile   ' Kreuz-Koordinaten
dim xoben, xunten, ylinks, yrechts as word volatile                            ' distance between crosses
dim xfactor_oben, xfactor_unten, yfactor_links, yfactor_rechts as float volatile  ' display/touch ratios

    if konsole_uart>6 then
       tft_cls9
    end if
    DBP_ON  RTC_BKP3R.0=0  RTC_BKP3R.1=0   RTC_BKP3R.2=0  DBP_OFF  xy_bit=0  lr_bit=0  ou_bit=0  ' X/Y und links/rechts Vertauschungsbits löschen
    xfaktor = (TFT_WITH -1)/4095.0    yfaktor = (TFT_HIGHT-1)/4095.0           ' ideal values  display/touch ratio
    TFT_Clear
    fadenkreuz(30,30)
    bitte_kreuz
    wait_touch_release   xc1 = X_coord_raw   yc1 = Y_coord_raw
    'prn(xc1)  prn(yc1)  cnl
    TFT_Clear
    fadenkreuz(TFT_With -31, 30)
    bitte_kreuz
    wait_touch_release   xc2 = X_coord_raw   yc2 = Y_coord_raw
    if abs(yc2 - yc1) > 1500 then                                              ' y-Distanz zu gross -> Vertauschung X <-> Y
       xy_bit=1  DBP_ON    RTC_BKP3R.0=1   DBP_OFF                             ' Schalter setzen, damit get_coord_raw direkt korrigierte Werte liefert
       mx1=xc1   mx2=xc2   my1=yc1   my2=yc2
       xc1=my1   xc2=my2   yc1=mx1   yc2=mx2                                   ' X und y Werte tauschen
    end if
    if longint(xc1 - xc2) > 1500 then                                          ' linke X-Koordinate grösser als rechte -> links/rechts vertauscht
       lr_bit=1   DBP_ON   RTC_BKP3R.1=1   DBP_OFF                             ' Schalter setzen, damit get_coord_raw direkt korrigierte Werte liefert
       xc1 = 4095-xc1   xc2 = 4095-xc2                                         ' links/rechts Werte tauschen
    end if
    'prn(xc2)  prn(yc2)  cnl
    xoben=xc2-xc1   xfactor_oben = (float(TFT_With) -60.0)/float(xoben)
    TFT_Clear
    fadenkreuz(30, TFT_Hight -31)
    bitte_kreuz
    wait_touch_release   xc3 = X_coord_raw   yc3 = Y_coord_raw
    'prn(xc3)  prn(yc3)  cnl
    TFT_Clear
    fadenkreuz(TFT_With -31, TFT_Hight -31)
    bitte_kreuz
    wait_touch_release   xc4 = X_coord_raw   yc4 = Y_coord_raw
    'prn(xc4)  prn(yc4)  cnl
    xunten=xc4-xc3   xfactor_unten = (float(TFT_With) -60.0)/float(xunten)
    if longint(yc1-yc3) > 1500 then  
       TFT_Clear  ou_bit=1  DBP_ON  RTC_BKP3R.2=1  DBP_OFF
       yc1 = 4095-yc1   yc2 = 4095-yc2    yc3 = 4095-yc3   yc4 = 4095-yc4
       'cnl  prn(yc1)  prn(yc2)  prn(yc3)  prn(yc4)  cnl
    end if
    ylinks=yc3-yc1  yrechts=yc4-yc2
    yfactor_links =(TFT_Hight-60.0)/ylinks
    yfactor_rechts=(TFT_Hight-60.0)/yrechts
    x_factor=sqrt(xfactor_unten * xfactor_oben)                                ' geometrisches Mittel oben/unten
    y_factor=sqrt(yfactor_links * yfactor_rechts)                              ' geometrisches Mittel links/rechts
    ' Die 4 angeklickten Punkte korrigieren:
    X_offset=integer(float((30.0 - xc1*x_factor) + ((TFT_WITH-30.0) - (xc2*x_factor)) + (30.0 - xc3*x_factor) + ((TFT_WITH-30.0)  - xc4*x_factor))/4.0)
    Y_offset=integer(float((30.0 - yc1*y_factor) + (30.0  - yc2*y_factor) + ((TFT_hight-30.0) - yc3*y_factor) + ((TFT_hight-30.0) - yc4*y_factor))/4.0)
    TFT_Clear
    ' Fehlerprüfung: Faktorprüfung: Touch/Display-Faktoren >= ideale Faktoren < +30%, Offsetprüfung: Offset < 100
    DBP_ON
    RTC_BKP0R = float_to_longword(X_factor)                                    ' im Backup-RAM speichern
    RTC_BKP1R = float_to_longword(Y_factor)
    RTC_BKP2R = longword((X_offset <<16) + (Y_offset and 0xFFFF))
    DBP_OFF     cnl
    longword_to_float(RTC_BKP0R)   X_factor = resultat                         ' wieder auslesen
    longword_to_float(RTC_BKP1R)   Y_factor = resultat
    X_offset = integer(RTC_BKP2R>>16)  Y_offset = integer(RTC_BKP2R and 0xFFFF)
    if konsole_uart>6 then
       tft_cls9
    end if
    ' Report - Die 4 angeklickten Punkte:
    cwt("P1 ")  prl(float(xc1*x_factor + x_offset))  con("/")  prl(float(yc1*y_factor+y_offset))  cnl  cwt("P2 ")  prl(float(xc2*x_factor + x_offset))  con("/")  prl(float(yc2*y_factor+y_offset))   cnl
    cwt("P3 ")  prl(float(xc3*x_factor + x_offset))  con("/")  prl(float(yc3*y_factor+y_offset))  cnl  cwt("P4 ")  prl(float(xc4*x_factor + x_offset))  con("/")  prl(float(yc4*y_factor+y_offset))   cnl
    cwt("x-factor: ")  print_float(x_factor)  cwt(", y-factor: ")  print_float(y_factor)  cnl   ' und ausgeben
    cwt("x-offset: ")  pr(x_offset,5)         cwt(", y-offset: ")  pr(y_offset,5)         cnl
    cwt("xy-Bit: ")  con(testbit(RTC_BKP3R,0) +48)  cwt(", left/right-Bit: ")  con(testbit(RTC_BKP3R,1) +48)  cwt(", up/down-Bit: ")  con(testbit(RTC_BKP3R,2) +48)  cnl
    if (X_factor >= xfaktor) and (y_factor >= yfaktor) and (X_factor < (1.3 * xfaktor)) and (y_factor < (1.3 * yfaktor)) and (100 > abs(x_offset)) and (100 > abs(y_offset)) then
       cwt("*** Calibration OK ***")
    else
         cwt("Calibration Tolerance > 30%")
    end if
end sub

sub procedure set_font
    if (TFT_font<8)  then TFT_orient = FO_HORIZONTAL  end if
    if (TFT_font>7)  and (TFT_font<16) then  TFT_orient = FO_VERTICAL  end if
    if (TFT_font>15) then TFT_orient = FO_VERTICAL_COLUMN  end if
    select case      TFT_font
      case 0, 8,16   fontpointer = @TFT_defaultFont               TFT_gr=14  char_offset=2
      case 1, 9,17   fontpointer = @Verdana17x18_Regular          TFT_gr=18  char_offset=2
      case 2,10,18   fontpointer = @Courier_New8x16_Regular       TFT_gr=10  char_offset=2
      case 3,11,19   fontpointer = @Arial16x19_Bold               TFT_gr=16  char_offset=2
      case 4,12,20   fontpointer = @Arial21x24_Bold               TFT_gr=21  char_offset=3
      case 5,13,21   fontpointer = @HandelGothic_BT21x24_Regular  TFT_gr=21  char_offset=3
      case 6,14,22   fontpointer = @Impact35x53_Regular           TFT_gr=35  char_offset=4
      case 7,15,23   fontpointer = @Courier_New8x16_Bold          TFT_gr=10  char_offset=2
    end select
    TFT_Set_Font(fontpointer, TFT_print_Color, TFT_orient)
end sub

sub procedure set_basic_colors
    if use_palette then
       TFT_color=9      TFT_Backcol=16    vfarb=9         hfarb=16          fillfarb=18
       aktiv_farbe=2    inakt_farbe=5     stat_farbe=4    alarm_farbe=2     TFT_print_Color = vt100_palette[7]
    else
        TFT_color = cl_palette[9]    TFT_Backcol = cl_palette[16]  vfarb = cl_palette[9]        hfarb = cl_palette[16]   fillfarb = cl_palette[18]
        aktiv_farbe = cl_palette[2]  inakt_farbe = cl_palette[5]   stat_farbe = cl_palette[4]   alarm_farbe = cl_palette[2]
        farb_dir = LEFT_TO_RIGHT     start_farb = cl_black         end_farb = cl_white          TFT_print_Color = cl_palette[vt100_palette[7]]
    end if
    pen=1  filled=0
end sub

sub procedure start_tft
    TFT_started=1
    tft_fill_screen(tft_backcol)
    TFT_Set_Pen(vfarb, pen)
    TFT_Set_Brush(filled, fillfarb, 0, 0, 0, 0)
    TFT_Set_Font(@TFT_defaultFont, TFT_print_Color, FO_HORIZONTAL)
end sub

sub procedure Init_All_TFT(dim modus as word)                                  ' modus=0: read config bit for palette use
dim n as word volatile                                                         ' modus=1: do not read config

    tft_type = (RTC_BKP5R >> 25) and 7
    if tft_type<2 then
       use_palette=1
       DBP_ON  clearbit(RTC_BKP5R,24)  DBP_OFF
       for n=0 to palettemax -1
           cl_palette[n] = palette_colors24[n]
       next n
    else
        for n=0 to palettemax -1
            cl_palette[n] = palette_colors16[n]
        next n
        if modus=0 then
           if  testbit(RTC_BKP5R,24) =0 then
               use_palette=1
           else
               use_palette=0
           end if
        end if
    end if
    if tft_type=0 then
       #ifndef 411 then
       TFT_SPI_Speed=4
       #else
       TFT_SPI_Speed=8
       #endif
       spi2_speed(TFT_SPI_Speed)
       exit
    end if
    if testbit(RTC_BKP8R,30) then  TFT_Invers8=255  TFT_Invers16=65535  TFT_Invers32=true else  TFT_Invers8=0  TFT_Invers16=0  TFT_Invers32=0 end if
    set_basic_colors    set_font
    TFT_font=0   TFT_Spalte=0   TFT_Zeile=0   TFT_cursor=0   TFT_cursor_form = RTC_BKP5R.5
    TFT_Scroll_Cnt=1   TFT_SCM=0   TFT_NL_Cnt=0   TFT_NL_Max=0    TFT_Umbruch=0
    longword_to_float(RTC_BKP0R)   X_factor = resultat   longword_to_float(RTC_BKP1R)  Y_factor = resultat
    X_offset = integer(RTC_BKP2R >>16)      Y_offset = integer(RTC_BKP2R and 0xFFFF)
    xy_bit=testbit(RTC_BKP3R,0)    lr_bit=testbit(RTC_BKP3R,1)   ou_bit=testbit(RTC_BKP3R,2)
    'cnl print_float(X_factor) uart(",")   print_float(y_factor) uart(",")
    select case tft_type
      case 1                                                                   ' ILI9488 SPI
           #ifndef 411 then
           TFT_SPI_Speed=4
           #else
           TFT_SPI_Speed=8
           #endif
           spi2_speed(TFT_SPI_Speed)
           TFT_WITH=480    TFT_X_Hi=0x01   TFT_X_Lo=0xDF
           TFT_HIGHT=320   TFT_Y_Hi=0x01   TFT_Y_Lo=0x3F
           TFT_Rotate_180(1)
           TFT_Set_Active(@SPI_Set_Index, @SPI_Write_Command, @SPI_Write_Palette24_Data)
           TFT_Init_ILI9481_8bit_custom(TFT_WITH, TFT_HIGHT)
           HXinit(1)
           TFT_max_z  = TFT48_max_z
           TFT_max_s  = TFT48_max_s
           TFT_scroll_mode=0                                                   ' 0=cannot scroll, 1=Softscroll, 2=Hardscroll
      case 2                                                                   ' ILI9341 SPI
           #ifndef  411 then
           TFT_SPI_Speed=16
           #else
           TFT_SPI_Speed=16
           #endif
           spi2_speed(TFT_SPI_Speed)
           TFT_WITH=320    TFT_X_Hi=0x01   TFT_X_Lo=0x3F
           TFT_HIGHT=240   TFT_Y_Hi=0x00   TFT_Y_Lo=0xEF
           if testbit(RTC_BKP5R,23) =1 then
              TFT_Rotate_180(1)
           else
               TFT_Set_Default_Mode()
           end if
           if use_palette then
              TFT_Set_Active(@SPI_Set_Index, @SPI_Write_Command, @SPI_Write_Palette16_Data)
           else
               TFT_Set_Active(@SPI_Set_Index, @SPI_Write_Command, @SPI_Write_Data16)
           end if
           TFT_Init_ILI9341_8bit_custom(TFT_WITH, TFT_HIGHT)
           TFT_max_z  = TFT32_max_z
           TFT_max_s  = TFT32_max_s
           TFT_scroll_mode=0
           
      case 3,4                                                                 ' ST7789V SPI  3 - speziell für das 2,25'' IPS-TFT-Display mit 284x76 Pixeln
           #ifndef  411 then                                                   '              4 - Standart 320x240 Pixel
           TFT_SPI_Speed=8
           #else
           TFT_SPI_Speed=16
           #endif
           spi2_speed(TFT_SPI_Speed)
           if testbit(RTC_BKP5R,23) =1 then
              TFT_Rotate_180(1)
           else
               TFT_Set_Default_Mode()
           end if
           if use_palette then
              TFT_Set_Active(@SPI_Set_Index, @SPI_Write_Command, @SPI_Write_Palette16_Data)
           else
               TFT_Set_Active(@SPI_Set_Index, @SPI_Write_Command, @SPI_Write_Data16)
           end if
           TFT_Init_ST7789V_8bit_Custom(320, 240)
           if TFT_Type=3 then
              TFT_WITH=284
              TFT_HIGHT=76
              TFT_max_z  = 4                                                   ' 5 Zeilen !
              TFT_max_s  = 31                                                  ' 31 Zeichen !
              TFT_X_Offset = (2*9+0)
              TFT_Y_Offset = (5*16-2)
              TFT_BLED=0
           else
               TFT_WITH=320
               TFT_HIGHT=240
               TFT_max_z  = TFT32_max_z
               TFT_max_s  = TFT32_max_s
               TFT_X_Offset = 0
               TFT_Y_Offset = 0
               TFT_BLED=1
           end if
           TFT_scroll_mode=0
           TFT_WR=1   TFT_RD=1   TFT_CS=1   TFT_RST=1
           TFT_Set_Address_Ptr=@TFT_Set_Address_ILI9341
           start_tft
           exit
           
      #ifdef WeAct then
      case 5                                                                   ' ILI9486 SPI
           TFT_SPI_Speed=4
           spi2_speed(TFT_SPI_Speed)
           TFT_WITH=480    TFT_X_Hi=0x01   TFT_X_Lo=0xDF
           TFT_HIGHT=320   TFT_Y_Hi=0x01   TFT_Y_Lo=0x3F
           TFT_Rotate_180(1)
           if use_palette then
              TFT_Set_Active(@SPI_Set_Index, @SPI_Write_Command, @SPI_Write_Palette16_Data)
           else
               TFT_Set_Active(@SPI_Set_Index, @SPI_Write_Command, @SPI_Write_Data16)
           end if
           TFT_Init_ILI9481_8bit_custom(TFT_WITH, TFT_HIGHT)
           HXinit(3)
           TFT_max_z  = TFT48_max_z
           TFT_max_s  = TFT48_max_s
           TFT_scroll_mode=0
      #endif
           
      #ifdef 407mini then
      case 5                                                                   ' ILI9486 SPI
           TFT_SPI_Speed=4
           spi2_speed(TFT_SPI_Speed)
           TFT_WITH=480    TFT_X_Hi=0x01   TFT_X_Lo=0xDF
           TFT_HIGHT=320   TFT_Y_Hi=0x01   TFT_Y_Lo=0x3F
           TFT_Rotate_180(1)
           if use_palette then
              TFT_Set_Active(@SPI_Set_Index, @SPI_Write_Command, @SPI_Write_Palette16_Data)
           else
               TFT_Set_Active(@SPI_Set_Index, @SPI_Write_Command, @SPI_Write_Data16)
           end if
           TFT_Init_ILI9481_8bit_custom(TFT_WITH, TFT_HIGHT)
           HXinit(3)
           TFT_max_z  = TFT48_max_z
           TFT_max_s  = TFT48_max_s
           TFT_scroll_mode=0
      #endif
      
      #ifdef VG then
      case 5                                                                   ' HX8357C parallel
           TFT_SPI_Speed=4
           spi2_speed(TFT_SPI_Speed)
           TFT_WITH=480    TFT_X_Hi=0x01   TFT_X_Lo=0xDF
           TFT_HIGHT=320   TFT_Y_Hi=0x01   TFT_Y_Lo=0x3F
           TFT_Rotate_180(1)
           TFT_Set_Active(@Parallel_Set_Index, @Parallel_Write_Command, @Parallel_Write_Data16)
           TFT_Init_ILI9481_8bit_custom(TFT_WITH, TFT_HIGHT)
           HXinit(5)
           TFT_max_z  = TFT48_max_z
           TFT_max_s  = TFT48_max_s
           TFT_scroll_mode=0
      case 6,7                                                                 ' SSD1963 16Bit parallel
           TFT_SPI_Speed=4
           spi2_speed(TFT_SPI_Speed)
           TFT_WITH=800
           TFT_HIGHT=480
           if testbit(RTC_BKP5R,23)=1 then
              TFT_Rotate_180(1)
           else
               TFT_Set_Default_Mode()
           end if
           if use_palette then
              TFT_Set_Active(@Parallel_Set_Index, @Parallel_Write_Command, @Parallel_Write_Palette16_Data)
           else
               TFT_Set_Active(@Parallel_Set_Index, @Parallel_Write_Command, @Parallel_Write_Data16)
           end if
           GPIO_Digital_Output(@GPIOF_BASE, _GPIO_PINMASK_All)
           GPIO_Digital_Output(@GPIOD_BASE, _GPIO_PINMASK_10 or _GPIO_PINMASK_11 or _GPIO_PINMASK_12 or _GPIO_PINMASK_13 or _GPIO_PINMASK_14 or _GPIO_PINMASK_7)
           if TFT_Type=6 then
              TFT_Init_SSD1963_7Inch_800x480_Custom(800, 480)
           else
               TFT_Init_SSD1963_Board_50_custom(800, 480)
           end if
           TFT_SSD1963_Set_Address_Ptr = @Parallel_Set_Address_SSD1963
           TFT_max_z  = TFT80_max_z
           TFT_max_s  = TFT80_max_s
           TFT_scroll_mode=2
           TFT_WR=1   TFT_RD=1   TFT_CS=1   TFT_RST=1   TFT_BLED=1
           start_tft
           exit
      #endif
      
      #ifdef 407ZG then
      case 5                                                                   ' HX8357C parallel
           TFT_SPI_Speed=4
           spi2_speed(TFT_SPI_Speed)
           TFT_WITH=480    TFT_X_Hi=0x01   TFT_X_Lo=0xDF
           TFT_HIGHT=320   TFT_Y_Hi=0x01   TFT_Y_Lo=0x3F
           TFT_Rotate_180(1)
           TFT_Set_Active(@Parallel_Set_Index, @Parallel_Write_Command, @Parallel_Write_Data16)
           TFT_Init_ILI9481_8bit_custom(TFT_WITH, TFT_HIGHT)
           HXinit(5)
           TFT_max_z  = TFT48_max_z
           TFT_max_s  = TFT48_max_s
           TFT_scroll_mode=0
      case 6,7                                                                 ' SSD1963 16Bit parallel
           TFT_SPI_Speed=4
           spi2_speed(TFT_SPI_Speed)
           TFT_WITH=800
           TFT_HIGHT=480
           if testbit(RTC_BKP5R,23)=1 then
              TFT_Rotate_180(1)
           else
               TFT_Set_Default_Mode()
           end if
           if use_palette then
              TFT_Set_Active(@Parallel_Set_Index, @Parallel_Write_Command, @Parallel_Write_Palette16_Data)
           else
               TFT_Set_Active(@Parallel_Set_Index, @Parallel_Write_Command, @Parallel_Write_Data16)
           end if
           GPIO_Digital_Output(@GPIOF_BASE, _GPIO_PINMASK_All)
           GPIO_Digital_Output(@GPIOD_BASE, _GPIO_PINMASK_10 or _GPIO_PINMASK_11 or _GPIO_PINMASK_12 or _GPIO_PINMASK_13 or _GPIO_PINMASK_14 or _GPIO_PINMASK_7)
           if TFT_Type=6 then
              TFT_Init_SSD1963_7Inch_800x480_Custom(800, 480)
           else
               TFT_Init_SSD1963_Board_50_custom(800, 480)
           end if
           TFT_SSD1963_Set_Address_Ptr = @Parallel_Set_Address_SSD1963
           TFT_max_z  = TFT80_max_z
           TFT_max_s  = TFT80_max_s
           TFT_scroll_mode=2
           TFT_WR=1   TFT_RD=1   TFT_CS=1   TFT_RST=1   TFT_BLED=1
           start_tft
           exit
      #endif
    end select
    TFT_WR=1   TFT_RD=1   TFT_CS=1   TFT_RST=1   TFT_BLED=1
    TFT_Set_Address_Ptr=@tft_set_address_ili9481_2
    start_tft
end sub

sub procedure TFT_clear
    if TFT_started=1 then
       #ifdef 407ZG then
       if osk_started then
          TFT_Set_Pen(0, 1)
          TFT_Set_Brush(1, 0, 0, 0, 0, 0)
          TFT_Rectangle(0, 0, 799, 240)
       else
           TFT_Fill_Screen(0)
       end if
       #endif
       #ifdef VG then
       if osk_started then
          TFT_Set_Pen(0, 1)
          TFT_Set_Brush(1, 0, 0, 0, 0, 0)
          TFT_Rectangle(0, 0, 799, 240)
       else
           TFT_Fill_Screen(0)
       end if
       #endif
       #ifdef Weact then
       TFT_Fill_Screen(0)
       #endif
       #ifdef PyBoard then
       TFT_Fill_Screen(0)
       #endif
       #ifdef 407mini then
       TFT_Fill_Screen(0)
       #endif
       #ifdef 411 then
       TFT_Fill_Screen(0)
       #endif
       if use_palette=0 then
          TFT_Set_Pen(cl_palette[9], 1)
          TFT_Set_Font(@TFT_defaultFont, cl_palette[9], FO_HORIZONTAL)
       else
           TFT_Set_Pen(9, 1)
           TFT_Set_Font(@TFT_defaultFont, 9, FO_HORIZONTAL)
       end if
       TFT_Scroll_Cnt=1   TFT_SCM=0   TFT_NL_Cnt=0   TFT_NL_Max=0
    end if
end sub

sub procedure TFT_restore_colors
    TFT_Set_Pen(vfarb, pen)
    if filled=2 then
       TFT_Set_Brush(0, 0, 1, farb_dir, start_farb, end_farb)
    else
        TFT_Set_Brush(filled, fillfarb, 0, 0, 0, 0)
    end if
    set_font
end sub

sub procedure Init_SPI1_Serflash
    #ifndef 411 then
       #ifdef 407ZG then
       SPI1_Init_Advanced(_SPI_FPCLK_DIV4, _SPI_MASTER OR _SPI_8_BIT OR _SPI_CLK_IDLE_LOW OR _SPI_FIRST_CLK_EDGE_TRANSITION OR _SPI_MSB_FIRST OR _SPI_SS_DISABLE OR _SPI_SSM_ENABLE OR _SPI_SSI_1, @_GPIO_MODULE_SPI1_PB345)
       #endif
       #ifdef 407mini then
       SPI1_Init_Advanced(_SPI_FPCLK_DIV4, _SPI_MASTER OR _SPI_8_BIT OR _SPI_CLK_IDLE_LOW OR _SPI_FIRST_CLK_EDGE_TRANSITION OR _SPI_MSB_FIRST OR _SPI_SS_DISABLE OR _SPI_SSM_ENABLE OR _SPI_SSI_1, @_GPIO_MODULE_SPI1_PB345)
       #endif
       #ifdef VG then
       SPI1_Init_Advanced(_SPI_FPCLK_DIV4, _SPI_MASTER OR _SPI_8_BIT OR _SPI_CLK_IDLE_LOW OR _SPI_FIRST_CLK_EDGE_TRANSITION OR _SPI_MSB_FIRST OR _SPI_SS_DISABLE OR _SPI_SSM_ENABLE OR _SPI_SSI_1, @_GPIO_MODULE_SPI1_PB345)
       #endif
    #endif
    sf_cs=1                                                                    ' flash-CS off
end sub

sub procedure com1_int_on                                                      ' com1 interrupt on
    USART1_CR1.B5=1
    NVIC_IntEnable(IVT_INT_USART1)
    clear_buffer1
end sub

sub procedure Init_com1                                                        ' com1 starten / usart1
    #ifdef Pyboard then
    konsole_uart=1   set_uart_konsole   clear_buffer1
    exit
    #endif
    uart_nr=KONSOLE1                                                           ' Umleitung aus
    if RTC_BKP4R>0 then
       set_baud(RTC_BKP4R)
       if perror then  set_baud(115200)  perror=0 end if
    else
        set_baud(115200)
    end if
    konsole_uart=1
    com1_int_on
end sub

sub procedure redirect_konsole
dim test as byte volatile

    test = RTC_BKP8R and 15
    if test=0 then exit end if
    if test>9 then test=test+16 end if
    select case test
      #ifndef 411 then
      case 1,3                                                                 ' Schnittstelle 1&3
      case 2                                                                   ' com2
        #ifdef 405RG then
               #ifndef VG then
                if RTC_BKP17R=0     then exit end if                           ' com2 nicht Konfiguriert
               #endif
        #endif
      case 4    if (i2c2_on=1)      then exit end if                           ' Schnittstelle 4 belegt von I2C2
      case 5    if (usb1_started=0) then exit end if                           ' USB Device nicht gestartet
      case 6    if (usb0_started=0) then exit end if                           ' USB Host nicht gestartet
      case 7    if (TFT_started =0) then exit end if                           ' TFT nicht gestartet
      case 9    if (TFT_started =0)  or (usb0_started=0)  then exit end if     ' TFT oder USB Host nicht gestartet
      case 31   if (TFT_started =0) then konsole_uart = 1      exit end if     ' TFT nicht gestartet
                if (usb0_started=0) then konsole_uart = 1      exit end if     ' USB Host nicht gestartet
        #ifdef 407ZG then
      case 8    if (TFT_started =0)  or ((keyboard_active=0) and (osk_started<>2)) then exit end if  ' TFT oder Matrix oder OSK nicht gestartet
      case 30   if (usb1_started=0)    then exit end if                        ' USB Device nicht gestartet
                if (keyboard_active=0) then exit end if                        ' Matrix nicht gestartet
        #endif
        #ifdef VG then
      case 8    if (TFT_started =0) or (osk_started<>2)     then exit end if   ' TFT oder OSK nicht gestartet
        #endif
        #ifdef 407mini then
      case 8    if (TFT_started =0)  or (keyboard_active=0) then exit end if   ' TFT oder Matrix nicht gestartet
      case 30   if (usb1_started=0)    then exit end if                        ' USB Device nicht gestartet
                if (keyboard_active=0) then exit end if                        ' Matrix nicht gestartet
        #endif
      #else
      case 2                                                                   ' nur Schnittstelle 2
      #endif
      case else exit                                                           ' Filehandler
    end select
    snl   sys("continue on interface nbr.: ",5)  pr(test,5)   cnl
    konsole_uart = test   'uart_nr = test
    if konsole_uart>6 then  tft_cls9  end if
end sub


sub procedure Init_ser2_ivt(dim speed as longword, dim bits, pari, stopbits as byte)   ' MIDI starten  auf com2
dim d_bits, d_pari, d_stopbits as word volatile

    d_bits=0   d_pari=0   d_stopbits=0                                         ' 8 Data Bits, No Parity, 1 Stop Bit
    if bits    =8  then d_bits     = _UART_8_BIT_DATA   end if
    if bits    =9  then d_bits     = _UART_9_BIT_DATA   end if
    if pari    =0  then d_pari     = _UART_NOPARITY     end if
    if pari    =1  then d_pari     = _UART_ODDPARITY    end if
    if pari    =2  then d_pari     = _UART_EVENPARITY   end if
    if stopbits=1  then d_stopbits = _UART_ONE_STOPBIT  end if
    if stopbits=2  then d_stopbits = _UART_TWO_STOPBITS end if
    if stopbits=5  then d_stopbits = _UART_HALF_STOPBIT end if
    if stopbits=15 then d_stopbits = _UART_ONE_AND_A_HALF_STOPBITS end if
    #ifdef 407ZG then
    UART2_Init_Advanced(speed, d_bits, d_pari, d_stopbits, @_GPIO_MODULE_USART2_PD56)
    set_pull_up_down(Port_D,6,1,0)                                             ' RX Pullup
    USART2_CR1.B5=1
    NVIC_IntEnable(IVT_INT_USART2)
    #endif
    #ifdef 407mini then
    UART4_Init_Advanced(speed, d_bits, d_pari, d_stopbits, @_GPIO_MODULE_UART4_PC10_11)
    set_pull_up_down(Port_C,11,1,0)
    UART4_CR1.B5=1
    NVIC_IntEnable(IVT_INT_UART4)
    #endif
    #ifdef 411 then
    UART2_Init_Advanced(speed, d_bits, d_pari, d_stopbits, @_GPIO_MODULE_UART2_PA23)
    set_pull_up_down(Port_A,3,1,0)
    USART2_CR1.B5=1
    NVIC_IntEnable(IVT_INT_USART2)
    #endif
    #ifdef 405RG then
      #ifdef VG then
      UART2_Init_Advanced(speed, d_bits, d_pari, d_stopbits, @_GPIO_MODULE_USART2_PD56)
      set_pull_up_down(Port_D,6,1,0)                                           ' RX Pullup
      #else
      UART2_Init_Advanced(speed, d_bits, d_pari, d_stopbits, @_GPIO_MODULE_USART2_PA23)
      set_pull_up_down(Port_A,3,1,0)                                           ' RX Pullup
      #endif
    USART2_CR1.B5=1
    NVIC_IntEnable(IVT_INT_USART2)
    #endif
    ser2_zeiger=0
    sys("started com2",9)
end sub

#ifndef 411 then
