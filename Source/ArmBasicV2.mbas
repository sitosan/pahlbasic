sub procedure esc_sequence(dim ctr_char as byte, dim iface as word)            ' Escape Sequence for Matrix-/USB-Keyboard
    put_char_in_buffer(27,  iface)
    put_char_in_buffer("[", iface)
    put_char_in_buffer(ctr_char, iface)
    select case ctr_char
      case 49,52
           put_char_in_buffer(126, iface)
    end select
end sub

sub procedure update_keys
dim i as word  volatile

    nbr_keys_last  = nbr_keys
    for i=0 to (KBR_MAX_NBR_PRESSED - 1)
        keys_last[i] = keys[i]
    next i
end sub

sub procedure fn_key(dim funckey as byte, dim intrfce as word)                 ' ESC-Sequenz Funktionstasten in Empfangs-Puffer
    put_char_in_buffer(27, intrfce)                                            ' Escapesequenz einleiten
    put_char_in_buffer("[", intrfce)                                           ' Escapesequenz einleiten
    if funckey>65 then                                                         ' Funktionstasten 9...12
       put_char_in_buffer(50, intrfce)                                         ' VT100 Code (first)
    else                                                                       ' Funktionstasten 1...8
        put_char_in_buffer(49, intrfce)                                        ' VT100 Code (first)
    end if
    select case funckey                                                        ' VT100 Codes (second)  Liste ist erforderlich wegen Fehler in TeraTerm
      case 58   put_char_in_buffer(49, intrfce)  '1                            ' Fkey 1
      case 59   put_char_in_buffer(50, intrfce)  '2                            ' Fkey 2
      case 60   put_char_in_buffer(51, intrfce)  '3                            ' Fkey 3
      case 61   put_char_in_buffer(52, intrfce)  '4                            ' Fkey 4
      case 62   put_char_in_buffer(53, intrfce)  '5                            ' Fkey 5
      case 63   put_char_in_buffer(55, intrfce)  '7                            ' Fkey 6  Fehler in TeraTerm V4 ???? macht diesen select crap nötig
      case 64   put_char_in_buffer(56, intrfce)  '8                            ' Fkey 7
      case 65   put_char_in_buffer(57, intrfce)  '9                            ' Fkey 8
      case 66   put_char_in_buffer(48, intrfce)  '0                            ' Fkey 9
      case 67   put_char_in_buffer(49, intrfce)  '1                            ' Fkey 10
      case 68   put_char_in_buffer(51, intrfce)  '3                            ' Fkey 11
      case 69   put_char_in_buffer(52, intrfce)  '4                            ' Fkey 12
    end select
end sub

sub procedure KeyBoard_Decode(dim pbuf as ^byte)                               ' USB-Keyboard dekodieren
dim
    extra_key as byte     volatile
    arrReport as byte[8]  volatile
    i, j      as byte     volatile
    output    as byte     volatile
    
    key_ctrl=0
    for i=0 to 7                                                               ' Tastencodes holen
        arrReport[i] = pbuf^                                                   ' aus Puffer
        pbuf = pbuf +1                                                         ' Zeiger erhöhen
    next i
    extra_key = arrReport[0]                                                   ' Shift, Ctrl, Alt, AltGr merken
    for i=2 to 7                                                               ' Tasten-Nummer ermitteln
        if ((arrReport[i] = 0x01) or (arrReport[i] = 0x02) or (arrReport[i] = 0x03)) then
           exit
        end if
    next i
    nbr_keys    =0                                                             ' Anzahltasten
    nbr_keys_new=0                                                             ' neugedückte Tasten
    for i=2 to 7
        if arrReport[i] <> 0 then
           keys[nbr_keys] = arrReport[i]
           Report[i] = arrReport[i]
           nbr_keys = nbr_keys +1
           j=0
           while (j < nbr_keys_last)
                 if (arrReport[i] = keys_last[j]) then  break end if
                 j = j +1
           wend
           if (j = nbr_keys_last) then
              keys_new[nbr_keys_new] = arrReport[i]
              nbr_keys_new = nbr_keys_new +1
           end if
        else
            if Report[i]>0  then
               key_released = Report[i]
               Report[i]=0
            end if
        end if
    next i
    if (nbr_keys_new=1) then                                                   ' nur eine Taste gedrückt?
       key_newest = keys_new[0]
       key_pressed = key_newest
       if (key_newest>56) then                                                 ' nicht in der Buchstaben/Ziffern-Tabelle?
          if (key_newest>82) and (key_newest<101) then                         ' in der Nummernblock-Tabelle?
             select case extra_key
               case 0x02, 0x20   output = numkey_shift[key_newest -83]         ' mit Shift
               case 0x01, 0x10   output = numkey_ctrl[key_newest  -83]         ' mit Ctrl
               case 0x40         output = numkey_altgr[key_newest -83]         ' mit AltGr
               case else         output = numkey[key_newest       -83]         ' ohne "
             end select
          else                                                                 ' Cursortasten, Funktionstasten etc
              if (key_newest>73) and (key_newest<83) then
                 output = specialkey[key_newest -74]                           ' Cursortasten, Entf, Pos1, Ende
                 if key_newest<>76 then                                        ' not Entf-Taste? (del is a function key)
                    key_ctrl=1                                                 ' flag for input routine (inputstr)
                    put_char_in_buffer(27,9)                                   ' Escapesequenz einleiten
                    put_char_in_buffer("[",9)
                    if key_newest=74 then                                      ' 'Pos1'
                       put_char_in_buffer(49,9)
                       output =126
                    end if
                    if key_newest=77 then                                      ' 'Ende'
                       put_char_in_buffer(52,9)
                       output =126
                    end if
                 end if
              else
                  if (key_newest>57) and (key_newest<70) then                  ' Funktionstasten?
                     fn_key(key_newest,9)                                      ' Escapesequenz in USB-Puffer
                     output=126                                                ' ESC-Schluss-Zeichen
                  end if
              end if
          end if
       else                                                                    ' Buchstaben und Ziffern
           if language=0 then
              select case extra_key
                case 0x02, 0x20   output = Keyboard_ShiftKey_de[key_newest]    ' mit Shift (german keys)
                case 0x01, 0x10   output = Keyboard_CtrlKey_de[key_newest]     ' mit Ctrl      "
                case 0x40         output = Keyboard_AltgrKey_de[key_newest]    ' mit AltGr     "
                case 0x04         output = Keyboard_AltKey_de[key_newest]      ' mit Alt       "
                case else         output = Keyboard_Key_de[key_newest]         ' ohne          "
              end select
           else
               select case extra_key
                 case 0x02, 0x20  output = Keyboard_ShiftKey_us[key_newest]    ' mit Shift (us keys)
                 case 0x01, 0x10  output = Keyboard_CtrlKey_us[key_newest]     ' mit Ctrl      "
                 case 0x40        output = Keyboard_AltgrKey_us[key_newest]    ' mit AltGr     "
                 case 0x04        output = Keyboard_AltKey_us[key_newest]      ' mit Alt       "
                 case else        output = Keyboard_Key_us[key_newest]         ' ohne          "
              end select
           end if
       end if
       put_char_in_buffer(output,9)
       if (konsole_uart =9) or (konsole_uart=6) or (konsole_uart=31) then      ' Konsole mit USB-Keyboard
          if mvar=3 then  perror=maxerror  get_one_usb_byte end if             ' ctrl c?  dann künstlichen Fehler erzeugen
       end if
       if onbuf9=1 then                                                        ' on buf9? Keyboard-Basic-Interrupt eingeschaltet?
          if output>0 then                                                     ' druckbares Zeichen?
             int_helper(16)                                                    ' Basic-Interrupt-Nr. 16
          end if
       end if
    else                                                                       ' mehrere Tasten gedrückt?
        key_newest=0x00                                                        ' ungültig!  Taste löschen
    end if
    update_keys
end sub

  #ifndef VG then
    #ifndef PyBoard then
      #ifndef WeAct then
sub procedure Init_Matrix_Keyboard(dim matrix as word)                         ' keyMode1: 0=active low, 1=active high   **** start Matrix Keyboard ****
const InROM=0                                                                  ' keyMode2: 0=Computer, 1=Music
const InRAM=1
const Off=0
dim   portout, portin, n  as  word volatile
      odrainptr           as ^word volatile
      
    #ifdef 407ZG then
    if matrix <14 then
       portout=Port_G   portin=Port_G
    else
        portout=Port_G   portin=Port_E
    end if
    #endif
    #ifdef 407mini then
    portout=Port_D   portin=Port_D
    #endif
    keyMode1=0
    outputptr=get_portpointer(portout)                                         ' GPIO_Base portout
    inputptr=get_portpointer(portin)                                           ' GPIO_Base portin
    odrainptr=get_portpointer(portout)+OTYPER
    'prn(0x40021810)
    'prn(longword(outputptr))
    'prn(longword(inputptr))
    set_matrix(matrix)
    if keyMode1>1    then  keyMode1=1     end if
    if keyMode2 then                                                           ' Piano Keyboard
       start_note=(RTC_BKP14R>>10) and 127
       if keymode4 then
          start_MIDI_sound                                                     ' Soundmodul starten
          adsr_on=0
       end if
    else
        MX_interface=(RTC_BKP14R>>10) and 15
    end if
    inputMask=(1<<yin) -1
    if portout=portin then
       outputMask=((1<<xout)-1)<<yin
       relayMask=relayMask and (not outputMask)
       relayMask=relayMask and (not inputMask)
       GPIO_Digital_Output(outputptr, outputMask)                              ' Relay-Port
       GPIO_Digital_Input(inputptr, inputMask)                                 ' Relay-Port
    else
        outputMask=(1<<xout) -1
        GPIO_Digital_Output(outputptr, outputMask)                             ' beliebiger Port
        relayMask=relayMask and (not outputMask)
        GPIO_Digital_Input(inputptr, inputMask)                                ' beliebiger weiterer Port
        diginpMask=diginpMask and (not inputMask)
    end if
    for n=0 to yin-1
        if keyMode1=0 then                                                     ' Low active
           set_pull_up_down(portin,n,1,0)                                      ' dann Pullups
        else                                                                   ' High active
            set_pull_up_down(portin,n,0,1)                                     ' dann Pulldowns
        end if
    next n
    for n=0 to 7                                                               ' Keybuffer löschen
        if keyMode1=0 then
           keybuffer[n]=65535
        else
            keybuffer[n]=0
        end if
    next n
    outputptr=get_portpointer(portout) + ODR                                   ' GPIO_ODR
    inputptr =get_portpointer(portin)  + IDR                                   ' GPIO_IDR
    'prn(longword(outputptr))    prn(longword(inputptr))
    extraKey=Off
    if decode=InROM then                                                       '            im ROM ?
       if MX_check_table>14 then
          table_adr=@scancodeMX[0]                                             ' RAM-Decoder wurde im ROM gespeichert
       else
           table_adr=@scancode[0]                                              ' vorkonfiguriert im ROM !
       end if
    else                                                                       '            im RAM ?
        table_adr=MX_decoder  '0x40024EC0                                      ' im RAM !
    end if
end sub

sub procedure MX_f_key(dim mx_fkey as byte)                                    ' function keys for Matrix-Keyboard
    fn_key(mx_fkey + 57,8)                                                     ' Esc-Sequenz Function Key starten
    put_char_in_buffer(126,8)                                                  ' Esc-Sequenz-Schlusszeichen
end sub

sub procedure set_ctrl_key
    key_ctrl=1
end sub

sub procedure MX_key(dim mkey as byte)
    if mkey<13 then                                                            ' ohne Shift,Alt,CTRL etc.
       MX_f_key(mkey)                                                          ' Funktionstasten
    else
        select case mkey
          case 14   'extraKey=Shift                                            '                 ctrl n
          case 15   'extraKey=Ctrl                                             '                 ctrl o
          case 16   'extraKey=Alt                                              '                 ctrl p
          case 17   'extraKey=Altgr                                            '                 ctrl q
          case 18   esc_sequence("D",8)             set_ctrl_key               ' Cursor left     ctrl r
          case 19   esc_sequence("C",8)             set_ctrl_key               ' Cursor right    ctrl s
          case 20   put_char_in_buffer(9,8)                                    ' Tab             ctrl t
          case 21   put_char_in_buffer(127,8)                                  ' entf            ctrl u
          case 22   esc_sequence(49,8)                                         ' Pos1            ctrl v
          case 23   esc_sequence(52,8)                                         ' Ende            ctrl w
          case 24   put_char_in_buffer(8,8)                                    ' Del             ctrl x
          case 25   extraKey.1 = not extraKey.1                                ' Feststelltaste  ctrl y
          case 26   esc_sequence("A",8)             set_ctrl_key               ' Cursor up       ctrl z
          case 28   esc_sequence("B",8)             set_ctrl_key               ' Cursor down     ctrl ß
          case 29   'extraKey=Fn
          #ifdef 407ZG then
          case 30   GPIOB_ODR.B2=not GPIOB_ODR.B2                              ' Licht
          #endif
          #ifdef VG then
          case 30   GPIOB_ODR.B2=not GPIOB_ODR.B2                              ' Licht
          #endif
          #ifdef 407mini then
          case 30
          #endif
          case 31
          case else put_char_in_buffer(mkey,8)                                 ' Zeichen
        end select
    end if
end sub

sub procedure MX_scan_key(dim diagnose as word)                                ' Matrix-Tastatur
const Off=0
const Shift=2                                                                  ' keyMode1: 0=active low,     1=active high
const Ctrl=4                                                                   ' keyMode2: 0=Computer,       1=Piano
const Alt=8                                                                    ' keymode3: 0=konst.Anschlag, 1=Poti an ad1
const Altgr=16                                                                 ' keymode4: 0=sende MIDI,     1=play internal DDS-Gen.
const Fn=32
const Computer=0
const Piano=1
const High=1
const Low=0
const Extern=0
const Intern=1
dim decoder                            as ^byte     volatile
dim keyport, oldkeyport, mkey          as  word     volatile
dim x, y, comp, midi_key               as  word     volatile

    for x=0 to xout-1                                                          ' Spalten-Portbits nacheinander aktivieren
        if keyMode1=Low then                                                   '            low active ?               X-Portausgänge setzen
           outputptr^ = outputptr^ or outputMask                               ' alle Portausgänge high
           clearbit(outputptr^,x+yin)                                          ' SpaltenBit low
        else                                                                   '            high active ?
            outputptr^ = outputptr^ and (not outputMask)                       ' alle Portausgänge low
            setbit(outputptr^,x+yin)                                           ' SpaltenBit high
        end if
        nop nop nop nop nop
        keyport=inputptr^       and inputMask                                  ' Tastenreihe auslesen                  Y-Porteingänge lesen
        oldkeyport=keybuffer[x] and inputMask                                  ' gespeicherte Tastenreihe
        comp=keyport xor oldkeyport                                            ' ungleiche Bits speichern
        if comp then                                                           ' Unterschiede?
           keybuffer[x]=keyport                                                ' gespeicherte Tastenreihe aktualisieren
           for y=0 to yin -1                                                   ' ungleiche Bits ermitteln
               if testbit(comp,y)=1 then                                       ' Unterschied?
                  tabl_pos=y+(x*yin)                                           ' Tabellenposition=Tastenposition
                  midi_key=tabl_pos + start_note                               ' MIDI-Note
                  decoder=table_adr + tabl_pos                                 ' Decodier-Zeiger auf Normal-Tabelle
                  mkey=decoder^                                                ' Taste aus Grundtabelle
                  if testbit(keyport,y)=keyMode1 then                          '                         Taste gedrückt?
                     if keyMode2=Computer then                                 ' ---------------- Computer Keyboard ------------
                        key_newest=tabl_pos
                        key_pressed=key_newest
                        if diagnose=0 then
                           select case   extraKey
                             case Off
                                         select case mkey                          ' normal
                                           case 14   extraKey=Shift  key_newest=0
                                           case 15   extraKey=Ctrl   key_newest=0
                                           case 16   extraKey=Alt    key_newest=0
                                           case 17   extraKey=Altgr  key_newest=0
                                           case 29   extraKey=Fn     key_newest=0
                                           case else
                                                     MX_key(mkey)
                                         end select
                             case Shift
                                         decoder=table_adr + tabl_pos + (1*128)     ' mit Shift
                                         MX_key(decoder^)
                             case Ctrl
                                         decoder=table_adr + tabl_pos + (2*128)     ' mit ctrl
                                         put_char_in_buffer(decoder^,8)
                             case Alt
                                         decoder=table_adr + tabl_pos + (3*128)     ' mit alt
                                         MX_key(decoder^)
                             case Altgr
                                         decoder=table_adr + tabl_pos + (4*128)     ' mit altgr
                                         MX_key(decoder^)
                             case Fn
                                         decoder=table_adr + tabl_pos + (5*128)     ' mit fn
                                         MX_key(decoder^)
                           end select
                        else
                            put_char_in_buffer(decoder^,8)
                        end if
                     else                                                      ' ---------------- Piano Keyboard ---------------
                         if keymode4=Extern then                               ' extern play (send MIDI)
                            uart_nr=MIDI                                       ' MIDI
                            uart(144 + midi_channel)                           ' sende MIDI-Note On
                            uart(midi_key)                                     ' Noten-Nummer
                            if keymode3 then                                   ' einstellbarer Anschlag?
                               uart(byte(get_adc_sample(0)>>5))                ' Anschlag-Stärke  (Pedal)
                            else                                               ' konstanter Anschlag
                                uart(127)                                      ' const 127 (Orgel)
                            end if
                         else                                                  ' intern play
                             if (midi_key>11) and (midi_key<108) then          ' Notenbereich des DDS-Generators
                                voice_key[tabl_pos]=play_note(midi_key,600000,1.0)   ' play note on
                             end if
                         end if
                     end if                                                    ' -----------------------------------------------
                  else                                                         '                      Taste losgelassen?
                      if keyMode2=Computer then                                ' ----------------- Computer Tastatur -----------
                         if (mkey>13) and (mkey<18) then
                            extraKey=Off
                         else
                             key_released=tabl_pos
                         end if
                         if key_newest=key_released then  key_newest=0 end if
                      else                                                     ' ----------------- Piano Keyboard --------------
                          if keymode4 then                                     ' play intern ?
                             if (midi_key>12) and (midi_key<107) then          ' Notenbereich des DDS-Generators
                                voice_out(voice_key[tabl_pos])                 ' play note off
                             end if
                          else                                                 ' play extern
                              uart_nr=MIDI                                     ' MIDI
                              uart(128 + midi_channel)                         ' sende MIDI-Note Off
                              uart(midi_key)                                   ' Noten-Nummer
                              uart(0)                                          ' Anschlagstärke
                          end if                                               ' -----------------------------------------------
                      end if
                  end if
               end if
           next y
        end if
    next x
    if keyMode1=Low then                                                       '            low active ?
       outputptr^ = outputptr^ or outputMask                                   ' alle Portausgänge high
    else                                                                       '            high active ?
        outputptr^ = outputptr^ and not(outputMask)                            ' alle Portausgänge low
    end if
end sub
      #endif
    #endif
  #endif
  
sub procedure USBDev_CDCDataReceived(dim size as word)                         ' Callback function which will be called on received packet
dim n as byte volatile

    USBDev_CDCSetReceiveBuffer(@usb_r_buffer)                                  ' Prepare receive buffer
    n=0
    while size                                                                 ' wurde etwas empfangen?
          mvarusb = usb_r_buffer[n]
          recstrusb[usb_zeiger] = mvarusb                                      ' in pahlbasic-com-Puffer umfüllen
          if usb_zeiger < usbfifo  then
             inc(usb_zeiger)
          end if
          if (konsole_uart=5) or (konsole_uart=30) then
             mvar = mvarusb
             ser_zeiger = usb_zeiger
             if mvar=3 then  perror = maxerror  get_one_usb_byte end if        ' ctrl c
          end if
          dec(size)  inc(n)
    wend
    if onbuf_usb=1 then                                                        ' usb device int on?
       int_helper(16)                                                          ' Basic-Interrupt Nr.16
    end if
end sub
#endif

sub procedure instr_stamp                                                      ' Zeitstempel  2Byte!!
    protokoll_date_time
    if isvar2(2)=0 then exit end if
    varlong[progline[2] -65] = uint64(date_reg <<32) + time_reg
end sub

#ifdef 411 then
sub procedure instr_seed                                                       ' Startpunkt für rand setzen (F411)
dim seeder as word volatile
    seeder=word(calculate_exp(2))
    srand(seeder)
end sub
#endif

sub procedure stopp                                                            ' normales end / exit / stop
    contadres = progpointer +1  
    contflag_value=1  
    progpointer = progend -2
end sub

sub procedure instr_end                                                        ' Instruktion end / exit
    if progline[1] = "." then                                                  ' starkes end. / exit. ?
       mvar=0   perror=0
       contflag=0  contflag_value=0  
       progpointer = progend -2
       contadres = progend -2
       #ifndef 411 then
       sound_off 
       #endif
       release_interrupts
    else                                                                       ' end/stop
        if pmode=1 then                                                        ' nur im Programm!
           mvar=0   perror=0
           stopp                                                               ' normales end / exit / stop
        else
            perror=1                                                           ' nicht im Kommando-Modus
        end if
    end if
end sub

#ifndef 411 then
sub procedure instr_usb                                                        ' startet USB, wenn nicht konfiguriert
    if int_marker then exit end if
    select case progline[2]
      case "5"  usb_wait_counter=30000
                Init_USB_Device
      case "9"  while  Init_USB_Host<4  wend
      case else perror=13
    end select
end sub
#endif

sub procedure longword_to_float(dim t_long as longword)
dim f_pointer as ^float volatile

    f_pointer = @t_long
    resultat = f_pointer^
end sub

sub function float_to_longword(dim t_float as float) as longword
dim l_pointer as ^longword volatile

    l_pointer = @t_float
    result = l_pointer^
end sub

sub procedure set_timerx_speed(dim timnbr as word, dim freqout as longword)    ' timnbr=timer number, freqout=frequency in Hz
#ifndef 411 then
const       div1=2
            div2=1
#else
const       div1=1
            div2=1
#endif
dim k       as word     volatile
    reg     as longword volatile
    freqin  as longword volatile
    
    select case timnbr                                                         ' select bus frequency
      case 2,3,4,5,6,7,12,13,14
           freqin = Get_Fosc_kHz()*1000/div1                                   ' APB1 Timerfactor
      case 1,8,9,10,11
           freqin = Get_Fosc_kHz()*1000/div2                                   ' APB2 Timerfactor
    end select
    k=1
    while uint64(freqin / k / freqout) > 65535                                 ' prescaler ermitteln
          inc(k)
    wend
    reg = (freqin / k / freqout) -1                                            ' Reload Value
    ratio=reg +1
    select case timnbr                                                         ' select Timer
      case 2    TIM2_PSC = k -1   TIM2_ARR = reg
      case 3    TIM3_PSC = k -1   TIM3_ARR = reg
      case 4    TIM4_PSC = k -1   TIM4_ARR = reg
      case 5    TIM5_PSC = k -1   TIM5_ARR = reg
      case 9    TIM9_PSC = k -1   TIM9_ARR = reg
      case 10  TIM10_PSC = k -1  TIM10_ARR = reg
      case 11  TIM11_PSC = k -1  TIM11_ARR = reg
      #ifndef 411 then                                                         ' F401/F411 do not have these Timers
      case 6    TIM6_PSC = k -1   TIM6_ARR = reg
      case 7    TIM7_PSC = k -1   TIM7_ARR = reg
      case 12  TIM12_PSC = k -1  TIM12_ARR = reg
      case 13  TIM13_PSC = k -1  TIM13_ARR = reg
      case 14  TIM14_PSC = k -1  TIM14_ARR = reg
      #endif
    end select
end sub

sub procedure send(dim zeichen as byte)                                        ' ein Zeichen senden und speichern für Listing
    if listswitch<2 then                                                       ' >=2 bedeutet: Zeichen geht nur ins Listing
       uart(zeichen)                                                           ' <2  auch Ausgabe
    end if
    if listswitch then
       if listcounter < (stringlen -2) then
          listline[actual_line][listcounter] = zeichen
          listline[actual_line][listcounter +1] = 0
          inc(listcounter)
       end if
    end if
end sub

sub procedure send_led_24bits
dim n, m, k as word volatile

    int2_off
    for k=0 to led_anzahl -1
        for n=23 to 0  step -1
            if testbit(led_farben[k],n) = 1 then
               #ifndef 411 then
               led_out=1
               for m=1 to 7
                   asm
                      nop
                      nop
                      nop
                      nop
                      nop
                   end asm
               next m
               led_out=0
               for m=1 to 3
                   asm
                      nop
                      nop
                      nop
                      nop
                      nop
                   end asm
               next m
               #else
               led_out=1
               Delay_Cyc(700)
               led_out=0
               Delay_Cyc(300)
               #endif
            else
                #ifndef 411 then
                led_out=1
                for m=1 to 3
                    asm
                       nop
                       nop
                       nop
                       nop
                       nop
                    end asm
                next m
                led_out=0
                for m=1 to 7
                    asm
                       nop
                       nop
                       nop
                       nop
                       nop
                    end asm
                next m
                #else
                led_out=1
                Delay_Cyc(300)
                led_out=0
                Delay_Cyc(700)
                #endif
            end if
        next n
        #ifndef 411 then
        for m=1 to 3  asm  nop  end asm  next m
        #else
        Delay_Cyc(300)
        #endif
    next k
    int2_on
end sub

