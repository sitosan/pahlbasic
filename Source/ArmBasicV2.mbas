    SD_Card_buffer      as char[8] at SD_Float
    SD_timeout          as MMC_timeout_values
    SD_Card_Error       as short
    SD_Card_started     as word
    SD_Drive            as word                                                ' Nummer des aktuellen Drives
    SD_Dir_Counter      as longword
    MMC_chip_select     as sbit at GPIOB_ODR.0  'as sbit at GPIOC_ODR.11       ' für 2. SD-Card Drive
    dir_string          as string[32]                                          ' aktuelles Verzeichnis
    Drive1_Path_String  as string[128]
    Drive2_Path_String  as string[128]

'USB                                                                            ---------------407ZG-------------------------------------------
dim usb_r_buffer        as byte[64]
    usb0_started        as longword
    usb1_started        as longword
    usb_wait_counter    as word
    usb1_char           as byte
    USB_ID              as sbit at GPIOA_ODR.10
    USB_PW              as sbit at GPIOA_ODR.09
    USBHost_HIDHandler  as TUSBHostHIDHandler
    USBHost_HIDHandlerPtr as ^TUSBHostHIDHandler

'Soft_I2C                                                                       ---------------407ZG-------------------------------------------
dim Soft_I2C_Scl_Input  as sbit at GPIOB_IDR.B8
    Soft_I2C_Sda_Input  as sbit at GPIOB_IDR.B9
    Soft_I2C_Scl_Output as sbit at GPIOB_ODR.B8
    Soft_I2C_Sda_Output as sbit at GPIOB_ODR.B9

'TFT Anschlüsse                                                                 -----407ZG-----------------------------------------------------
dim TFT_DataPort as word  at GPIOF_ODR  sfr
    TFT_RST      as sbit  at GPIOD_ODR.14
    TFT_BLED     as sbit  at GPIOD_ODR.07
    TFT_RS       as sbit  at GPIOD_ODR.12
    TFT_CS       as sbit  at GPIOD_ODR.13
    TFT_RD       as sbit  at GPIOD_ODR.10
    TFT_WR       as sbit  at GPIOD_ODR.11
    
'XPT2046 Anschlüsse                                                             ------407ZG----------------------------------------------------
DIM
    T_CS         as sbit  at GPIOB_ODR.12                                      ' Touch CS
    T_IRRPT      as sbit  at GPIOD_IDR.15                                      ' Touch Interrupt Pin
    
'User_LED, SerialFlash CS, WS2812 LED Outputs                                   ------407ZG----------------------------------------------------
DIM
    USER_LED     as sbit  at GPIOC_ODR.13                                      ' Lebenslicht
    sf_cs        as sbit  at GPIOA_ODR.15                                      ' ser. Flash-Chip CS
    led_out      as sbit  at GPIOB_ODR.02                                      ' WS2812 Anschluss
    RTS1         as sbit  at GPIOB_ODR.01                                      ' RS485 Ready_to_Send Strang1
    RTS2         as sbit  at GPIOD_ODR.03                                      ' RS485 Ready_to_Send Strang2
    RTS3         as sbit  at GPIOD_ODR.04                                      ' RS485 Ready_to_Send Strang3


'Relays, Impuls, USB-Power, GPS-Power                                           ----------407ZG------------------------------------------------
DIM
    relay        as word  at GPIOG_ODR                                         ' 16 Relays
