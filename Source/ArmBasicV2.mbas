sub procedure receive_ser4() iv IVT_INT_USART3  ics ICS_AUTO                   ' com4 Interrupt Service     -UART3
    mvar4 = USART3_DR
    stat4 = USART3_SR                                                          ' nach Überlauf muss Statusregister gelesen werden
    recstr4[ser4_zeiger] = mvar4                                               ' last in, first out = lifo
    if ser4_zeiger < fifo4 then
       inc(ser4_zeiger)
    end if
    if konsole_uart=4 then                                                     ' Konsole auf com4?
       mvar = mvar4
       ser_zeiger = ser4_zeiger
       if mvar=3 then  perror = maxerror  get_one_ser4_byte end if
