    GPIO_Alternate_Function_Enable(@_GPIO_MODULE_TIM5_CH1_PA0)
    GPIO_Alternate_Function_Enable(@_GPIO_MODULE_TIM5_CH2_PA1)
    GPIO_Alternate_Function_Enable(@_GPIO_MODULE_TIM5_CH3_PA2)
    GPIO_Alternate_Function_Enable(@_GPIO_MODULE_TIM5_CH4_PA3)
    TIM5_CCER=0x1111   TIM5_CCMR1_Output=0x6060    TIM5_CCMR2_Output=0x6060
