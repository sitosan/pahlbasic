#ifdef 411 then
sub procedure init_pwms(dim freq as word)
    InitTimer5(freq)   'prn(ratio)
    if testbit(RTC_BKP16R,0) then  
       GPIO_Digital_Output(@GPIOA_BASE, _GPIO_PINMASK_0) 
       setbit(relayMask,0)
    else
        GPIO_Alternate_Function_Enable(@_GPIO_MODULE_TIM5_CH1_PA0)
        clearbit(relayMask,0)
    end if
    if testbit(RTC_BKP16R,1) then  
       GPIO_Digital_Output(@GPIOA_BASE, _GPIO_PINMASK_1) 
       setbit(relayMask,1)
    else
        GPIO_Alternate_Function_Enable(@_GPIO_MODULE_TIM5_CH2_PA1)
        clearbit(relayMask,1)
    end if
    if RTC_BKP17R=0 then
       setbit(relayMask,2)   setbit(relayMask,3)
       if testbit(RTC_BKP16R,2) then
          GPIO_Digital_Output(@GPIOA_BASE, _GPIO_PINMASK_2) 
          setbit(relayMask,2)
       else
           GPIO_Alternate_Function_Enable(@_GPIO_MODULE_TIM5_CH3_PA2)
           clearbit(relayMask,2)
       end if
       if testbit(RTC_BKP16R,3) then  
          GPIO_Digital_Output(@GPIOA_BASE, _GPIO_PINMASK_3) 
          setbit(relayMask,3)
       else
           GPIO_Alternate_Function_Enable(@_GPIO_MODULE_TIM5_CH4_PA3)
           clearbit(relayMask,3)
       end if
       if testbit(RTC_BKP16R,4) then  GPIO_Digital_Input(@GPIOA_BASE,  _GPIO_PINMASK_2) end if
    else
        GPIO_Alternate_Function_Enable(@_GPIO_MODULE_UART2_PA23)
        clearbit(relayMask,2)   clearbit(relayMask,3)
    end if
    TIM5_CCER=0x1111   TIM5_CCMR1_Output=0x6060    TIM5_CCMR2_Output=0x6060
    if RTC_BKP11R=0 then  pwm1 = ratio/2 else  pwm1 = RTC_BKP11R  end if
    if RTC_BKP12R=0 then  pwm2 = ratio/2 else  pwm2 = RTC_BKP12R  end if
    if RTC_BKP13R=0 then  pwm3 = ratio/2 else  pwm3 = RTC_BKP13R  end if
    if RTC_BKP15R=0 then  pwm4 = ratio/2 else  pwm4 = RTC_BKP15R  end if
    TIM5_CCR1=pwm1   TIM5_CCR2=pwm2   TIM5_CCR3=pwm3   TIM5_CCR4=pwm4
end sub
#endif

#ifdef 405RG then
sub procedure init_gpios()
    asm
       MOVW  R0, #lo_addr(TFT_BLED)
       MOVT  R0, #hi_addr(TFT_BLED)
       MOV   R1, #1
       LSL   R1, R1, #bitPos(TFT_BLED)
    end asm
    GPIO_Config(R0, R1, _GPIO_CFG_DIGITAL_OUTPUT)                              ' TFT-LED                            405RG/407VG
    asm
       MOVW  R0, #lo_addr(T_IRRPT)
       MOVT  R0, #hi_addr(T_IRRPT)
       MOV   R1, #1
       LSL   R1, R1, #bitPos(T_IRRPT)
    end asm
    GPIO_Config(R0, R1, _GPIO_CFG_DIGITAL_INPUT)                               ' T_IRRPT                            405RG/407VG
    asm
       MOVW  R0, #lo_addr(sf_cs)
       MOVT  R0, #hi_addr(sf_cs)
       MOV   R1, #1
       LSL   R1, R1, #bitPos(sf_cs)
    end asm
    GPIO_Config(R0, R1, _GPIO_CFG_DIGITAL_OUTPUT)                              ' ser.Flash CS                       405RG/407VG
    
    #ifdef VG then
    GPIO_Digital_Output(@GPIOA_BASE, _GPIO_PINMASK_9)                          ' RTS1                               405RG/407VG
    GPIO_Digital_OUTput(@GPIOA_BASE, _GPIO_PINMASK_1)                          ' USER LED   Lebenslicht             407VG
    GPIO_Digital_Input(@GPIOD_BASE, _GPIO_PINMASK_15)                          ' Touch-Int                          407VG
    GPIO_Digital_OUTput(@GPIOB_BASE, _GPIO_PINMASK_0)                          ' SD-card_CS,                        405RG/407VG
    ' MP3 config
    GPIO_Digital_Output(@GPIOA_BASE, _GPIO_PINMASK_9)                          ' RST
    GPIO_Digital_Input (@GPIOC_BASE, _GPIO_PINMASK_9)                          ' DREQ
    GPIO_Digital_Output(@GPIOA_BASE, _GPIO_PINMASK_10)                         ' CS
    GPIO_Digital_Output(@GPIOA_BASE, _GPIO_PINMASK_8)                          ' BSYNC
    MP3_CS            = 1                                                      ' Deselect MP3_CS
    MP3_RST           = 1                                                      ' Set MP3_RST pin
    BSYNC             = 0                                                      ' Clear BSYNC
    BSYNC             = 1                                                      ' Clear BSYNC
    #endif
    #ifdef Pyboard then
    GPIO_Digital_Output(@GPIOA_BASE, _GPIO_PINMASK_13)                         ' RTS1                               405RG/Pyboard
    GPIO_Digital_OUTput(@GPIOA_BASE, _GPIO_PINMASK_14)                         ' USER LED   Lebenslicht             405RG/Pyboard
    GPIO_Digital_Input(@GPIOA_BASE, _GPIO_PINMASK_15)                          ' Touch-Int                          405RG/Pyboard
    GPIO_Digital_OUTput(@GPIOB_BASE, _GPIO_PINMASK_0)                          ' SD-card_CS,                        405RG/407VG
    #endif
    #ifdef WeAct then
    GPIO_Digital_Output(@GPIOA_BASE, _GPIO_PINMASK_9)                          ' RTS1                               405RG/407VG
    GPIO_Digital_OUTput(@GPIOB_BASE, _GPIO_PINMASK_2)                          ' USER LED   Lebenslicht             405RG
    GPIO_Digital_Input(@GPIOA_BASE, _GPIO_PINMASK_15)                          ' Touch-Int                          405RG
    GPIO_Digital_OUTput(@GPIOB_BASE, _GPIO_PINMASK_0)                          ' SD-card_CS,                        405RG/407VG
    #endif
    GPIO_Digital_Output(@GPIOB_BASE, _GPIO_PINMASK_12)                         ' Touch_CS                           405RG/407VG
    GPIO_Digital_Output(@GPIOC_BASE, _GPIO_PINMASK_13)                         ' WS2812 LED-Anschluss               405RG/407VG
    GPIO_Analog_Input(@GPIOC_BASE, _GPIO_PINMASK_4)                            ' Record-Pin                         405RG/407VG
    if testbit(RTC_BKP8R,12) then
       GPIO_Digital_Input(@GPIOC_BASE,  _GPIO_PINMASK_0)                       ' digital Input 1
       setbit(diginpMask,0)
    else
        GPIO_Analog_Input(@GPIOC_BASE, _GPIO_PINMASK_0)                        ' Analog Input 1                     405RG/407VG
        clearbit(diginpMask,0)
    end if
    if testbit(RTC_BKP8R,13) then
       GPIO_Digital_Input(@GPIOC_BASE,  _GPIO_PINMASK_1)                       ' digital Input 2                    405RG/407VG
       setbit(diginpMask,1)
    else
        GPIO_Analog_Input(@GPIOC_BASE, _GPIO_PINMASK_1)                        ' Analog Input 2                     405RG/407VG
        clearbit(diginpMask,1)
    end if
    if testbit(RTC_BKP8R,14) then
       GPIO_Digital_Input(@GPIOC_BASE,  _GPIO_PINMASK_2)                       ' digital Input 3                    405RG/407VG
       setbit(diginpMask,2)
    else
        GPIO_Analog_Input(@GPIOC_BASE, _GPIO_PINMASK_2)                        ' Analog Input 3                     405RG/407VG
        clearbit(diginpMask,2)
    end if
    if testbit(RTC_BKP8R,15) then
       GPIO_Digital_Input(@GPIOC_BASE,  _GPIO_PINMASK_3)                       ' digital Input 4                    405RG/407VG
       setbit(diginpMask,3)
    else
        GPIO_Analog_Input(@GPIOC_BASE, _GPIO_PINMASK_3)                        ' Analog Input 4                     405RG/407VG
        clearbit(diginpMask,3)
    end if
    USER_LED=1                                                                 ' Lebenslicht aus
    RTS1=1                                                                     ' RS485-RTS Senderichtung
    ' EXTI
    SYSCFGEN_bit    = 1
    SYSCFG_EXTICR1  = word(0x2222)                                             ' Sys-Config  3-C,  2-C,  1-C,  0-C
    SYSCFG_EXTICR2  = word(0x5555)                                             ' Sys-Config  7-F,  6-F,  5-F,  4-F
    #ifdef WeAct then
    SYSCFG_EXTICR3  = word(0x5555)                                             ' Sys-Config 11-F, 10-F,  9-F,  8-F
    SYSCFG_EXTICR4  = word(0x0555)                                             ' Sys-Config 15-A, 14-F, 13-F, 12-F
    #endif
    #ifdef PyBoard then
    SYSCFG_EXTICR3  = word(0x5555)                                             ' Sys-Config 11-F, 10-F,  9-F,  8-F
    SYSCFG_EXTICR4  = word(0x0555)                                             ' Sys-Config 15-A, 14-F, 13-F, 12-F
    #endif
    #ifdef VG then
    SYSCFG_EXTICR3  = word(0x5555)                                             ' Sys-Config 11-F, 10-F,  9-F,  8-F
    SYSCFG_EXTICR4  = word(0x3555)                                             ' Sys-Config 15-D, 14-F, 13-F, 12-F
    #endif
    inputdelay_on   = 0
    inputdelay_on.0 = RTC_BKP7R.16
    inputdelay_on.1 = RTC_BKP7R.17
    inputdelay_on.2 = RTC_BKP7R.18
    inputdelay_on.3 = RTC_BKP7R.19
    inputdelay_on.4 = RTC_BKP7R.20
end sub
#endif

#ifdef 407mini  then
sub procedure init_gpios()
    asm
       MOVW  R0, #lo_addr(TFT_BLED)
       MOVT  R0, #hi_addr(TFT_BLED)
       MOV   R1, #1
       LSL   R1, R1, #bitPos(TFT_BLED)
    end asm
    GPIO_Config(R0, R1, _GPIO_CFG_DIGITAL_OUTPUT)                              ' TFT-LED
    asm
       MOVW  R0, #lo_addr(T_IRRPT)
       MOVT  R0, #hi_addr(T_IRRPT)
       MOV   R1, #1
       LSL   R1, R1, #bitPos(T_IRRPT)
    end asm
    GPIO_Config(R0, R1, _GPIO_CFG_DIGITAL_INPUT)
    asm
       MOVW  R0, #lo_addr(sf_cs)
       MOVT  R0, #hi_addr(sf_cs)
       MOV   R1, #1
       LSL   R1, R1, #bitPos(sf_cs)
    end asm
    GPIO_Config(R0, R1, _GPIO_CFG_DIGITAL_OUTPUT)                              ' ser.Flash CS                407Mini
    GPIO_Digital_OUTput(@GPIOA_BASE, _GPIO_PINMASK_1)                          ' USER LED
    GPIO_Digital_OUTput(@GPIOC_BASE, _GPIO_PINMASK_5)                          ' RS485-RTS1
    GPIO_Digital_Output(@GPIOB_BASE, _GPIO_PINMASK_12)                         ' Touch_CS                    407Mini
    GPIO_Digital_Output(@GPIOA_BASE, _GPIO_PINMASK_10)                         ' WS2812 LED-Anschluss
    GPIO_Digital_Output(@GPIOD_BASE, _GPIO_PINMASK_ALL)                        ' Relays
    GPIO_Digital_Input(@GPIOE_BASE, _GPIO_PINMASK_0 or _GPIO_PINMASK_1 or _GPIO_PINMASK_2 or _GPIO_PINMASK_3 or _GPIO_PINMASK_4 or _GPIO_PINMASK_5 or _GPIO_PINMASK_6 or _GPIO_PINMASK_7 or _GPIO_PINMASK_8 or _GPIO_PINMASK_9 or _GPIO_PINMASK_10 or _GPIO_PINMASK_11 or _GPIO_PINMASK_15)    'dig Inputs 0...11 + 15 (Touch-Int)
    GPIO_Analog_Input(@GPIOC_BASE, _GPIO_PINMASK_0 or _GPIO_PINMASK_1 or _GPIO_PINMASK_2 or _GPIO_PINMASK_3)  'Analog Inputs  Basic
    if fzg then                                                                ' wird der F407ZG mit der 407mini-Software eingesetzt,
       GPIO_Digital_Output(@GPIOF_BASE, _GPIO_PINMASK_ALL)                     ' können Port F und G als Ausgänge betrieben werden
       GPIO_Digital_Output(@GPIOG_BASE, _GPIO_PINMASK_ALL)
       GPIOF_ODR=0    GPIOG_ODR=0
    end if
    USER_LED=1    RTS1=1                                                       ' Lebenslicht aus, RS485 auf Senderichtung
    relay           = (RTC_BKP6R   and 0xFFFF)                                 ' Relais-Konfiguration Zustand setzen
    opendrain = (RTC_BKP6R >> 16)  and 0xFFFF                                  ' Relais-Konfiguration OpenDrain setzen
    set_diginp_resistors(RTC_BKP7R and 0x0FFF,0)                               ' dig. Eingangs-Konfiguration (Port E) setzen
    input_resistors =  RTC_BKP7R   and 0x0FFF
    ' MP3 config
    GPIO_Digital_Output(@GPIOA_BASE, _GPIO_PINMASK_9)                          ' RST
    GPIO_Digital_Input (@GPIOC_BASE, _GPIO_PINMASK_9)                          ' DREQ
    GPIO_Digital_Output(@GPIOA_BASE, _GPIO_PINMASK_10)                         ' CS
    GPIO_Digital_Output(@GPIOA_BASE, _GPIO_PINMASK_8)                          ' BSYNC
    MP3_CS            = 1                                                      ' Deselect MP3_CS
    MP3_RST           = 1                                                      ' Set MP3_RST pin
    BSYNC             = 0                                                      ' Clear BSYNC
    BSYNC             = 1                                                      ' Clear BSYNC
    ' EXTI
    SYSCFGEN_bit    = 1
    SYSCFG_EXTICR1  = word(0x4444)                                             ' Sys-Config  3-E,  2-E,  1-E,  0-E
    SYSCFG_EXTICR2  = word(0x5554)                                             ' Sys-Config  7-F,  6-F,  5-F,  4-E
    SYSCFG_EXTICR3  = word(0x5525)                                             ' Sys-Config 11-F, 10-F,  9-C,  8-F
    SYSCFG_EXTICR4  = word(0x4522)                                             ' Sys-Config 15-E, 14-F, 13-C, 12-F       407Mini
    inputdelay_on   = 0
    inputdelay_on.0 = RTC_BKP7R.16
    inputdelay_on.1 = RTC_BKP7R.17
    inputdelay_on.2 = RTC_BKP7R.18
    inputdelay_on.3 = RTC_BKP7R.19
    inputdelay_on.4 = RTC_BKP7R.20
end sub
#endif

#ifdef 407ZG then
