'delay routines                                                                 --------------------------------------------------------------------------
sub procedure delay1us
    delay_us(1)
end sub

sub procedure delay30us
    delay_us(30)
end sub

sub procedure delay60us
    delay_us(60)
end sub

sub procedure delay300us
    delay_us(300)
end sub

sub procedure delay01                                                          ' 1 ms Verzögerung
    delay_ms(1)
end sub

sub procedure delay4                                                           ' 4 ms Verzögerung
    delay_ms(4)
end sub

sub procedure delay10                                                          ' 10 ms Verzögerung
    delay_ms(10)
end sub

sub procedure delay15                                                          ' 15 ms Verzögerung
    delay10
    delay4
    delay01
end sub

sub procedure delay20                                                          ' 20 ms Verzögerung
    delay10
    delay10
end sub

sub procedure delay60                                                          ' 60 ms Verzögerung
    delay20
    delay20
    delay20
end sub

sub procedure delay100                                                         ' 100 ms Verzögerung
    delay60
    delay20
    delay20
end sub

sub procedure delay300                                                         ' 300 ms Verzögerung
    delay100
    delay100
    delay100
end sub

sub procedure delay500                                                         ' 500 ms Verzögerung
    delay300
    delay100
    delay100
end sub

sub function search_variable  as word
    if varname_zeiger=0  then  result=99  exit  end if
    for result=0 to varname_zeiger -1
        if searchstring[0] = varname[result][0] then
           if strcmp(searchstring, varname[result])=0 then  exit  end if
        end if
    next result
    result=99
end sub

sub procedure new_variable(dim init_value as extended)
    if varname_zeiger>31 then  perror=14  sys("Variables Memory Full",0)  exit  end if
    if varname_zeiger<31 then
       varname[varname_zeiger] = searchstring
       var_ram_write_float(init_value, varname_zeiger)
       inc(varname_zeiger)
    end if
end sub

sub function get_varname(dim pos as word) as word
    result=0
    while ((progline[pos]<>11) and (progline[pos] <> "{")) and (result<20)
          searchstring[result] = progline[pos]
          inc(pos)  inc(result)
    wend
    if result>16 then  perror=2  result=0  sys("Variable Name max. 16 Chars",0)  exit  end if
    searchstring[result]=0   result=pos
end sub

sub procedure clear_i2c_buffer
dim n as longword volatile

    for n=0 to 15  i2c_read_data[n]=0  i2c_write_data[n]=0  next n
end sub

sub procedure i2c_read_reg(dim chip_adr as byte, dim reg_adr as byte, dim number_of_bytes_to_read as word)  'liest mehrere Bytes aus einem Register
    i2c_num_bytes=1
    i2c_write_data[0] = reg_adr
    I2C1_Start()
    I2C1_Write(chip_adr, @i2c_write_data, i2c_num_bytes, END_MODE_RESTART)
    I2C1_Read(chip_adr, @i2c_read_data, number_of_bytes_to_read, END_MODE_STOP)
end sub

sub procedure i2c2_read_reg(dim chip_adr as byte, dim reg_adr as byte, dim number_of_bytes_to_read as word)  'liest mehrere Bytes aus einem Register
    i2c_num_bytes=1
    i2c_write_data[0] = reg_adr
    I2C2_Start()
    I2C2_Write(chip_adr, @i2c_write_data, i2c_num_bytes, END_MODE_RESTART)
    I2C2_Read(chip_adr, @i2c_read_data, number_of_bytes_to_read, END_MODE_STOP)
end sub

sub procedure i2c_cmd(dim chip_adr as byte, dim reg_nr as byte, dim cmd as byte)   ' schreibt 1 Byte (Kommando) in Register reg_nr
    i2c_num_bytes=2
    i2c_write_data[0] = reg_nr
    i2c_write_data[1] = cmd
    I2C1_Start()
    I2C1_Write(chip_adr, @i2c_write_data, i2c_num_bytes, END_MODE_stop)
end sub

sub procedure i2c_write_reg(dim chip_adr as byte, dim reg_nr as byte, dim number_of_bytes_to_write as word)  ' schreibt mehrere Byte in Register reg_nr
    i2c_write_data[0] = reg_nr
    I2C1_Start()
    I2C1_Write(chip_adr, @i2c_write_data, number_of_bytes_to_write, END_MODE_stop)
end sub

sub procedure i2c2_write_reg(dim chip_adr as byte, dim reg_nr as byte, dim number_of_bytes_to_write as word)  ' schreibt mehrere Byte in Register reg_nr
    i2c_write_data[0] = reg_nr
    I2C2_Start()
    I2C2_Write(chip_adr, @i2c_write_data, number_of_bytes_to_write, END_MODE_stop)
end sub

'BME280                                                                         --------------------------------------------------------------------------
sub procedure BME280_read_Cal
    i2c_read_reg(BME_adress, BME_REGISTER_T1, 6)
    BME_T1 =  word(i2c_read_data[1]      << 8) or i2c_read_data[0]
    BME_T2 =  integer((i2c_read_data[3]  << 8) or i2c_read_data[2])
    BME_T3 =  integer((i2c_read_data[5]  << 8) or i2c_read_data[4])
    i2c_read_reg(BME_adress, BME_REGISTER_P1, 18)
    BME_P1 =  word(i2c_read_data[1]      << 8) or i2c_read_data[0]
    BME_P2 =  integer((i2c_read_data[3]  << 8) or i2c_read_data[2])
    BME_P3 =  integer((i2c_read_data[5]  << 8) or i2c_read_data[4])
    BME_P4 =  integer((i2c_read_data[7]  << 8) or i2c_read_data[6])
    BME_P5 =  integer((i2c_read_data[9]  << 8) or i2c_read_data[8])
    BME_P6 =  integer((i2c_read_data[11] << 8) or i2c_read_data[10])
    BME_P7 =  integer((i2c_read_data[13] << 8) or i2c_read_data[12])
    BME_P8 =  integer((i2c_read_data[15] << 8) or i2c_read_data[14])
    BME_P9 =  integer((i2c_read_data[17] << 8) or i2c_read_data[16])
    i2c_read_reg(BME_adress, BME_REGISTER_H1, 1)
    BME_H1 =  i2c_read_data[0]
    i2c_read_reg(BME_adress, BME_REGISTER_H2, 7)
    BME_H2 =  integer((i2c_read_data[1]  << 8) or i2c_read_data[0])
    BME_H3 =  i2c_read_data[2]
    BME_H6 =  short(i2c_read_data[6])
    BME_H4 =  integer((i2c_read_data[3] <<4) OR (i2c_read_data[4] and 0x0F))
    BME_H5 =  integer((i2c_read_data[5] <<4) OR (i2c_read_data[4] >>4))
end sub

sub function bme280_read_temp() as float                                       ' Idee: Peter Mather
dim var1,var2,adc_T as int64  volatile

    i2c_read_reg(BME_adress, BME_REGISTER_PRESSUREDATA, 8)
    adc_T = ((i2c_read_data[3] <<16) OR (i2c_read_data[4] <<8) or i2c_read_data[5]) >>4
    var1 = ((((adc_T >>3) - (BME_T1 <<1))) * BME_T2) div 2048
    var2 = (((((adc_T >>4) - (T1)) * ((adc_T div 16) - (BME_T1))) div 4096) * (BME_T3)) div 16384
    t_fine = var1 + var2
    result = ((t_fine * 5 + 128) / 256) / 100.0
end sub

sub function bme280_read_pressure() as float                                   ' Idee: Peter Mather
dim var1, var2, adc_P, p as int64  volatile

    adc_P = ((i2c_read_data[0] <<16) OR (i2c_read_data[1] <<8) or i2c_read_data[2]) >>4
    var1 = t_fine - 128000
    var2 = var1 * var1 * BME_P6
    var2 = var2 + ((var1 * BME_P5) <<17)
    var2 = var2 + (BME_P4 << 35)
    var1 = ((var1 * var1 * BME_P3) div 256) + ((var1 * BME_P2) <<12)
    var1 = ((1<<47)+var1)* BME_P1 div 8589934592
    if var1 = 0 THEN  result = 0  exit  end if
    p = 1048576 - adc_P
    p = (((p<<31) - var2) *3125) div var1
    var1 = (BME_P9 * (p div 8192) * (p div 8192)) div 33554432
    var2 = (BME_P8 * p) div 524288
    p = ((p + var1 + var2) div 256) + (BME_P7 <<4)
    result = p/25600.0
end sub

sub function bme280_read_humidity() as float                                   ' Idee: Peter Mather
dim v_x1,adc_H  as int64  volatile

    adc_H = (i2c_read_data[6] <<8) or i2c_read_data[7]
    v_x1 = t_fine - 76800
    v_x1=(((((adc_H <<14) - (BME_H4 <<20)-(BME_H5*v_x1)) +16384) div 32768)*(((((((v_x1*BME_H6)div 1024)*(((v_x1*BME_H3) div 2048) +32768))div 1024) +2097152)*BME_H2 +8192) div 16384))
    v_x1 = (v_x1 - (((((v_x1 div 32768) * (v_x1 div 32768)) div 128) * BME_H1) div 16))
    if v_x1 < 0 then v_x1 = 0  end if
    if v_x1 > 419430400 then v_x1 = 419430400  end if
    result = (v_x1 div 4096) / 1024.0
end sub

sub function BME280_read_ID() as word
    i2c_read_reg(BME_adress, 0xD0, 1)
    result = i2c_read_data[0]
end sub

sub procedure BME280_init
    BME_Adress = 0x76
    i2c_cmd(BME_Adress, BME_REGISTER_RST, 0xB6)
    delay20
    BME_ID = BME280_read_ID()
    if (BME_ID > 0x57) and (BME_ID < 0x61) then                                ' BME280/BMP280
       BME280_read_Cal
       if BME_ID = 0x60 then
          i2c_cmd(BME_Adress,0xF2,0x05)                                        ' CTRL_HUM nur bei BME280
       end if
       i2c_cmd(BME_Adress, BME_REGISTER_CONTROL, 0xB7)                         ' CTRL_MEAS
    else
        sys("Unknown Device On 0x76 Adress",0)
    end if
end sub

'I2C                                                                            --------------------------------------------------------------------------
sub procedure i2c_prn(dim anzahl as word)
dim n as word volatile

    for n=0 to anzahl -1   prn(i2c_read_data[n])   next n
end sub

sub procedure i2c_save_device(dim i2c_adres as byte)
    DBP_ON
    select case i2c_adres
      case 64   setbit(RTC_BKP9R,00)  sys("  HTU31",3)                         ' 0x40
      case 118  setbit(RTC_BKP9R,01)  sys("  BME280/BMP280  *)",3)             ' 0x76
      'case 90   RTC_BKP9R.3 =1   DBP_Bit=0  sys("  CCS881)",3)                 ' 0x5A
                'i2c_speed=20000
      case 98   setbit(RTC_BKP9R,02)  sys("  SCD40/41",3)                      ' 0x62
      case 68   setbit(RTC_BKP9R,03)  sys("  SHT3x",3)                         ' 0x44
      case 65   setbit(RTC_BKP9R,04)  sys("  INA219",3)                        ' 0x41
      case 80   setbit(RTC_BKP9R,31)  sys("  24CXX",3)                         ' 0x50
    end select
    DBP_OFF
end sub

sub function I2C_scan_bus as longword                                          ' I2C1-Bus (Sensor-Bus) scannen
dim n, soft_i2c_error as word volatile

    result=0   i2c_speed=100000
    if (RTC_BKP5R and 64) = 0 then  exit end if                                ' Scannen freigegeben?
    #ifdef Pyboard then
    set_pull_up_down(Port_B,6,0,1)    set_pull_up_down(Port_B,7,0,1)           ' Test-Pulldowns
    if (GPIOB_IDR.6=0) or (GPIOB_IDR.7=0) then  set_pull_up_down(Port_B,6,0,0)  set_pull_up_down(Port_B,7,0,0)  exit end if  ' keine Pullups? (sollten die Pins eigentlich auf High ziehen)
    set_pull_up_down(Port_B,6,0,0)  set_pull_up_down(Port_B,7,0,0)             ' Test-Pulldowns wieder aus
    #else
    set_pull_up_down(Port_B,8,0,1)    set_pull_up_down(Port_B,9,0,1)           ' Test-Pulldowns
    if (GPIOB_IDR.8=0) or (GPIOB_IDR.9=0) then  set_pull_up_down(Port_B,8,0,0)  set_pull_up_down(Port_B,9,0,0)  exit end if  ' keine Pullups? (sollten die Pins eigentlich auf High ziehen)
    set_pull_up_down(Port_B,8,0,0)  set_pull_up_down(Port_B,9,0,0)             ' Test-Pulldowns wieder aus
    #endif
    sys("Scanning Sensor-Bus: ",0)
    DBP_ON  RTC_BKP9R=0   DBP_OFF                                              ' alle Devices löschen
    Soft_I2C_Init()                                                            ' Bus-Scan via Soft-I2C
    for n=1 to 127                                                             ' alle 7-Bit Adressen
        soft_i2c_error=0
        int_off
        Soft_I2C_Start()
        soft_i2c_error = Soft_I2C_Write((n <<1) or 0)                          ' Schreibadresse testen   #### evtl. auf Leseadresse (or 1) ändern
        Soft_I2C_Stop()
        int_on
        if soft_i2c_error=0 then                                               ' kein Fehler? dann Device!
           if result < 32 then                                                 ' max. 32 Devices
              inc(result)                                                      ' zählen
              sys("  Hex Adress: ",0)  prh(n)                                  ' ausdrucken
              i2c_save_device(n)                                               ' speichern
           end if
        end if
    next n
end sub

sub function i2c_start_devices as word
dim n, k as word volatile

    result=0   n=0
    while n<31
          select case n
            case 1    if testbit(RTC_BKP9R,1) then                                ' 0x76  BME280/BMP280
                         int_off  BME280_init()  int_on
                         inc(result)
                      end if
            'case 2
            'case 3
            'case 4
          end select
          inc(n)
    wend
    int_on
end sub
'---------------------------------------------------------------------------------------------------------------------------------------------------------

sub procedure cut(dim m as word)                                               ' 1 Zeichen an Stelle m entfernen
    while pstr[m] > 0
          pstr[m] = pstr[m +1]
          inc(m)
    wend
end sub

sub procedure lcut                                                             ' alle Leerzeichen links entfernen
    while pstr0 = 32
          cut(0)
    wend
end sub

sub procedure lcut0                                                            ' alle Nullen links entfernen
    if (pstr0 = "0") and (pstr[1] = "x") then
       while (pstr[2] = 48)  and (length(pstr) > 4)
             cut(2)
       wend
    else
        while pstr0 = 48
              cut(0)
        wend
    end if
end sub

sub procedure rcut                                                             ' rechte Nullen entfernen pstr
dim n, stp as word volatile

    stp=1   n = length(pstr) -1
    if pstr[n]=48 then
       while (n>0) and stp and ((pstr[n]=48) or (pstr[n]=46))                  ' rechte Nullen entfernen
             if pstr[n]=46 then stp=0 end if
             pstr[n]=0  dec(n)
       wend
    end if
end sub

sub procedure nospaces                                                         ' sämtliche Leerzeichen ausser innerhalb von "" entfernen
dim n, strg_flag, var_flag as word volatile

    n=0   strg_flag=0   var_flag=0
    while pstr[n] > 0
          if pstr[n] = "§" and ((pstr[n +1] > 64) and (pstr[n +1] < 91)) then  ' Variablen-Name ?
             var_flag=1  inc(n)
             while isalnum(pstr[n]) or (pstr[n] = "_")
                   inc(n)
             wend
             if (pstr[n]=32) and (var_flag=1) then  pstr[n]=11  var_flag=0  end if  ' Spaces durch Zeichen 11 ersetzen
          end if
          if n>2 then
             if (pstr[n] = "m") and  (pstr[n -1] = "e") and  (pstr[n -2] = "r")  then  ' rem Anweisung ?
                if isalpha(pstr[n-3])=0 then                                   ' fals die Anweisung die Zeichen 'rem' enthält z.B. 'tremolo'
                   inc(n)
                   if length(pstr) > 3 then
                      while pstr[n]=32                                         ' hinter rem noch spaces ?
                            cut(n)
                      wend
                      exit
                   end if
                end if
             else
                 if (pstr[n -2] = 39) and (strg_flag=0) then                   ' Hochkomma?
                    inc(n)
                    if length(pstr) > 1 then
                       while pstr[n]=32                                        ' hinter rem noch spaces?
                             cut(n)
                       wend
                       exit
                    end if
                 end if
             end if
          end if
          if (pstr[n]=32) and  (strg_flag=0)  then cut(n)  end if
          if (pstr[n]=34) then  strg_flag= not strg_flag   end if
          if (pstr[n]<>32) or   strg_flag  then  inc(n)    end if
    wend
end sub

sub function isnum2(dim pos as word)as word                                    ' numerisch?
    result=0
    if isdigit(progline[pos]) then  result=0xFFFF  exit  end if
    if progline[pos] = "%"    then  result=0xFFFF  exit  end if
    if progline[pos] = 16     then  result=0xFFFF        end if
end sub

sub function isnum(dim pos as word)as word                                     ' numerisch?
    select case progline[pos]
      case "0","1"                                                             ' binaer
           result=8
      case "2","3","4","5","6","7","8","9"                                     ' dezimal
           result=4
      case "."                                                                 ' Dezimalpunkt
           result=1
      case "("                                                                 ' Klammer
           result=32
      case "%",16                                                              ' Kennzeichen
           result=64
      case "A","B","C","D","E","F"                                             ' hexadezimal
           result=2
      case else
           result=0                                                            ' nicht numerisch
    end select
end sub

sub function get_num_str(dim pos as word, dim modus as word) as word           ' Zahl als Zeichenkette aus Programmzeile holen
dim m, ziff as byte volatile                                                   ' ziff = Anzahl Ziffern
    result = pos
    m=0
    select case modus
      case 13                                                                  ' dezimal
           ziff=21
      case 14                                                                  ' hexadezimal
           ziff=16
      case 8                                                                   ' binaer
           ziff=32
    end select
    while isnum(result) and (m < ziff)                                         ' numerisch?
          if (isnum(result) and modus)=0 then perror=13  sys("Zahlenfehler: bin/hex/dez",0)  clear_pstr  exit  end if  ' aber Zeichen nicht erlaubt?
          pstr[m] = progline[result]                                           ' sonst kopieren
          inc(result)  inc(m)
    wend
    pstr[m] = 0                                                                ' Zeichenkettenende
end sub

'TFT Routines                                                                   --------------------------------------------------------------------------
sub procedure TFT_reset_cursor                                                 ' Cursor off
    TFT_Set_Pen(TFT_backcol,1)
    if  TFT_cursor_form then
        TFT_V_Line(TFT_zeile*16, TFT_zeile*16+15, TFT_spalte*9)
    else
        TFT_H_Line(TFT_spalte*9+1, TFT_spalte*9+8, TFT_zeile*16+15)
    end if
end sub

sub procedure TFT_set_cursor                                                   ' Cursor on
    TFT_Set_Pen(TFT_color, 1)
    if  TFT_cursor_form then                                                   ' vertical line
        TFT_V_Line(TFT_zeile*16, TFT_zeile*16 + 15, TFT_spalte*9)
    else
        TFT_H_Line(TFT_spalte*9+1, TFT_spalte*9+8, TFT_zeile*16+15)            ' Underline
    end if
end sub

sub procedure TFT_set_cursor2
    if TFT_cursor then  TFT_set_cursor end if
end sub

sub procedure TFT_reset_cursor2
    if TFT_cursor then  TFT_reset_cursor end if
end sub

sub procedure TFT_cursor_left                                                  ' Cursor nach links
    if TFT_spalte>0 then
       TFT_reset_cursor2
       dec(TFT_spalte)
       TFT_set_cursor2
    else
        if tft_umbruch_zeile then                                              '???????????????????
           if TFT_Zeile>0 then
              TFT_reset_cursor2
              TFT_Umbruch_Zeile = TFT_Zeile
              dec(TFT_Zeile)
              TFT_Spalte = TFT_max_s -1
              TFT_set_cursor2
           end if
        end if
    end if
end sub

sub procedure TFT_cursor_right
    TFT_reset_cursor2
    if TFT_spalte < TFT_max_s then
       inc(TFT_spalte)
    end if
    TFT_set_cursor2
end sub

sub procedure TFT_chr144                                                       ' Ersatz für Zeichen 144
    TFT_Set_Pen(TFT_backcol,1)
    TFT_Set_Brush(1,TFT_backcol,0,0,0,0)
    TFT_Rectangle(TFT_spalte *9, TFT_zeile *16 , TFT_spalte *9 +9, TFT_zeile *16 +16)
    TFT_Set_Pen(TFT_print_Color,1)
    TFT_H_Line(TFT_spalte *9 +1, TFT_spalte *9 +8, TFT_zeile *16 +14)
end sub

sub procedure TFT_chr160                                                       ' Ersatz für Zeichen 160
    TFT_Set_Pen(TFT_backcol,1)
    TFT_Set_Brush(1,TFT_backcol,0,0,0,0)
    TFT_Rectangle(TFT_spalte *9, TFT_zeile *16 , TFT_spalte *9 +9, TFT_zeile *16 +16)
    TFT_Set_Pen(TFT_print_Color,1)
end sub

sub procedure TFT_backstep                                                     ' Zeichen links löschen
    if TFT_spalte > 0 then
       dec(TFT_spalte)
       TFT_chr160
       TFT_set_cursor2
    end if
end sub

sub procedure TFT_delete_line(dim TFTzeile, TFTStartSpalte, TFTEndspalte as word) ' Zeile teilweise/komplett löschen
    TFT_Set_Pen(TFT_backcol, 1)
    TFT_Set_Brush(1, TFT_backcol,0,0,0,0)
    if TFTEndSpalte=0 then  TFTEndSpalte = TFT_With -1  end if
    TFT_Rectangle(TFTStartSpalte *9, TFTzeile *16 , TFTEndspalte, TFTzeile *16 +16)
end sub

sub procedure clear_escapes                                                    ' Escapesequenz löschen
dim n as word volatile

    for n=0 to 4    escape_value[n]=0   next n
    escape_counter=0
end sub

sub procedure TFT_scroll
    #ifdef 407ZG then
    TFT_zeile=(tft_scroll_cnt -1)
    TFT_delete_line(TFT_zeile,0,0)
    TFT_Scroll_1Line
    #endif
    #ifdef VG then
    TFT_zeile=(tft_scroll_cnt -1)
    TFT_delete_line(TFT_zeile,0,0)
    TFT_Scroll_1Line
    #endif
end sub

sub procedure TFT_Clear_Sreen_with_delay
    if TFT_NL_Max=0 then                                                       ' Bildschirm voll?
       if uart_nr=NULL then                                                    ' TFT_wait_key = 'ctrl c' / Umleitung ins Gerät 25 (null)
          TFT_delete_line(TFT_zeile, 0, 0)                                     ' ganze Zeile löschen
          TFT_Delete_Flag=0
       else
           delay500  delay500                                                  ' Ergebnis noch 1 Sekunde stehen lassen
           TFT_CLS(1)                                                          ' dann löschen
       end if
    end if
end sub

#ifdef 407ZG then
sub procedure TFT_Newline
    inc(TFT_NL_Cnt)                                                            ' Newline-Zähler (Zeilenzähler) erhöhen
    if TFT_SCM=0 then
       if TFT_zeile<TFT_max_z then                                             ' unterste Screen-Zeile noch nicht erreicht?
          inc(TFT_zeile)
          TFT_delete_line(TFT_zeile,0,0)                                       ' ganze Zeile löschen
       else                                                                    ' unterste Zeile!
           if TFT_scroll_mode>0 then                                           ' Display kann Scrollen?
              if TFT_SCM=0 then
                 TFT_SCM=1                                                     ' Zeilenumbruch!
                 Parallel_Scroll_Area                                          ' Scrollen aktivieren
              end if
              TFT_scroll                                                       ' Scrollen
           else
               TFT_Clear_Sreen_with_delay
           end if
       end if
    else
        TFT_scroll                                                             ' Scrollen
    end if
end sub
#endif

