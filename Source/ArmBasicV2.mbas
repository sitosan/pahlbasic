' Ende Forward-Deklarationen für Compiler ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^


' Routines   =================================================================================================================================================

sub function get_portpointer(dim port as word) as longword                     ' Zeiger auf GPIO  port: 0...7  (A...H)
    result=0x40020000 + (port* 0x400)
end sub

sub procedure set_RAM_adress                                                   ' Programmzeiger auf RAM
    prog_mem = @progstr
    progend  = @progstr + programming_end
    run_mode = in_RAM
end sub

sub function set_ROM_adress as longword                                        ' Programmzeiger auf ROM
dim pptr as ^longword volatile

    if Prog_ROM_Start=0 then  perror=19  sys("No ROM for BASIC",0) exit end if
    
    pptr     = Prog_ROM_Start +100
    result   = pptr^
    pptr     = Prog_ROM_Start +104
    if pptr^ = true then  perror=16  sys(noprog,0) exit  end if
    prog_mem = Prog_ROM_Start +108
    progend  = prog_mem + pptr^
    run_mode = in_ROM
end sub

sub procedure switch_memory                                                    ' Programmspeicher umschalten RAM <-> ROM
dim auto as longword  volatile

    select case run_mode
      case in_ROM
           set_RAM_adress
      case in_RAM
           auto = set_ROM_adress
           if perror or (auto>198) then                                        ' Fehler oder nur Konfiguration?
              cwtnl(noprog)
              set_RAM_adress                                                   ' kein Programm im ROM dann weiter im RAM
              exit
           end if
    end select
end sub

sub procedure switch_memory_back(dim mem as word)                              ' Programmspeicher zurückschalten
dim auto as longword  volatile

    select case mem
      case in_RAM
           set_RAM_adress
      case in_ROM
           auto = set_ROM_adress
           if perror or (auto>198) then                                        ' Fehler oder nur Konfiguration?
              cwtnl(noprog)
              set_RAM_adress                                                   ' kein Programm im ROM dann weiter im RAM
              exit
           end if
    end select
end sub

sub function bpointer(dim ppointer as ^byte) as byte
    result = ppointer^
end sub

sub function wpointer(dim ppointer as ^word) as word
    result = ppointer^
end sub

sub function lpointer(dim ppointer as ^longword) as longword
    result = ppointer^
end sub

sub function vpointer(dim ppointer as ^byte) as ^byte
    result = ppointer
end sub

sub function modular(dim wert, moder as longint) as longint
    result=wert - (wert mod moder)
end sub

sub procedure DBP_ON
    DBP_Bit=1
end sub

sub procedure DBP_OFF
    DBP_Bit=0
end sub

#ifndef 411 then
sub function MX_check_table as word                                            ' check ob MX-Dekoder im ROM ist
dim n as word volatile

    result=0
    for n=0 to 767
        if scancodeMX[n] < 255 then  inc(result) end if
    next n
end sub
#endif

sub procedure set_tgl_bit(dim pos, modus as word)                              ' Bit setzen oder toggeln
dim element, index as word      volatile
dim contens        as longword  volatile
dim adrs           as ^longword volatile

    if isnum2(pos) then
       num_const(pos)
       adrs=longword(resultat)
       contens=adrs^
       pos = position(pos +1, ",", 0)                                          ' BIT?
       if pos=0 then  perror=2  exit end if
       modus=modus+4
    else
        if progline[pos]=22 then                                               ' -> ?
           if progline[pos +1] ="{" then                                       ' mit Klammer
              adrs=longword(calculate_exp(pos +2))
              if progline[calc_pos1 +2]<> "," then  perror=2  exit end if
              pos = calc_pos1 +3
           else                                                                ' ohne Klammer
               adrs=longword(calculate_exp(pos +1))
               if progline[calc_pos1 +1]<> "," then  perror=2  exit end if
               pos = calc_pos1 +2
           end if
           contens=adrs^
           modus=modus +4
        else                                                                   ' keine Adresse
            element = whatvar_ID(pos,1)
            var_select(element)   contens = longword(resultat)                 ' Variableninhalt holen
            pos = position(pos +1, ".", "=")                                   ' BIT?
            if pos=0 then  perror=2 exit end if
        end if
    end if
    if progline[pos] = "{" then  inc(pos) end if                               ' Bit-Index in Klammern
    index = word(calculate_exp(pos))
    if index>31 then  perror=13 exit end if                                    ' Bitposition zu gross
    select case modus
      case 0    clearbit(contens,index)  let_result(element,contens)
      case 1    setbit(contens,index)    let_result(element,contens)
      case 2    contens.index = not contens.index   let_result(element,contens)
      case 4    clearbit(contens,index)  adrs^ = contens
      case 5    setbit(contens,index)    adrs^ = contens
      case 6    contens.index = not contens.index   adrs^ = contens
    end select
end sub

sub procedure copy_romstr_to_ramstr(dim rompointer as ^char, dim rampointer as ^char)
    while rompointer^ >0
          rampointer^ = rompointer^
          inc(rampointer)  inc(rompointer)
    wend
end sub

'#ifdef 411 then
sub function set_gpio(dim port_no, pin_no, pin_mode as word) as word           ' pin_mode: 0=Input, 1=Output, 2=alternate, 3=Analog
dim portpointerM, portpointerS, portpointerO  as ^longword volatile            ' Zeiger auf Mode-, oSpeed- und Otype-Register

    result=0
    if pin_no   > 15 then exit end if
    if pin_mode > 03 then exit end if
    portpointerM = get_portpointer(port_no)                                    ' Adresse von GPIOx_MODER
    if (longword(portpointerM) < 0x40020000) or (longword(portpointerM) > 0x40022BFF) then exit end if
    portpointerS = portpointerM + OSPEEDR                                      ' Adresse von GPIOx_OSPEEDR
    portpointerO = portpointerM + OTYPER                                       ' Adresse von GPIOx_OTYPER
    portpointerM^ = portpointerM^ and (not longword(0x03 << (pin_no*2)))       ' PinMode löschen
    portpointerM^ = portpointerM^ or longword((pin_mode and 3) << (pin_no*2))  ' PinMode setzen
    if pin_mode=1 then                                                         ' Output-Mode?
       setbit(portpointerO^ , pin_no)                                          ' Gegentakt-Ausgang
       portpointerS^ = portpointerS^ and (not longword(0x03 << (pin_no*2)))    ' PinSpeed löschen
       portpointerS^ = portpointerS^  or      longword(0x03 << (pin_no*2))     ' PinSpeed max.
    end if
    result=0xFFFF
end sub

sub function set_af(dim port_no, pin_no, alf as word)  as word                 ' alternative Funktion 0...15 für Pins 0...15 auf Port_A ... Port_K
dim portpointerM, portpointerAL, portpointerAH as ^longword volatile           ' Zeiger auf Moder-, AFRL-, AFRH-Register
dim pin_noH as word volatile

    result=0
    if pin_no > 15 then exit end if
    if alf    > 15 then exit end if
    portpointerM  = get_portpointer(port_no)                                   ' Adresse von GPIOx_Moder - Aufruf von set_gpio() nicht nötig
    if (longword(portpointerM) < 0x40020000) or (longword(portpointerM) > 0x40022BFF) then exit end if
    portpointerM^ = portpointerM^ and (not longword(0x03 << (pin_no*2)))       ' Modus: löschen
    portpointerM^ = portpointerM^  or      longword(0x02 << (pin_no*2))        ' Modus: alternative Funktion
    portpointerAL = portpointerM + AFRL                                        ' Adresse von GPIOx_AFRL
    portpointerAH = portpointerM + AFRH                                        ' Adresse von GPIOx_AFRH
    if pin_no<8 then
       portpointerAL^ = portpointerAL^ and (not longword(0x0F << (4*pin_no)))  ' alternative Funktion löschen
       portpointerAL^ = portpointerAL^  or      longword(alf  << (4*pin_no))   ' alternative Funktion setzen
    else
        pin_noH=pin_no-8
        portpointerAH^ = portpointerAH^ and (not longword(0x0F << (4*pin_noH))) ' alternative Funktion löschen
        portpointerAH^ = portpointerAH^  or      longword(alf  << (4*pin_noH))  ' alternative Funktion setzen
    end if
    result=0xFFFF
end sub
'#endif

sub procedure TFT_Set_Address_ILI9481_2(dim x as word y as word)
  TFT_Set_Index_Ptr(0x2A)
  TFT_Write_Command_Ptr(x >> 8)
  TFT_Write_Command_Ptr(x)
  TFT_Write_Command_Ptr(TFT_X_Hi)  '(0x01)
  TFT_Write_Command_Ptr(TFT_X_Lo)  '(0xDF)
  TFT_Set_Index_Ptr(0x2B)
  TFT_Write_Command_Ptr(y >> 8)
  TFT_Write_Command_Ptr(y)
  TFT_Write_Command_Ptr(TFT_Y_Hi)  '(0x01)
  TFT_Write_Command_Ptr(TFT_Y_Lo)  '(0x3F)
  TFT_Set_Index_Ptr(0x2C)
end sub

sub procedure TFT_Set_Address_ILI9481_3(dim x as word y as word)
  TFT_Set_Index_Ptr(0x2A)
  TFT_Write_Command_Ptr(x >> 8)
  TFT_Write_Command_Ptr(x)
  TFT_Write_Command_Ptr(TFT_X_Hi)  '(0x01)
  TFT_Write_Command_Ptr(TFT_X_Lo)  '(0xDF)
  TFT_Set_Index_Ptr(0x2B)
  if TFT_X<x then TFT_X=x end if
  TFT_Write_Command_Ptr(y >> 8)
  TFT_Write_Command_Ptr(y)
  TFT_Write_Command_Ptr(TFT_Y_Hi)  '(0x01)
  TFT_Write_Command_Ptr(TFT_Y_Lo)  '(0x3F)
  TFT_Set_Index_Ptr(0x2C)
end sub

sub procedure TFT_Set_Address_ILI9341(dim x as word y as word)
    x=x+TFT_X_Offset  y=y+TFT_Y_Offset
    TFT_Set_Index_Ptr(0x2A)
    TFT_Write_Command_Ptr(x >> 8)
    TFT_Write_Command_Ptr(x)
    TFT_Write_Command_Ptr(0x01)
    TFT_Write_Command_Ptr(0x3F)
    TFT_Set_Index_Ptr(0x2B)
    TFT_Write_Command_Ptr(y >> 8)
    TFT_Write_Command_Ptr(y)
    TFT_Write_Command_Ptr(0x00)
    TFT_Write_Command_Ptr(0xEF)
    TFT_Set_Index_Ptr(0x2C)
end sub

#ifndef 411 then
sub procedure usb_write_text(dim byref ptext as string)                        ' sended Text über USB
dim tpointer as ^char volatile

    tpointer = @ptext
    while tpointer^
          USBDev_CDCSendData(tpointer, 1)
          inc(tpointer)
    wend
end sub

