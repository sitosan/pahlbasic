    USART3_CR1.B5=1
    NVIC_IntEnable(IVT_INT_USART3)
    ser4_zeiger=0
    sys("started com4",9)
end sub
#endif

sub function rtc_init_mode as word
dim RTC_Wait_ctr as word volatile

    result=0
    RTC_Wait_ctr=0
    DBP_ON
    RTC_WPR=0xCA                                                               ' Disable Write Protection
    RTC_WPR=0x53                                                               ' ("Code")
    delay_us(2)
    if (INITF_bit=0)  then                                                     ' init mode off ?
         setbit(RTC_ISR,7)                                                     ' INIT Enter Initialization mode
         while ((INITF_bit=0) and (RTC_Wait_ctr<30))                           ' wait for rtc init mode
             delay_us(10)                                                      ' max. 200us
             inc(RTC_Wait_ctr)
         wend                                                                  ' about 80 us
         if INITF_bit=0  then                                                  ' RTC init failed
             clearbit(RTC_ISR,B7)                                              ' Exit Initialization mode.
             RTC_WPR=0xFF                                                      ' Enable the write protection for RTC registers
             result=3   clearbit(RTC_ISR,7)   RTC_WPR=0xFF   con("R")  exit    ' Failed to update RTC registers
         end if
    end if
end sub

sub procedure rtc_init_mode_off
    clearbit(RTC_ISR,7)                                                        ' Free running mode
    RTC_WPR=0xFF                                                               ' disable the write protection for RTC registers
    delay_us(1)
    DBP_OFF
end sub

sub function init_LSE_RTC  as word
dim RTC_Wait_ctr as word volatile

    if LSERDY_bit=1  then result=0  exit  end if                               ' LSE läuft bereits
    DBP_ON                                                                     ' Access to RTC Backup registers enabled.   (PWR power control register (PWR_CR))
    PWREN_bit=1                                                                ' PWREN: Power interface clock enable.      (RCC APB1 peripheral clock enable register (RCC_APB1ENR))
    'Bit_Nr     65432109876543210                                              ' Bit-Nummern für RCC_BDCR
    RCC_BDCR = %01000000100000011                                              ' LSE einschalten
    delay_us(1)
    RTC_Wait_ctr=0                                                             ' time out Zähler
    while  ((LSERDY_bit=0)  and (RTC_Wait_ctr<4000))
           delay01
           inc(RTC_Wait_ctr)
    wend
    if LSERDY_bit=0  then  result=2  con("L") exit end if                      ' LSE Oscillator not ready
    delay_us(200)
    if rtc_init_mode then  result=3  con("R") exit end if                      ' RTC in Init-Mode versetzen
    RTC_PRER  = (127 << 16)  or 255                                            ' Configure the RTC prcounter
    RTC_PRER  = (127 << 16)  or 255
    FMT_bit=0                                                                  ' 24_HR_Format
    rtc_init_mode_off
    result=0
end sub

sub procedure set_clock_time
dim tenth, ones as word     volatile
dim reg         as longword volatile

    tenth  = hours / 10
    reg    = (tenth and 3) <<20
    ones   = hours - (tenth * 10)
    reg    = reg or ((ones and 15) <<16)
    tenth  = minutes / 10
    reg    = reg or ((tenth and 7) <<12)
    ones   = minutes - (tenth * 10)
    reg    = reg or ((ones and 15) <<8)
    tenth  = seconds / 10
    reg    = reg or ((tenth and 7) <<4)
    ones   = seconds - (tenth * 10)
    reg    = reg or (ones and 15)
    RTC_TR = reg
end sub

sub procedure set_clock_date
dim tenth, ones as word     volatile
dim reg         as longword volatile

    tenth  = years / 10
    reg    = (tenth and 15) <<20
    ones   = years - (tenth * 10)
    reg    = reg or ((ones and 15) <<16)
    dow    = calc_dow(days,months,years)
    ones   = dow
    reg    = reg or ((ones and 7) <<13)
    tenth  = months / 10
    reg    = reg or ((tenth and 1) <<12)
    ones   = months - (tenth * 10)
    reg    = reg or ((ones and 15) <<8)
    tenth  = days / 10
    reg    = reg or ((tenth and 3) <<4)
    ones   = days - (tenth * 10)
    reg    = reg or (ones and 15)
    RTC_DR = reg
end sub

sub function set_clock as word                                                 ' Stellen der RTC
    if init_LSE_RTC  then  result=4  con("I")  exit end if
    if rtc_init_mode then  result=5  con("M")  exit end if                     ' RTC in Init-Mode versetzen
    ADD1H_Bit=0
    SUB1H_Bit=0
    if time_set_flag=1 then                                                    ' Zeitregister setzen
       set_clock_time
       time_set_flag=0
    end if
    if date_set_flag=1 then                                                    ' Date-Register setzen
       set_clock_date
       date_set_flag=0
       delay10
    end if
    if testbit(RTC_ISR,4)=0 then uart("K") end if
    result=0
    set_sommer_winter_alarm
    rtc_init_mode_off                                                          ' free running mode
    twoAclock=0                                                                ' 2Uhr A
end sub

sub procedure clear_rtc_alarm_A                                                ' RTC Alarm A löschen
    DBP_ON           RTC_WPR=0xCA    RTC_WPR=0x53                              ' Zugriff auf RTC ermöglichen
    ALRAF_Bit=0      ALRAE_Bit=0     ALRAIE_Bit=0
    RTC_WPR=0xFF     DBP_OFF
end sub

sub procedure clear_rtc_alarm_B                                                ' RTC Alarm B löschen
    DBP_ON           RTC_WPR=0xCA    RTC_WPR=0x53                              ' Zugriff auf RTC ermöglichen
    ALRBF_Bit=0      ALRBE_Bit=0     ALRBIE_Bit=0
    RTC_WPR=0xFF     DBP_OFF
end sub

sub procedure clear_rtc_alarms
    DBP_ON       RTC_WPR=0xCA  RTC_WPR=0x53                                    ' Zugriff auf RTC ermöglichen
    ALRBF_Bit=0  ALRAF_Bit=0   ALRAE_Bit=0   ALRBE_Bit=0   ALRAIE_Bit=0   ALRBIE_Bit=0   'Alarme und Interrupts aus
    while (ALRAWF_Bit=0) or (ALRBWF_Bit=0) wend                                ' Auf Schreiben warten
    SYSCFGEN_bit=1   clearbit(EXTI_IMR,17)   clearbit(EXTI_RTSR,17)            ' RTC_Alarme sind an EXTI-Controller angeschlossen, Eingang 17
    clearbit(RTC_BKP5R,15)
end sub

sub procedure set_clock_alarm_AB(dim dayss, hourss, minss, sekss, nmbr as byte)
dim day_tens, day_units, hour_tens, hour_units, min_tens, min_units, sek_tens, sek_units as byte     volatile
    rtc_register                                                                         as longword volatile
    
    day_tens  = dayss  div 10   day_units  = dayss  - (day_tens  * 10)         ' prn(day_tens)  uart(32)  pr(day_units)
    hour_tens = hourss div 10   hour_units = hourss - (hour_tens * 10)         ' prn(hour_tens) uart(32)  pr(hour_units)
    min_tens  = minss  div 10   min_units  = minss  - (min_tens  * 10)         ' prn(min_tens)  uart(32)  pr(min_units)
    sek_tens  = sekss  div 10   sek_units  = sekss  - (sek_tens  * 10)         ' prn(sek_tens)  uart(32)  pr(sek_units)
    rtc_register=(day_tens and 3)<<28
    rtc_register=rtc_register or ((day_units and 15)<<24)
    rtc_register=rtc_register or ((hour_tens and 3)<<20)
    rtc_register=rtc_register or ((hour_units and 15)<<16)
    rtc_register=rtc_register or ((min_tens and 7)<<12)
    rtc_register=rtc_register or ((min_units and 15)<<8)
    rtc_register=rtc_register or ((sek_tens and 7)<<4)
    rtc_register=rtc_register or (sek_units and 15)
    if dayss=0 then                                                            ' täglich
       setbit(rtc_register,31)
    else                                                                       ' Tag X
        clearbit(rtc_register,31)
    end if
    if nmbr=1 then                                                             ' Alarm A
       if onadres[19] then  perror=19  sys("set Alarm A first",0) exit end if  ' Alarm B gesetzt? -> Fehler!
       RTC_Alarm_A = rtc_register                                              ' nur speichern
       exit
    end if
    if nmbr=2  then                                                            ' Alarm B
       RTC_Alarm_B = rtc_register                                              ' speichern
       if onadres[18]>0 then                                                   ' Alarm A gesetzt?
          clear_rtc_alarms                                                     ' Alarme löschen
          RTC_ALRMASSR=0   RTC_ALRMBSSR=0                                      ' Subsekunden ignorieren
          RTC_ALRMAR = RTC_Alarm_A     RTC_ALRMBR = rtc_register               ' Alarmzeiten A&B setzen
          if RTC_Alarm_A = rtc_register then                                   ' Alarm A&B identisch?
             ALRAE_Bit=0   ALRAIE_Bit=0   ALRBE_Bit=1   ALRBIE_Bit=1           ' dann nur Alarm B
          else                                                                 ' Alarm A&B unterschiedlich?
              ALRAE_Bit=1   ALRAIE_Bit=1   ALRBE_Bit=1   ALRBIE_Bit=1          ' dann RTC-Alarm A&B aktivieren, Interrupts an
          end if
       else                                                                    ' Alarm A nicht gesetzt?
           clear_rtc_alarms                                                    ' Alarme löschen
           RTC_ALRMBSSR=0                                                      ' Subsekunden B ignorieren
           RTC_ALRMBR = rtc_register                                           ' Alarmzeit B setzen
           ALRAE_Bit=0   ALRAIE_Bit=0   ALRBE_Bit=1   ALRBIE_Bit=1             ' RTC-Alarm B aktivieren, Interrupts an
       end if
    end if
    SYSCFGEN_bit=1   setbit(EXTI_IMR,17)   setbit(EXTI_RTSR,17)                ' RTC_Alarme sind an EXTI-Controller angeschlossen, Eingang 17
    #ifndef 411 then
    NVIC_IntEnable(IVT_INT_RTC_Alarm)                                          ' Interrupt eintragen und starten
    #else
    NVIC_IntEnable(IVT_INT_EXTI17_RTC_ALARM)                                   ' Interrupt eintragen und starten
    #endif
    RTC_WPR=0xFF     DBP_OFF    'uart(126)
end sub

sub procedure set_sommer_winter_alarm                                          ' Init automatic summertime switching
    if testbit(RTC_BKP5R,7) =1 then  exit end if                               ' autom. Sommerzeit ist aus? -> fertig
    clear_rtc_alarms
    '1.) Winterzeit: Sekunden, Minuten=0  -> Bit0-15=0,  StundenEiner=3 -> Bit16=1 Bit17=1, AM Bit22=0, Wochentag=7  Bit24-26=1 Bit27=0 Bit30=1 Bit31=0
    '2.) Sommerzeit: Sekunden, Minuten=0  -> Bit0-15=0,  StundenEiner=2 -> Bit16=0 Bit17=1, AM Bit22=0, Wochentag=7  Bit24-26=1 Bit27=0 Bit30=1 Bit31=0
    '     Bit31->  10987654321098765432109876543210  <- Bit0
    RTC_ALRMASSR=0                                                             ' Sub-Seconds A
    '     Bit31->  10987654321098765432109876543210  <- Bit0
    RTC_ALRMAR  = %01000111000000110000000000000000                            ' Sonntags, 3 Uhr      auf Winterzeit umschalten A
    RTC_ALRMBSSR=0                                                             ' Sub-Seconds B
    '     Bit31->  10987654321098765432109876543210  <- Bit0
    RTC_ALRMBR  = %01000111000000100000000000000000                            ' Sonntags, 2 Uhr      auf Sommerzeit umschalten B
    SYSCFGEN_bit=1  setbit(EXTI_IMR,17)  setbit(EXTI_RTSR,17)                  ' RTC_Alarme sind an EXTI-Controller angeschlossen, Eingang 17
    ALRBE_Bit   =1   ALRAE_Bit  =1   ALRBIE_Bit =1   ALRAIE_Bit  =1            ' RTC-Alarme aktivieren, Interrupts an
    setbit(RTC_BKP5R,15)                                                       ' abfragbar machen
    #ifndef 411 then
    NVIC_IntEnable(IVT_INT_RTC_Alarm)                                          ' Interrupt eintragen und starten
    #else
    NVIC_IntEnable(IVT_INT_EXTI17_RTC_ALARM)                                   ' Interrupt eintragen und starten
    #endif
    DBP_OFF    'uart(126)
end sub

sub function get_hours(dim modus as word) as word                              ' Stunden von Hardwareuhr/Zeitstempel holen
dim ones, tenth as word     volatile
dim reg         as longword volatile

    select case modus
      case 0    reg = RTC_TR                                                   ' RTC Time Register
      case 1    reg = RTC_TSTR                                                 ' RTC Time Stamp Register
      case 2    reg = time_reg                                                 ' Software Time Register
    end select
    tenth   = (reg>>20) and 3
    ones    = (reg>>16) and 15
    result  = (10 * tenth) + ones
end sub

sub function get_minutes(dim modus as word) as word                            ' Minuten von Hardwareuhr/Zeitstempel holen
dim ones, tenth as word     volatile
dim reg         as longword volatile

    select case modus
      case 0    reg = RTC_TR
      case 1    reg = RTC_TSTR
      case 2    reg = time_reg
    end select
    tenth   = (reg>>12) and 7
    ones    = (reg>>8) and 15
    result  = (10 * tenth) + ones
end sub

sub function get_seconds(dim modus as word) as word                            ' Sekunden von Hardwareuhr/Zeitstempel holen
dim ones, tenth as word     volatile
dim reg         as longword volatile

    select case modus
      case 0    reg = RTC_TR
      case 1    reg = RTC_TSTR
      case 2    reg = time_reg
    end select
    tenth   = (reg >>4) and 7
    ones    = reg and 15
    result  = (10 * tenth) + ones
end sub

sub function get_years(dim modus as word) as word                              ' Jahr von Hardwareuhr/Zeitstempel holen
dim ones, tenth as word     volatile
dim reg         as longword volatile

    select case modus
      case 0    reg = RTC_DR                                                   ' RTC Date Register
      case 1    reg = RTC_TSDR                                                 ' RTC Date Stamp Register
      case 2    reg = date_reg                                                 ' Software Date Register
    end select
    tenth   = (reg>>20) and 15
    ones    = (reg>>16) and 15
    result  = (10 * tenth) + ones
end sub

sub function get_months(dim modus as word) as word                             ' Monat von Hardwareuhr/Zeitstempel holen
dim ones, tenth as word     volatile
dim reg         as longword volatile

    select case modus
      case 0    reg = RTC_DR
      case 1    reg = RTC_TSDR
      case 2    reg = date_reg
    end select
    tenth   = (reg>>12) and 1
    ones    = (reg>>8) and 15
    result  = (10 * tenth) + ones
end sub

sub function get_days(dim modus as word) as word                               ' Tag von Hardwareuhr/Zeitstempel holen
dim ones, tenth as word     volatile
dim reg         as longword volatile

    select case modus
      case 0    reg = RTC_DR
      case 1    reg = RTC_TSDR
      case 2    reg = date_reg
    end select
    tenth   = (reg>>4) and 3
    ones    = reg and 15
    result  = (10 * tenth) + ones
end sub

sub function get_dow(dim modus as word) as word                                ' Wochentag von Hardwareuhr/Zeitstempel holen
dim reg as longword volatile

    select case modus
      case 0    reg = RTC_DR
      case 1    reg = RTC_TSDR
      case 2    reg = date_reg
    end select
    result    = (reg>>13) and 7
end sub

sub function init_clock(dim modus as word) as word                             ' Stunden, Minuten, usw...
    result=0
    if (testbit(RTC_ISR,4)=1) and (testbit(RCC_BDCR,1)=1) then                 ' Kalender und LSE ready
       hours    = get_hours(modus)
       minutes  = get_minutes(modus)
       seconds  = get_seconds(modus)
       years    = get_years(modus)
       dow      = get_dow(modus)
       months   = get_months(modus)
       days     = get_days(modus)                                              ' Uhr läuft und ist gestellt - fertig
    else
        if testbit(RTC_ISR,4)=0 then                                           ' Kalender läuft nicht
           result=1  con("K")
        end if
        if testbit(RCC_BDCR,1)=0 then                                          ' LowSpeedOscillator läuft nicht
           result=2  con("L")
        end if
    end if
end sub

sub procedure Calibrate_RTC (dim Cal_Value as integer)                         ' RTC Kalibrieren
dim rcount as longword volatile

    if abs(Cal_Value) > 500 then perror = 13  sys("Calibration value < 500",0)  exit  end if
    rcount=0
    if rtc_init_mode then  exit end if                                         ' RTC in Init-Mode versetzen
    while (RECALPF_bit=1)  and (rcount<10000)                                  ' wait until the last Calibration is completed
          inc(rcount)                                                          ' RECALPF_bit
          delay_us(1)
    wend
    if Cal_Value < 0 then                                                      ' Determine if +/- and set value.
          RTC_CALR = longword(abs(Cal_Value) and 0x1FF)                        ' CALM[8:0]:  smooth calibration  CALP = 0  slower
    else
         RTC_CALR  = longword(((512 - Cal_Value) and 0x1FF) or 32768)          ' CALM[8:0]:  smooth calibration  CALP = 1  faster
    end if
    rtc_init_mode_off
end sub

sub procedure ccm_ram_write_byte(dim ccm_data as byte, dim ccm_adress as longword)  ' Ein Byte in CCM-RAM schreiben
dim cram_pointer as ^byte volatile

    cram_pointer = ccm_ram_pointer + ccm_adress                                ' Zeiger auf Startadresse
    cram_pointer^ = ccm_data
end sub

sub function ccm_ram_read_byte(dim ccm_adress as longword) as byte             ' Ein Byte aus CCM-RAM lesen
dim cram_pointer as ^byte volatile

    cram_pointer = ccm_ram_pointer + ccm_adress                                ' Zeiger auf Startadresse
    result = cram_pointer^
end sub

sub procedure var_ram_read_long(dim ccm_adress as longword)                    ' Ein Long aus CCM-Array-RAM lesen
dim cram_pointer as ^longword volatile

    cram_pointer = var_ram_pointer + (ccm_adress << 3)                         ' Zeiger auf Startadresse
    l_resultat = cram_pointer^
end sub

sub procedure var_ram_write_long(dim ccm_data as longword, dim ccm_adress as longword)  ' Ein Long in CCM-Array-RAM schreiben
dim cram_pointer as ^longword volatile

    cram_pointer = var_ram_pointer + (ccm_adress << 3)                         ' Zeiger auf Startadresse
    cram_pointer^ = ccm_data
end sub

sub procedure var_ram_read_ulong(dim ccm_adress as longword)                   ' Ein ULong aus CCM-Array-RAM lesen
dim cram_pointer as ^uint64 volatile

    cram_pointer = var_ram_pointer + (ccm_adress << 3)                         ' Zeiger auf Startadresse
    u_resultat = cram_pointer^
end sub

sub procedure var_ram_write_ulong(dim var_data as longword, dim var_adress as longword)  ' Ein ULong ins VAR-RAM schreiben
dim vram_pointer as ^uint64 volatile

    vram_pointer = var_ram_pointer + (var_adress << 3)                         ' Zeiger auf Startadresse
    vram_pointer^ = var_data
end sub

sub procedure var_ram_read_float(dim var_adress as longword)                   ' Ein Extended aus VAR-Array-RAM lesen
dim vram_pointer as ^extended volatile

    vram_pointer = var_ram_pointer + (var_adress << 3)                         ' Zeiger auf Startadresse
    resultat = vram_pointer^
end sub

sub procedure var_ram_write_float(dim var_data as extended, dim var_adress as longword)  ' Ein Extended in VAR-Array-RAM schreiben
dim vram_pointer as ^extended volatile

    vram_pointer = var_ram_pointer + (var_adress << 3)                         ' Zeiger auf Startadresse
    vram_pointer^ = var_data
end sub

sub procedure array_ram_read_float(dim ext_adress as longword)                 ' Ein Extended aus Array-RAM lesen
dim aram_pointer as ^extended volatile

    aram_pointer = array_ram_pointer + (ext_adress << 3)                       ' Zeiger auf Startadresse
    resultat = aram_pointer^
end sub

sub procedure array_ram_write_float(dim ext_data as extended, dim ext_adress as longword)  ' Ein Extended in Array-RAM schreiben
dim aram_pointer as ^extended volatile

    aram_pointer  = array_ram_pointer + (ext_adress << 3)                      ' Zeiger auf Startadresse
    aram_pointer^ = ext_data
end sub

sub procedure bkpram_write_byte(dim bkp_data as byte, dim bkp_adress as longword)   ' Ein Byte in Backup-RAM (hinter Protokoll) schreiben
dim bram_pointer as ^Byte volatile

    DBP_ON
    if  BRR_bit=0 then  perror=19 exit end if
    bram_pointer  = backup_ram_start + 4064 + bkp_adress                       ' Zeiger auf Startadresse (0x4002 4000 - 0x4002 4FFF) + 4064
    bram_pointer^ = bkp_data
    DBP_OFF
end sub

sub function bkpram_read_byte(dim bkp_adress as longword) as byte              ' Ein Byte aus Backup-RAM (hinter Protokoll) lesen
dim bram_pointer as ^byte volatile

    bram_pointer = backup_ram_start + 4064 + bkp_adress                        ' Zeiger auf Startadresse (0x4002 4000 - 0x4002 4FFF) + 4064
    result = bram_pointer^
end sub

sub procedure bkpram_write_long(dim bkp_data as longword, dim bkp_adress as longword)   ' Ein Long in Backup-RAM (hinter MX-Dekoder) schreiben
dim bram_pointer as ^longword volatile

    DBP_ON
    if  BRR_bit=0 then  perror=19 exit end if
    bram_pointer = backup_ram_start + 4000 + (bkp_adress << 2)                 ' Zeiger auf Startadresse (0x40024000 - 0x4002 4FFF) + 4000
    bram_pointer^ = bkp_data
    DBP_OFF
end sub

sub function bkpram_read_long(dim bkp_adress as longword) as longword          ' Ein Long aus Backup-RAM (hinter MX-Dekoder) lesen
dim bram_pointer as ^longword volatile

    bram_pointer = backup_ram_start + 4000 + (bkp_adress << 2)                 ' Zeiger auf Startadresse (0x4002 4000 - 0x4002 4FFF) + 4000
    result = bram_pointer^
end sub

sub procedure bkpram_write_float(dim bkp_data as extended, dim bkp_adress as longword)   ' Ein extended in Backup-RAM schreiben
dim bram_pointer as ^extended volatile

    DBP_ON
    if  BRR_bit=0 then  perror=19 exit end if
    bram_pointer = bkpram_pointer + (bkp_adress << 3)                          ' Zeiger auf Startadresse (0x4002 4000 - 0x4002 4FFF)
    bram_pointer^ = bkp_data
    DBP_OFF
end sub

sub procedure bkpram_read_float(dim bkp_adress as longword)                    ' Ein extended aus Backup-RAM lesen
dim bram_pointer as ^extended volatile

    bram_pointer = bkpram_pointer + (bkp_adress << 3)                          ' Zeiger auf Startadresse (0x4002 4000 - 0x4002 4FFF)
    resultat = bram_pointer^
end sub

sub function init_bkpram as longword                                           ' Backup-RAM einschalten
    PWREN_bit=1   DBP_ON
    #ifndef 411 then
    BKPSRAMEN_bit=1
    #endif
    if  BRR_bit=1 then  result=2  DBP_OFF   exit  end if                       ' Bkp-RAM bereits eingeschaltet
    result=0
    DBP_ON
    #ifndef 411 then
    BKPSRAMEN_bit=1  
    #endif
    BRE_bit=1
    while BRR_bit=0                                                            ' Auf Backup-Regler "Ein"-Meldung warten
          delay_us(80)
          inc(result)
          if result>29 then  result=0  DBP_OFF exit end if                     ' Einschalten nicht möglich
    wend
    DBP_OFF
    result=1
end sub

#ifndef 411 then
sub procedure clear_soundbuffer
dim n as longword volatile

    for n=0 to 1023
        soundbuffer[n] = 0
    next n
end sub

sub procedure fill_soundbuffer_w_sinus
dim n as longword volatile

    for n=0 to 1023
        soundbuffer[n] = integer(sinus[n] * 2047.0)
    next n
end sub

sub procedure anti_knax
dim n as longword volatile

    if sound_init=0 then
       if null_line=2048 then  exit end if
       for n=0 to 2048
           null_line = n
           delay_us(250)
       next n
    else
        if null_line=0 then  exit end if
        for n=2048 to 0  step -1
           null_line = n
           delay_us(250)
        next n
    end if
end sub

sub procedure set_dacs
    GPIO_Analog_Input(@GPIOA_BASE, _GPIO_PINMASK_4)                            ' Analogausgang 1  zuerst als Eingang
    GPIO_Analog_Input(@GPIOA_BASE, _GPIO_PINMASK_5)                            ' Analogausgang 2  zuerst als Eingang
    DAC_DHR12R1 = 0
    DAC_DHR12R2 = 0
    DAC1_Init(_DAC_CH1_ENABLE)                                                 ' Soundcard Ausgang
    DAC1_Init(_DAC_CH2_ENABLE)                                                 ' Orgel Ausgang
    setbit(DAC_CR,0)    setbit(DAC_CR,16)                                      ' Analog buffer aktivieren
    setbit(DAC_CR,1)    setbit(DAC_CR,17)                                      '           "
    clearbit(DAC_CR,2)  clearbit(DAC_CR,18)                                    '           "
end sub

sub procedure clear_midi_modulator
dim n as word volatile

for n=0 to voicemax_min1  
    midi_modulator[n]=1.0  
next n
end sub

sub procedure clear_midi_volume
dim n as word volatile

    for n=0 to 15
        channel_volume[n]=1.0
        channel_expr[n]=1.0
    next n
end sub

sub procedure init_sound
    if sound_init=0 then
       NVIC_IntDisable(IVT_INT_TIM8_UP_TIM13)  CEN_TIM13_CR1_bit=0             ' dds off
       stop_all_voices
       clear_midi_modulator
       clear_midi_volume
       g_modulator=0.0
       set_dacs
       InitTimer4                                                              ' Timer Orgelsound
       null_line=0
       if int_marker=0 then
          anti_knax
       end if
       tempo=60
       vibrato=0
       tremolo=0
       kill_nbr=0
       InitTimer7_for_ADSR
       NVIC_SetIntPriority(IVT_INT_TIM3,86)                                    ' SystemTimer verringerte Priority
       sound_init=1
    end if
end sub

sub procedure reset_dacs
    clearbit(DAC_CR,0)    clearbit(DAC_CR,16)                                  ' Analog buffer deaktivieren
    clearbit(DAC_CR,1)    clearbit(DAC_CR,17)                                  '           "
    clearbit(DAC_CR,2)    clearbit(DAC_CR,18)                                  '           "
    DAC1_Deinit()
    clearbit(GPIOA_ODR,4)
    clearbit(GPIOA_ODR,5)
    GPIO_Analog_Input(@GPIOA_BASE, _GPIO_PINMASK_4)                            ' Analogausgang 1  wieder als Eingang
    GPIO_Analog_Input(@GPIOA_BASE, _GPIO_PINMASK_5)                            ' Analogausgang 2  wieder als Eingang
end sub

sub procedure sound_off
    if sound_init then
       stop_all_voices
       if int_marker=0 then
          anti_knax
       end if
       NVIC_IntDisable(IVT_INT_TIM4)                                           ' Sound off
       NVIC_IntDisable(IVT_INT_TIM7)                                           ' ADSR off
       RCC_APB1ENR.TIM4EN=0
       RCC_APB1ENR.TIM7EN=0
       NVIC_SetIntPriority(IVT_INT_TIM3,36)                                    ' SystemTimer normale Priority
       reset_dacs
       sound_init=0
    end if
end sub
#endif

sub procedure get_mcu_id
const test_port1=%1010101010101010
const test_port2=%0101010101010101

    mcu_id = DBG_DBGMCU_IDCODE and 4095
    #ifdef 407mini then                                                        ' wenn der F407ZG mit der 407mini-Software betrieben wird
    fzg=1
    GPIO_Digital_Input(@GPIOF_BASE, _GPIO_PINMASK_All)
    GPIO_Digital_Input(@GPIOG_BASE, _GPIO_PINMASK_All)
    GPIOF_ODR=test_port1                                                       ' können Port F und G als Ausgänge eingesetzt werden
    if test_port1<>GPIOF_ODR then  fzg=0 exit end if
    GPIOF_ODR=test_port2
    if test_port2<>GPIOF_ODR then  fzg=0 exit end if
    GPIOG_ODR=test_port1
    if test_port1<>GPIOG_ODR then  fzg=0 exit end if
    GPIOG_ODR=test_port2
    if test_port2<>GPIOG_ODR then  fzg=0 exit end if
    GPIOF_ODR=0  GPIOG_ODR=0
    #endif
end sub

sub procedure get_flash_size
dim fs_pointer as ^word

    fs_pointer = 0x1FFF7A22
    flash_size = fs_pointer^ and 0xFFFF
end sub

sub procedure change_daylight_saving(dim dlmodus as word)
    if dlmodus=0 then                                                          ' Summer -> Winter
       DBP_ON                                                                  ' umstellen!
       RTC_WPR=0xCA
       RTC_WPR=0x53
       SUB1H_Bit=1                                                             ' 1 Stunde subtrahieren
       clearbit(RTC_CR,18)                                                     ' Wechsel-Bit rücksetzen = Winterzeit
       DBP_OFF
    else                                                                       ' Winter -> Summer
        DBP_ON                                                                 ' umstellen!
        RTC_WPR=0xCA
        RTC_WPR=0x53
        ADD1H_Bit=1                                                            ' 1 Stunde addieren
        setbit(RTC_CR,18)                                                      ' Wechsel-Bit setzen = Sommerzeit
        DBP_OFF
    end if
end sub

sub procedure clear_config_bit_15
    DBP_ON  clearbit(RTC_BKP5R,15)  DBP_OFF
end sub

sub procedure init_hardware                                                    ' Hardware und Startvariablen initialisieren
dim error as short volatile

   'CCR=0
   init_gpios()
   T_CS=1   TFT_CS=1
   usb0_started=0   usb1_started=0   usb_wait_counter=3500
   TFT_started=0   TFT_delete_flag=0   keyboard_active=0   konsole_uart=0   prompt_flag=0
   #ifdef 407ZG then
   relayMask=0xFFFF
   diginpMask=0xFFFF
   osk_started=0
   osk_invisible=0
   #endif
   #ifdef 407mini then
   relayMask=0xFFFF
   diginpMask=0x0FFF
   #endif
   #ifdef 411 then
   relayMask=0x00FF
   diginpMask=0x003F
   #endif
   #ifdef 405RG then
   relayMask=0x000F
   diginpMask=0x000F
   #endif
   SD_Card_started=0   SD_Drive=1
   mod_server=0                                                                ' Modbus Master
   #ifndef 411 then
   if RTC_BKP10R=0 then
      init_pwms(1000)
   else
       init_pwms(RTC_BKP10R)
   end if
   #endif
   'NVIC_IntEnable(IVT_INT_MemManage)
   'NVIC_IntEnable(IVT_INT_UsageFault)
   'NVIC_IntEnable(IVT_INT_BusFault)
   sys_flag = testbit(RTC_BKP5R, 16)                                           ' System-Meldungen aktivieren
   hiliting = true
   Init_com1
   init_all_tft(0)
   InitTimer2()                                                                ' Milli-Sekundenzähler
   #ifndef 411 then
   while Init_USB_Host<4  wend
   Init_usb_device
   #endif
   VT100_clear
   clear_diginp_intrpt                                                         ' Totzeit-Timer resetten
   InitTimer3()                                                                ' Time-Zähler
   if (RTC_BKP14R and 511)>0 then  led_anzahl = (RTC_BKP14R and 511) else  led_anzahl=256 end if   ' LED Konfiguration
   #ifndef 411 then
   'GPIO_Digital_Output(@GPIOA_BASE, _GPIO_PINMASK_10)                          ' WS2812 LED-Anschluss
   clear_leds   send_led_24bits                                                ' WS2812-LEDs aus
   delay4
   #endif
   get_mcu_id   get_flash_size                                                 ' Testet auch Vorhandensein Ports D/E oder F/G
   #ifndef Pyboard then
   sys("started com1",9)
   #endif
   hwfault=0
   #ifndef 411 then
   if init_rng>0 then  sys("Random Number Generator Disrupted",0)  inc(hwfault) end if
   #endif
   if init_bkpram() then  sys("Backup Domain OK ",0) else  sys("Backup Domain Error ",0)  inc(hwfault) end if            '
   delay01
   Init_SPI1_serflash
   select case init_clock(0)
   case 0  sys("Clock started",0)
           if testbit(RTC_BKP5R,7)=0 then                                      ' automat. Sommerzeit?
              twoAclock=0                                                      ' 2Uhr A
              if check_summer_time then                                        ' Sommerzeit?
                 if testbit(RTC_CR,18)=0 then                                  ' Zeit noch nicht umgestellt?
                    change_daylight_saving(1)
                 end if
              else
                  if testbit(RTC_CR,18)=1 then                                 ' Zeit noch nicht umgestellt?
                     change_daylight_saving(0)
                  end if
              end if
              set_sommer_winter_alarm                                          ' RTC-Alarm starten!
           end if
   case 2  if init_LSE_RTC=0 then
              sys("please set the clock!",9) inc(hwfault)
           else
               sys("LSE not started",9) inc(hwfault)
           end if
   case 3  sys("RTC not started",9) inc(hwfault)
   case 1  sys("Date???",0)
   end select
   #ifndef 411 then
   soundbase = @soundbuffer
   max_sample =1024                                                            ' Anzahl Samples
   play_record=0                                                               ' Umschalter auf 'play'
   #endif
   init_adc1
   progname = ""
   gps_sentence = "RMC"
   timecount=0                                                                 ' system clock start
   if (testbit(RTC_ISR,4)=0) or (testbit(RCC_BDCR,1)=0) then                   ' wenn RTC nicht gestartet
      seconds=0                                                                ' wird ersetzt durch Auslesen der RTC
      minutes=0                                                                '   "
      hours  =0                                                                '   "
      days   =1                                                                ' Start-Datum:
      months =1
      years  =26
      dow = calc_dow(days,months,years)                                        ' wochentag (day of week)
      time_set_flag=0
      date_set_flag=0
   end if
   pmode   =0                                                                  ' Direktmodus
   sst_flag=0                                                                  ' single step Modus aus
   ticks   =0                                                                  ' system counter
   sf_check                                                                    ' Eeprom vorhanden?
   prgnr   =0                                                                  ' Programm-Nr fuer Programm im RAM
   speed   =20                                                                 ' Morsegeschwindigkeit (20 words/s)
   gps_on  = word(testbit(RTC_BKP5R, 29))
   gps_new =0
   midi_on = word(testbit(RTC_BKP5R, 28))
   midi_channel=1                                                              ' Kanal 1
   midi_velocity=127                                                           ' Anschlag volle Pulle
   midi_program=18                                                             ' percussive Organ
   #ifndef 411 then
   sound_init=0                                                                ' Sound nicht gestartet
   #endif
   dummy = i2c_scan_bus
   if dummy then
      sys("  found ",0)  pr(dummy,5)   sys(" I2C-Devices,   *) with extra start procedure",3)
   end if
   delay01
   init_I2C(i2c_speed)
   delay01
   dummy = i2c_start_devices()
   if dummy then  sys("  started ",0)  pr(dummy,5)  sys(" I2C-Devices",3)  end if
   #ifndef 411 then                                                            ' kein 411 -------------------------------------------
   delay01
   if RTC_BKP17R=0 then
      Init_ser2_ivt(9600,0,0,0)                                                ' Midi Schnittstelle
   else
       Init_ser2_ivt(RTC_BKP17R,bkpram_read_byte(0),bkpram_read_byte(1),bkpram_read_byte(2))
   end if
   delay01
   if RTC_BKP18R=0 then
      Init_ser3_ivt(9600,0,0,0)                                                ' GPS Schnittstelle
   else
       Init_ser3_ivt(RTC_BKP18R,bkpram_read_byte(3),bkpram_read_byte(4),bkpram_read_byte(5))
   end if
   delay01
     #ifndef 407ZG then                                                        ' kein STM32F407ZG +++++++++++++++++++++++++++++++
   if testbit(RTC_BKP5R,14)=0  then                                            ' Ser4 ###
      i2c2_on=0
      if RTC_BKP16R=0 then                                                     ' ser4 Speed nicht konfiguriert?
         Init_ser4_ivt(9600,0,0,0)                                             ' ser4 Schnittstelle
      else                                                                     ' ser4 konfiguriert
          Init_ser4_ivt(RTC_BKP16R,bkpram_read_byte(6),bkpram_read_byte(7),bkpram_read_byte(8))  ' ser4 Speed konfiguriert!
      end if
   else                                                                        ' I2C2 ###
       set_pull_up_down(Port_B,10,0,1)  set_pull_up_down(Port_B,11,0,1)        ' testweise Pulldowns einschalten
       if (testbit(GPIOB_IDR,10)=1) and (testbit(GPIOB_IDR,11)=1) then         ' externe Pullups?
          I2C2_Init_Advanced(100000,  @_GPIO_MODULE_I2C2_PB10_11)
          I2C2_SetTimeoutCallback(100000, @I2C2_TimeoutCallback)
          set_pull_up_down(Port_B,10,0,0)  set_pull_up_down(Port_B,11,0,0)     ' interne Pulldowns abschalten.
          i2c2_on=1
       else                                                                    ' keine externen Pullups!
           set_pull_up_down(Port_B,10,1,0)  set_pull_up_down(Port_B,11,1,0)    ' interne Pullups einschalten.
           inC(hwfault)
           i2c2_on=0
           sys("I2C2 not activated, Pullups missing",9)
       end if
   end if
     #else                                                                     ' STM32F407ZG:  +++++++++++++++++++++++++++++++++++++++
   if RTC_BKP16R=0 then                                                        ' ser4 Speed nicht konfiguriert?
      Init_ser4_ivt(9600,0,0,0)                                                ' ser4 Schnittstelle
   else                                                                        ' ser4 konfiguriert
       Init_ser4_ivt(RTC_BKP16R,bkpram_read_byte(6),bkpram_read_byte(7),bkpram_read_byte(8))  ' ser4 Speed konfiguriert!
   end if
   set_pull_up_down(Port_B,10,0,1)  set_pull_up_down(Port_B,11,0,1)            ' testweise Pulldowns einschalten
   if (testbit(GPIOB_IDR,10)=1) and (testbit(GPIOB_IDR,11)=1) then             ' externe Pullups?
      I2C2_Init_Advanced(100000,  @_GPIO_MODULE_I2C2_PB10_11)
      I2C2_SetTimeoutCallback(100000, @I2C2_TimeoutCallback)
      set_pull_up_down(Port_B,10,0,0)  set_pull_up_down(Port_B,11,0,0)         ' interne Pulldowns abschalten.
      i2c2_on=1
   else                                                                        ' keine externen Pullups!
       set_pull_up_down(Port_B,10,1,0)  set_pull_up_down(Port_B,11,1,0)        ' interne Pullups einschalten.
       inC(hwfault)
       i2c2_on=0
       sys("I2C2 not activated, Pullups missing",9)
   end if
     #endif                                                                    ' +++++++++++++++++++++++++++++++++++++++++++++++++++++
   adsr_on=0
   #endif
   #ifdef 411 then                                                             ' doch STM32F411: ------------------------------
   delay01
   if RTC_BKP17R>299 then
      Init_ser2_ivt(RTC_BKP17R,8,0,1)                                          ' Kombi-Schnittstelle 2 (MIDI/GPS)
   end if
   if RTC_BKP10R=0 then                                                        ' PWM-Frequenz
      init_pwms(1000)
   else
       init_pwms(RTC_BKP10R)
   end if
   #endif                                                                      ' ----------------------------------------------
   
   #ifndef 411 then                                                            ' kein 411
     #ifndef 405RG                                                             ' auch kein 405RG!!!
   if testbit(RTC_BKP8R,29) then                                               ' Matrix aktiviert?
      keyMode1=testbit(RTC_BKP8R,10)                                           ' low/high active
      if testbit(RTC_BKP8R,4) then                                             ' Musik Klaviatur?
         keyMode2=1                                                            ' Klaviatur-Modus ein
         keymode3=testbit(RTC_BKP8R,5)                                         ' Velocity=const/ad1
         keymode4=testbit(RTC_BKP8R,28)                                        ' play extern/intern
         if keyMode4=0 then
            Init_ser2_ivt(31250,8,0,1)                                         ' für MIDI initiieren
            sys(" for MIDI-Keyboard",3)
         else
             start_MIDI_sound
         end if
         start_Matrix   sys("started MX",9)
      else                                                                     ' Computer Tastatur ?
          keyMode2=0                                                           ' Computer Keyboard Modus ein
          decode=testbit(RTC_BKP8R,11)                                         ' Decodiertabelle im RAM?
          if usb0_started=0 then                                               ' USB-Host aus?
             start_Matrix
             if testbit(RTC_BKP8R,16) then                                     ' Konsole #8 on ?
                if TFT_started then
                   konsole_uart=8
                   decode=1                                                    ' testweise
                   MX_interface=0                                              ' testweise
                   'usb1_started=0
                   'NVIC_IntDisable(IVT_INT_OTG_FS)
                   TFT_Backcol=0   TFT_CLS(0)                                  ' Hintergrundfarbe = schwarz, TFT löschen
                end if
             end if
          end if
      end if
   end if
     #endif
   #endif
   #ifdef 407ZG then
   if testbit(RTC_BKP8R,26) then 
      start_osk
   end if
   if osk_started=1 then
      osk_started=2                                                            ' vom System gestartet
   end if
   #endif
   #ifdef VG then
   if testbit(RTC_BKP8R,26) then
      start_osk
   end if
   if osk_started=1 then
      osk_started=2                                                            ' vom System gestartet
   end if
   #endif
   redirect_konsole
   standart_konsole=konsole_uart
   load_flag=0
   InitTimer10
   default_ptr_type=(RTC_BKP5R>>2) and 3
   language=testbit(RTC_BKP5R,17)
   Fkey[0][0]=167   Fkey[0][1]=0
   #ifndef 411 then                                                            ' nicht beim 411
   if testbit(RTC_BKP5R,28) then                                               ' MIDI-Empfang On?
      Init_ser2_ivt(31250,8,0,1)  sys(" for MIDI-Decoder",3)
      start_MIDI_sound   midi_on=1
   end if
   time_reg = bkpram_read_long(0)
   date_reg = bkpram_read_long(1)
   #endif
   error = init_SD_Card
   if error=0 then  sys("SD_Card detected",9) end if
   current_path(1)
   sys("MCU-ID: ",9)  prh(mcu_id)   sys("   Flash size: ",3)  pr(flash_size,5)  sys(" KB",3)
   #ifdef 407mini then
   if fzg then sys("PortF and PortG available",9) end if
   #endif
   if flash_size >= 1024 then
      #ifndef 411 then
      if testbit(RTC_BKP8R,31)=0 then
         Prog_ROM_Start=sector11_adres1                                        ' kleines ROM-Modell
      else
           Prog_ROM_Start=sector10_adres                                       ' grosses ROM-Modell
      end if
      #else
      Prog_ROM_Start=sector7_adres2
      #endif
   else
       if flash_size >= 512 then
          #ifndef 411 then
          Prog_ROM_Start=0
          #else
          Prog_ROM_Start=sector7_adres2
          #endif
       else
           Prog_ROM_Start=0
       end if
   end if
   prog_nr=0
   clear_buffers
   sys("hardware configuration ready, Hardware-Errors: ",9)   pr(hwfault,5)
end sub

sub function get_one_byte() as byte                                            ' holt ein Zeichen von com1
dim loopc as word volatile

    if ser1_zeiger=0 then  result=0 exit end if
    loopc=0                                                                    ' loopcounter to bottom of buffer
    result = recstr1[0]                                                        ' take the lowest byte
    do                                                                         ' lifo
      recstr1[loopc] = recstr1[loopc +1]                                       ' shift right receive buffer one byte
      inc(loopc)                                                               ' next byte
    loop until loopc = ser1_zeiger                                             ' last received byte?
    dec(ser1_zeiger)                                                           ' receive write pointer -1
end sub

#ifndef 411 then
sub function get_one_usb_byte() as byte                                        ' holt ein Zeichen aus dem USB-Empfangspuffer
dim loopc as word volatile

    if usb_zeiger=0 then  result=0  exit end if
    loopc=0                                                                    ' loopcounter to bottom of buffer
    result = recstrusb[0]                                                      ' take the lowest byte
    do                                                                         ' lifo
      recstrusb[loopc] = recstrusb[loopc +1]                                   ' shift right receive buffer one byte
      inc(loopc)                                                               ' next byte
    loop until loopc = usb_zeiger                                              ' last received byte?
    dec(usb_zeiger)                                                            ' receive write pointer -1
end sub

sub function get_one_matrix_byte() as byte                                     ' holt ein Zeichen aus dem Matrix-Tastatur-Puffer
dim loopc as word volatile

    if ser8_zeiger=0 then  result=0 exit end if
    loopc=0                                                                    ' loopcounter to bottom of buffer
    result = recstr8[0]                                                        ' take the lowest byte
    do                                                                         ' lifo
      recstr8[loopc] = recstr8[loopc +1]                                       ' shift right receive buffer one byte
      inc(loopc)                                                               ' next byte
    loop until loopc = ser8_zeiger                                             ' last received byte?
    dec(ser8_zeiger)                                                           ' receive write pointer -1
end sub
#endif

sub function get_one_konsole_byte as byte
    select case   konsole_uart
      case 1,7    result = get_one_byte            ser_zeiger = ser1_zeiger    ' com1
      case 2      result = get_one_midi_byte       ser_zeiger = ser2_zeiger    ' com2
      #ifndef 411 then
      case 3      result = get_one_gps_byte        ser_zeiger = ser3_zeiger    ' com3
      case 5,6,9  result = get_one_usb_byte        ser_zeiger = usb_zeiger     ' USB-Device, USB-Host
      case 8,30   result = get_one_matrix_byte     ser_zeiger = ser8_zeiger    ' Matrix
      case 4      result = get_one_ser4_byte       ser_zeiger = ser4_zeiger    ' com4
      case 31     if ser1_zeiger>usb_zeiger then                               ' USB-Host + com1
                     result = get_one_byte         ser_zeiger = ser1_zeiger
                  else
                      result = get_one_usb_byte    ser_zeiger = usb_zeiger
                  end if
      #endif
    end select
end sub

sub function get_one_uart_byte as byte
    select case   uart_nr
      case 1,7    result = get_one_byte            ser_zeiger = ser1_zeiger    ' com1
      case 2      result = get_one_midi_byte       ser_zeiger = ser2_zeiger    ' com2
      #ifndef 411 then
      case 3      result = get_one_gps_byte        ser_zeiger = ser3_zeiger    ' com3
      case 5,6,9  result = get_one_usb_byte        ser_zeiger = usb_zeiger     ' USB-Device, USB-Host
      case 8,30   result = get_one_matrix_byte     ser_zeiger = ser8_zeiger    ' Matrix
      case 4      result = get_one_ser4_byte       ser_zeiger = ser4_zeiger    ' com4
      case 31     if ser1_zeiger>usb_zeiger then                               ' USB-Host + com1
                     result = get_one_byte         ser_zeiger = ser1_zeiger
                  else
                      result = get_one_usb_byte    ser_zeiger = usb_zeiger
                  end if
      #endif
    end select
end sub

#ifndef 411 then                                                               ' nict 411
sub function get_one_midi_byte() as byte                                       ' holt ein Zeichen aus dem MIDI-Empfangspuffer
dim loopd as byte volatile

    if ser2_zeiger=0 then  result=0  exit end if
    loopd=0                                                                    ' loopcounter to bottom of buffer
    result = recstr2[0]                                                        ' take the lowest byte
    do                                                                         ' lifo
      recstr2[loopd] = recstr2[loopd +1]                                       ' shift right receive buffer one byte
      inc(loopd)                                                               ' next byte
    loop until loopd = ser2_zeiger                                             ' last received byte?
    dec(ser2_zeiger)                                                           ' receive write pointer -1
end sub

