    hxwritedata(0x48)            '// MX, BGR

    hxwritecommand(0x3A)       ' // Pixel Interface Format
    'hxwritedata(0x55)    '  // 16 bit colour for parallel

    hxwritedata(0x66) '    // 18 bit colour for SPI

    hxwritecommand(0xB0)      ' // Interface Mode Control
    hxwritedata(0x00)

    hxwritecommand(0xB1)   ' // Frame Rate Control
    hxwritedata(0xA0)

    hxwritecommand(0xB4)    ' // Display Inversion Control
    hxwritedata(0x02)

    hxwritecommand(0xB6)     ' // Display Function Control
    hxwritedata(0x02)
    hxwritedata(0x02)
    hxwritedata(0x3B)

    hxwritecommand(0xB7)       ' // Entry Mode Set
    hxwritedata(0xC6)

    hxwritecommand(0xF7)       ' // Adjust Control 3
    hxwritedata(0xA9)
    hxwritedata(0x51)
    hxwritedata(0x2C)
    hxwritedata(0x82)

    hxwritecommand(0x11)  '  //Exit Sleep
delay_ms(120)

    hxwritecommand(0x29)  '  //Display on
delay_ms(25)
    HXwritecommand(0x36)
    if testbit(RTC_BKP5R, 23) = 1  then
       HXwritedata(0x20 or 0x08)      ' Landscape
    else
        HXwritedata(0x40 or 0x80 or 0x20 or 0x08)      ' Landscape inverted
    end if
            '// End of ILI9488 display configuration
end select
TFT_CS = 1
end sub

sub procedure draw_button(dim x, y, z as longword)                             ' from PIC32
    if use_palette then
       TFT_Set_Pen(0, 2)
       TFT_Set_Brush(1, z, 0, 0, 0, 0)
       TFT_Rectangle_Round_Edges(x, y, x + 80, y + 40, 5)
    else
        TFT_Set_Pen(CL_BLACK, 2)
        TFT_Set_Brush(1, 0, 1, LEFT_TO_RIGHT, z, cl_palette[9])
        TFT_Rectangle(x, y, x + 80, y + 40)
    end if
end sub

sub function four_buttons(dim modus as longword) as longword                   ' from PIC32
dim cl1, cl2, cl3, cl4                                             as longword volatile
dim button_red, button_blue, button_silver, button_white, test_bit as word     volatile

    if use_palette then
       button_red=2  button_blue=6  button_silver=18  button_white=9
    else
        button_red=cl_palette[2]  button_blue=cl_palette[6]  button_silver=cl_palette[18]  button_white=cl_palette[9]
    end if
    cl1=button_blue  cl2=button_blue  cl3=button_blue  cl4=button_blue  result=0
    if modus=2 then
       test_bit = testbit(RTC_BKP5R, 4)
       #ifndef 411 then
       if testbit(relay, 0) xor test_bit then  cl1=button_red  setbit(result,0) end if  ' Relaiszustände einlesen
       if testbit(relay, 1) xor test_bit then  cl2=button_red  setbit(result,1) end if
       if testbit(relay, 2) xor test_bit then  cl3=button_red  setbit(result,2) end if
       if testbit(relay, 3) xor test_bit then  cl4=button_red  setbit(result,3) end if
       #else
       if testbit(GPIOB_ODR, 04) xor test_bit then  cl1=button_red  setbit(result,0) end if  ' Relaiszustände einlesen
       if testbit(GPIOB_ODR, 05) xor test_bit then  cl2=button_red  setbit(result,1) end if
       if testbit(GPIOC_ODR, 14) xor test_bit then  cl3=button_red  setbit(result,2) end if
       if testbit(GPIOC_ODR, 15) xor test_bit then  cl4=button_red  setbit(result,3) end if
       #endif
    end if
    if modus=3 then  cl1 = button_red  result=1  end if
    TFT_Set_Pen(0, 2)                                                          ' Fenster malen
    TFT_Set_Brush(1, button_silver, 0, 0, 0, 0)
    TFT_Rectangle(20, 30, 300,  230)
    TFT_Set_Brush(1, button_blue, 0, 0, 0, 0)
    tft_Rectangle(20,30,300,60)
    TFT_Set_Brush(1, button_red, 0, 0, 0, 0)
    TFT_Rectangle(260, 30, 300,  60)
    if (modus=1) or (modus=4) then
       varstr[6][30]=0
       varstr[7][30]=0
       TFT_Set_Font(@Arial16x19_Bold, button_white, FO_HORIZONTAL)
       TFT_Write_Text(varstr[6], 30, 35)
       TFT_Set_Font(@Arial16x19_Bold, 0, FO_HORIZONTAL)
       TFT_Write_Text(varstr[7], 30, 140)
    end if
    if modus=2 then
       TFT_Set_Font(@Arial16x19_Bold, button_white, FO_HORIZONTAL)
       if language=0 then
          tft_write_constant_text("Direkte Relaissteuerung", 50, 35)
       else
           tft_write_constant_text("Direct Relay Control", 50, 35)
       end if
       TFT_Set_Font(@Arial16x19_Bold, 0, FO_HORIZONTAL)
       if language=0 then
          tft_write_constant_text("rot = ein    -   blau = aus", 70, 140)
       else
           tft_write_constant_text("red = on    -    blue = off", 70, 140)
       end if
    end if
    if modus=3 then
       TFT_Set_Font(@Arial16x19_Bold, button_white, FO_HORIZONTAL)
       TFT_Write_Text(varstr[7], 50, 35)
    end if
    draw_button(060, 080,cl1)
    draw_button(180, 080,cl2)
    draw_button(060, 170,cl3)
    draw_button(180, 170,cl4)
    TFT_Set_Font(@Arial21x24_Bold, button_white, FO_HORIZONTAL)
    select case modus
      case 2
           tft_write_constant_text("Rel.1", 070, 090)
           tft_write_constant_text("Rel.2", 190, 090)
           tft_write_constant_text("Rel.3", 070, 180)
           tft_write_constant_text("Rel.4", 190, 180)
      case 3
           tft_write_constant_text("  No",  070, 090)
           tft_write_constant_text("  Yes", 190, 090)
           tft_write_constant_text(" Esc",  070, 180)
           tft_write_constant_text("  OK",  190, 180)
      case 1, 4
           TFT_Write_Text(varstr[0], 070, 090)
           TFT_Write_Text(varstr[1], 190, 090)
           TFT_Write_Text(varstr[2], 070, 180)
           TFT_Write_Text(varstr[3], 190, 180)
    end select
    do
      XPT2046_read(0)
      if mvar=3 then TFT_Fill_Screen(tft_backcol)  TFT_zeile=0  TFT_spalte=0  exit end if
      if (x_coord > 60) and (x_coord < 140) and (y_coord > 80) and (y_coord < 120) then
         select case modus
           #ifndef 411 then
           case 2    relay.0 = not (mrelay.0)  result.0 = mrelay.0 xor RTC_BKP5R.4
           #else
           case 2    GPIOB_ODR.4 = not (GPIOB_IDR.4)  result.0 = GPIOB_IDR.4 xor RTC_BKP5R.4
           #endif
           case 1    result.0 = not (result.0)
           case 3    result.0 = 1  result.1=0  draw_button(180, 80,button_blue) tft_write_constant_text("  Yes", 190, 90)
           case 4    result=1
         end select
         if (result and 1) then cl1 = button_red  else  cl1 = button_blue  end if    
         draw_button(60, 80,cl1)
         select case modus
           case 2    tft_write_constant_text("Rel.1", 70, 90)
           case 1    TFT_Write_Text(varstr[0], 70, 90)
           case 3    tft_write_constant_text("  No", 70, 90)
         end select
      end if
      if (x_coord > 180) and (x_coord < 260) and (y_coord > 80) and (y_coord < 120) then
         select case modus
           #ifndef 411 then
           case 2    relay.1     = not (mrelay.1)     result.1 = mrelay.1    xor RTC_BKP5R.4
           #else
           case 2    GPIOB_ODR.5 = not (GPIOB_IDR.5)  result.1 = GPIOB_IDR.5 xor RTC_BKP5R.4
           #endif
           case 1    result.1 = not(result.1)
           case 3    result.1 =1  result.0=0  draw_button(60, 80,button_blue) tft_write_constant_text("  No", 70, 90)
           case 4    result=2
         end select
         if (result and 2) then cl2 = button_red  else  cl2 = button_blue  end if   
         draw_button(180, 80,cl2)
         select case modus
           case 2    tft_write_constant_text("Rel.2", 190, 90)
           case 1    TFT_Write_Text(varstr[1], 190, 90)
           case 3    tft_write_constant_text("  Yes", 190, 90)
         end select
      end if
      if (x_coord > 60) and (x_coord < 140) and (y_coord > 170) and (y_coord < 210) then
         select case modus
           #ifndef 411 then
           case 2    relay.2      = not (mrelay.2)      result.2 = mrelay.2     xor RTC_BKP5R.4
           #else
           case 2    GPIOC_ODR.14 = not (GPIOC_IDR.14)  result.1 = GPIOC_IDR.14 xor RTC_BKP5R.4
           #endif
           case 1    result.2 = not (result.2)
           case 3    result=27 TFT_Fill_Screen(tft_backcol)  TFT_zeile=0  TFT_spalte=0  exit
           case 4    result=4
         end select
         if result.2 then cl3 = button_red  else  cl3 = button_blue  end if   
         draw_button(60, 170,cl3)
         select case modus
           case 2    tft_write_constant_text("Rel.3", 70, 180)
           case 1    TFT_Write_Text(varstr[2], 70, 180)
           case 3    tft_write_constant_text("Esc", 70, 180)
         end select
      end if
      if (x_coord>180) and (x_coord<260) and (y_coord>170) and (y_coord<210) then
         select case modus
           #ifndef 411 then
           case 2    relay.3      = not (mrelay.3)      result.3 = mrelay.3     xor RTC_BKP5R.4
           #else
           case 2    GPIOC_ODR.15 = not (GPIOC_IDR.15)  result.1 = GPIOC_IDR.15 xor RTC_BKP5R.4
           #endif
           case 1    result.3 = not(result.3)
           case 3    result.2 = 1  TFT_Fill_Screen(tft_backcol)  TFT_zeile=0  TFT_spalte=0  exit
           case 4    result   = 8
         end select
         if testbit(result,3) then  cl4 = button_red  else  cl4 = button_blue  end if   
         draw_button(180, 170,cl4)
         select case modus
           case 2    tft_write_constant_text("Rel.4", 190, 180)
           case 1    TFT_Write_Text(varstr[3], 190, 180)
           case 3    tft_write_constant_text("  OK", 190, 180)
         end select
      end if
      if modus=4 then
         if testbit(result,0) then  cl1 = button_red else  cl1 = button_blue  end if
         if testbit(result,1) then  cl2 = button_red else  cl2 = button_blue  end if
         if testbit(result,2) then  cl3 = button_red else  cl3 = button_blue  end if
         if testbit(result,3) then  cl4 = button_red else  cl4 = button_blue  end if
         draw_button(060, 080,cl1)
         draw_button(180, 080,cl2)
         draw_button(060, 170,cl3)
         draw_button(180, 170,cl4)
         TFT_Write_Text(varstr[0], 070, 090)
         TFT_Write_Text(varstr[1], 190, 090)
         TFT_Write_Text(varstr[2], 070, 180)
         TFT_Write_Text(varstr[3], 190, 180)
      end if
      delay15
      loop until (x_coord>260) and (y_coord>30) and (x_coord<300) and (y_coord<60)
      TFT_Fill_Screen(tft_backcol)  TFT_zeile=0  TFT_spalte=0
end sub

sub procedure ok_button()                                                      ' from PIC32
dim button_white as word volatile

    if use_palette then  button_white=9 else  button_white = cl_palette[9] end if
    draw_button(160 -40, 120 -20,0)
    TFT_Set_Font(@Arial21x24_Bold, button_white, FO_HORIZONTAL)
    tft_write_constant_text("OK", 160 -14, 120 -10)
    do
      XPT2046_read(0)
      if mvar=3 then  TFT_Fill_Screen(tft_backcol)  TFT_zeile=0  TFT_spalte=0 exit end if
    loop until (x_coord>120) and (y_coord>100) and (x_coord<200) and (y_coord<160)
    TFT_Fill_Screen(tft_backcol)
end sub

sub procedure message_box()                                                    ' from PIC32
dim button_white as word volatile

    if use_palette  then  button_white=9  else  button_white = cl_palette[9]  end if
    TFT_Set_Pen(0, 2)
    TFT_Set_Brush(1, button_white, 0, 0, 0, 0)
    TFT_Rectangle_Round_Edges(160 -90, 120 - 70, 160 + 90,  120 + 40, 10)
    TFT_Set_Font(@Arial16x19_Bold, 0, FO_HORIZONTAL)
    varstr[7][18] = 0
    TFT_Write_Text(varstr[7], 160 - 80, 120 -60)
    ok_button
    TFT_Fill_Screen(tft_backcol)  TFT_zeile=0  TFT_spalte=0
end sub

sub procedure I2C1_TimeoutCallback(dim errorCode as byte)
    i2c_error = errorCode                                 ' _I2C_TIMEOUT_RD=3, _I2C_TIMEOUT_WR=4, _I2C_TIMEOUT_IDLE=5, _I2C_TIMEOUT_START=6
end sub

sub procedure I2C2_TimeoutCallback(dim errorCode as byte)
    i2c_error = errorCode                                 ' _I2C_TIMEOUT_RD=3, _I2C_TIMEOUT_WR=4, _I2C_TIMEOUT_IDLE=5, _I2C_TIMEOUT_START=6
end sub

sub procedure konsole_clear
    con(15)   con(24)
    VT100_clear
    set_konsole_color(6,0,0)
end sub


#ifndef 411 then
sub function Init_USB_Host  as word  org  usb_start_adr
dim loopcnt                 as longword volatile                               ' loop counter
dim usb_event               as byte     volatile

    result=4
    if progline[1] <> 38 then                                                  ' Anweisung USB??  dann Konfiguration ignorieren!
       if testbit(RTC_BKP5R,09)=1 then  usb0_started=0  exit  end if           ' Konfiguration: USB off
       if testbit(RTC_BKP5R,11)=0 then  usb0_started=0  exit  end if           ' Konfiguration: no USB Host
    end if
    if usb0_started=1 then  exit  end if                                       ' USB-Host already runs
    if usb1_started=1 then  exit  end if                                       ' USB-Device activ
    usb0_started=0
    #ifdef 405RG then
       #ifndef Pyboard then
       GPIO_Digital_Output(@GPIOC_BASE, _GPIO_PINMASK_5)                       ' USB-Power-Output
       GPIO_Digital_Output(@GPIOA_BASE, _GPIO_PINMASK_9)
       #else
       GPIO_Digital_Output(@GPIOB_BASE, _GPIO_PINMASK_4)                       ' USB-Power-Output
       #endif
    #endif
    #ifdef 407mini then
    GPIO_Digital_Output(@GPIOC_BASE, _GPIO_PINMASK_12)                         ' USB-Power-Output
    GPIO_Digital_Output(@GPIOA_BASE, _GPIO_PINMASK_9)
    #endif
    #ifdef 407ZG then
    GPIO_Digital_Output(@GPIOC_BASE, _GPIO_PINMASK_5)                          ' USB-Power-Output
    GPIO_Digital_Output(@GPIOA_BASE, _GPIO_PINMASK_9)
    #endif
    usb_start:
    #ifndef Pyboard then
    USB_Power=1   FHMOD_Bit=0   NOVBUSSENS_Bit=0   USB_PW=0                    ' USB Power off
    delay300
    USB_Power=0                                                                ' USB Power on
    #else
    USB_Power=0   FHMOD_Bit=0   NOVBUSSENS_Bit=0   USB_PW=0                    ' USB Power off
    delay300
    USB_Power=1                                                                ' USB Power on
    #endif
    Init_USBHost_Vars()
    USBHost_HIDInit()
    USBHost_RegisterDeviceEventHandler(@HIDEventHandler)
    USBHost_Init()
    delay10
    NVIC_IntEnable(IVT_INT_OTG_FS)
    USBHost_Main()
    delay60
    GPIO_Alternate_Function_Enable(@_GPIO_MODULE_OTG_FS_PA89_10_11_12)
    delay01                                                                      '#
    USBHost_Main()
    FHMOD_Bit=1
    delay10   delay01   delay01
    USBHost_Main()
    NOVBUSSENS_Bit=1
    delay10   delay01   delay01
    USBHost_Main()
    delay01   'con("U")
    if hidEvent < 2 then  con("*")  delay500  goto usb_start end if            ' _USB_HOST_EVENT_DEVICE_RESET
    loopcnt=0    usb_event=0   'con("1")
    if hidEvent < 3 then                                                       ' _USB_HOST_EVENT_DEVICE_ADDRESSED
    while usb_event < 3                                                        ' _USB_HOST_EVENT_DEVICE_ADDRESSED
      usb_event=hidevent
      USBHost_Main()
      delay60us
      inc(loopcnt)
      if loopcnt > 8000 then
         result=2  'uprn(result,1)
         usb0_started=2
         exit
      end if
    wend
    end if
    delay10
    if hidEvent < 4 then                                                       ' _USB_HOST_EVENT_DEVICE_ENUMERATED
    while usb_event < 4                                                        ' _USB_HOST_EVENT_DEVICE_ENUMERATED
      usb_event=hidevent
      USBHost_Main()   delay300us
    wend
    end if
    result=4
    usb0_started=1                                                             ' USB ready melden
    clear_usb_buffer                                                           ' Empfangspuffer leeren
    if (testbit(RTC_BKP5R,10)=0) and (progline[1]<>38) then                    ' USB-Konsole konfiguriert?
       if TFT_started=1 then                                                   ' TFT OK?
          konsole_uart=9                                                       ' USB-Konsole konfiguriert -> umleiten
          TFT_Backcol=0   TFT_CLS(0)                                           ' Hintergrundfarbe = schwarz, TFT löschen
       else
           konsole_clear                                                       ' Konsolenpuffer löschen
       end if
    end if
    if usb_event =4 then  sys("USB Keyboard detected",0)  end if               ' Fertigmeldung
    'prn(usb_device)
end sub

sub procedure Init_Usb_Device
dim timeoutcounter as word volatile

    if progline[1]<>38 then                                                    ' Anweisung USB??  dann Konfiguration ignorieren!
       if testbit(RTC_BKP5R,9)=1  then  usb1_started=0  exit  end if           ' USB aus
    end if
    if usb0_started=1    then  usb1_started=0  exit  end if                    ' USB-Host läuft schon
    if usb1_started=1    then                  exit  end if                    ' USB-Device läuft schon
    USB_Mode = USB_Device_Mode                                                 ' USB global Interrupt umschalten
    USBDev_CDCInit()                                                           ' Initialize HID Class
    USBDev_Init()
    FDMOD_Bit=1                                                                ' Only_Device_Mode_Bit
    NOVBUSSENS_Bit=1                                                           ' VBus detect off
    GPIO_Alternate_Function_Enable(@_GPIO_MODULE_OTG_FS_PA89_10_11_12)         ' PINs konfigurieren
    NVIC_IntEnable(IVT_INT_OTG_FS)                                             ' Enable USB device interrupt
    timeoutcounter=0
    while (USBDev_GetDeviceState() <> _USB_DEV_STATE_CONFIGURED)               ' Wait until device is configured (enumeration is successfully finished)
          if timeoutcounter>usb_wait_counter then                              ' nach 3sek noch keine USB-Verbindung?
             NVIC_IntDisable(IVT_INT_OTG_FS)  usb1_started=0                   ' USB-Device off
             exit 
          end if
          delay01
          inc(timeoutcounter)
    wend
    usb_zeiger=0   usb1_started=1
    USBDev_CDCSetReceiveBuffer(@usb_r_buffer)                                  ' Set receive buffer where received data is stored
    clear_usb_buffer
    if (testbit(RTC_BKP5R,10)=0) and (progline[1]<>38) then                    ' Konsole konfiguriert?
       konsole_uart=5                                                          ' USB-Konsole konfiguriert -> umleiten
       konsole_clear
       VT100_clear
    end if
    sys("Started USB Device",0)
end sub
#endif

sub procedure MMC_TimeoutCallback(dim errorCode as byte)                       ' declare timeout callback function
    SD_Card_Error = errorCode                                                  ' Error global machen
'  _MMC_INIT_TIMEOUT=1
'  _MMC_CMD_TIMEOUT=2
'  _MMC_SPI_TIMEOUT=3
end sub

sub function SD_Card_set_time as short
    init_clock(0)
    tm.Year   = years +2000
    tm.Month  = months
    tm.Day    = days
    tm.Hour   = hours
    tm.Minute = minutes
    tm.Second = seconds
    result = FAT32_SetTime(@tm)
end sub

sub function SD_Set_Path_Get_Dir(dim drive as word) as short                   ' setzt Pfad / holt Arbeitsverzeichnis
dim charpointer   as ^char       volatile                                      ' drive=0 get dir
dim n, m, l       as word        volatile                                      ' drive=1,2,3 set path and get dir
dim slash_counter as word        volatile
dim ch_dir_string as string[30]  volatile

    SPI_Set_Active(@SPI2_Read, @SPI2_Write)
    select case drive
      case 0    charpointer = FAT32_GetCurrentPath                             ' aktueller Pfad, muss nicht gesetzt werden, holt akt. Ordner
      case 3    charpointer = @pstr                                            ' setzt beliebigen Pfad (enthalten in pstr)
      case 1    charpointer = @Drive1_Path_String  SD_Drive=1                  ' stellt gespeicherten Pfad von Drive1 wieder her
      #ifdef 405RG then
      case 2    charpointer = @Drive2_Path_String  SD_Drive=2                  ' stellt gespeicherten Pfad von Drive2 wieder her
      #endif
      #ifdef 407ZG then
      case 2    charpointer = @Drive2_Path_String  SD_Drive=2                  ' stellt gespeicherten Pfad von Drive2 wieder her
      #endif
    end select
    if charpointer^ =0 then  result = -99 exit end if                          ' Pfad ist leer
    l=length(charpointer) -1
    if bpointer(charpointer + l) <> "\" then  result = -98 exit end if         ' Pfad hört nicht mit "\" auf
    n=0  result=0  slash_counter=0
    if drive then                                                              ' Pfad setzen?
       ch_dir_string[0] = "\"    ch_dir_string[1] = 0                          ' ins Rootdirectory
       int2_off  result = FAT32_ChangeDir(@ch_dir_string)  int2_on             ' wechseln
       if result<0 then  perror=19  sys(sd_not_ready,0)  pr(FAT32_GetError,5)  exit end if
    end if
    while (charpointer^ >0) and (n<l)
          m=0
          while ((charpointer^ <> "\") and (charpointer^ >0))
                ch_dir_string[m] = charpointer^                                ' Verzeichnis heraus kopieren
                inc(n)  inc(m)  inc(charpointer)
          wend
          ch_dir_string[m]=0   'cwtnl(ch_dir_string)
          dir_string=ch_dir_string                                             ' merken
          inc(slash_counter)                                                   ' Backslash zählen
          if drive and (slash_counter>1) then                                  ' nicht Rootdirectory?
             int2_off  result = FAT32_ChangeDir(@ch_dir_string)  int2_on       ' dann wechseln!
             if result<0 then  perror=19  sys("Directory?? ",0)  pr(FAT32_GetError,5)  exit end if
          end if
          inc(charpointer)                                                     ' Backslash überspringen
    wend
    if result<0 then  exit end if                                              ' Fehler? dann fertig
    'if drive=3  then  current_path(SD_Drive) end if                            ' Pfad speichern (macht die Anweisung cd schon)
    result=slash_counter                                                       ' sonst Anzahl Directory-Schritte
end sub

#ifdef 405RG then
sub function init_SD_Card as short
const GET_DIR=0
dim   dumy as short volatile

    SD_timeout.cmd_timeout  = 100000
    SD_timeout.spi_timeout  = 1000000
    SD_timeout.init_timeout = 10000000
    Mmc_SetTimeoutCallback(SD_timeout, @Mmc_TimeoutCallback)
    #ifdef Pyboard then
    GPIO_Digital_Output(@GPIOA_BASE, _GPIO_PINMASK_8)
    #endif
    delay01
    ' SDIO_CK frequency < 400 kHz in identification mode
    SDIO_Init(_SDIO_CFG_POWER_SAVE_DISABLE or _SDIO_CFG_4_WIDE_BUS_MODE or _SDIO_CFG_CLOCK_BYPASS_DISABLE or _SDIO_CFG_CLOCK_RISING_EDGE or _SDIO_CFG_HW_FLOW_ENABLE, 120, @_GPIO_MODULE_SDIO_D0_D3)
    GPIOD_PUPDR = GPIOD_PUPDR or 0x10                                          ' Pullups auf der Platine ?
    GPIOC_PUPDR = GPIOC_PUPDR or 0x550000                                      ' Pullups auf der Platine ?
    Mmc_Set_Interface(_MMC_INTERFACE_SDIO)                                     ' Set SDIO interface
    SDIO_Reset()
    Delay15
    int2_off  result = FAT32_Init()  int2_on                                   ' Init SD-Card
    if result<0 then  clearbit(SD_Card_started,0) exit end if
    SDIO_CLKCR = SDIO_CLKCR and not longword(0xff)                             ' SD card ist initialisiert, SDIO speed (SDIO_CK) erhöhen
    SDIO_CLKCR = SDIO_CLKCR or longword(0x2)
    setbit(SD_Card_started,0)
    int2_off  result = FAT32_GetFreeSpace(@freeClusts, @bytesPerCluster)  int2_on
    delay01
    dumy=SD_Card_set_time
    SD_Set_Path_Get_Dir(GET_DIR)
    SD_Drive=1
    SD_Dir_Counter=0
end sub

sub function init_SD_Card2 as short
const GET_DIR=0
dim   dumy as short volatile

    SD_timeout.cmd_timeout  = 1000
    SD_timeout.spi_timeout  = 1000000
    SD_timeout.init_timeout = 10000000
    Mmc_SetTimeoutCallback(SD_timeout, @Mmc_TimeoutCallback)
    delay01
    spi2_speed(64)
    SPI_Set_Active(@SPI2_Read, @SPI2_Write)
    Mmc_Set_Interface(_MMC_INTERFACE_SPI)                                      ' Set SPI interface
    int2_off  result = FAT32_Init()  int2_on
    delay01
    if result<0 then  clearbit(SD_Card_started,1) exit end if
    setbit(SD_Card_started,1)
    if TFT_started=0 then  TFT_SPI_Speed=16    end if
    spi2_speed(TFT_SPI_Speed)
    int2_off  result = FAT32_GetFreeSpace(@freeClusts, @bytesPerCluster)  int2_on
    delay01
    dumy=SD_Card_set_time
    SD_Set_Path_Get_Dir(GET_DIR)
    SD_Drive=2
    SD_Dir_Counter=0
end sub
#endif

