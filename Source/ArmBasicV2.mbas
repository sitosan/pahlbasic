  in_build_functions as key2element[in_build] = ("Rgb", "Rgb2", "Peek", "Size", "Open", "Fileptr", "Eof", "Dir", "Testbit", "Pointer", "Midi", "Fourier", "Fmod", "Red", "Green", "Blue", "Attrib", "Choice")   'max 8 Zeichen
