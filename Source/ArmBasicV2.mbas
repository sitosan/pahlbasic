sub procedure x15_10_service() iv IVT_INT_EXTI15_10 ics ICS_AUTO               ' EXT-Int (Eingang 11-16 - Interrupt)  Touch-Eingang=16
    if EXTI_PR.15 = 1 then                                                     ' Interrupt 15?  TOUCH
       EXTI_PR.15 = 1
       #ifdef 407ZG then
       if osk_started then                                                     ' osk gestartet?
          if osk_invisible then                                                ' virtuelles keyboard unsichtbar?
             if T_IRRPT=0 then                                                 ' Interrupt wird auch bei steigender Flanke ausgeführt
                if pmode=1 then                                                ' im Programm?
                   put_char_in_buffer(3, konsole_uart)                         ' ctrl-c, wenn Programm läuft, wenn osk invisible
                else                                                           ' im Kommando-Modus, osk wieder auf den Screen
                    osk_invisible=0
                    TFT_CLS(0)
                    Start_TP()                                                 ' OSK wieder auf den Schirm
                    print_prompt(1)
                end if
             end if
          else                                                                 ' virtuelles keyboard sichtbar?
              Check_TP()                                                       ' OSK abfragen
          end if
       else
           if inputdelay_tme[5] > 44 then                                      ' Touch-Totzeit
              inputdelay_tme[5] = 0
           end if
           if inputdelay_tme[5] < 1 then
              inputdelay_tme[5] = 3
              EXTI_IMR.15 = 0                                                  ' Touch-Interrupt ausschalten
              int_helper(15)                                                   ' On-Interrupt ausführen
           end if
       end if
       #else
       if inputdelay_tme[5] > 44 then
          inputdelay_tme[5] = 0
       end if
       if inputdelay_tme[5] < 1 then
          inputdelay_tme[5] = 3
          EXTI_IMR.15 = 0
          int_helper(15)
       end if
       #endif
    end if
end sub

sub procedure ADC_request() iv IVT_INT_ADC ics ICS_AUTO                        ' ADC-Interrupt
    #ifndef 411 then
    if EOC2_Bit    = 1 then                                                    ' Recording
       EOC2_Bit    = 0
       record_ptr^ = ADC2_DR -32768                                            ' Recording-Sample speichern
       wave_counter=(wave_counter +v_c) and 1023
    end if
    #endif
    if AWD_BIT   = 1 then                                                      ' Analog-Watchdog?
       AWD_BIT   = 0                                                           ' Auslöser zurücksetzen / maskieren
       AWDEN_Bit = 0
       int_helper(8)                                                           ' Interrupt-Prozedur
       AWDEN_Bit = 1
    end if
    if EOC_Bit   = 1 then                                                      ' Sample?
       EOC_Bit   = 0                                                           ' Auslöser zurücksetzen
       #ifndef 411 then
       adc_kanal = word(ADC1_SQR3 -10)                                         ' Speicherkanal aus Samplekanal ermitteln F407
       #else
       adc_kanal = word(ADC1_SQR3 -08)                                         ' Speicherkanal aus Samplekanal ermitteln F411
       #endif
       poti_werte[adc_kanal][sample_counter[adc_kanal]] = ADC1_DR              ' Wandlerwert speichern
       inc(sample_counter[adc_kanal])                                          ' nächste Speicherposition
       if sample_counter[adc_kanal] > 15 then                                  ' 16 Speicherkanäle
          sample_counter[adc_kanal] = 0
       end if
    end if
end sub

#ifndef 411 then
sub procedure RTC_Alarm() iv IVT_INT_RTC_Alarm ics ICS_AUTO                    ' automatische Sommer-/Winterzeit-Umschaltung (RTC-ALARM A&B)
#else
sub procedure RTC_Alarm() iv IVT_INT_EXTI17_RTC_ALARM ics ICS_AUTO             ' automatische Sommer-/Winterzeit-Umschaltung (RTC-ALARM A&B)
#endif
    EXTI_PR.17 = 1   'OK
    if testbit(RTC_BKP5R,15) = 0 then                                                   ' Automatik nicht aktiv !
       if ALRAF_Bit = 1 then                                                   ' Alarm A
          DBP_ON
          ALRAF_Bit = 0                                                        ' Alarm A aus
          DBP_OFF
          int_helper(18)
       end if
       if ALRBF_Bit = 1 then                                                   ' Alarm B
          DBP_ON
          ALRBF_Bit = 0                                                        ' Alarm B aus
          DBP_OFF
          int_helper(19)
       end if
    else                                                                       ' automatische Sommerzeit-/Winterzeit-Umschaltung aktiv!
        if ALRAF_Bit = 1 then                                                  ' Alarm A  Sonntag 3 Uhr?  Winterzeit!
           DBP_ON                                                              ' Backup Domain zugänglich machen
           ALRAF_Bit = 0                                                       ' Alarm A aus
           DBP_OFF
           if get_months(0)   = 10 then                                        ' Oktober?
              if get_days(0)  > 24 then                                        ' nach dem 24.Oktober?
                 twoAclock=1                                                   ' 2 Uhr A -> 2 Uhr B
                 if testbit(RTC_CR,18)=1 then                                  ' Zeit noch nicht umgestellt?
                    change_daylight_saving(0)
                 end if
              end if
           end if
           exit
        end if
        if ALRBF_Bit = 1 then                                                  ' Alarm B  Sonntag 2 Uhr?  Sommerzeit!
           DBP_ON
           ALRBF_Bit = 0                                                       ' Alarm B aus
           DBP_OFF
           if get_months(0)   = 03 then                                        ' März?
              if get_days(0)  > 24 then                                        ' nach dem 24.März?
                 if testbit(RTC_CR,18)=0 then                                  ' Zeit noch nicht umgestellt?
                    change_daylight_saving(1)
                 end if
              end if
           end if
        end if
    end if
end sub

sub function crc16_modbus(dim puchMsg as ^char, dim usDataLen as byte) as word  ' Modbus CRC  braucht zusätzlich 512 Bytes vorausberechnete Werte
dim uchCRCHi, uchCRCLo as char volatile
dim uIndex             as byte volatile

    uchCRCHi = 0xFF   uchCRCLo = 0xFF
    while usDataLen
          uIndex    = uchCRCLo xor puchMsg^
          puchMsg   = puchMsg+1
          uchCRCLo  = uchCRCHi xor auchCRCHi[uIndex]
          uchCRCHi  = auchCRCLo[uIndex]
          usDataLen = usDataLen-1
    wend
    result          = (uchCRCHi<<8) or uchCRCLo
end sub

sub function gps_checksum_ok as word
dim n, longo                           as word volatile
dim gps1, gps2, gps_comp, gps_checksum as byte volatile

    longo=length(gps_sentence)
    gps1=get_hex(gps_sentence[longo-2])   gps2=get_hex(gps_sentence[longo-1])   result=0
    if longo < 10                    then  exit end if
    if gps_sentence[0] <> "$"        then  exit end if                         ' GPS-Start
    if gps_sentence[longo -3] <> "*" then  exit end if                         ' Es folgt Checksumme
    if (gps1=0) or (gps2=0)          then  exit end if                         ' keine Hex-Zahl
    gps_checksum=(gps1<<4) or gps2                                             ' Nibbles zu Byte zusammensetzen
    gps_comp=0
    for n=1 to longo-4                                                         ' Eigentliche Check-Summe
        gps_comp=gps_comp xor gps_sentence[n]
    next n
    if gps_checksum=gps_comp then                                              ' Vergleichen
       result=0xFFFF
    end if
end sub

