                  ser_zeiger=0   nn = get_one_konsole_byte
           end select

      case "6"
           cnl  cwt("Contents of the Textarray:")  cnl
           nn=0   wres = textmax/textlines
           while (nn < wres) and  (ccm_ram_read_byte(wres * nn) > 0)
                 mm=0
