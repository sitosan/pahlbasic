sub procedure clear_adc
dim n, m as word volatile

    for m=0 to 3
        for n=0 to 15
            poti_werte[m][n]=0
        next n
        sample_counter[m]=0
    next m
    #ifndef 411 then
    adc_channel=10
    #else
    adc_channel=08
    #endif
end sub

sub procedure init_adc1                                                        ' Analog-Digital-Wandler einschalten
    clear_adc
    adc1_init  Scan_Bit=1
    NVIC_IntEnable(IVT_INT_adc)                                                ' Interrupt starten
    EOCIE_Bit=1
end sub

