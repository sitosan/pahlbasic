        if ser2_zeiger < fifo2 then  inc(ser2_zeiger) end if
        if konsole_uart=2 then                                                 ' Konsole auf com2?
           mvar = mvar2
           ser_zeiger = ser2_zeiger
           if mvar=3 then  perror = maxerror  get_one_midi_byte end if
        end if
        if onbuf2=1 then                                                       ' on buf2 ?
           int_helper(10)                                                      ' Interrupt-Nr. 10
        end if
    end if
end sub
#endif

