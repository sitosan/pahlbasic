#ifdef 411 then                                                                ' doch 411
sub function get_one_midi_byte() as byte                                       ' holt ein Zeichen aus dem MIDI-Empfangspuffer com2
dim loopd as byte volatile

    if gps_on=1 then  exit  end if
    if ser2_zeiger=0  then  result=0  exit end if
    loopd=0                                                                    ' loopcounter to bottom of buffer
    result = recstr2[0]                                                        ' take the lowest byte
    do                                                                         ' lifo
      recstr2[loopd] = recstr2[loopd +1]                                       ' shift right receive buffer one byte
      inc(loopd)                                                               ' next byte
    loop until loopd = ser2_zeiger                                             ' last received byte?
    dec(ser2_zeiger)                                                           ' receive write pointer -1
end sub

sub function get_one_gps_byte() as byte                                        ' holt ein Zeichen aus dem GPS-Empfangspuffer com2
dim loopd as byte volatile

    if ser2_zeiger=0 then  result=0  exit end if
    loopd=0                                                                    ' loopcounter to bottom of buffer
    result = recstr2[0]                                                        ' take the lowest byte
    do                                                                         ' lifo
      recstr2[loopd] = recstr2[loopd +1]                                       ' shift right receive buffer one byte
      inc(loopd)                                                               ' next byte
    loop until loopd = ser2_zeiger                                             ' last received byte?
    dec(ser2_zeiger)                                                           ' receive write pointer -1
end sub
#endif

sub function position(dim pos as word, dim sbyte, delim as byte) as word       ' nach beliebigem Byte in Progline suchen
    while progline[pos] <> sbyte
          if (progline[pos]=0) or (progline[pos] = delim) then  result=0 exit end if
          inc(pos)
    wend
    inc(pos)                                                                   ' Ziel ist hinter dem Gesuchten
    result = pos
end sub

sub function position2(dim pos as word, dim sbyte as byte) as word             ' nach beliebigem Byte rückwärts in Progline suchen
    while pos
          if progline[pos] = sbyte then  result=pos +1 exit end if             ' Ziel ist hinter dem Gesuchten
          dec(pos)
    wend
    result = 0
end sub

sub function equal_sign(dim pos as word) as word                               ' nach Gleichheitszeichen in Progline suchen
    while true
          select case progline[pos]
            case 182,185,">","<"    inc(pos)  result=pos exit                  ' Ziel ist hinter dem Gesuchten
            case 0                  result=0             exit
            case 183,184            result=0  perror=2   exit
          end select
          inc(pos)
    wend
end sub

sub function komma(dim pos as word) as word                                    ' nach Komma in select_str und Variablenliste in Anweisungen suchen
    dim count_brackets as word volatile
    
    while progline[pos] <> ","
          select case progline[pos]
            case 0, "]", "}"   result=0 exit
            case "[", "(", "{"                                                 ' geöffnete Klammer?
                 count_brackets = 1
                 while count_brackets > 0                                      ' bis zum Klammer-Ende vor
                       inc(pos)
                       select case progline[pos]
                         case "[", "(", "{"  inc(count_brackets)               ' neue Klammer auf?
                         case "]", ")", "}"  dec(count_brackets)               ' Klammer zu?
                         case 34             inc(pos)                          ' Zeichenkette?
                              while progline[pos] <> 34  inc(pos)  wend
                       end select
                 wend
            case 34
                 inc(pos)                                                      ' Text in Anführungszeichen überspringen
                 while progline[pos] <> 34                                     ' bis zum Ende vor
                       inc(pos)
                 wend
          end select
          inc(pos)
    wend
    inc(pos)                                                                   ' Ziel ist hinter dem Gesuchten
    result = pos
end sub

sub function komma3 as word                                                    ' Komma-Position direkt hinter Berechnungen
    if progline[calc_pos1 +1] = "," then
       result = calc_pos1 +2                                                   ' Position hinter dem Komma
    else
        result = komma(calc_pos1 +1)                                           ' kein Komma? dann suchen!
    end if
end sub

sub function komma2 as word                                                    ' Komma-Position direkt hinter Berechnungen
    if progline[calc_pos1 +1] = "," then  
       result = calc_pos1 +2                                                   ' Position hinter dem Komma
    else
        result=0
    end if
end sub

sub function parenthesis as word                                               ' Klammer-Position direkt hinter Berechnungen
    if progline[calc_pos1 +1] = "}" then
       result = calc_pos1 +1                                                   ' Position auf der Klammer (passt einfach öfter)
    else                                                                       ' keine Klammer?
        result = position(calc_pos1,"}",0)                                     ' suchen
        if result>0 then                                                       ' gefunden!
           dec(result)                                                         ' Korrigieren
        end if
    end if
end sub

sub function parenthesis2(dim pos as word) as word                             ' nach geschweifter Klammer in Progline suchen
dim count_brackets as word volatile
    count_brackets=1
    while count_brackets>0
          select case progline[pos]
            case 34
                 inc(pos)
                 while progline[pos]<>34   inc(pos)   wend
            case "{"  
                 inc(count_brackets)
            case "}"
                 dec(count_brackets)
          end select
          inc(pos)
    wend
    result = pos                                                               ' Ziel ist hinter dem Gesuchten
end sub

sub function bracket(dim pos as word) as word                                  ' nach eckiger Klammer in Progline suchen
dim count_brackets as word volatile

    count_brackets=1
    while count_brackets>0
          select case progline[pos]
            case 34
                 inc(pos)
                 while progline[pos] <> 34   inc(pos)   wend
            case "["   
                 inc(count_brackets)
            case "]"  
                 dec(count_brackets)
          end select
          inc(pos)
    wend
    result = pos                                                               ' Ziel ist hinter dem Gesuchten
end sub

sub function bracket2(dim pos as word) as word                                 ' nach runder Klammer in Progline suchen
dim count_brackets as integer volatile

    count_brackets=1   result=0
    while (progline[pos]>0) and (progline[pos]<>182)
          select case progline[pos]
            case 34
                 inc(pos)
                 while progline[pos]<>34   inc(pos)   wend
            case "("
                 inc(count_brackets)
                 result=0
            case ")"
                 dec(count_brackets)
                 if count_brackets=0 then
                    result = pos  exit
                 end if
          end select
          inc(pos)
    wend
end sub

sub function bracket3(dim pos as word) as word                                  ' nach runder Klammer in listline suchen
dim count_brackets as word volatile
    count_brackets=1
    while count_brackets>0
          select case listline[actual_line][pos]
            case 34
                 inc(pos)
                 while listline[actual_line][pos] <> 34   inc(pos)   wend
            case "("
                 inc(count_brackets)
            case ")"
                 dec(count_brackets)
          end select
          inc(pos)
    wend
    result = pos                                                               ' Ziel ist hinter dem Gesuchten
end sub

sub function isfunc(dim pos as word)as word                                    ' auf math. Funktion prüfen
    if (progline[pos]>239) or ((progline[pos]>2) and (progline[pos]<11)) or (progline[pos]=18) or (progline[pos]=24) then  ' inkl. fnX()
       result=0xFFFF
    else
        result=0
    end if
end sub

sub function getline(dim pos as longword) as word                              ' Zeilen-Nummer auslesen (aus progline)
dim n as word volatile

    result=0  n=0
    while (n < 5) and isziff(pos)                                              ' Programmzeilennummer max 5 Stellen
          result = (result *10) + progline[pos] -48                            ' errechne zeilennummer
          inc(pos)
          inc(n)
    wend
    l_resultat = pos
end sub

sub function is_not_delim(dim pos as word) as word                             ' auf Trennzeichen in progline prüfen
    select case progline[pos]
      case 0, "]", "=", "}", ",", ";", "[", "_", "&", 92, 105, 104, 119, 118, 139, "#", "{", 120, 106, 117
           result=0
      case else
           result=0xFFFF
    end select
end sub

sub function isdelim(dim pos as word) as word                                  ' auf Trennzeichen in pstr prüfen
    select case pstr[pos]
      case 0, 9, 32, ",", ";", "."
           result=0xFFFF
      case else
           result=0
    end select
end sub

sub function iskomma(dim pos as word) as word                                  ' auf Komma prüfen
    if progline[pos] = ","  then
       result=0xFFFF
    else
        result=0
    end if
end sub

sub function isziff(dim pos as word) as word                                   ' auf Ziffer Prüfen
    result = word(isdigit(progline[pos]))
end sub

sub function ishex(dim pos as ^char) as word                                   ' im Programmtext auf Hex-Ziffer Prüfen
    result=0
    if (pos^ > 47) and (pos^ < 58) then  result=0xFFFF  exit  end if
    if (pos^ > 64) and (pos^ < 71) then  result=0xFFFF        end if
end sub

sub function isvar(dim pos as word) as word                                    ' auf num. Variable A-Z und NamesVar prüfen
    if ((progline[pos] > 64) and (progline[pos] < 91)) or (progline[pos] = "$") then
       result=0xFFFF
    else
        result=0
    end if
end sub

sub function isvar2(dim pos as word) as word                                   ' auf num. Variable A-Z prüfen
    if ((progline[pos]>64) and (progline[pos]<91))  then
       result=0xFFFF
    else
        result=0
    end if
end sub

sub function islocalvar(dim pos as word) as word                               ' auf num. lokale Variable A-J prüfen
    if (progline[pos]>64) and (progline[pos]<75) then
       result=0xFFFF
    else
        result=0
    end if
end sub

sub function isvar3(dim pos as word) as word                                   ' auf num. Variable A-L, P, S, Z prüfen
    if ((progline[pos]>64) and (progline[pos]<77)) or (progline[pos]="P") or (progline[pos]="S") or (progline[pos]="Z") then
       result=0xFFFF
    else
        result=0
    end if
end sub

sub function isTarray(dim pos as word) as word                                 ' auf Textarray prüfen
    if (progline[pos]=25) and (progline[pos +1]="{") then
       result=0xFFFF
    else
        result=0
    end if
end sub

sub function isstr(dim pos as word) as word                                    ' auf String Variable prüfen
    if ((progline[pos]>192) and (progline[pos]<201)) then
       result=0xFFFF
    else
        result=0
    end if
end sub

sub function isstr2(dim pos as word) as word                                   ' auf String oder Textarray prüfen
    if isstr(pos) or isTarray(pos) then
       result=0xFFFF
    else
        result=0
    end if
end sub

sub function is_any_str(dim pos as word) as word                               ' jede Art String
    if isstr(pos) or isTarray(pos) or (progline[pos]=34) then
       result=0xFFFF
    else
        result=0
    end if
end sub

sub function isport(dim pos as word) as word                                   ' auf Systemvariable prüfen für calculation_exp
    if ((progline[pos]>200) and (progline[pos]<240)) then                      ' exklusive inkey
       result=0xFFFF
    else
        result=0
    end if
end sub

sub function issign2(dim pos as word)as word                                   ' auf diverse numerische Zeichen prüfen für select_str
    select case progline[pos]
      case "-", "+", "@", 16, 22, "!", 161, 191, 99, 100, 101, 130             ' mit '->' aber ohne Anführungszeichen
           result=0xFFFF
      case else
           result=0
    end select
end sub

sub function issign1(dim pos as word)as word                                   ' auf diverse numerische Zeichen prüfen für select_str  ohne '->'
    select case progline[pos]
      case "-", "+", "@", 16, "!", 161, 191, 99, 100, 101, 130                 ' ohne '->' und ohne Anführungszeichen
           result=0xFFFF
      case else
           result=0
    end select
end sub

sub function issign(dim pos as word)as word                                    ' auf diverse numerische Zeichen prüfen für get_parameters
    select case progline[pos]
      case "-", "+", "@", 16, 22, "!", 161, 191, 99, 100, 101, 130             ' mit '->'
           result=0xFFFF
      case 34
           if progline[pos +2] = 34 then  result=0xFFFF  else  result=0  end if   ' einzelnes Zeichen in Anführungszeichen
      case else
           result=0
    end select
end sub

sub function whatvar_ID(dim pos as word, dim set_mode as word) as word            ' Variablentyp ermitteln
dim toke    as word volatile
dim a_index as word volatile
dim b_index as word volatile
dim merkpos as word volatile

    toke = progline[pos]    result=0
    if (toke>64) and (toke<91) then                                            ' Variablen   65...90
       if progline[pos +1] = "[" then                                          ' Arrays
          a_index = calculate_exp(pos +2)
          merkpos = komma2
          if toke<75 then
             if a_index>array_max_min1 then  result=0  perror=21  exit end if
             result = a_index + ((toke -65) * array_max) + 10000                ' 10000...14999
          else
              if toke = "S"  then                                              ' Sound-Array
                 if a_index>1023 then result=0  perror=21  exit end if
                 result = a_index + 2000                                       ' 2000...3023
              else
                  if toke = "Z"  then                                          ' Backup-RAM-Array
                     if a_index>399 then  result=0  perror=21  exit end if
                     result = a_index + 5000                                   ' 5000...5499
                  else
                      if toke = "P"  then                                      ' Farbpalette
                         if a_index>63 then  perror=21  result=0  exit end if
                         result = a_index + 6000                               ' 6000...6063
                      else
                          if toke = "L"  then                                  ' LED - Farben
                             if merkpos then
                                b_index = word(calculate_exp(merkpos))
                                if a_index>31 then  perror=21  result=0  exit end if
                                if b_index>7  then  perror=21  result=0  exit end if
                                if (a_index mod 2) = testbit(RTC_BKP5R,13) then          ' <-- is this OK in Basic? ----------------
                                   result = b_index + (a_index * 8) + 7000     ' 7000...7255
                                else
                                    result = (7 - b_index) + (a_index * 8)  + 7000
                                end if
                             else
                                 if a_index>255 then  perror=21  result=0  exit end if
                                 result = a_index + 7000
                             end if
                          else
                              if toke="K"  then                                ' Array K()
                                 if merkpos then
                                    b_index = calculate_exp(merkpos)
                                    if a_index>9   then  result=0  perror=21  exit end if
                                    if b_index>array_max_min1  then  result=0  perror=21  exit end if
                                    result = b_index + (a_index * array_max) + 10000
                                 else
                                     if a_index>4999  then  result=0  perror=21  exit end if
                                     result = a_index + 10000                   ' 10000...14999
                                 end if
                              else
                                  result=0
                              end if
                          end if
                      end if
                  end if
              end if
          end if
       else
           result = toke  exit
       end if
    end if
    if (toke>192) and (toke<201) then  result = toke + 9000   exit end if      ' Strings   9192...9200
    if (toke>200) and (toke<241) then  result = toke          exit end if      ' System-Variablen 201...240
    #ifndef 411 then
    if toke=25  then                                                           ' Text-Array
       a_index = calculate_exp(pos +2)
       if a_index>127 then  perror=21  result=0 exit end if
       result = a_index + 9000                                                 ' 9000...9127
       exit
    end if
    #endif
    if toke = "$" then                                                         ' named Variables  ##################################
       if int_marker then  exit end if
       w_resultat = get_varname(pos +1)
       a_index = search_variable                                               ' globale Variable?
       if a_index<99 then                                                      ' 99=Var-Speicher voll (32 Variablen)
          result = a_index + 8000 exit                                         ' 8000...8023
       else
           if set_mode then
              new_variable(0.0)                                                ' neue globale Variable im Hauptprogramm
              if perror then  exit end if
              a_index = varname_zeiger -1
              result  = a_index + 8000 exit
           else
               perror=13  sys(wvariable,0) exit
           end if
       end if
    end if
end sub

sub function whatvar_adres(dim pos as word, dim set_mode as word) as word      ' ermittelt Adresse von Variablen, Prog.zeilen, Zeichenketten in pstr
dim toke                 as word    volatile
dim indx2                as longint volatile
dim indx, indx3, merkpos as word    volatile
dim strpointer           as ^char   volatile

    toke = progline[pos]   w_resultat=0   l_resultat=0   result = pos          ' indx = 0
    if (toke>64) and (toke<91) then                                            ' Variablen
       if progline[pos +1] = "[" then                                          ' Arrays
          result = bracket(pos +2) -1
          indx = word(calculate_exp(pos +2))
          merkpos = komma2
          if toke<75 then                                                      ' A...J
             w_resultat=8
             if merkpos=0 then
                if indx>array_max_min1  then perror=21  l_resultat=0  exit end if
                l_resultat = array_ram_pointer + ((toke -65) * array_max_bytes) + (indx * 8)   s_resultat = array_max - indx exit
             else
                 perror=2  sys("no comma",0)  exit
             end if
          else
              if toke = "S" then                                               ' Sound-Array
                 #ifndef 411 then
                 w_resultat=2
                 if indx>1023 then  perror=21  l_resultat=0 exit end if
                 l_resultat = @soundbuffer + indx  s_resultat = 1024 - indx
                 #else
                 perror=13 exit
                 #endif
              else
                  if toke = "Z"  then                                          ' Backup-RAM-Array
                     #ifndef 411 then
                     w_resultat=8
                     if indx>399 then  perror=21  l_resultat=0  w_resultat=8 exit end if
                     l_resultat = backup_ram_start + longword(indx * 8)   s_resultat = 400 - indx
                     #else
                     perror=13 exit
                     #endif
                  else
                      if toke = "P" then                                       ' Farbpalette
                         w_resultat=4
                         if indx > (colormax -1) then  perror=21  l_resultat=0 exit end if
                         l_resultat = @cl_palette + indx    s_resultat = colormax - indx  exit
                      else
                          if toke = "L"  then                                  ' LED-Farben
                             w_resultat=4
                             if merkpos then
                                indx3 = word(calculate_exp(merkpos))
                                if (indx * 8 + indx3) > 255 then  perror=21 exit end if
                                if (indx mod 2) = testbit(RTC_BKP5R,13) then     ' <-- is this OK in Basic? ------------
                                   l_resultat = @led_farben[0] + (indx * 8) + indx3     ' ##################ändern+++++++++++++++++++++++++
                                else
                                    l_resultat = @led_farben[0]  + (indx * 8)  + (7 - indx3)
                                end if
                                s_resultat = led_anzahl - (indx * 8 + indx3)
                             else
                                 if indx > 255  then  perror=21 exit end if
                                 l_resultat = @led_farben[0] + indx   s_resultat = led_anzahl - indx
                             end if
                             exit
                          else
                              if toke = "K"  then
                                 w_resultat=8
                                 if merkpos then
                                    indx3 = word(calculate_exp(merkpos))
                                    if indx3>array_max_min1  then  perror=21  l_resultat=0  w_resultat=8 exit end if
                                    if indx>9                then  perror=21  l_resultat=0  w_resultat=8 exit end if
                                    l_resultat = array_ram_pointer + longword(indx * array_max_bytes) + longword(indx3 * 8)   s_resultat = 5000 - (indx * array_max + indx3)
                                 else
                                     if indx>4999  then  perror=21  l_resultat=0  exit end if
                                     l_resultat = array_ram_pointer + longword(indx * 8)   s_resultat = 5000 - indx
                                 end if
                                 exit
                              else
                                  l_resultat=0
                              end if
                          end if
                      end if
                  end if
              end if
          end if
       else
           l_resultat = @varfloat[toke -65]   w_resultat=8
           exit
       end if
    end if
    if toke=34 then
       if progline[pos +1] = "f" then                                          ' Label-Adressen - func
          if progline[pos +2] = "u" then
             if progline[pos +3] = "n" then
                if progline[pos +4] = "c" then
                   if progline[pos +5] = ":" then
                      result = position(pos +1,34,0) - 1
                      w_resultat = result - pos -6
                      l_resultat = get_label_adress(pos +6, 4, w_resultat)  ' func
                      exit
                   end if
                end if
             end if
          end if
       end if
       if progline[pos +1] = "s" then                                          ' Label-Adressen - sub
          if progline[pos +2] = "u" then
             if progline[pos +3] = "b" then
                if progline[pos +4] = ":" then
                   result = position(pos +1,34,0) - 1
                   w_resultat = result - pos -5
                   l_resultat = get_label_adress(pos +5, 5, w_resultat)     ' sub
                   exit
                end if
             end if
          end if
       end if
       if progline[pos +1] = "p" then                                          ' Label-Adressen - proc
          if progline[pos +2] = "r" then
             if progline[pos +3] = "o" then
                if progline[pos +4] = "c" then
                   if progline[pos +5] = ":" then
                      result = position(pos +1,34,0) - 1
                      w_resultat = result - pos -6
                      l_resultat = get_label_adress(pos +6, 6, w_resultat)  ' proc
                      exit
                   end if
                end if
             end if
          end if
       end if
       l_resultat = (@progline) + pos +1
       result = position(pos +1,34,0) -1
       w_resultat =  result - pos -1
       exit
    end if
    if toke=35  then
       l_resultat = (@progline) + pos +1
       result = position(pos +1,35,0) -1
       w_resultat =  result - pos -1
       exit
    end if
    if isziff(pos) then  toke = getline(pos)  result = l_resultat -1   l_resultat = get_line_adress(toke, prog_mem) exit end if   ' Zeilennummer
    #ifndef 411 then
    if toke=25  then                                                           ' Text-Array
       result = position(pos +2, "}",0) -1
       indx = longword(calculate_exp(pos +2))
       if indx>127 then  l_resultat=0  perror=21 exit end if
       l_resultat = ccm_ram_start + (indx * 128)                               ' Stringelement
       strpointer = l_resultat  w_resultat = length(strpointer)                ' Zeiger auf Stringanfang, Stringlänge
       pos = komma2
       if pos=0 then  exit end if
       indx2 = longint(calculate_exp(pos))
       merkpos = komma2
       if calc_pos1 > result then  result = parenthesis end if
       if (indx2>127) then  perror=21  sys(str_element,0)  pr(indx2,5) exit end if
       if indx2=0 then                                                         ' virtuelles Zeichen T(x, 0)
          if w_resultat>0 then
             indx2 = w_resultat +1
          else
             indx2=1
          end if
       end if
       if indx2<0 then                                                         ' negativer Index (von rechts)
          indx2 = w_resultat + indx2 +1
          if indx2 <= 0 then  perror=21  sys(str_element,0)  pr(indx2,5) exit end if
       end if
       l_resultat = l_resultat + indx2 -1                                      ' Zeiger auf einzelnes Zeichen
       if merkpos then
          w_resultat = word(calculate_exp(merkpos))                            ' Stringlänge
          if calc_pos1 > result then result = parenthesis  end if
       else
           w_resultat=1                                                        ' einzelnes Zeichen, Länge = 1
       end if
       exit
    end if
    #endif
    if (toke>192) and (toke<201) then                                          ' Strings
       l_resultat = @varstr[toke -193]                                         ' Adresse der Stringvariablen
       strpointer = l_resultat  w_resultat = length(strpointer)                ' Zeiger auf Stringanfang, Stringlänge
       if progline[pos +1] = "{" then
          result = position(pos +2, "}",0) -1
          indx2 = longint(calculate_exp(pos +2))                               ' Stringelement
          merkpos = komma2
          if (indx2>255) then  perror=21  sys(str_element,0)  pr(indx2,5) exit end if
          if indx2 = 0 then                                                    ' virtuelles Zeichen X$(0)
             if w_resultat then
                indx2 = w_resultat +1
             else
                 indx2 = 1
             end if
          end if
          if indx2 < 0 then                                                    ' negativer Index (von rechts)
             indx2 = w_resultat + indx2 +1
             if indx2 <= 0 then  perror=21  sys(str_element,0)  pr(indx2,5) exit end if
          end if
          l_resultat = l_resultat + indx2 -1                                   ' Adresse von Stringelement
          if merkpos then
             w_resultat = word(calculate_exp(merkpos))                         ' Stringlänge
             if calc_pos1 > result then  result = parenthesis end if
          else
              w_resultat=1                                                     ' einzelnes Zeichen
          end if
          exit
       else
           exit
       end if
    end if
    if toke = "$" then                                                         ' VARIABLEN mit Namen   ############################
       if int_marker then  exit end if
       w_resultat=8
       result = get_varname(pos +1)                                            ' Variablen-Namen aus Text holen
       indx3 = search_variable                                                 ' suchen in globaler Liste
       if indx3 < 99 then 
          l_resultat = var_ram_start + (indx3 * 8)  exit                       ' Globale Variable?  fertig!
       else                                                                    ' nicht gefunden?
           if set_mode then                                                    ' set aktiviert?
              new_variable(0.0)                                                ' dann anlegen!
              if perror then  exit end if
              indx3 = varname_zeiger -1                                        ' Index berechnen
              l_resultat = var_ram_start + (indx3 * 8)  exit
           else
               l_resultat=0  perror=13  sys(wvariable,0)  pr(pos,5) exit
           end if
       end if
    end if                                                                     ' ###################################################
    if toke=29  then  l_resultat = @varstr[9]  w_resultat = length(varstr[9])  exit end if  ' result$
    if toke=228 then  l_resultat = @relay      w_resultat = 2                  exit end if  ' relay
    if toke=232 then  l_resultat = @diginput   w_resultat = 2                  exit end if  ' diginp
end sub

sub function what_contens_has_this_adress(dim adres as longword) as word
dim ptr1, ptr2 as longword volatile

    if (adres >= longword(prog_mem)) and (adres < longword(prog_mem + progmax)) then
       if progend < (prog_mem +6) then perror = 22  sys(noprog,0)  exit end if
       if adres=0 then
          result=11 exit                                                       ' 11=Programmzeile0
       end if
       if bpointer(adres -1) = 0 then
          if bpointer(adres +4) = 130 then
             if bpointer(adres +5) = 4 then                                    ' 12=function?
                result=12 exit
             end if
             if bpointer(adres +5) = 5 then                                    ' 13=sub?
                result=13 exit
             end if
             if bpointer(adres +5) = 6 then                                    ' 14=proc?
                result=14 exit
             end if
          end if
          result=11 exit                                                       ' 11=Programmzeile?
       end if
    end if
    ptr1 = @progline   ptr2 = @pstr
    if (adres = ptr1) or (adres = ptr2) then  result=8 end if
    ptr1 = @varfloat[0]   ptr2 = @varfloat[26]
    if (adres >= ptr1) and (adres < ptr2) then
       result=1 exit                                                           ' 1=NumVar
    end if
    if (adres >= var_ram_pointer) and (adres < (var_ram_pointer +192)) then
       result=2 exit                                                           ' 2=NamedVar
    end if
    if (adres >= array_ram_pointer) and (adres < array_ram_ende) then          ' 3=ArrayElement
       result=3 exit
    end if
    #ifndef 411 then
    if (adres >= backup_ram_start) and (adres <= backup_ram_end) then          ' 7=Array Z
       result=7 exit
    end if
    #endif
    ptr1 = @led_farben[0]    ptr2 = @led_farben[255]                           ' 4=Array L
    if (adres >= ptr1) and (adres <= ptr2) then
       result=4 exit
    end if
    ptr1 = @cl_palette[0]    ptr2 = @cl_palette[63]                            ' 5=Array P
    if (adres >= ptr1) and (adres <= ptr2) then
       result=5 exit
    end if
    #ifndef 411 then
    ptr1 = @soundbuffer[0]   ptr2 = @soundbuffer[1023]                         ' 6=Array S
    if (adres >= ptr1) and (adres <= ptr2) then
       result=6 exit
    end if
    #endif
    ptr1 = @varstr[0]        ptr2 = @varstr[9]                                 ' 8=StringVar
    if (adres >= ptr1) and (adres <= ptr2) then
       result=8 exit
    end if
    #ifndef 411 then
    ptr1 = ccm_ram_start     ptr2 = text_array_end                             ' 9=TextArray-String
    if (adres >= ptr1) and (adres <= ptr2) then
       result=9 exit
    end if
    #endif
    select case default_ptr_type                                               ' Nichts von den Obigen?
      case 0    result=15                                                      ' 15=Byte8
      case 1    result=16                                                      ' 16=Word16
      case 2    result=17                                                      ' 17=Longword32
      case 3    result=18                                                      ' 18=Float32
    end select
end sub

sub function get_var_list(dim pos, num as word) as word                        ' Variablenliste holen (nicht die Parameter) (Position, Schalter)
dim n, k as word volatile                                                      
                                                                               ' num = 1 numerisch
    result=0                                                                   ' num = 2 Strings
    while (progline[pos] > 0)                                                  ' num = 3 beides
          n = whatvar_ID(pos, 0)                                                  ' num = 4 alles
          if num<4 then
             if perror then  exit end if
             if num=2 then
                if (n<9000) or (n>9200) then
                   perror=24  exit
                end if
             end if
             if num=1 then    'testbit(num,1)=0 then
                if (n>8999) and (n<9201) then
                   perror=24  exit
                end if
             end if
          else
              perror=0
          end if
          para[result] = n  inc(result)
          k = komma(pos)
          if k then
             pos = k
          else
              exit
          end if
    wend
end sub

sub function get_var_adr_list(dim pos as word) as word                         ' Variablenadressen-Liste holen (nicht die Parameter) (Position, Schalter)
dim n as word volatile

    result=0
    if progline[pos] = "}" then  exit end if
    while progline[pos] > 0
          n = whatvar_adres(pos,1)    'prn(n)
          if l_resultat=0 then  perror=13  sys(wvariable,0) exit end if
          para[result]=0
          if n then
             if isvar(pos) then
                para[result]=1
             end if
             #ifndef 411 then
             if isstr2(pos) or (progline[pos] = 29) then
             #else
             if isstr(pos) or (progline[pos] = 29) then
             #endif
                 para[result]=2
             end if
             par[result] = extended(l_resultat)   inc(result)   'prn(l_resultat)
          end if
          if progline[n +1] = "," then
             pos = n +2
          else
              exit
          end if
    wend
end sub

sub function isoper(dim pos as word) as word                                   ' auf Operator prüfen
    select case progline[pos]
      case "+","-","*","/","<",">","^",181,182,183,184,185,186,187,188,189,190,15,21
           result=65535
      case else
           result=0
    end select
end sub

sub function isoper2(dim pos as word) as word                                  ' auf Abkürzungs-Operator prüfen
    if (progline[pos]>31) and (progline[pos]<50)  then
       result=65535
    else
        result=0
    end if
end sub

sub procedure clear_bkpram                                                     ' Backup-RAM löschen
dim n as longword volatile

    for n=0 to 399
        bkpram_write_float(0, n)
    next n
end sub

sub procedure clear_RTC_RAM                                                    ' RTC-RAM löschen
    DBP_ON
    memset(0x40002850,0,80)
    DBP_OFF
end sub

sub procedure clear_var                                                        ' num. Variablen löschen
dim n as longword volatile

    for n=0 to varmax -1   varfloat[n] = 0.0   next n
    for n=0 to 23  var_ram_write_float(0.0, n)  varname[n] = ""  next n        ' floatvar[n] = 0.0
    varname_zeiger=0
end sub

sub procedure clear_string                                                     ' Strings löschen
dim n as longword volatile

    for n=0 to strmax -1   clear_varstr(n)   next n
    #ifndef 411 then
    memset(ccm_ram_start, 0, textmax)
    #endif
    gps_string = ""
end sub

sub procedure clear_prog                                                       ' Programm löschen
    memset(@progstr, 0, 5)                                                     ' Progspeicher im RAM löschen
    prog_mem = @progstr   
    progend = prog_mem +2   
    frei = progmax - progend -3   progpointer = prog_mem   prgnr=0             ' freien Speicherplatz berechnen, Programmzähler auf Start
    programming_end=2                                                          ' Programm besteht nur aus 3 Nullen: 2 für Zeilen-Nummer 0, 1 für Zeileende
end sub

sub procedure frac(dim arg as float)                                           ' Funktion frac
    resultat = extended(fabs(arg - floor(arg)))
end sub

sub procedure round(dim arg as float)                                          ' Funktion round
    resultat = extended(floor(arg + 0.5))
end sub

sub function search_line(dim linenr as word) as longword                       ' Zeile suchen und ggfs löschen
dim k, m, pos, linetest as longword volatile

    k=0   result=0
    while k < programming_end -1
      pos = k
      linetest = (progstr[k +1] <<8) + progstr[k]
      k = k + 2                                                                'weiter bis hinter Zeilennummer
      if (linetest = linenr) then                                              'Zeilennummer gibt es schon?
          m=2                                                                  'Zeilennummer könnte null enthalten
          while progstr[k] >0                                                  'Zeilenende suchen
                inc(m)                                                         'Zeilenlänge -1
                inc(k)                                                         'Position im Programmspeicher
          wend
          k = pos
          while k < programming_end
             progstr[k] = progstr[k + m + 1]                                   'Zeile löschen durch Zusammenschieben
             inc(k)
          wend
          progstr[k] =0                                                        'neue Stringendemarke
          programming_end = programming_end - m -1                             'Programmende neu berechnen
          frei = progmax - programming_end                                     'freien Speicherplatz neu berechnen
          result = pos                                                         'neue Position im Programm
          exit
      end if
      if linetest > linenr then                                                'Zeilenposition am Anfang oder in der Mitte
         result = pos
         exit
      end if
      while progstr[k] >0                                                      'nächste Zeile suchen
            inc(k)
      wend
      inc(K)                                                                   'nächster Zeilenanfang
    wend
    if result=0 then                                                           'Zeilennummer nicht gefunden
       if linetest < linenr then
          result = programming_end -2                                          'neue Position also am Programmende
       end if
    end if
end sub

sub procedure insert_one_byte_prog(dim inbyte as byte)                         ' ein Zeichen einfügen
    dim k as longword volatile
    
    inc(programming_end)                                                       ' Programmendemarke 1 nach hinten
    k = programming_end
    progend = @progstr + programming_end
    while k  > programming_pointer                                             ' Platz machen - alles 1 byte nach hinten
          progstr[k] = progstr[k -1]
          dec(k)
    wend
    progstr[programming_pointer] = inbyte                                      ' byte einfügen
end sub

sub function isinstruction(dim pos as word) as word
    if ((progline[pos]>127) and (progline[pos]<161)) or ((progline[pos]>163) and (progline[pos]<175)) then
       result=65535
    else
        result=0
    end if
end sub

sub function store_command_as_progam(dim pr_pointer as ^char) as ^char
dim plen,n as word volatile

    plen=length(progline)
    pr_pointer^=1   inc(pr_pointer)                                            ' Zeilen-Nummer 1
    pr_pointer^=0   inc(pr_pointer)
    pr_pointer^=plen +4   inc(pr_pointer)                                      ' Zeilenlänge
    pr_pointer^=9   inc(pr_pointer)                                            ' Tab
    n=0
    while (progline[n]>0) and (n<240)                                          ' Kommandos
          pr_pointer^=progline[n]
          inc(pr_pointer)  inc(n)
    wend
    result=pr_pointer
    pr_pointer^=0   inc(pr_pointer)                                            ' Zeilen-Ende
    pr_pointer^=0   inc(pr_pointer)                                            ' Programm-Ende
    pr_pointer^=0   inc(pr_pointer)
    pr_pointer^=0
end sub

sub procedure store_line_rom(dim maxprg as longword)                           ' Programmzeile sequentiell im Programm ROM speichern
dim pos, tabulator, linenumber, plen  as word     volatile
    flstatus                          as longword volatile
    
    int2_off  FLASH_Unlock()  int2_on
    linenumber = getline(0)  pos = l_resultat
    int2_off  flstatus = FLASH_Write_Byte(programming_pointer_rom, lo(linenumber))  int2_on
    if flstatus then  flash_save_error exit end if
    inc(programming_pointer_rom)  inc(programming_end_rom)
    
    int2_off  flstatus = FLASH_Write_Byte(programming_pointer_rom, hi(linenumber))  int2_on
    if flstatus then  flash_save_error exit end if
    inc(programming_pointer_rom)  inc(programming_end_rom)
    tabulator=9
    while progline[pos]=9
          inc(pos)  inc(tabulator)
    wend
    plen=length(@progline[pos]) +5
    int2_off  flstatus = FLASH_Write_Byte(programming_pointer_rom, plen)  int2_on
    if flstatus then  flash_save_error exit end if
    inc(programming_pointer_rom)  inc(programming_end_rom)
    int2_off  flstatus = FLASH_Write_Byte(programming_pointer_rom, tabulator)  int2_on
    if flstatus then  flash_save_error exit end if
    inc(programming_pointer_rom)  inc(programming_end_rom)
    while (progline[pos]>0) and (pos<250)
          int2_off  flstatus = FLASH_Write_Byte(programming_pointer_rom, progline[pos])  int2_on
          if flstatus then  flash_save_error exit end if
          inc(programming_pointer_rom)  inc(programming_end_rom)  inc(pos)
    wend
    int2_off  flstatus = FLASH_Write_Byte(programming_pointer_rom, 0)  int2_on
    if flstatus then  flash_save_error exit end if
    inc(programming_pointer_rom)  inc(programming_end_rom)
    if programming_end_rom > maxprg then  flash_save_error exit end if
    int2_off  FLASH_Lock()  int2_on
end sub

sub procedure store_progend(dim pr_auto as word)
dim flstatus as  longword volatile
    
    int2_off  FLASH_Unlock()  int2_on
    int2_off  flstatus = FLASH_Write_Byte(programming_pointer_rom, 0)  int2_on
    if flstatus then  flash_save_error  exit end if
    inc(programming_pointer_rom)  inc(programming_end_rom)
    int2_off  flstatus = FLASH_Write_Byte(programming_pointer_rom, 0)  int2_on
    if flstatus then  flash_save_error  exit end if
    inc(programming_pointer_rom)  inc(programming_end_rom)
    int2_off  flstatus = FLASH_Write_Byte(programming_pointer_rom, 0)  int2_on
    if flstatus then  flash_save_error  exit end if
    'inc(programming_pointer_rom)  inc(programming_end_rom)
    int2_off  flstatus = FLASH_Write_Word(Prog_ROM_Start +100, longword(pr_auto))  int2_on       ' Programm vorhanden anzeigen
    if flstatus then  flash_save_error  exit end if
    int2_off  flstatus = FLASH_Write_Word(Prog_ROM_Start +104, programming_end_rom)  int2_on     ' Programmlänge
    if flstatus then  flash_save_error  exit end if
    int2_off  FLASH_Lock()  int2_on
end sub

sub procedure store_line                                                       ' Programmzeile Random im Programm RAM speichern
dim n, k, test, pos, lang as longword volatile
    linenumber            as longword volatile
    
    if isinstruction(0) or (perror > 0) then  exit end if                      ' nur instruktion?
    linenumber=0   n=0   pos=0  lang=0
    test = length(progline)
    linenumber = getline(0)  pos = l_resultat
    if linenumber>0 then  programming_pointer = search_line(linenumber)  contflag=0 end if    'Zeile suchen und löschen
    if test = pos   then  repl_flag=0 exit end if                              ' nur zeilennummer?
    tabulator=9
    while progline[pos]=9
          inc(pos)  inc(tabulator)
    wend
    if linenumber>0 then
       frei = progmax - programming_end
       if test - pos + 2 < frei then                                           ' passt Zeile in Programmspeicher?
          n = test
          if pmode=0 then
             if hiliting then
                TFT_Umbruch=1
                set_uart_konsole
                uart(13)  del_cursor  set_uart_color(3,0,0)  uart(">")  set_uart_color(6,0,0)  listcounter=0  listswitch =1
                print_format(linenumber,5)
                if tabulator>9 then
                   for k=10 to tabulator
                       send(32)  send(32)
                   next k
                end if
                send(32)  list_line(pos, 0)  listswitch=0   TFT_Umbruch=0
             end if
          end if
          while n >= pos
                insert_one_byte_prog(progline[n])                              ' Zeile einfügen
                dec(n) inc(lang)                                               ' Byte für Byte
          wend
          insert_one_byte_prog(tabulator and 63)                               ' Tabulator
          insert_one_byte_prog(lang +4)                                        ' Zeilenlänge
          insert_one_byte_prog(hi(linenumber))
          insert_one_byte_prog(lo(linenumber))                                 ' 2 Byte Zeilennummer
          perror=256                                                           ' ready-Meldung unterdruecken
       else
           perror=14                                                           ' out of memory error
       end if
    else
        perror=8                                                               ' linenumber = 0 error
    end if
    frei = progmax - programming_end                                           ' freien Speicherplatz neu berechnen
    clear_progline
    repl_flag=0
    if hiliting then
       sort_listline
    end if
end sub

sub procedure str_to_float                                                     ' Zeichenkette in Flieskommazahl wandeln
dim n, k, minus as longword volatile
dim mantissa    as uint64   volatile
dim factor      as extended volatile

    n=0   minus=0  factor=0   mantissa=0   pstr[17]=0
    if pstr0 = "-" then  n=1  minus=1 end if
    while (pstr[n]>47) and (pstr[n]<58)
          mantissa = 10 * mantissa
          mantissa = mantissa + pstr[n] -48
          inc(n)
    wend
    resultat = extended(mantissa)
    if pstr[n] = "." then
       k=0   inc(n)  mantissa=0
       while (pstr[n]>47) and (pstr[n]<58) and (k<7)
             mantissa = 10 * mantissa
             mantissa = mantissa + pstr[n] -48
             inc(k)   inc(n)
       wend
       select case k
         case 1    factor = 10 '.0
         case 2    factor = 100 '.0
         case 3    factor = 1000 '.0
         case 4    factor = 10000 '.0
         case 5    factor = 100000 '.0
         case 6    factor = 1000000 '.0
         case 7    factor = 10000000 '.0
       end select
       resultat = resultat + (extended(mantissa) / factor)
    end if
    if minus then resultat = resultat * (-1) end if
end sub

sub function bin_to_word  as longword                                          ' Binaerstring in Long-Word-Zahl umwandeln
dim n as word volatile

    n=0    result=0
    while (n<32) and (pstr[n]>47) and (pstr[n]<50)
          result   = result << 1
          result.0 = pstr[n] -48
          inc(n)
    wend
end sub

sub procedure upper                                                            ' Kleinbuchstaben in Grossbuchstaben wandeln
dim n as longword volatile

    n=0
    while pstr[n]>0
          if (pstr[n]>96) and (pstr[n]<123) then pstr[n] = pstr[n] -32 end if
          inc(n)
    wend
end sub

sub function get_hex(dim hstr as char) as byte
    result=0
    if (hstr>47) and (hstr<58) then result = hstr-48 end if
    if (hstr>64) and (hstr<71) then result = hstr-55 end if
end sub

sub function hex_to_word  as longword                                          ' hex-String in Long-Word-Zahl umwandeln
dim n as longword volatile

    n=0   result=0   upper
    while (n<8) and (pstr[n]>0)
          result = (result <<4) + get_hex(pstr[n])
          inc(n)
    wend
end sub

sub procedure noflags                                                          ' alle Flags fuer input ausschalten
    num_flag=0   bin_flag=0   hex_flag=0   strg_flag=0
end sub

sub procedure init_vars                                                        ' alle Interpreter-Variablen mit Startwerten laden
  #ifndef 411 then
  bkpram_pointer    = backup_ram_start                                         ' Zeiger auf Backup-RAM
  ccm_ram_pointer   = ccm_ram_start                                            ' Zeiger auf das CCM-RAM
  array_ram_pointer = array_ram_start                                          ' Zeiger auf das Array-RAM
  var_ram_pointer   = var_ram_start
  #else
  array_ram_pointer = longword(@array_space[0])
  var_ram_pointer   = longword(@name_var[0])
  #endif
  clear_buffers                                                                ' alle seriellen input buffer leeren
  calc_instance=0
  backsign=32
  mvar=0  contflag=1  debug_flag=1   task_nr=0   func_var_arg=0    func_var_res=0
  EXTI_IMR=0  EXTI_RTSR=0  EXTI_FTSR=0  EXTI_PR=4095   EXTI_SWIER=0
  #ifdef 407ZG then
  if osk_started then
     setbit(EXTI_IMR,15)
     setbit(EXTI_FTSR,15)
  end if
  #endif
  #ifdef VG then
  if osk_started then
     setbit(EXTI_IMR,15)
     setbit(EXTI_FTSR,15)
  end if
  #endif
  onbuf1=0    onbuf2=0     onbuf3=0     onbuf4=0    onbuf_usb=0    onbuf8=0   onbuf9=0   onerr=0
  int_marker  =0
  milli_int1  =0   milli_int2  =0   milli_int3  =0   milli_int4  =0
  milli1_timer=0   milli2_timer=0   milli3_timer=0   milli4_timer=0
  milli1_time =0   milli2_time =0   milli3_time =0   milli4_time =0
  lcd=0   pipe=0                                                               ' Ausgabe auf Terminal, 1 = lcd
  listcounter=0   listswitch=0   actual_line=0
  clear_listline
  flk=0                                                                        ' Flanke fuer on digx
  alarmtime=0                                                                  ' Zeitwert fuer on time
  merror=0   merrline=0                                                        ' merker fuer error
  executeflag=0                                                                ' flag fuer goto im directmode
  contadres=0                                                                  ' wiederaufnahme adresse fuer cont
  contflag_value=0                                                             ' Schalter für contflag
  contflag = contflag_value                                                    ' continue flag
  start_kom_flag=0                                                             ' start kommando aktiv
  pulsewith=10                                                                 ' systemvariable pulse schreiben  defaultwert = 1 sekunde
  cret_sup_flag=0                                                              ' merker zur unterdrueckung von carriage return bei print
  calc_flag=0                                                                  ' Schalter fuer tokenization der val-function - schaltet Syntax-Prüfung aus
  print_color=7                                                                ' Weiss
  noflags                                                                      ' schaltet alle Flags fuer input-routine aus
  dptr=0                                                                       ' Systemvariable für die Zeiger auf Anfang
  data_flag=0
  timerint=0
  listcounter=0
  hiliting = true
  modbus_bytes=4
  MIDI_offset=0
end sub

sub procedure print_line(dim ls as word)                                       ' Programmzeile ausdrucken
dim n as word volatile

    unl                                                                        ' Zeilenvorschub
    listcounter=0   clear_listline    listswitch=ls
    print_format((progline[1] <<8 ) + instr_byte, 6)                           ' Zeilennummer ausgeben
    if ((progline[2] and 63) >1) and ((progline[2] and 63) <9) then
       for n=2 to progline[2] and 63
           send(" ")  send(" ")
       next n
    end if
    if (progline[2] and 63) >8 then
       for n=10 to progline[2] and 63
           send(" ")  send(" ")
       next n
    end if
    send(32)
    list_line(3, 0)                                                            ' Rest der Zeile ausgeben
    listswitch=0
end sub

sub procedure init_info_screen
    TFT_Fill_Screen(TFT_Backcol)
    if use_palette then
       TFT_Set_Font(@TFT_defaultFont, 9, FO_HORIZONTAL)
       tft_write_constant_text(versionmeldung, 20, 20)
       TFT_Set_Font(@Arial21x24_Bold, 4, FO_HORIZONTAL)
       tft_write_constant_text("Info Screen", 100,50)
       TFT_Set_Pen(4, 1) TFT_Set_brush(0,0,0,0,0,0)  TFT_Rectangle(10, 80, 310, 237)
    else
        TFT_Set_Font(@TFT_defaultFont, CL_Palette[9], FO_HORIZONTAL)
        tft_write_constant_text(versionmeldung, 20, 20)
        TFT_Set_Font(@Arial21x24_Bold, CL_Palette[4], FO_HORIZONTAL)
        tft_write_constant_text("Info Screen", 100,50)
        TFT_Set_Pen(CL_yellow2, 1) TFT_Set_brush(0,0,0,0,0,0)  TFT_Rectangle(10, 80, 310, 237)
    end if
end sub

sub procedure info_screen
dim coleur, act_col, inact_col, stat_col, n, pos as word       volatile
dim txt                                          as string[5]  volatile

    init_clock(0)
    datestring(0)
    if use_palette then
       text_feld(20,210,15, 6)
    else
        text_feld(20,210,15, cl_palette[6])
    end if
    timestring(0)
    if use_palette then
       text_feld(218,210,10, 6)
    else
        text_feld(218,210,10, cl_palette[6])
    end if
    if pmode=0 then
       if use_palette then
          coleur=6   pstr = "Direkt"
       else
           coleur = cl_palette[6]   pstr = "Direkt"
       end if
    else
        if use_palette then
           coleur=4   pstr = "Prog"
        else
            coleur = cl_palette[4]   pstr = "Prog"
        end if
    end if
    text_feld(151,210,7,coleur)
    if use_palette then coleur = 6  else  coleur = cl_palette[6]  end if
    wordtostr(pwm1, txt)   pstr =  "Pwm1 " +  txt  text_feld(20,90,11,coleur)
    wordtostr(pwm2, txt)   pstr =  "Pwm2 " +  txt  text_feld(116,90,11,coleur)
    wordtostr(pwm3, txt)   pstr =  "Pwm3 " +  txt  text_feld(212,90,11,coleur)
'Zustand der dig. Eingänge
    if use_palette then
       act_col=2
       inact_col=5
       stat_col=4
    else
        act_col = cl_palette[2]
        inact_col = cl_palette[5]
        stat_col = cl_palette[4]
    end if
    if diginput.0 then pstr = "Dig1 *"  coleur = act_col  else pstr = "Dig1 -"  coleur = inact_col end if
    text_feld(20,120,6,coleur)
    if diginput.1 then pstr = "Dig2 *"  coleur = act_col  else pstr = "Dig2 -"  coleur = inact_col  end if
    text_feld(78,120,6,coleur)
    if diginput.2 then pstr = "Dig3 *"  coleur = act_col  else pstr = "Dig3 -"  coleur = inact_col  end if
    text_feld(136,120,6,coleur)
    if diginput.3 then pstr = "Dig4 *"  coleur = act_col  else pstr = "Dig4 -"  coleur = inact_col  end if
    text_feld(194,120,6,coleur)
    if diginput.4 then pstr = "Dig5 *"  coleur = act_col  else pstr = "Dig5 -"  coleur = inact_col  end if
    text_feld(252,120,6,coleur)
'Zustand der Relais
    #ifndef 411 then
    if testbit(relay,0) then pstr = "Rel1 *"  coleur = act_col  else pstr = "Rel1 -"  coleur = inact_col  end if
    #else
    if testbit(GPIOB_ODR,4) then pstr = "Rel1 *"  coleur = act_col  else pstr = "Rel1 -"  coleur = inact_col  end if
    #endif
    text_feld(20,150,6,coleur)
    #ifndef 411 then
    if testbit(relay,1) then pstr = "Rel2 *"  coleur = act_col  else pstr = "Rel2 -"  coleur = inact_col  end if
    #else
    if testbit(GPIOB_ODR,5) then pstr = "Rel1 *"  coleur = act_col  else pstr = "Rel1 -"  coleur = inact_col  end if
    #endif
    text_feld(78,150,6,coleur)
    #ifndef 411 then
    if testbit(relay,2) then pstr = "Rel3 *"  coleur = act_col  else pstr = "Rel3 -"  coleur = inact_col  end if
    #else
    if testbit(GPIOC_ODR,14) then pstr = "Rel1 *"  coleur = act_col  else pstr = "Rel1 -"  coleur = inact_col  end if
    #endif
    text_feld(136,150,6,coleur)
    #ifndef 411 then
    if testbit(relay,3) then pstr = "Rel4 *"  coleur = act_col  else pstr = "Rel4 -"  coleur = inact_col  end if
    #else
    if testbit(GPIOC_ODR,15) then pstr = "Rel1 *"  coleur = act_col  else pstr = "Rel1 -"  coleur = inact_col  end if
    #endif
    text_feld(194,150,6,coleur)
    #ifndef 411 then
    if testbit(relay,4) then pstr = "Rel5 *"  coleur = act_col  else pstr = "Rel5 -"  coleur = inact_col  end if
    text_feld(252,150,6,coleur)
    #endif
    if gps_string[gps_komma_pos(2) +1] = "A" then
       pstr = "GPS"    coleur = inact_col
       text_feld(20,180,5,coleur)
       pos = gps_komma_pos(3)
       pstr[0] = gps_string[pos +1]    pstr[1] = gps_string[pos +2]   pstr[2] = "*"  pstr[3] = 0
       text_feld(59,180,5,coleur)
       for n=0 to 7  pstr[n] = gps_string[pos +3 +n]  next n
       pstr[8] = "'"   pstr[9] = 0
       text_feld(97,180,10,coleur)
       pos = gps_komma_pos(5)
       pstr[0] = gps_string[pos +1]   pstr[1] = gps_string[pos +2]   pstr[2] = gps_string[pos +3]   pstr[3] = "*"   pstr[4] = 0
       text_feld(173,180,6,coleur)
       for n=0 to 7  pstr[n] = gps_string[pos +4 +n]  next n
       pstr[8] = "'"   pstr[9] = 0
       text_feld(220,180,10,coleur)
    else
        n = wait_gps
        pstr = "GPS Not Ready"   coleur = stat_col
        text_feld(20,180,15,coleur)
    end if
end sub

sub function insert_line_number(dim number as word) as word
dim n, m, numdetect as word      volatile
dim numstring       as string[6] volatile

    n=0   result=0   numdetect=0
    if (pstr0 = "/") and (pstr[1] = "/") then
       clear_pstr
       exit
    end if
    m=0
    while pstr[n]=32                                                           ' führende Spaces?
          inc(n)                                                               ' erstmal überspringen
          inc(m)
    wend
    while (pstr[n]>47) and  (pstr[n]<58)                                       ' Zeilen-Nummer?
          cut(n)                                                               ' dann entfernen
          numdetect=1                                                          ' und merken
    wend
    wordtostr(number, numstring)                                               ' neue Zeilen-Nummer
    if numdetect=1 then                                                        ' ## bereits Zeilen-Nummer da?
       for n=0 to m -1                                                         ' dann müssen die Spaces weg (sind ja vor der Zeilen-Nummer)
           cut(0)
       next n
       pstr = numstring + pstr                                                 ' neue Zeilen-Nummer vor die Restzeile setzen
    else                                                                       ' ## keine Zeilen-Nummer vorhanden?
        pstr = numstring + chr(32) + pstr                                      ' dann neue Zeilen-Nummer und 1 Space einfügen
    end if
    result = numdetect +1                                                      ' eingefügt melden
end sub

sub function tabs_to_spaces as word                                            ' entfernt Tabs in Anweisungen (nur für geladene Texte)
dim tabswitch as word volatile

    result=0  tabswitch=0
    while pstr[result]>0
          if (pstr[result]>96) and (pstr[result]<123) then  tabswitch=1 end if  ' Anweisung?
          if tabswitch then                                                    ' In Anweisung keine Tabs
             if pstr[result]=9 then  pstr[result]=32  end if                   ' Tabs in Spaces
          end if
          inc(result)
    wend
end sub

sub function spaces_to_tabs(dim change as byte, dim space_num as word) as word ' verwandelt Doppel-Spaces nach Zeilen-Nummer in Tabulatoren
dim n, count_spaces as word volatile

    n=0   result=0   count_spaces=0
    while pstr[n]=32                                                           ' führende Spaces?
          inc(n)                                                               ' überspringen
    wend
    while (pstr[n]=9)                                                          ' führende Tabs?
          pstr[n]=32                                                           ' durch Spaces ersetzen
          inc(n)
    wend
    while (pstr[n]>47) and (pstr[n]<58)                                        ' Zeilen-Nummer?
          inc(n)  inc(result)
    wend
    if result then
       while pstr[n]=32                                                        ' mehrfache Spaces durch Tabs ersetzen
             inc(count_spaces)
             if  count_spaces = space_num  then  pstr[n] = change  count_spaces=0  end if
             inc(n)
       wend
    end if
end sub

sub procedure xchange_char(dim char1,char2 as byte)                            ' markiert Spaces, die nicht entfernt werden sollen
dim n, varflag as word volatile

    n=0   varflag=0
    while pstr[n]>0
          if (pstr[n] = "§") and ((pstr[n +1] > 64) and (pstr[n +1] < 91)) then
             varflag=1   inc(n)  inc(n)
             while isalnum(pstr[n]) or (pstr[n] = "_")
                   inc(n)
             wend
          end if
          if (pstr[n] = char1) then
             if varflag=1 then
                pstr[n] = char2   varflag=0
             end if
          else
              varflag=0
          end if
          inc(n)
    wend
end sub

sub procedure put_char_in_buffer(dim b_char as char, dim intrfce_nmbr as word) ' Zeichen (b_char) in Empfangspuffer von Interface #intrfce_nmbr einfügen
    mvar=b_char   if mvar=3 then  perror=maxerror end if
    select case   intrfce_nmbr
      case 1,7    if ser1_zeiger>=fifo1 then  exit end if
                  recstr1[ser1_zeiger]=b_char  inc(ser1_zeiger)  ser_zeiger=ser1_zeiger
      case 2      if ser2_zeiger>=fifo2 then  exit end if
                  recstr2[ser2_zeiger]=b_char  inc(ser2_zeiger)  ser_zeiger=ser2_zeiger
      #ifndef 411 then
      case 3      if ser3_zeiger>=fifo3 then  exit end if
                  recstr3[ser3_zeiger]=b_char  inc(ser3_zeiger)  ser_zeiger=ser3_zeiger
      case 4      if ser4_zeiger>=fifo4 then  exit end if
                  recstr4[ser4_zeiger]=b_char  inc(ser4_zeiger)  ser_zeiger=ser4_zeiger
      case 5,6,9  if usb_zeiger>=usbfifo then exit end if
                  recstrusb[usb_zeiger]=b_char  inc(usb_zeiger)  ser_zeiger=usb_zeiger
      case 8,30   if MX_interface=0 then                                       ' Matrix wird intern verwendet
                     key_ctrl=0
                     mvar8=b_char
                     if ser8_zeiger>=fifo8 then  exit end if
                     recstr8[ser8_zeiger]=b_char  inc(ser8_zeiger) 
                     if (konsole_uart=8) or (konsole_uart=30) then  ser_zeiger=ser8_zeiger end if
                     if onbuf8=1 then
                        int_helper(25)                                         ' Interrupt-Nr.
                     end if
                  else                                                         ' Matrix als externes Keyboard
                      uart_nr=MX_interface  uart(b_char)
                  end if
      case 31     if ser1_zeiger>=fifo1  then exit end if
                  if usb_zeiger>=usbfifo then exit end if
                  if ser1_zeiger>usb_zeiger then
                     recstr1[ser1_zeiger]=b_char  inc(ser1_zeiger)  ser_zeiger=ser1_zeiger
                  else
                      recstrusb[usb_zeiger]=b_char  inc(usb_zeiger)  ser_zeiger=usb_zeiger
                  end if
      #endif
    end select
end sub

sub procedure put_string_in_buffer(dim byref bstring as string)                ' String in Empfangspuffer einfügen
dim n as word volatile

    n=0
    while bstring[n]
          put_char_in_buffer(bstring[n],konsole_uart)  
          inc(n)
    wend
end sub

sub procedure put_listline_in_buffer                                           ' Programmzeile in Empfangspuffer
    pstr = listline[actual_line]                                               ' listline zum Bearbeiten in pstr
    spaces_to_tabs(9, 2)
    xchange_char(32,11)
    nospaces
    xchange_char(11,32)
    listline[actual_line] = pstr                                               ' fertig bearbeitet
    put_string_in_buffer(listline[actual_line])                                ' in Empfangspuffer
end sub

sub procedure vt100_save_pos
    con_esc   con("s")
end sub

sub procedure vt100_load_pos
    con_esc   con("u")
end sub

sub procedure TFT_Blink_Cursor(dim active as word)                             ' blinkender Cursor für TFT
    if active then
       if TFT_blink=1 then TFT_reset_cursor  TFT_blink=0  exit  end if
       if TFT_blink=0 then TFT_set_cursor    TFT_blink=1        end if
    else
        TFT_reset_cursor
    end if
end sub

sub procedure inputstr(dim breite as integer)                                  ' Zeileneingabe
dim k, ctrlflag, rem_flag, einfg_flag, laenge, wait_counter, cursor_activ, noflag  as word    volatile
    zeiger, m, n                                                                   as integer volatile
    ufarbe, tfarbe, einfarbe, uefarbe, alfarbe, umfarbe, listzeiger                as word    volatile
    meinfueg, xcounter, string_flag, string_count, key_counter, key_repeat         as word    volatile
    svar, startbyte, endbyte, exbyte1, exbyte2, bchar, exbyte3, exbyte4, exbyte5   as byte    volatile
    xkey              as byte[32]    volatile
    eingabe           as string[256] volatile
    function_key_text as string[32]  volatile
    
    memset(@eingabe[0],0,256)
    uefarbe=7   einfarbe=3   alfarbe=1   umfarbe=6
    string_flag=0   string_count=0   exbyte3=91  exbyte4=93   exbyte5=96   TFT_Umbruch=1
    key_repeat=0   key_counter=0   wait_counter=0    key_newest=0    key_released=0   cursor_activ=0   TFT_cursor=0   noflag=0
    einfg_flag=0   einfg_flag.0 = RTC_BKP5R.5    if einfg_flag.0 = 1 then  tfarbe = einfarbe else  tfarbe = uefarbe  ufarbe = uefarbe  end if
    clear_pstr  con(15)  con(24)  if hiliting  then  VT100_clear  set_konsole_color(tfarbe, 0,0)  cursor_on end if
    for xcounter=0 to 19  xkey[xcounter]=0  next xcounter
    bchar = backsign   startbyte=31   endbyte=123   exbyte1=90   exbyte2=92   laenge=127   meinfueg = einfg_flag   xkey[0] = 0   xcounter=0 ' keine Flags/Programmieren
    if (konsole_uart>6) and (konsole_uart<32) then
       TFT_cursor=1   cursor_activ=1    TFT_Blink=1
       if use_palette then  TFT_Backcol=0  TFT_color=9 else  TFT_Backcol=cl_palette[0]  TFT_color=cl_palette[9] end if
       if TFT_scroll_mode=0 then                                               ' TFT ohne Scroll-Funktion?
          select case (TFT_max_z - TFT_Zeile +1)                               ' den Platz auf dem Display berechnen
            case 2    laenge = 2 * TFT_max_s -4                                ' abhängig von der Zeilen-Position (2 Zeilen passen)
            case 1    laenge = TFT_max_s -4                                    ' 1 Zeile passt
            case 0    TFT_reset_cursor  TFT_CLS(0)                             ' kein Platz -> linke obere Ecke  (überfüssig?)
                      print_prompt(0)  TFT_set_cursor
                      laenge = 3 * TFT_max_s -4
            case else laenge = 3 * TFT_max_s -4                                ' genug Platz für 3-zeilige Eingabe
          end select
       end if
    end if
    if num_flag  then  startbyte=44  endbyte=58   exbyte1=46   exbyte2=48  laenge=15   end if  ' auf Zahlen beschraenken
    if bin_flag  then  startbyte=47  endbyte=50   exbyte1=90   exbyte2=94  laenge=32   end if  ' auf Binaereingabe beschraenken
    if hex_flag  then  startbyte=47  endbyte=71   exbyte1=57   exbyte2=65  laenge=8    end if  ' auf Hexeingabe beschraenken
    if strg_flag then  startbyte=31  endbyte=255  exbyte1=90   exbyte2=92              end if  ' Texteingabe für input
    if (num_flag=0) and (bin_flag=0) and (hex_flag=0) and (strg_flag=0) then  noflag=1 end if
    zeiger=0  n=0  ctrlflag=0  rem_flag=0  svar=0   TFT_Umbruch_Zeile=0    listzeiger=actual_line
    if breite>0 then  if breite <= laenge  then  laenge = breite  end if  end if
    if breite<0 then
       breite=0
    else
        clear_konsole_buffer
    end if
while true
    IWDG_KR=0xAAAA
    if ser_zeiger>0 then                                                       ' Zeichen empfangen?
       svar = get_one_konsole_byte                                             ' dann eins holen
       if (svar=3) then  exit end if                                           ' ctrl c -> fertig
       if ctrlflag=2 then                                                      ' 2-Schritt-Escape-Sequenz?
          select case svar
            case 49   ctrlflag=3   continue                                    ' nein -> function key 1-9      4 Schritt-Sequenz   + 'Pos1'  3 Schritt-Sequenz
            case 50   ctrlflag=4   continue                                    ' nein -> function key 10-12    4 Schritt-Sequenz
            case 52   ctrlflag=5   continue                                    ' nein -> 'Ende'                3 Schritt-Sequenz
            case 65,66,67,68                                                   ' ja   -> Ende, Cursor up/Pos1, Cursor down/Ende, Cursor left, Cursor right
            case else ctrlflag=0   continue                                    ' nicht erlaubt
          end select
       end if
       if ctrlflag=1 then                                                      ' Escape-Sequenz?
          if svar=91 then                                                      ' yip!
             ctrlflag=2                                                        ' kleine Sequenz einleiten
          else
              ctrlflag=0                                                       ' Escape-Taste   für spätere Auswertung!!!
          end if
          continue
       end if
       if ctrlflag=0 then
          if svar=27 then ctrlflag=1  continue end if                          ' Escape-Sequenz-Start-Flag setzen
       end if
       if (n <= laenge) and (svar>0) then                                      ' maximale Zeichenlaenge erreicht?
          if svar=13 then break  end if                                        ' Return? -> fertig
          if ctrlflag=0 then     'keine Escape-Sequenz? dann los! -------------------------------------------------------------------------------
             if testbit(meinfueg,0) = 1 then                                   ' Einfüge-Modus eingestellt?
                if n >= laenge then                                            ' kein Platz für Einfügen?
                   clearbit(einfg_flag,0)                                      ' dann temporär Überschreiben!
                   ufarbe = umfarbe
                else                                                           ' Länge reicht wieder aus?
                    einfg_flag.0 = meinfueg.0                                  ' dann wieder wie eingestellt
                    if testbit(einfg_flag,0) then
                       ufarbe = einfarbe                                       ' Textfarbe Einfüge-Modus
                    else
                        ufarbe = uefarbe                                       ' Textfarbe Überschreib-Modus
                    end if
                end if
             else                                                              ' Überschreib-Modus eingestellt
                 ufarbe = uefarbe
             end if
             if hex_flag then if (svar>96) and (svar<103) then svar=svar-32    end if  end if  ' Kleinbuchstaben in Grosse (für hex-Eingabe )
             if num_flag then if n>0 then if svar=45      then svar=47 end if  end if  end if  ' Minus nur an der ersten Stelle  (für num. Eingabe)
             if num_flag then
                if svar=46 then                                                ' Dezimalpunkt?
                   if strchr(eingabe, 46) < 0xFFFF then                        ' ist schon ein Punkt vorhanden?
                      svar=47                                                  ' dann kein zweiter
                   end if
                end if
             end if
             if (num_flag=0) and (hex_flag=0) and (bin_flag=0) and (strg_flag=0) then   ' Programmier-Modus?
                k=0   string_count=0
                while k < zeiger
                      if eingabe[k]=34 then  inc(string_count) end if
                      inc(k)
                wend
                string_flag = string_count mod 2
                if string_flag=1 then  
                   endbyte=255   exbyte2=90  exbyte3=126  exbyte4=126  exbyte5=126
                else  
                    endbyte=123  exbyte2=92  exbyte3=91   exbyte4=93   exbyte5=96
                end if
             end if
             if (svar > startbyte) and (svar < endbyte) and ((svar > exbyte1) and (svar < exbyte2) = 0) and (svar<>126) and (svar <> exbyte3) and (svar <> exbyte4) and (svar <> exbyte5) or (((svar =9) or (svar =167) or (svar =124)) and ((hex_flag =0) and (num_flag =0) and (bin_flag = 0)))  then   'druckbares zeichen?
                if zeiger = laenge then                                        ' Zeichen hat erlaubten Bereich verlassen
                   set_konsole_color(alfarbe,0,0)                              ' Zeichen ausserhalb -> sichtbar machen
                else
                    set_konsole_color(ufarbe,0,0)                              ' umgeschaltet auf Überschreiben -> sichtbar machen
                end if
                if svar=9 then                                                 ' Tabulator als
                   con(46)                                                     ' Punkt drucken
                else
                    acon(svar)                                                 ' lokales Echo
                end if
                set_konsole_color(tfarbe,0,0)                                  ' wieder aktuelle Zeichenfarbe
                if testbit(einfg_flag,0) then      'Einfügemodus?  EEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE
                   VT100_save_pos                                              ' Corsorposition (VT100) merken
                   inc(n)                                                      ' Eingabe eins länger machen
                   m = n                                                       ' Hilfszähler setzen
                   while (m >= zeiger) and (m >= 0)                            ' rechte Zeichen
                         eingabe[m +1] = eingabe[m]                            ' um 1 verschieben
                         dec(m)
                   wend
                   eingabe[zeiger] = svar  eingabe[n]=0                        ' neues Zeichen einfügen, neue Endemarke
                   inc(zeiger)                                                 ' Eingabeposition eins weiter
                   m = zeiger
                   xcounter=0
                   while m < n                                                 ' rechte Zeichen
                         if eingabe[m]=9 then
                            con(46)
                         else
                             acon(eingabe[m])                                  ' neu ausdrucken    ###
                         end if
                        inc(m)
                   wend
                   con_esc  con("u")                                           ' Cursorposition VT100 wieder herstellen
                else               'Überschreibmodus?   ÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜÜ
                    if ufarbe=6 then                                           ' alte Eingabe speichern
                       xkey[xcounter] = eingabe[zeiger]
                       if  xcounter < 32 then
                           inc(xcounter)
                           if xcounter=32 then
                              xcounter=0
                              umfarbe = uefarbe
                           end if
                       end if
                    end if
                    eingabe[zeiger] = svar                                     ' dann neues Zeichen darüber schreiben
                    inc(zeiger) 
                    if  zeiger > n  then  n = zeiger  eingabe[n] = 0  end if   ' neue Eingabeposition am Ende ebenso Endemarke
                end if
             end if         'Druckbare Zeichenabteilung hier zu Ende_______________________________________________________________
             if svar=24 then                                                   ' ctrl x - letztes Überschreiben rückgängig machen
                if xcounter and (einfg_flag.0 = 0) then
                   con(8)
                   set_konsole_color(uefarbe,0,0)
                   con(xkey[xcounter -1])
                   set_konsole_color(tfarbe,0,0)
                   con(8)
                   if zeiger then                                              ' nur zur Sicherheit prüfen
                      dec(zeiger)
                   end if
                   if xcounter then
                      eingabe[zeiger] = xkey[xcounter -1]
                      dec(xcounter) 
                   end if
                end if
             end if
             if svar=16 then                                                   ' ctrl-P  "Zwischenablage" in Puffer
                if noflag then
                   if listzeiger>0 then
                      if eingabe[0]>0 then
                         listline[listzeiger]=eingabe
                      end if
                      actual_line=listzeiger -1                                   ' Zeiger auf letzte Eingabe
                      put_listline_in_buffer
                      xcounter=0
                   end if
                end if
                continue
             end if
             if svar=12 then                                                   ' Zeile löschen  ctrl l
                while zeiger<n                                                 ' Erstmal ganz nach rechts
                      if eingabe[zeiger]=9 then                                ' Tabulator?
                         con(46)                                               ' Punkt ausgeben
                      else
                          acon(eingabe[zeiger])                                ' Cursor nach rechts (indem einfach die Zeichen ausgedruckt werden, klappt auch ohne VT100)
                      end if
                      inc(zeiger)                                              ' Eingabezeiger eins grösser
                wend
                while zeiger>0                                                 ' Dann ganz nach links
                      con(8)                                                   ' Cursor nach links
                      con(bchar)                                               ' Zeichen löschen
                      con(8)                                                   ' Cursor nach links
                      dec(zeiger)                                              ' Eingabezeiger eins kleiner
                wend
                n=0  ctrlflag=0  svar=0   ser_zeiger=0   clear_pstr   xcounter=0
                memset(@eingabe[0],0,256)
                clear_konsole_buffer      actual_line=listzeiger
             end if
             if svar=10 then                                                   ' ctrl J  CLS
                if noflag then
                   zeiger=0  n=0  m=0  xcounter=0
                   put_string_in_buffer(@eingabe)
                   memset(@eingabe, 0, 256)
                   if konsole_uart>7 then
                      tft_cls9
                      if konsole_uart>29 then  vt100_cls end if
                   else
                       vt100_cls
                   end if
                   print_prompt(1)
                   set_konsole_color(tfarbe,0,0)                               ' wieder aktuelle Zeichenfarbe
                end if
             end if
             if svar=5 then                                                    ' ctrl-E? -> Einfügemodus
                meinfueg.0 = not(meinfueg.0)  einfg_flag.0 = meinfueg.0        ' speichern
                if testbit(einfg_flag,0) then  tfarbe = einfarbe  else  tfarbe = uefarbe  ufarbe = uefarbe  end if  ' Farben wechseln
             end if
             if svar=4 then                                                    ' ctrl-D? -> single step
                if debug_flag then
                   if sst_flag=0 then
                      sst_flag=1                                               ' Single step Flag setzen
                      con("d")  con("+")                                       ' Bestätigung ausgeben
                   else
                       sst_flag=0  con("d")  con("-")
                   end if
                   cnl  print_prompt(0)
                   set_konsole_color(tfarbe,0,0)
                end if
             end if
             if testbit(einfg_flag,0)  then  xcounter=0  end if
             if (svar=127) or ((svar=8) and zeiger) then                       ' delete oder Rückschritt
                if (n>0) and (zeiger<n) then                                   ' Grenzen des Eingabefeldes erreicht?
                   if (svar=8) and zeiger then                                 ' Rücktaste?
                      dec(zeiger)                                              ' Position in Eingabe eins nach links
                      con(8)                                                   ' Cursor nach links
                   end if
                   m = zeiger  dec(n)                                          ' Eingabelänge eins kürzer
                   VT100_save_pos                                              ' Cursorposition VT100 merken
                   while m < n                                                 ' alle rechten Zeichen
                         eingabe[m] = eingabe[m +1]                            ' eins nach links
                         if eingabe[m]=9 then
                            con(46)
                         else
                             acon(eingabe[m])                                  ' rechte Zeichen neu ausdrucken
                         end if
                         inc(m)
                   wend
                   eingabe[n]=0                                                ' neue Endemarke setzen
                   con(bchar)                                                  ' das "überstehende Zeichen" überschreiben
                   VT100_load_pos                                              ' Cursorposition VT100 wieder herstellen
                end if
             end if
             if svar=8 then                                                    ' Rückschritt (löschen links)
                if (n>0) and (zeiger=n) then                                   ' für MCS51-Modus
                   eingabe[zeiger -1]=0                                        ' Zeichen links löschen durch neues Zeilenende
                   con(8)  con(bchar)  con(8)                                  ' überschreiben ##################
                   dec(n)                                                      ' Länge eins kleiner
                   if  zeiger>0  then  dec(zeiger)  end if                     ' Eingabezeiger eins kleiner
                end if
             end if
          else       'Escape-Sequenz--------------------------------------------------------------------- Dann:  ----------------------------
              if ctrlflag=6 then                                               ' Funktionstasten
                 ctrlflag=0                                                    ' Ende Escape-Sequenz für function keys zu Ende
                 if svar=126 then
                    put_string_in_buffer(function_key_text)
                 end if
                 continue
              end if
              if ctrlflag=5 then
                 if svar=126 then                                              ' Taste 'Ende'
                    set_konsole_color(tfarbe,0,0)                               ' wieder aktuelle Zeichenfarbe
                    while zeiger < n                                           ' Ende noch nicht erreicht?            Cursor unten/'Ende'
                          if eingabe[zeiger]=9 then                            ' Tabulator?
                             con(46)                                           ' Punkt ausgeben
                          else
                              acon(eingabe[zeiger])                            ' Cursor nach rechts
                          end if
                          inc(zeiger)                                          ' Eingabezeiger eins grösser
                    wend
                    xcounter=0
                    umfarbe=6
                 end if
                 ctrlflag=0
                 continue
              end if
              if ctrlflag=4 then                                               ' function keys 10-12
                 ctrlflag=6                                                    ' bei Funktionstasten weitermachen
                 if (svar>47) and (svar<50) then
                    if noflag then
                       function_key_text = Fkey[svar-48]
                       xcounter=0
                       umfarbe=6
                       continue
                    else
                        ctrlflag=0
                        continue
                    end if
                 end if
                 if (svar>50) and (svar<53) then
                    if noflag then
                       function_key_text = Fkey[svar-49]
                       xcounter=0
                       umfarbe=6
                       continue
                    else
                        ctrlflag=0
                        continue
                    end if
                 end if
              end if
              if ctrlflag=3 then                                               ' function keys 1-9
                 ctrlflag=6                                                    ' bei Funktionstasten weitermachen
                 if (svar>48) and (svar<54) then                               ' function key?  (1...5)
                    if noflag then
                       function_key_text = fkey_text[svar-49]
                       xcounter=0
                       umfarbe=6
                       continue
                    else
                        ctrlflag=0
                        continue
                    end if
                 end if
                 if (svar>54) and (svar<58) then                               ' function key?  (6...9)
                    if noflag then
                       function_key_text = fkey_text[svar-50]
                       xcounter=0
                       umfarbe=6
                       continue
                    else
                        ctrlflag=0
                        continue
                    end if
                 end if
                 if svar=126 then                                              ' Pos1
                    while zeiger>0                                             ' Anfang noch nicht erreicht?          Cursor oben/'Pos1'
                          con(8)                                               ' Cursor nach links
                          dec(zeiger)                                          ' Eingabezeiger eins kleiner
                    wend
                    xcounter=0
                    umfarbe=6
                    ctrlflag=0
                    continue
                 end if
              end if
              if ctrlflag=2 then                                               ' Einfache Escape-Sequenz (3 Zeichen - Pos1 und Ende (4) werden abgebrochen)
                 select case svar
                   case 0    ctrlflag=0   continue
                   case 65   if noflag then
                                if actual_line<listzeiger then                    ' cursour up
                                   while zeiger>0                                 ' pos 1
                                         con(8)
                                         con(32)
                                         con(8)
                                         dec(zeiger)
                                   wend
                                   umfarbe=6
                                   inc(actual_line)   'prn(actual_line)
                                   memset(@eingabe[0],0,256)
                                   clear_konsole_buffer
                                   n=0
                                   put_listline_in_buffer
                                   xcounter=0
                                end if
                             end if
                             ctrlflag=0
                             continue
                   case 66   if noflag then
                                if listzeiger>0 then                              ' cursor down
                                   if actual_line>0 then
                                      while zeiger>0
                                            con(8)
                                            con(32)
                                            con(8)
                                            dec(zeiger)
                                      wend
                                      umfarbe=6
                                      if actual_line=listzeiger then
                                         listline[listzeiger]=eingabe
                                      end if
                                      dec(actual_line)    'prn(actual_line)
                                      memset(@eingabe[0],0,256)
                                      n=0
                                      clear_konsole_buffer
                                      put_listline_in_buffer
                                      xcounter=0
                                   end if
                                end if
                             end if
                             ctrlflag=0
                             continue
                   case 67   if zeiger < n then                                ' Ende noch nicht erreicht?            Cursor rechts
                                set_konsole_color(tfarbe,0,0)                               ' wieder aktuelle Zeichenfarbe
                                if eingabe[zeiger]=9 then                      ' Tabulator?
                                   con(46)                                     ' Punkt aus geben
                                else
                                    acon(eingabe[zeiger])                      ' Cursor nach rechts
                                end if
                                inc(zeiger)                                    ' Eingabezeiger eins grösser
                                xcounter=0
                                umfarbe=6
                             end if
                   case 68   if zeiger>0 then                                  ' Anfang noch nicht erreicht?          Cursor links
                                con(8)                                         ' Cursor nach links
                                dec(zeiger)                                    ' Eingabezeiger eins kleiner
                                xcounter=0
                                umfarbe=6
                             end if
                 end select
                 ctrlflag=0                                                    ' Escape-Sequenz beendet
              end if                                                           ' function key Ende
          end if
       else                                                                    ' Überlänge? -> dann nur noch Rücktaste erlaubt!
           if svar=8 then                                                      ' Rücktaste?
              if zeiger then
                 eingabe[zeiger -1] = 0                                        ' Zeichen links von akt. Pos. löschen
                 con(8)  con(160)  con(8)                                      ' ueberschreiben
                 if n then dec(n) end if                                       ' pufferzeiger eins kleiner
                 dec(zeiger)                                                   ' Eingabezeiger nach rechts
                 xcounter=0
                 umfarbe=6
              end if
           end if
       end if
    end if
    if (konsole_uart>6) and (konsole_uart<32) then                             ' Konsole mit TFT-LCD?
       TFT_cursor=1   TFT_reset_cursor
       if n < laenge then                                                      ' Cursorwechsel bei TFT-Betrieb
          TFT_reset_cursor
          TFT_cursor_form = meinfueg
          TFT_set_cursor
       else
           TFT_reset_cursor
           TFT_cursor_form=0
           TFT_set_cursor
       end if
    end if
    if (konsole_uart>5) and (konsole_uart<32) then                             ' Konsole mit TFT-LCD oder USB-Keyboard?
       #ifndef 411 then
       if ser_zeiger=0 then                                                    ' erst Pufferinhalt abarbeiten
          if (konsole_uart=6) or (konsole_uart>7) then                         ' Konsole mit USB-Keyboard?
             if (konsole_uart=8) or (konsole_uart=30) then
                if key_released = key_pressed  then  key_repeat=0  ser8_zeiger=0  key_released=0   end if   ' Taste losgelassen
             else
                 if key_released = key_pressed  then  key_repeat=0  usb_zeiger=0  key_released=0   end if   ' Taste losgelassen
             end if
             if key_repeat then                                                ' Repeat-Modus?
                if (konsole_uart=8) or (konsole_uart=30) then  MX_interface=0 end if
                if key_ctrl then
                   if (konsole_uart=8) or (konsole_uart=30) then
                      recstr8[0]=27    recstr8[1]="["    recstr8[2]=svar    recstr8[3]=0    ser_zeiger=3  ser8_zeiger=3
                   else
                       recstrusb[0]=27  recstrusb[1]="["  recstrusb[2]=svar  recstrusb[3]=0  ser_zeiger=3  usb_zeiger=3  ' Escape-Sequenz
                   end if
                else
                    if (konsole_uart=8) or (konsole_uart=30) then
                       recstr8[0]=svar  recstr8[1]=0  ser_zeiger=1  ser8_zeiger=1
                    else
                        recstrusb[0]=svar  recstrusb[1]=0  ser_zeiger=1  usb_zeiger=1  ' Nur Zeichen
                    end if
                end if
                delay_ms(50) continue                                          ' Repeatgeschwindigkeit
             end if
          end if
       end if
       #endif
       wait_counter=0   key_counter=0                                          ' Blink-, Repeat-Counter
       while ser_zeiger=0
             if key_counter>500  then  key_repeat=1    break                          end if   ' Repeatverzögerung für USB-Keyboard
             if wait_counter>500 then  wait_counter=0  TFT_Blink_Cursor(cursor_activ) end if   ' Cursor-Blinken auf TFT
             if key_newest>0 then                                              ' USB Taste gedrückt?
                inc(key_counter)                                               ' Repeat-Verzögerungszähler
             end if
             inc(wait_counter)                                                 ' Blinkzähler
             delay01                                                           ' Blinkgeschwindigkeit
       wend
    end if
wend
    eingabe[n]=0    pstr=eingabe                                               ' String-Ende-Marke
    if lcd then  
       TFT_reset_cursor2
    end if
    if hex_flag then  upper end if                                             ' Bei Hex-Eingabe: Kleinbuchstaben in Grossbuchstaben
    clear_konsole_buffer   cursor_off                                          ' Eingabepuffer loeschen
    if svar=3 then                                                             ' control c merken
       clear_pstr 
       mvar=3
    end if
    backsign=32   TFT_Umbruch=0   actual_line=listzeiger
end sub

sub procedure change_if_token(dim ifcount as word)                             ' if-token austauschen
dim m as word volatile

    if ifcount then
       m=0
       while  progline[m]<>135                                                 ' kein if1-Token?
              if (progline[m]=0) or (progline[m]=139) then  exit  end if       ' Ende oder if2-Token?  dann bereits getauscht -> fertig!
              inc(m)
       wend
       progline[m]=139                                                         ' austauschen gegen if2-Token
    end if
end sub

sub function vardigit(dim vd as byte) as word                                  ' ist das Zeichen eine Zahl oder Variable?
    if isdigit(vd) or ((vd>64) and (vd<91)) or (vd=167) then
       result=65535
    else
        result=0
    end if
end sub

sub function get_typeof(dim byte_count as word) as word                        ' welcher Art ist die (num) Variable (Anzahl Bytes)
    select case byte_count
      case 8    result=1      ' extended
      case 4    result=4      ' longword
      case 2    result=6      ' integer
      case else result=0
    end select
end sub

sub procedure tokenization(dim modus as word)                                  ' Zeile in Tokens wandeln
dim n,m,k,lang,test,test01,test0,test1,test2,test3,test4,linepointer,token,increment,klammerauf,tabul,num_count as word volatile
dim rklam,sklam,numsw,kword,ifcount,fn_flag,sfn_flag,let_flag, ext_flag, on_flag, set_get_cfg_flag, kolon as word volatile
dim key_flag,var_flag, rem_flag, st_flag, start_flag, func_flag, kop_flag as word volatile    'tflag,
dim klammerart               as word[loopdepth] volatile                       ' 1 = geschweift, 2 = Eckig, 3 = rund
dim rklammerauf, sklammerauf as word            volatile
dim count_raute              as word            volatile

clear_progline   perror=0
kolon=0
for n=0 to loopdepth  klammerart[n]=0  next n                                  ' Klammerebenen löschen
klammerauf=0  rklam=0   sklam=0  rklammerauf=0  sklammerauf=0                  ' Zaehler fuer geoeffnete Klammern
numsw=0                                                                        ' Schalter fuer Zeilennummer
num_count=0
kword=1    key_flag=0                                                          ' Schalter fuer Anweisungen, Flag für keyword detected
tabul=0
ifcount=0                                                                      ' Anzahl if's pro Zeile
linepointer=0   perror=0   n=0   k=0                                           ' Zaehler und Fehler auf null
fn_flag=0                                                                      ' Funktionsflag, überwacht Funktions-Klammer
sfn_flag=0                                                                     ' Stringfunktionsflag, überwacht String-Funktions-Klammer
let_flag=0                                                                     ' Zuweisungsflag  Kode für Gleichheitszeichen (Zuweisungszeichen)
ext_flag=0                                                                     ' flag fuer instruction extender (2-Byte Instruktionen)
kop_flag=0                                                                     ' alternativ zu ext_flag = 3 für Konstanten (pi, e...) und Operatoren +=, *= etc
on_flag =0                                                                     ' flag fuer on-instruktion  ändert Kode für goto, gosub und start
set_get_cfg_flag=0                                                             ' Schalter für set,get,config,clear, note Anweisung erlaubt Instruktionen & Funktionen als Argument
                                                                               ' set = 1, get = 2, cfg = 3, clear = 4, note = 5
var_flag=0                                                                     ' (System)Variablen mit Bit-Manipulation
func_flag=0                                                                    ' Schaltet Anführungszeichen-Modus für call/func/proc/start/sub-Anweisung ein
start_flag= 0                                                                  ' Schalter für deffn/defpr-Anweisung
st_flag=0                                                                      ' Stringflag
test0=0                                                                        ' letztes (gemerktes) token
test01=0                                                                       ' Zeichen vorher
rem_flag=0                                                                     ' Schalter für rem-Instruction (erlaubt fast alle Zeichen)
count_raute=0                                                                  ' zählt "#"-Zeichen
spaces_to_tabs(9,2)
nospaces                                                                       ' Leerzeichen entfernen
lang = length(pstr)
while linepointer <= lang
increment=1  token=0
test = pstr[linepointer]  test1 = pstr[linepointer +1]  test2 = pstr[linepointer +2]  test3 = pstr[linepointer +3]  test4 = pstr[linepointer +4]  'Vereinfachung
select case test
 case 0
 break
 case "a"
      increment = 3
      select case test1
      case "b"          token = 242                                            ' abs
      case "d"
          select case test2
          case "1"       token = 222                                           ' ad1
          case "2"       token = 223                                           ' ad2
          case "3"       token = 224                                           ' ad3
          case "4"       token = 237                                           ' ad4
          case "d"       token = 97                                            ' add
          end select
      case "n"           token = 186                                           ' and
      case "R"           token = 12          increment = 2    ext_flag = 2    set_get_cfg_flag =1  ' array
      case "r"
           select case test2
             case "r"  token = 12            increment = 5     ext_flag = 2   set_get_cfg_flag =1 ' array
           end select
      case "s"
           select case test2
             case "c"  token = 8                                               ' asc
             case else token = 117           increment = 2     start_flag=0    ' as
           end select
      case "t"
           select case test2
             case "n"  token=244                                               ' atn
             #ifndef 411 then
             case "t"  token=203             increment=6      var_flag=1       ' attack
             #endif
           end select
      end select
 case "b"
      increment = 3
      select case test1
        case "a"  token=7                    increment=4      ext_flag=1       ' baud
        case "u"  token=236                                   var_flag=1       ' buf
        case "i"
             if test3 = "$" then
                token=192                    increment=4      sklam=1          ' bin$
             else
                 token=112                                                     ' bin
             end if
        case "l"   token=22                  increment=5      ext_flag=4       ' bload
        case "r"   token=21                  increment=5      ext_flag=2       ' break
        case "s"   token=23                  increment=5      ext_flag=4       ' bsave
      end select
 case "c"
      increment = 4
      select case test1
      case "a"
           select case test2
           case "s"   token = 151                                              ' case
           case "l"
                select case test3
                case "c"   token = 161                                         ' calc
                case "l"   token = 30        sklam = 1   ext_flag = 2   func_flag = 1  ' call
                end select
           end select
      case "d"        token = 33             increment = 2    ext_flag = 1     ' cd
      case "e"        token = 153            increment = 5                     ' celse
      case "O"        token = 29             increment = 2    ext_flag = 1    set_get_cfg_flag = 3  ' config
      case "o"
           select case test2
           case "L"     token = 201          increment = 3        var_flag=1   ' color
           case "l"     token = 201          increment = 5        var_flag=1   ' color
           if pstr[linepointer +5] ="$" then                                   ' color$
              token = 107                    increment = 6        sklam = 1
           end if
           case "s"     token = 249          increment = 3                     ' cos
           case "m"     token = 31           increment = 3                     ' com
           case "n"
               select case test3
               case "t"    token = 4                              ext_flag=1   ' cont
               case "f"    token = 29        increment = 6        ext_flag=1    set_get_cfg_flag = 3  ' config
               case "v"    token = 6         increment = 7        ext_flag=1   ' convert
               case "V"    token = 6                              ext_flag=1   ' convert
               end select
           case "u"        token = 108       increment = 6        sklam = 1    ' count$
           end select
      case "L"             token = 16        increment = 2        ext_flag = 1    set_get_cfg_flag = 4  ' clear
      case "l"
          increment = 5
          select case test2
          case "s"
               if test3 = "$" then
                  token = 115        increment = 4                             ' cls$
               else
                   token = 22        increment = 3        ext_flag = 1         ' cls
               end if
          case "e"     token = 16                         ext_flag = 1    set_get_cfg_flag = 4   ' clear
          case "O"     token = 163   increment = 3                             ' clock
          case "o"
              select case test3
                case "c"    token = 163                                        ' clock
                case "s"    token = 14                    ext_flag = 1         ' close
              end select
          end select
      case "h"
           if test3 = "$" then
              token = 179                                 sklam=1              ' chr$
           end if
      end select
 case "d"
      increment = 3
      select case test1
        case "a"
             select case test2
               #ifndef 411 then
               case "c"   token = 210                                          ' dac
               #endif
               case "T"   token = 215                                          ' dataptr
               case "t"
               if test3 = "e" then
                  token = 178            increment = 4            sklam = 1    ' date
               end if
