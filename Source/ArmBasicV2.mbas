end sub

sub procedure instr_move
const CS_Hi=(1<<13)
      CS_Lo=(1<<29)
dim   n, k        as word            volatile
      TFT_Buffer  as word[128][128]  volatile

    if (TFT_started=0) or (TFT_Type<6) then  perror=19 exit end if
    if (get_parameters(2)< 6)          then  perror=02 exit end if
    if (para[0]<0) or (para[0]>799)    then  perror=13 exit end if
    if (para[1]<0) or (para[1]>479)    then  perror=13 exit end if
    if (para[2]<1) or (para[2]>128)    then  perror=13 exit end if
    if (para[3]<1) or (para[3]>128)    then  perror=13 exit end if
    if (para[4]<0) or (para[4]>799)    then  perror=13 exit end if
    if (para[5]<0) or (para[5]>479)    then  perror=13 exit end if
    GPIOD_BSRR=CS_Lo                                                           ' Chip_Select Lo
    for n=0 to para[3] -1                                                      ' Block lesen
        Parallel_Set_Address3_SSD1963(word(para[0]), word(para[1])+n, 799, 479)
        GPIO_Digital_Input(@GPIOF_BASE,  _GPIO_PINMASK_All)
        for k=0 to para[2] -1   TFT_Buffer[k][n]=Parallel_Read_Data16    next k
        GPIO_Digital_Output(@GPIOF_BASE, _GPIO_PINMASK_All)
    next n
    if (para[6]=0) then                                                        ' bewegen=0, kopieren<>0
       for n=0 to para[3] -1                                                   ' Block löschen
           Parallel_Set_Address_SSD1963(word(para[0]), word(para[1])+n, 799, 479)
           for k=1 to para[2] -1   Parallel_Write_Data16(tft_backcol)    next k
       next n
    end if
    for n=0 to para[3] -1                                                      ' Block an neue Position
        Parallel_Set_Address_SSD1963(word(para[4]), word(para[5])+n, 799, 479)
        for k=0 to para[2] -1   Parallel_Write_Data16(TFT_Buffer[k][n])  next k
    next n
    GPIOD_BSRR=CS_Hi                                                           ' Chip_Select Hi
end sub
#endif

sub procedure instr_get_dir
dim error            as short      volatile
dim lw,mw,ex,atr     as word       volatile
dim pdir             as __Dir      volatile
dim strptr           as ^char      volatile
dim varptr           as ^extended  volatile
dim nstrg            as string[96] volatile

    if SD_Card_present=0 then  No_SD_Card        exit end if
    if progline[2]<>","  then  perror=03         exit end if
    lw=get_var_adr_list(3)   
    if lw<1 then  perror=13  sys(parameters,0) exit end if
    if para[0] <> 2      then  perror=24         exit end if
    strptr=longword(par[0])
    SPI_Set_Active(@SPI2_Read, @SPI2_Write)
    mw=position(3,117,0)
    if SD_Dir_Counter=0 then
       error=FAT32_FindFirst(@pdir)
    else
        error=FAT32_FindNext(@pdir)
    end if
    if error<0 then  clear_pstr  set_string_with_adres(strptr, 256, 0) exit end if
    nstrg=progname
    inc(SD_Dir_Counter)
    if mw then
       ex=word(calculate_exp(mw))   'prn(ex)
       if (ex<1) or (ex>32) then  perror=13 exit end if
       progname=pdir.NameExt   atr=pdir.Attrib
       if ex=32 then
          while ((16 and atr)=0) and (1=error)
                 error=FAT32_FindNext(@pdir)
                 atr=pdir.Attrib
                 inc(SD_Dir_Counter)  'prn(SD_Dir_Counter)
          wend
       else
           while (ex<>file_ext_test) and (1=error)
                 error=FAT32_FindNext(@pdir)
                 progname=pdir.NameExt
                 inc(SD_Dir_Counter)  'prn(SD_Dir_Counter)
           wend
       end if
    end if
    if error=1 then
       clear_pstr
       pstr=pdir.NameExt   set_string_with_adres(strptr, 256, 0)
       if lw>1 then
          if para[1]<>1 then  perror=24 exit end if
          varptr=longword(par[1])
          varptr^=pdir.Attrib
       end if
       inc(SD_Dir_Counter)
    else
        clear_pstr  set_string_with_adres(strptr, 256, 0)
    end if
    progname=nstrg
end sub

sub procedure get_midi_data
const array_adr=500*8
dim   n as word volatile

    if pmode=0 then
       sys("Channel    Counter",9)
       for n=0 to 15
           cnl  print_format(n+1,3)  print_spaces(9)  prl(midi_channel_counter[n])
       next n
    else
        for n=0 to 15
            array_ram_write_float(extended(midi_channel_counter[n]), longword(n + array_adr))
        next n
    end if
end sub

sub procedure get_midi_end
    midi_on=0
end sub

#ifndef 411 then
sub procedure get_keypad                                                       ' verbindet das Matrix-Keyboard laufend mit der FM-Synthese
dim voicenr, dummy                            as word          volatile
dim factor1, factor2, factor3, n, anz, count  as word          volatile
dim phaseshift1,phaseshift2,phaseshift3       as float         volatile
dim mbuffer                                   as integer[1024] volatile

    if int_marker then  exit end if
    for n=0 to 1023  mbuffer[n]=soundbuffer[n]  next n
    factor1=fm_factor1   factor2=fm_factor2   factor3=fm_factor3
    phaseshift1=fm_phaseshift1   phaseshift2=fm_phaseshift2   phaseshift3=fm_phaseshift3   count=fm_count
    'cnl  prl(fm_count)  con(32)  con(32)  prl(fm_factor)  con(32)  prf(fm_phaseshift1)   con(32)  prf(fm_phaseshift2)    con(32)  prf(fm_phaseshift3)
    anz=get_parameters(2)
    if (anz>3) and (anz<8) then
       count=anz
       if count=7 then  count=6 end if
       if (para[0]<1) or (para[0]>31)      then  para[2]=1  end if
       if (para[1]<1) or (para[1]>31)      then  para[2]=1  end if
       if (para[2]<1) or (para[2]>31)      then  para[2]=1  end if
       'if (par[3]<1.0) or (par[3]>65535.0) then  par[3]=150 end if
'       if (par[4]<0.0) or (par[4]>65535.0) then  par[4]=100 end if
'       if (par[5]<0.0) or (par[5]>65535.0) then  par[5]=100 end if
       if sound_init=0 then  start_MIDI_sound end if
       factor1=word(para[0])       factor2=word(para[1])      factor3=word(para[2])
       phaseshift1=float(par[3])   phaseshift2=float(par[4])  phaseshift3=par[5]
       adsr_on=1
    end if
    if adsr_on then
       do
         voicenr=voice_key[tabl_pos]
         if phase[voicenr]=0 then
            while phase[voicenr]<2
                  dummy=fmod(count, factor1, factor2, factor3, s_modulator[voicenr] * phaseshift1, phaseshift2, phaseshift3)   ', phaseshift2, factor2)
            wend
         end if
       loop until ser_zeiger
       clear_konsole_buffer
    end if
    for n=0 to 1023  soundbuffer[n]=mbuffer[n]  next n
end sub
#endif

sub procedure instr_get
    select case progline[1]
    #ifdef 407ZG then
      case 137  instr_get_lcd
    #endif
    #ifdef VG then
      case 137  instr_get_lcd
    #endif
      case "#"  instr_get_raute
      case 102  instr_get_dir
      case 128  if progline[2] = 8 then                                        ' get MIDI
                   select case progline[3]
                     case 154  get_midi_data
                     case 169  get_midi_end
                     #ifndef 411 then
                     case else if get_parameters(3) then
                                  start_midi(1)
                               else
                                   start_midi(0)
                               end if
                     #else
                     case else perror=2
                     #endif
                   end select
                end if
      case 96,136,222,223,224,228,232,237                                      ' get output, input, relay, get ad1, get ad2,...
                if mod_server then  perror=19  sys(modserver,0) exit end if
                instr_get_set_reset_modbus
      #ifndef 411 then
      case 164  get_keypad
      #endif
      case else instr_get_ohne_raute
    end select
end sub

sub procedure instr_next                                                       ' Anweisung next
dim lvar as word volatile

    if pmode=0       then  perror=1  exit end if                               ' im Direktmodus nicht erlaubt
    if loopcounter=0 then  perror=5  exit end if                               ' keine Schleifen?
    if gostack=0     then  perror=9  exit end if
    if progline[1]   then                                                      ' Zählvariable?
       if loopvar[gostack -1] <> progline[1]  then  perror=2  sys("Wrong Loop Variable",0) exit end if   ' Zählvariable falsch
    end if
    exit_adres[gostack -1] = progpointer                                       ' Ausstiegsadresse hinter next
    cont_adres[gostack -1] = mcontadres                                        ' continue-Adresse vor next
    lvar = loopvar[gostack -1] -65
    if loopstep[gostack -1]>0.0 then                                           ' Schrittweite positiv?
       if varfloat[lvar] + loopstep[gostack -1] <= loop_end[gostack -1] then   ' Endwert erreicht?
          varfloat[lvar] = varfloat[loopvar[gostack -1] -65] + loopstep[gostack -1]  ' nein?
          progpointer = returnadr[gostack -1]
       else                                                                    ' ja
           dec(gostack)                                                        ' dann fertig, vom Stapel nehmen
           loopvar[gostack]=0
           dec(loopcounter)
       end if
       exit
    end if
    if loopstep[gostack -1]<0.0 then                                           ' Schrittweite negativ?
       if varfloat[lvar] + loopstep[gostack -1] >= loop_end[gostack -1] then   ' Endwert erreicht?
          varfloat[lvar] = varfloat[loopvar[gostack -1] -65] + loopstep[gostack -1]  'nein? weitermachen!
          progpointer = returnadr[gostack -1]
       else                                                                    ' Ja
           dec(gostack)                                                        ' dann fertig, vom Stapel nehmen
           loopvar[gostack]=0
           dec(loopcounter)
       end if
    end if
end sub

sub function get_line_adress(dim goline as longword, dim pos as ^byte) as ^byte   ' Adresse zu Programmzeile ermitteln
dim linetest as  longword volatile
dim k        as ^byte     volatile

    k = pos
    while (k < progend -3)                                                     ' Zeile suchen
          linetest = wpointer(k)                                               ' dann: Zeiger auf Zeilen-Nummer
          if linetest = goline then                                            ' stimmt Zeilen-Nummer?
             result = k   exit                                                 ' dann geht es dort weiter
          end if
          k = k + bpointer(k +2)
    wend
    result = true
    perror = 8                                                                 ' Zeile nicht gefunden
end sub

sub function get_label_adress(dim pos2 as word, dim token as byte, dim leng as word) as ^byte  ' Adresse zu Programmzeile ermitteln
dim l as  longword volatile
dim k as ^char     volatile

    k = prog_mem  result = true
    while k < (progend -2)                                                     ' Zeile suchen
          if bpointer(k +4) = 130 then                                         ' Extender 3 ?
             if bpointer(k +5) = token then                                    ' token:  4 für function,   5 für sub,   6 für proc
                if bpointer(k +6) = progline[pos2] then
                   l=1
                   while (bpointer(k + l + 6) >1) and (progline[l + pos2] >0) and  (bpointer(k + l +6) = progline[l + pos2])
                         inc(l)
                         if l = leng then
                            if (bpointer(k + l +6) <2) or (bpointer(k + l + 6) =123) then   ' Zeilenende, Doppelpunkt oder '{'
                               result = k
                               exit
                            end if
                         end if
                   wend
                end if
             end if
          end if
          k = k + bpointer(k+2)
    wend
    result = true
    perror = 8                                                                 ' Zeile nicht gefunden
end sub

sub procedure goto_line(dim g_line as word)                                    ' Springt zur Zeile
dim aktuell as ^byte volatile

    aktuell = prog_mem
    if pmode=1 then
       if g_line > errline then                                                ' Sprungziel hinter aktueller Zeile?
          aktuell = progadres                                                  ' dann ab hier suchen
       end if
    end if
    progpointer = get_line_adress(g_line, aktuell) -1
    if perror then  exit end if
end sub

