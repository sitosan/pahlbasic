             case 1    uwt("  peek(word)")
             case 2    uwt("  peek(longword)")
             case 3    uwt("  peek(float64)")
           end select
           unl  uwt("RTC_BKP5R.2-3") print_format((RTC_BKP5R >> 2) and 3, 7)
           select case ((RTC_BKP5R >> 2) and 3)
             case 0    uwt("  pointer = ->byte")
             case 1    uwt("  pointer = ->word")
             case 2    uwt("  pointer = ->longword")
             case 3    uwt("  pointer = ->float64")
           end select
           unl  uwt("RTC_BKP5R.4 ")  print_format(testbit(RTC_BKP5R,4),8)  if testbit(RTC_BKP5R,4)  then uwt("  negative Relay-Logic")  else  uwt("  positive Relay-Logic")  end if
           unl  uwt("RTC_BKP5R.5 ")  print_format(testbit(RTC_BKP5R,5),8)  if testbit(RTC_BKP5R,5)  then uwt("  Insert-Mode")  else  uwt("  Overwrite-Mode")  end if
           unl  uwt("RTC_BKP5R.6 ")  print_format(testbit(RTC_BKP5R,6),8)  if testbit(RTC_BKP5R,6)  then uwt("  I2C Scanning on")  else  uwt("  I2C Scanning off")  end if
           unl  uwt("RTC_BKP5R.7 ")  print_format(testbit(RTC_BKP5R,7),8)
