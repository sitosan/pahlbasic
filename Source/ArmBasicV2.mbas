#ifdef 407ZG then
sub procedure TFT_Line_Break                                                   ' Zeilenumbruch
    if TFT_zeile >= TFT_max_z then
       if TFT_scroll_mode>0 then                                               ' Display kann Scrollen?
          if TFT_SCM=0 then
             TFT_SCM=1                                                         ' Zeilenumbruch!
             Parallel_Scroll_Area                                              ' Scrollen aktivieren
             TFT_Scroll_Cnt=1
             TFT_zeile=0
          end if
       end if
    end if
    if TFT_SCM=1 then                                                          ' 1x Scrollen (Zeilenumbruch) aktiviert?
       TFT_scroll   TFT_Spalte=0    inc(TFT_NL_Cnt)                            ' scrollen!  Newline-Zähler erhöhen
       TFT_Umbruch_Zeile = TFT_Zeile
       TFT_SCM=2                                                               ' weiteres Scrollen unterbinden
       TFT_set_cursor2
    else
        if TFT_zeile<TFT_max_z then                                            ' unteres Display-Ende noch nicht erreicht?
           inc(TFT_zeile)    TFT_Spalte=0   inc(TFT_NL_Cnt)                    ' nein!
           TFT_Umbruch_Zeile = TFT_Zeile
           TFT_set_cursor2
        end if
    end if
end sub
#endif

