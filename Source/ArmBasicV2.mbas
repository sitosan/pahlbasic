    timer4_arr=tim4_arr
    TIM4_CR1.7=1                                                               ' Shadow-Register aktivieren
    NVIC_IntEnable(IVT_INT_TIM4)
    TIM4_DIER.UIE      = 1
    TIM4_CR1.CEN       = 1
end sub
