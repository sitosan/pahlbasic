           unl
           uwtnl("RTC_BKP5R.9 ")  print_format(testbit(RTC_BKP5R,9),8)  if testbit(RTC_BKP5R,9)  then uwt("  USB serial Device not activated")  else  uwt("  USB serial Device activated")  end if
           uwtnl("RTC_BKP5R.10")  print_format(testbit(RTC_BKP5R,10),8) if testbit(RTC_BKP5R,10) then uwt("  USB Console switched off")  else  uwt("  USB Console switched on")  end if
           uwtnl("RTC_BKP5R.11")  print_format(testbit(RTC_BKP5R,11),8) if testbit(RTC_BKP5R,11) then uwt("  Keyboard activated")  else  uwt("  Keyboard not activated")  end if
           uwtnl("RTC_BKP5R.17")  print_format(testbit(RTC_BKP5R,17),8) if testbit(RTC_BKP5R,17) then uwt("  Keyboard US")  else  uwt("  Keyboard DE")  end if
           unl
           uwtnl("RTC_BKP5R.12")  print_format(testbit(RTC_BKP5R,12),8) if testbit(RTC_BKP5R,12) then uwt("  Morse Output on Relay16")  else  uwt("  Morse Output on Sound")  end if
           uwtnl("RTC_BKP5R.13")  print_format(testbit(RTC_BKP5R,13),8) if testbit(RTC_BKP5R,13) then uwt("  LED-Coordinate 0,0 is left down")  else  uwt("  LED-Coordinate 0,0 is left up")  end if
           #ifndef 407ZG then
           uwtnl("RTC_BKP5R.14")  print_format(testbit(RTC_BKP5R,14),8) if testbit(RTC_BKP5R,14) then uwt("  I2C2-Bus on PB10/11")  else  uwt("  UART Serial_4 on PB10/11")  end if
           #endif
           uwtnl("RTC_BKP5R.16")  print_format(testbit(RTC_BKP5R,16),8) if testbit(RTC_BKP5R,16) then uwt("  Verbose off")  else  uwt("  Verbose on")  end if
           unl
           uwtnl("RTC_BKP5R.24")  print_format(testbit(RTC_BKP5R,24),8) if testbit(RTC_BKP5R,24) then uwt("  do not use Color Palette")  else  uwt("  use Color Palette")  end if
           uwtnl("RTC_BKP5R.23")  print_format(testbit(RTC_BKP5R,23),8) if testbit(RTC_BKP5R,23) then uwt("  Display rotated")  else  uwt("  Display not rotated")  end if
           uwtnl("RTC_BKP5R.25-27")   print_format((RTC_BKP5R >> 25) and 7,5)
           select case (RTC_BKP5R >> 25) and 7
             case 0    uwt("  no TFT Display connected")
             case 1    uwt("  Display: ILI9488 480x320 SPI")
             case 2    uwt("  Display: ILI9341 320x240 SPI")
             case 3    uwt("  Display: ST7793  480x200 SPI")
             case 4    uwt("  Display: HX8357B Parallel 8Bit")
             case 5    uwt("  Display: HX8357C Parallel 8Bit")
             case 6    uwt("  Display: SSD1963 800x480 Parallel 16Bit")
             case 7    uwt("  Display: ST7789V 320x240 SPI")
           end select
