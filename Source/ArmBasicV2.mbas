    hxwritedata(0x0A)
    hxwritedata(0x08)
    hxwritedata(0x16)
    hxwritedata(0x1A)
    hxwritedata(0x0F)

    hxwritecommand(0XE1)   ' // Negative Gamma Control
    hxwritedata(0x00)
    hxwritedata(0x16)
    hxwritedata(0x19)
    hxwritedata(0x03)
    hxwritedata(0x0F)
