           uwtnl("sys(344):  Stop-Bits com4")

      case "X"
           mm=0
           for nn=0 to 10   if dat_nr[nn] then inc(mm)  end if  next  nn
           if mm then prn(mm)  cwt(" opened files on Flash Chip: ")  else  cwtnl("no files open on Flash Chip") end if
           for nn=0 to 10
               if dat_nr[nn] then
                  cwtnl("#")  print_format(nn +10, 2)  cwt(" Filenumber: ")  print_format(dat_nr[nn], 2)  cwt(" as ")  pr(file_modus[nn],8)
               end if
           next nn

      case "S"
           cwtnl("String Variables:")
           list_stringvar
           
      case 65,66,67,68,69,70,71,72,73,74
           cwtnl("Array ") con(progline[2]) cwt("():")
           list_array(progline[2],progline[3])
           
      case "V"
           list_variables
    end select
    pstr = mpstr
end sub

sub procedure instr_dump
dim p    as word     volatile

    p=run_mode
    set_RAM_adress
    memory_dump
    if p=in_ROM then  set_RAM_adress end if
end sub

sub procedure instr_rdump
dim auto as longword volatile
dim p    as word     volatile

    p=run_mode
    auto=set_ROM_adress
    memory_dump
    if p=in_RAM then  set_RAM_adress end if
end sub
#endif

sub function nibble_to_hex(dim nibble as byte)as byte
    if nibble < 10 then
       result = 48 + nibble
    else
        result = 55 + nibble
    end if
end sub

sub procedure bin_str(dim num as longword, dim lang as word)                   ' Longword-Zahl in Binärstring wandeln
dim n, k, pstart as longword volatile

    pstart=0
    if lang then
       k=0
    else
        k=1   pstr[0] = "%"                                                    ' Kennzeichen für Binärzahl
    end if
    for n=31 to 0 step -1
        if n=3 then pstart=1 end if
        if n = lang then pstart=1 end if
        if testbit(num, n) = 0 then
           if pstart then pstr[k] = 48 end if                                  ' Nullen
        else
            pstr[k] = 49   pstart=1                                            ' und Einsen
        end if
        if pstart then inc(k)  end if                                          ' keine führenden Nullen
    next n
    pstr[k] = 0                                                                ' Zeichenkettenende
end sub

sub procedure print_prompt(dim modus as word)
    if modus=0 then
       cnl                                                                     ' für inputstr, kleine LCDs
    end if
    prompt_flag=0
    if hiliting then
       if (RTC_BKP5R and 32) then                                              ' Insert Mode
          set_konsole_color(6,1,0)
       else
           set_konsole_color(4,1,0)
       end if
    end if
    con(62)                                                                    ' >
    if (konsole_uart>6) and (konsole_uart<32) then
       con(32)
    end if
    cret_sup_flag=0
end sub

sub function hms_str(dim hms as byte)as string[3]
    ByteToStrWithZeros(hms,result)
end sub

sub procedure timestring(dim start_char as word)                               'clock-string zusammensetzen
dim hms as string[3] volatile

    hms = hms_str(hours)
    pstr[start_char +0] = hms[1]
    pstr[start_char +1] = hms[2]
    pstr[start_char +2] = ":"
    hms = hms_str(minutes)
    pstr[start_char +3] = hms[1]
    pstr[start_char +4] = hms[2]
    pstr[start_char +5] = ":"
    if seconds > 59 then                                                       'waehrend der Synchron.-phase
       pstr[start_char +6] = "0"
       pstr[start_char +7] = "0"
    else
        hms = hms_str(seconds)
        pstr[start_char +6] = hms[1]
        pstr[start_char +7] = hms[2]
    end if
    pstr[start_char +8] = 0
end sub

sub procedure datestring(dim start_char as word)                               'date-string zusammensetzen
dim hms as string[3] volatile

    select case language
      case 0    pstr[start_char +0] = dowstr_de[dow][0]
                pstr[start_char +1] = dowstr_de[dow][1]
      case 1    pstr[start_char +0] = dowstr_en[dow][0]
                pstr[start_char +1] = dowstr_en[dow][1]
                pstr[start_char +2] = dowstr_en[dow][2]
                inc(start_char)
    end select
    pstr[start_char +2] = ","
    pstr[start_char +3] = 32
    select case language
      case 0,2  hms = hms_str(days)
      case 1    hms = hms_str(months)
    end select
    pstr[start_char +4] = hms[1]
    pstr[start_char +5] = hms[2]
    if language=0 then
       pstr[start_char +6] = "."
    else
        pstr[start_char +6] = "-"
    end if
    select case language
      case 0,2  hms = hms_str(months)
      case 1    hms = hms_str(days)
    end select
    pstr[start_char +7] = hms[1]
    pstr[start_char +8] = hms[2]
    if language=0 then
       pstr[start_char +9] = "."
    else
        pstr[start_char +9] = "-"
    end if
    hms = hms_str(years)
    pstr[start_char +10] = "2"
    pstr[start_char +11] = "0"
    pstr[start_char +12] = hms[1]
    pstr[start_char +13] = hms[2]
    pstr[start_char +14] = 0
end sub

sub procedure set_textarray_string(dim text_indexb as word)                    ' wird für read gebraucht
dim n, byteadres as longword volatile

    if text_indexb > (textlines -1) then  exit end if
    n=0  byteadres = (textlineslen * text_indexb)
    while (n < 127) and (pstr[n] > 0)
          ccm_ram_write_byte(pstr[n], byteadres)
          inc(n)   inc(byteadres)
    wend
    ccm_ram_write_byte(0, byteadres)
end sub

sub procedure clear_com0_pointer                                               '
    ser_zeiger=0   mvar=0
end sub

sub procedure clear_buffer1                                                    ' Konsole-Empfangspuffer loeschen
    memset(@recstr1, 0, fifo1)
    ser1_zeiger=0   mvar1=0
end sub

sub procedure clear_buffer2                                                    ' MIDI-Empfangspuffer loeschen
    memset(@recstr2, 0, fifo2)
    ser2_zeiger=0   mvar2=0                                                    ' Zeiger auf Null, Merktaste, Fehler auf Null
end sub

#ifndef 411 then
sub procedure clear_buffer3                                                    ' GPS-Empfangspuffer loeschen
    memset(@recstr3, 0, fifo3)
    ser3_zeiger=0   mvar3=0                                                    ' Zeiger auf Null, gemerktes Zeichen, Fehler auf Null
end sub

sub procedure clear_buffer4                                                    ' ser4-Empfangspuffer loeschen
    memset(@recstr4, 0, fifo4)
    ser4_zeiger=0   mvar4=0                                                    ' Zeiger auf Null, Merktaste, Fehler auf Null
end sub

sub procedure clear_usb_buffer                                                 ' USB-Empfangspuffer loeschen
    memset(@recstrusb, 0, usbfifo)
    usb_zeiger=0    mvarusb=0                                                  ' Zeiger auf Null, Merktaste, Fehler auf Null
end sub

sub procedure clear_matrix_buffer                                              ' Matrix-Empfangspuffer loeschen
    memset(@recstr8, 0, fifo8)
    ser8_zeiger=0   mvar8=0                                                    ' Zeiger auf Null, Merktaste, Fehler auf Null
end sub
#endif

sub procedure clear_uart_buffer(dim uartnr as word)                            ' UARTpuffer löschen
    select case   uartnr
      case 1,7    clear_buffer1
      case 2      clear_buffer2
      #ifndef 411 then
      case 3      clear_buffer3
      case 4      clear_buffer4
      case 5,6,9  clear_usb_buffer
      case 8,30   clear_matrix_buffer
      case 31     clear_buffer1
                  clear_matrix_buffer
      #endif
    end select
end sub

sub procedure clear_konsole_buffer
    clear_uart_buffer(konsole_uart)
    clear_com0_pointer
end sub

sub procedure clear_buffers                                                    ' alle Schnittstellenpuffer löschen
    clear_buffer1
    clear_buffer2
    #ifndef 411 then
    clear_buffer3
    clear_buffer4
    clear_usb_buffer
    clear_matrix_buffer
    #endif
    clear_com0_pointer
end sub

sub procedure clear_calc_stack                                                 ' Rechenargumentstapel für calculate_exp löschen
dim n as longword volatile

    calcstack=0
    calc_instance=0
    for n=0 to loopdepth -1
        calc_arg[n]=0.0                                                        ' Rechenargumentstapel für calculate_exp
        calc_oper[n]=0                                                         ' Rechenoperation-Stapel         "
        calc_fn[n]=0                                                           ' Rechenfunktion-Stapel          "
    next n
end sub

sub procedure clear_stacks                                                     ' alle Schleifen und Stapel löschen
dim n as longword volatile

    gostack=0                                                                  ' Stackpointer für gosub und loops
    mgostack=0                                                                 ' Stackmerker
    ifstack=0
    mifstack=0
    selstack=0
    mselstack=0
    loopcounter=0                                                              ' loop-Zähler
    mloopcounter=0
    task_nr=0
    for n=0 to loopdepth -1
        loop_end[n]=0.0                                                        ' Endwert für for
        loopstep[n]=0.0                                                        ' Schrittweite für for
        loopvar[n]=0                                                           ' loop-Variable
        returnadr[n]=0                                                         ' Return-Adresse-Stapel
        cont_adres[n]=0                                                        ' cont-Adresse-Stapel
        exit_adres[n]=0                                                        ' exit-Adresse-Stapel
        select_var[n]=0.0                                                      ' Select Variable
        select_flag[n]=0                                                       ' Select Flag
        select_str_len[n]=0
        then_flag[n]=0                                                         ' If-wahr-Flag
    next n
end sub

sub procedure clear_varstr(dim str_nbr as word)                                ' Stringvar löschen
    memset(@varstr[str_nbr], 0, stringlen)
end sub

sub procedure clear_pstr                                                       ' Arbeitsstring löschen
    memset(@pstr, 0, stringlen)
end sub

sub procedure clear_qstr                                                       ' Ergebnisstring löschen
    memset(@qstr, 0, stringlen)
end sub

sub procedure clear_listline                                                   ' List-Zwischenspeicher löschen
    memset(@listline[actual_line], 0, stringlen)
end sub

sub procedure sort_listline
dim n as word volatile

    if actual_line<(listmax-2) then
          inc(actual_line)
       else
           for n=0 to listmax-3
               listline[n]=listline[n+1]
           next n
           actual_line=listmax -2
       end if
end sub

sub procedure clear_progline                                                   ' Anweisungs-Zeile löschen
    memset(@progline, 0, stringlen)
end sub

sub function wait_key as byte
    clear_com0_pointer
    while  ser_zeiger=0  IWDG_KR=0xAAAA  wend
    result = get_one_konsole_byte
end sub

sub function wait_key2 as byte
    cwt("press a key")   con(13)
    clear_com0_pointer
    while  ser_zeiger=0  IWDG_KR=0xAAAA  wend
    'if osk_started then
'       while T_IRRPT=0   wend                                                  ' auf Stiftabheben warten
'    end if
    cwt("           ")   con(13)
    result=mvar  clear_com0_pointer
end sub

sub function TFT_Output as word
    result= (lcd=1) or ((konsole_uart>6) and (konsole_uart<32))
end sub

sub procedure TFT_wait_key                                                     ' auf Taste warten - für TFT-Ausgabe
dim muart as word volatile

    muart=uart_nr
    if TFT_Output then                                                         ' TFT-Ausgabe?
       TFT_NL_Cnt=0
       if konsole_uart=31 then  uart_nr=1  unl  uart_nr=31 end if              ' Newline auf Interface 1
       uwt("press a key")   uart(13)
       if konsole_uart=31 then  uart_nr=1  uart(27)  uart(91)  uart("1")  uart("A")  uart_nr=31 end if  ' Cursor 1 up auf Interface 1
       clear_com0_pointer
       while  ser_zeiger=0   IWDG_KR=0xAAAA  wend
       #ifdef 407ZG then
       if osk_started then
          while T_IRRPT=0   IWDG_KR=0xAAAA   delay20   wend                    ' auf Key up warten
       end if
       #endif
       #ifdef VG then
       if osk_started then
          while T_IRRPT=0   IWDG_KR=0xAAAA   delay20   wend                    ' auf Key up warten
       end if
       #endif
       if konsole_uart=31 then  
          uart_nr=9
          print_spaces2(20)   con(13)                                          ' nur auf TFT
          uart_nr=31
       end if
       if mvar=3 then
          uart_nr=NULL                                                         ' Umleitung ins Gerät 25 (Null)
          clear_com0_pointer   perror=0   prompt_flag=1
          print_spaces2(20)   con(13)                                          ' für Interface31: auch auf Interface 1
          exit
       else
           get_one_konsole_byte
           clear_com0_pointer
       end if
       if TFT_scroll_mode=0 then                                               ' TFT kann nicht scrollen
          TFT_Cls(1)
       end if
    end if
end sub

#ifndef 411 then
sub procedure Read_DS_ID                                                       ' ID des DS18x20 Sensors lesen
dim n       as word    volatile
dim DS_ID   as uint64  volatile
dim id_byte as byte[8] volatile
dim ds_typ  as byte    volatile

    int_off
    delay_us(150)
    DS_ID=0
    Ow_Reset(GPIOA_ODR, 7)                                                     ' Onewire reset signal
    Ow_Write(GPIOA_ODR, 7, 0x33)                                               ' read ROM
    for n=0 to 7
        id_byte[n] = Ow_Read(GPIOA_ODR, 7)
    next n
    delay_us(150)
    int_on
    for n=7 to 0  step -1
        DS_ID = DS_ID << 8
        DS_ID = DS_ID or id_byte[n]
    next n
    ds_typ = id_byte[0]
    select case ds_typ
      case 0x28 sys("Temperature Sensor is DS18B20",0)
      case 0x10 sys("Temperature Sensor is DS1820/DS18S20",0)
      case else sys("Unknown Temperature Sensor: ",0)   prh(ds_typ)
    end select
    uint64tostr(DS_ID, pstr)
end sub

sub function start_conversion(dim pin as byte) as word                         ' Messwandlung auf PinPA6 oder PinPA7 starten
    if (pin<6) and (pin>7) then perror=13 exit  end if
    int_off
    delay_us(15)
    Ow_Reset(GPIOA_ODR, pin)                                                   ' Onewire reset signal
    Ow_Write(GPIOA_ODR, pin, 0xCC)                                             ' skip ROM
    Ow_Write(GPIOA_ODR, pin, 0x44)                                             ' CONVERT_T
    delay_us(150)
    int_on
    result=1
end sub

sub function read_temp(dim pinn as longword, dim sw as word) as float          ' auslesen des DS18S20   sw=0 Messwert lesen,  sw=1 Messvorgang starten
dim pinbytes    as byte[8] volatile
    temp        as word    volatile
    n           as word    volatile
    pin, ds_typ as byte    volatile
    strptr      as ^char   volatile
    DS_ID       as uint64  volatile
    
    if pinn>7 then
       strptr = pinn
       DS_ID=0    n=0
       while (strptr^ > 47) and (strptr^ < 58) and (n<22)
             DS_ID = 10 * DS_ID + strptr^ -48
             inc(strptr)  inc(n)
       wend
       for n=0 to 7
           pinbytes[n] = lo(DS_ID)
           DS_ID = DS_ID >> 8
       next n
       ds_typ = pinbytes[0]
       int_off
       delay_us(15)
       Ow_Reset(GPIOA_ODR, 6)                                                  ' Onewire reset signal
       Ow_Write(GPIOA_ODR, 6, 0x55)                                            ' match ROM
       for n=0 to 7                                                            ' send 64Bit-ID
           Ow_Write(GPIOA_ODR, 6, pinbytes[n])
       next n
       if sw=0 then
          Ow_Write(GPIOA_ODR, 6, 0xBE)                                         ' read scratchpad  'Temperatur Auslesen Start
          temp =  Ow_Read(GPIOA_ODR, 6)                                        ' Temperatur low lesen
          temp = (Ow_Read(GPIOA_ODR, 6) << 8 ) + temp                          ' Temperatur low lesen
       else
           Ow_Write(GPIOA_ODR, 6, 0x44)                                        ' CONVERT_T
           delay_us(150)
           int_on
           exit
       end if
    else
        select case pinn
          case 6    pin=6
          case 7    pin=7
          case else perror=13   sys("One Wire Pin Number?",0)  exit
        end select
        int_off
        delay_us(15)
        Ow_Reset(GPIOA_ODR, pin)                                               ' Onewire reset signal
        Ow_Write(GPIOA_ODR, pin, 0x33)                                         ' read ROM
        ds_typ = Ow_Read(GPIOA_ODR, pin)                                       ' DS18B20 oder ?
        n      = Ow_Read(GPIOA_ODR, pin)
        n      = Ow_Read(GPIOA_ODR, pin)
        n      = Ow_Read(GPIOA_ODR, pin)
        n      = Ow_Read(GPIOA_ODR, pin)
        n      = Ow_Read(GPIOA_ODR, pin)
        n      = Ow_Read(GPIOA_ODR, pin)
        n      = Ow_Read(GPIOA_ODR, pin)
        delay_us(150)
        int_on
        delay10
        int_off
        delay_us(15)
        Ow_Reset(GPIOA_ODR, pin)                                               ' Onewire reset signal
        Ow_Write(GPIOA_ODR, pin, 0xCC)                                         ' SKIP_ROM
        Ow_Write(GPIOA_ODR, pin, 0xBE)                                         ' read scratchpad
        temp =  Ow_Read(GPIOA_ODR, pin)                                        ' lesen
        temp = (Ow_Read(GPIOA_ODR, pin) << 8 ) + temp
    end if
    if (temp and 0x8000) then                                                  ' negativ?
       temp = (not temp) + 1                                                   ' 2er-complement
       n=1
    else
        n=0
    end if
    result=0
    select case  ds_typ
      case 0x28  if (temp and 1) then result = result + 0.0625 end if          ' DS18B20
                 if (temp and 2) then result = result + 0.125 end if
                 if (temp and 4) then result = result + 0.25 end if
                 if (temp and 8) then result = result + 0.5 end if
                 result = result + ((temp >> 4) and 255)
      case 0x10  if (temp and 1) then result = result + 0.5 end if             ' DS18S20
                 result = result + ((temp >> 1) and 255)
      case else  if (temp and 1) then result = result + 0.0625 end if          ' DS18B20
                 if (temp and 2) then result = result + 0.125 end if
                 if (temp and 4) then result = result + 0.25 end if
                 if (temp and 8) then result = result + 0.5 end if
                 result = result + ((temp >>4) and 255)
    end select
    if n then
       result = result * (-1)
    end if
    int_on
end sub
#endif

'Touch 2046 Routinen
sub procedure get_coord_raw
dim a, b, c, d as word volatile                                                ' Koordinatenzwischenspeicher

    #ifndef 411 then
    spi2_speed(128)
    #else
    spi2_speed(64) '64)
    #endif
    c=0  d=0
    T_CS=0
    spi2_write(0x90)
    a = spi2_read(0)   b = spi2_read(0)
    c = ((a <<8) +b) >>3
    spi2_write(0xD0)
    a = spi2_read(0)   b = spi2_read(0)
    T_CS=1
    d = ((a <<8) +b) >>3
    if xy_bit then
       x_raw = d   y_raw = c
    else
        x_raw = c   y_raw = d
    end if
    if lr_bit then
       x_raw = 4095-x_raw
    end if
    if ou_bit then
       y_raw = 4095-y_raw
    end if
    spi2_speed(TFT_SPI_Speed)
    'prn(X_raw)  prn(Y_raw)   cnl
end sub

sub function XPT2046_read(dim m as longword) as word
dim a, b, c, d, e, n as longword volatile

    wait_touch_press
    result=0  key_press_time=0  c=0  d=0  e=0  n=0
    while T_IRRPT=0
          IWDG_KR=0xAAAA
          get_coord_raw
          a = word(float(x_raw) * X_factor) + x_offset
          b = word(float(y_raw) * Y_factor) + y_offset
          d=d+a   e=e+b   inc(n)
          inc(key_press_time)
          if key_press_time>50 then
             if m then  TFT_Write_Char("A",1,1) end if
          end if
          if mvar=3 then  exit end if
          delay10
    wend
    a = d div n   b = e div n
    if (a < TFT_With) and (b < TFT_Hight) then  x_coord=a   y_coord=b    result=1  end if
end sub

sub procedure spi2_speed(dim speed as longword)
    select case speed
      case 2
      SPI2_Init_Advanced(_SPI_FPCLK_DIV2,   _SPI_MASTER OR _SPI_8_BIT OR _SPI_CLK_IDLE_LOW OR _SPI_FIRST_CLK_EDGE_TRANSITION OR _SPI_MSB_FIRST OR _SPI_SS_DISABLE OR _SPI_SSM_ENABLE OR _SPI_SSI_1, @_GPIO_MODULE_SPI2_PB13_14_15)
      case 4
      SPI2_Init_Advanced(_SPI_FPCLK_DIV4,   _SPI_MASTER OR _SPI_8_BIT OR _SPI_CLK_IDLE_LOW OR _SPI_FIRST_CLK_EDGE_TRANSITION OR _SPI_MSB_FIRST OR _SPI_SS_DISABLE OR _SPI_SSM_ENABLE OR _SPI_SSI_1, @_GPIO_MODULE_SPI2_PB13_14_15)
      case 8
      SPI2_Init_Advanced(_SPI_FPCLK_DIV8,   _SPI_MASTER OR _SPI_8_BIT OR _SPI_CLK_IDLE_LOW OR _SPI_FIRST_CLK_EDGE_TRANSITION OR _SPI_MSB_FIRST OR _SPI_SS_DISABLE OR _SPI_SSM_ENABLE OR _SPI_SSI_1, @_GPIO_MODULE_SPI2_PB13_14_15)
      case 16
      SPI2_Init_Advanced(_SPI_FPCLK_DIV16,  _SPI_MASTER OR _SPI_8_BIT OR _SPI_CLK_IDLE_LOW OR _SPI_FIRST_CLK_EDGE_TRANSITION OR _SPI_MSB_FIRST OR _SPI_SS_DISABLE OR _SPI_SSM_ENABLE OR _SPI_SSI_1, @_GPIO_MODULE_SPI2_PB13_14_15)
      case 32
      SPI2_Init_Advanced(_SPI_FPCLK_DIV32,  _SPI_MASTER OR _SPI_8_BIT OR _SPI_CLK_IDLE_LOW OR _SPI_FIRST_CLK_EDGE_TRANSITION OR _SPI_MSB_FIRST OR _SPI_SS_DISABLE OR _SPI_SSM_ENABLE OR _SPI_SSI_1, @_GPIO_MODULE_SPI2_PB13_14_15)
      case 64
      SPI2_Init_Advanced(_SPI_FPCLK_DIV64,  _SPI_MASTER OR _SPI_8_BIT OR _SPI_CLK_IDLE_LOW OR _SPI_FIRST_CLK_EDGE_TRANSITION OR _SPI_MSB_FIRST OR _SPI_SS_DISABLE OR _SPI_SSM_ENABLE OR _SPI_SSI_1, @_GPIO_MODULE_SPI2_PB13_14_15)
      case 128
      SPI2_Init_Advanced(_SPI_FPCLK_DIV128, _SPI_MASTER OR _SPI_8_BIT OR _SPI_CLK_IDLE_LOW OR _SPI_FIRST_CLK_EDGE_TRANSITION OR _SPI_MSB_FIRST OR _SPI_SS_DISABLE OR _SPI_SSM_ENABLE OR _SPI_SSI_1, @_GPIO_MODULE_SPI2_PB13_14_15)
      case 256
      SPI2_Init_Advanced(_SPI_FPCLK_DIV256, _SPI_MASTER OR _SPI_8_BIT OR _SPI_CLK_IDLE_LOW OR _SPI_FIRST_CLK_EDGE_TRANSITION OR _SPI_MSB_FIRST OR _SPI_SS_DISABLE OR _SPI_SSM_ENABLE OR _SPI_SSI_1, @_GPIO_MODULE_SPI2_PB13_14_15)
    end select
end sub

'TFT Routinen
#ifdef 405RG then                                                              ' auf 405RG gibt es kein paralleles TFT-LCD
   #ifdef VG then
   sub procedure Parallel_Set_Index(dim index as byte)                         ' F405RG_Firmware auf 407VG-Board
   const 
       WR_Hi=(1<<14)
       WR_Lo=(1<<30)
       RS_Hi=(1<<10)
       RS_Lo=(1<<26)
       RS_Lo_WR_Lo=(RS_Lo or WR_Lo)

       GPIOD_BSRR=RS_Lo_WR_Lo                                                  ' TFT_RS=0   TFT_WR=0
       GPIOE_ODR=word(index)
       GPIOD_BSRR=WR_Hi                                                        ' TFT_WR=1
   end sub

   sub procedure Parallel_Write_Command(dim cmd as byte)                       ' F405RG_Firmware auf 407VG-Board
   const 
       WR_Hi=(1<<14)
       WR_Lo=(1<<30)
       RS_Hi=(1<<10)
       RS_Hi_WR_Lo=(RS_Hi or WR_LO)

       GPIOD_BSRR=RS_Hi_WR_Lo                                                  ' TFT_RS=1   TFT_WR=0
       GPIOE_ODR=word(cmd)
       GPIOD_BSRR=WR_Hi                                                        ' TFT_WR=1
   end sub

   sub procedure Parallel_Set_Address_SSD1963(dim x1 as word y1 as word x2 as word y2 as word)    ' F405RG_Firmware auf 407VG-Board
       Parallel_Set_Index(0x2a)                                                ' SET column address
       Parallel_Write_Command(x1 >> 8)
       Parallel_Write_Command(x1)
       Parallel_Write_Command(x2 >> 8)
       Parallel_Write_Command(x2)
       'prn(x1)  prn(x2)
       Parallel_Set_Index(0x2b)                                                ' SET page address
       Parallel_Write_Command(y1 >> 8)
       Parallel_Write_Command(y1)
       Parallel_Write_Command(y2 >> 8)
       Parallel_Write_Command(y2)
       'prn(y1)  prn(y2)
       Parallel_Set_Index(0x2C)
   end sub

   sub procedure Parallel_Set_Address_SSD1963_2(dim x1 as word y1 as word x2 as word y2 as word)    ' F405RG_Firmware auf 407VG-Board
       Parallel_Set_Index(0x2a)                                                ' SET column address
       Parallel_Write_Command(x1 >> 8)
       Parallel_Write_Command(x1)
       Parallel_Write_Command(x2 >> 8)
       Parallel_Write_Command(x2)
       if TFT_X<x1 then TFT_X=x1 end if
       'prn(x1)  prn(x2)
       Parallel_Set_Index(0x2b)                                                ' SET page address
       Parallel_Write_Command(y1 >> 8)
       Parallel_Write_Command(y1)
       Parallel_Write_Command(y2 >> 8)
       Parallel_Write_Command(y2)
       'prn(y1)  prn(y2)
       Parallel_Set_Index(0x2C)
   end sub

   sub procedure Parallel_Set_Address3_SSD1963(dim x1 as word y1 as word x2 as word y2 as word)   ' F405RG_Firmware auf 407VG-Board
       Parallel_Set_Index(0x2a)                                                ' SET column address
       Parallel_Write_Command(x1 >> 8)
       Parallel_Write_Command(x1)
       Parallel_Write_Command(x2 >> 8)
       Parallel_Write_Command(x2)
       'prn(x1)  prn(x2)
       Parallel_Set_Index(0x2b)                                                ' SET page address
       Parallel_Write_Command(y1 >> 8)
       Parallel_Write_Command(y1)
       Parallel_Write_Command(y2 >> 8)
       Parallel_Write_Command(y2)
       'prn(y1)  prn(y2)
       Parallel_Set_Index(0x2E)
   end sub

   sub procedure Parallel_Write_Data16(dim wdata as word)                      ' F405RG_Firmware auf 407VG-Board
   const
       WR_Hi=(1<<14)
       WR_Lo=(1<<30)
       RS_Hi=(1<<10)
       RS_Hi_WR_Lo=(RS_Hi or WR_LO)

       GPIOD_BSRR=RS_Hi_WR_Lo                                                  ' TFT_RS=1   TFT_WR=0
       GPIOE_ODR = wdata
       GPIOD_BSRR=WR_Hi                                                        ' TFT_WR=1
   end sub

   sub function Parallel_Read_Data16() as word                                 ' F405RG_Firmware auf 407VG-Board
   const
       RD_Hi=(1<<13)
       RD_Lo=(1<<29)
       RS_Hi=(1<<05)
       RS_Hi_RD_Lo=(RS_Hi or RD_LO)
         
       GPIOD_BSRR=RS_Hi_RD_Lo
       asm
          nop
          nop
          nop
          nop
          nop
          nop
          nop
          nop
       end asm
       result=GPIOE_IDR
       GPIOD_BSRR=RD_Hi
   end sub

   sub procedure Parallel_Write_Palette16_Data(dim wdata as word)              ' F405RG_Firmware auf 407VG-Board
   const
       WR_Hi=(1<<14)
       WR_Lo=(1<<30)
       RS_Hi=(1<<10)
       RS_Hi_WR_Lo=(RS_Hi or WR_LO)

       GPIOD_BSRR=RS_Hi_WR_Lo                                                  ' TFT_RS=1   TFT_WR=0
       GPIOE_ODR=word(cl_palette[wdata and colormax_min1])
       GPIOD_BSRR=WR_Hi                                                        ' TFT_WR=1
   end sub

   sub procedure Parallel_Scroll_Area                                          ' F405RG_Firmware auf 407VG-Board
   const 
       CS_Hi=(1<<09)
       CS_Lo=(1<<25)

       GPIOD_BSRR=CS_Lo                                                        ' TFT_CS=0
       Parallel_Set_Index(0x33)
       Parallel_Write_Command(0)
       Parallel_Write_Command(0)
       Parallel_Write_Command(0x01)
       Parallel_Write_Command(0xD0)
       Parallel_Write_Command(0)
       Parallel_Write_Command(0)
       GPIOD_BSRR=CS_Hi                                                        ' TFT_CS=1
       TFT_scroll_cnt=0
       TFT_zeile=0
   end sub

   sub procedure Parallel_Scroll_Undone                                        ' F405RG_Firmware auf 407VG-Board
   const 
       CS_Hi=(1<<09)
       CS_Lo=(1<<25)

       Parallel_Scroll_area
       GPIOD_BSRR=CS_Lo                                                        ' TFT_CS=0
       Parallel_Set_Index(0x37)
       Parallel_Write_Command(0)
       Parallel_Write_Command(0)
       GPIOD_BSRR=CS_Hi                                                        ' TFT_CS=1
   end sub

   sub procedure Parallel_Scroll(dim lines as word)                            ' F405RG_Firmware auf 407VG-Board
   const 
       CS_Hi=(1<<09)
       CS_Lo=(1<<25)

       GPIOD_BSRR=CS_Lo                                                        ' TFT_CS=0
       Parallel_Set_Index(0x37)
       Parallel_Write_Command(Hi(lines))
       Parallel_Write_Command(Lo(lines))
       GPIOD_BSRR=CS_Hi                                                        ' TFT_CS=1
   end sub

   sub procedure TFT_Scroll_1Line                                              ' F405RG_Firmware auf 407VG-Board
       if TFT_Scroll_Cnt < (tft_max_z+1) then
          Parallel_Scroll(TFT_Scroll_Cnt*16)
          inc(TFT_Scroll_Cnt)
       else
           TFT_Scroll_Cnt=0
           Parallel_Scroll(TFT_Scroll_Cnt*16)
           inc(TFT_Scroll_Cnt)
       end if
   end sub
   #endif
#endif

#ifdef 407ZG then
sub procedure Parallel_Set_Index(dim index as byte)                            ' F407ZG
const
    WR_Hi=(1<<11)
    WR_Lo=(1<<27)                                                 '
    RS_Lo=(1<<28)
    WR_Lo_RS_Lo=(WR_Lo or RS_Lo)
      
    GPIOD_BSRR=WR_Lo_RS_Lo                                                     ' TFT_WR=0  TFT_RS=0
    GPIOF_ODR=word(index)
    GPIOD_BSRR=WR_Hi                                                           ' TFT_WR=1
end sub

sub procedure Parallel_Write_Command(dim cmd as byte)                          ' F407ZG
const
    WR_Hi=(1<<11)
    WR_Lo=(1<<27)                                                 '
    RS_Hi=(1<<12)
    WR_Lo_RS_Hi=(WR_Lo or RS_Hi)
                                                                               '   5432 1098 7654 3210
    GPIOD_BSRR=WR_Lo_RS_Hi    'TFT_WR=0  TFT_RS=1                              ' 0x0000 0000 0000 0000
    GPIOF_ODR=word(cmd)
    GPIOD_BSRR=WR_Hi                                                           ' TFT_WR=1
end sub

sub procedure Parallel_Set_Address_SSD1963(dim x1 as word y1 as word x2 as word y2 as word)  ' F407ZG
    Parallel_Set_Index(0x2a)                                                   ' SET column address
    Parallel_Write_Command(x1 >> 8)
    Parallel_Write_Command(x1)
    Parallel_Write_Command(x2 >> 8)
    Parallel_Write_Command(x2)
    'prn(x1)  prn(x2)
    Parallel_Set_Index(0x2b)                                                   ' SET page address
    Parallel_Write_Command(y1 >> 8)
    Parallel_Write_Command(y1)
    Parallel_Write_Command(y2 >> 8)
    Parallel_Write_Command(y2)
    'prn(y1)  prn(y2)
    Parallel_Set_Index(0x2C)
end sub

sub procedure Parallel_Set_Address_SSD1963_2(dim x1 as word y1 as word x2 as word y2 as word)   ' F407ZG
    Parallel_Set_Index(0x2a)                                                   ' SET column address
    Parallel_Write_Command(x1 >> 8)
    Parallel_Write_Command(x1)
    Parallel_Write_Command(x2 >> 8)
    Parallel_Write_Command(x2)
    if TFT_X<x1 then TFT_X=x1 end if
    'prn(x1)  prn(x2)
    Parallel_Set_Index(0x2b)                                                   ' SET page address
    Parallel_Write_Command(y1 >> 8)
    Parallel_Write_Command(y1)
    Parallel_Write_Command(y2 >> 8)
    Parallel_Write_Command(y2)
    'prn(y1)  prn(y2)
    Parallel_Set_Index(0x2C)
end sub

sub procedure Parallel_Set_Address3_SSD1963(dim x1 as word y1 as word x2 as word y2 as word)    ' F407ZG
    Parallel_Set_Index(0x2a)                                                   ' SET column address
    Parallel_Write_Command(x1 >> 8)
    Parallel_Write_Command(x1)
    Parallel_Write_Command(x2 >> 8)
    Parallel_Write_Command(x2)
    'prn(x1)  prn(x2)
    Parallel_Set_Index(0x2b)                                                   ' SET page address
    Parallel_Write_Command(y1 >> 8)
    Parallel_Write_Command(y1)
    Parallel_Write_Command(y2 >> 8)
    Parallel_Write_Command(y2)
    'prn(y1)  prn(y2)
    Parallel_Set_Index(0x2E)
end sub

sub procedure Parallel_Write_Data16(dim wdata as word)                         ' F407ZG
const
    WR_Hi=(1<<11)
    WR_Lo=(1<<27)                                                 '
    RS_Hi=(1<<12)
    WR_Lo_RS_Hi=(WR_Lo or RS_Hi)
      
    GPIOD_BSRR=WR_Lo_RS_Hi                                                     ' TFT_WR=0  TFT_RS=1
    GPIOF_ODR = wdata
    GPIOD_BSRR=WR_Hi                                                           ' TFT_WR=1
end sub

sub function Parallel_Read_Data16() as word                                    ' F407ZG
const
    RD_Hi=(1<<10)
    RD_Lo=(1<<26)
    RS_Hi=(1<<12)
    RS_Hi_RD_Lo=(RS_Hi or RD_Lo)

    GPIOD_BSRR=RS_Hi_RD_Lo
    asm
       nop
       nop
       nop
       nop
       nop
       nop
       nop
       nop
    end asm
    result=GPIOF_IDR
    GPIOD_BSRR=RD_Hi
end sub

sub procedure Parallel_Write_Palette16_Data(dim wdata as word)                 ' F407ZG
const
    WR_Hi=(1<<11)
    WR_Lo=(1<<27)                                                 '
    RS_Hi=(1<<12)
    WR_Lo_RS_Hi=(WR_Lo or RS_Hi)
      
    GPIOD_BSRR=WR_Lo_RS_Hi                                                     ' TFT_WR=0  TFT_RS=1
    GPIOF_ODR=word(cl_palette[wdata and colormax_min1])
    GPIOD_BSRR=WR_Hi                                                           ' TFT_WR=1
end sub

sub procedure Parallel_Scroll_Area                                             ' F407ZG
const 
    CS_Hi=(1<<13)
    CS_Lo=(1<<29)
      
    GPIOD_BSRR=CS_Lo                                                           ' TFT_CS=0
    nop  nop  nop
    Parallel_Set_Index(0x33)
    Parallel_Write_Command(0)
    Parallel_Write_Command(0)
    Parallel_Write_Command(0x01)
    Parallel_Write_Command(0xD0)
    Parallel_Write_Command(0)
    Parallel_Write_Command(0)
    nop  nop  nop
    GPIOD_BSRR=CS_Hi                                                           ' TFT_CS=1
    TFT_scroll_cnt=0
    TFT_zeile=0
end sub

sub procedure Parallel_Scroll_Undone                                           ' F407ZG
const 
    CS_Hi=(1<<13)
    CS_Lo=(1<<29)
      
    Parallel_Scroll_area
    GPIOD_BSRR=CS_Lo                                                           ' TFT_CS=0
    nop  nop  nop
    Parallel_Set_Index(0x37)
    Parallel_Write_Command(0)
    Parallel_Write_Command(0)
    nop  nop  nop
    GPIOD_BSRR=CS_Hi                                                           ' TFT_CS=1
end sub

sub procedure Parallel_Scroll(dim lines as word)                               ' F407ZG
const 
    CS_Hi=(1<<13)
    CS_Lo=(1<<29)
      
    GPIOD_BSRR=CS_Lo                                                           ' TFT_CS=0
    nop  nop  nop
    Parallel_Set_Index(0x37)
    Parallel_Write_Command(Hi(lines))
    Parallel_Write_Command(Lo(lines))
    nop  nop  nop
    GPIOD_BSRR=CS_Hi                                                           ' TFT_CS=1
end sub

sub procedure TFT_Scroll_1Line                                                 ' F407ZG
    if TFT_Scroll_Cnt < (tft_max_z+1) then
       Parallel_Scroll(TFT_Scroll_Cnt*16)
       inc(TFT_Scroll_Cnt)
    else
        TFT_Scroll_Cnt=0
        Parallel_Scroll(TFT_Scroll_Cnt*16)
        inc(TFT_Scroll_Cnt)
    end if
end sub
#endif

sub procedure SPI_Set_Index(dim index as byte)
    TFT_RS=0
    spi2_write(index)
end sub

sub procedure SPI_Write_Command(dim cmd as byte)
    TFT_RS=1
    spi2_write(cmd)
end sub

sub procedure SPI_Write_Palette16_Data(dim wdata as word)
    TFT_RS=1
    spi2_write((cl_palette[wdata and colormax_min1] >>8) xor TFT_Invers8)
    spi2_write((cl_palette[wdata and colormax_min1]) xor TFT_Invers8)
end sub

sub procedure SPI_Write_Palette24_Data(dim wdata as word)
    TFT_RS=1
    blu8 = cl_palette[wdata and colormax_min1] >>16
    spi2_write(blu8 xor TFT_Invers8)
    grn8 = cl_palette[wdata and colormax_min1] >>8
    spi2_write(grn8 xor TFT_Invers8)
    red8 = cl_palette[wdata and colormax_min1]
    spi2_write(red8 xor TFT_Invers8)
end sub

sub procedure SPI_Write_Data24(dim wdata as word)                              ' ???
    TFT_RS=1
    blu8 = (wdata and 31) <<3
    spi2_write(blu8 xor TFT_Invers8)
    grn8 = ((wdata >> 5) and 63) <<2
    spi2_write(grn8 xor TFT_Invers8)
    red8 = ((wdata >> 11) and 31) <<3
    spi2_write(red8 xor TFT_Invers8)
end sub

sub procedure SPI_Write_Data32(dim wdata as longword)                          ' ???
    wdata=wdata xor TFT_Invers32
    TFT_RS=1
    spi2_write(wdata >>16)
    spi2_write(wdata >>8)
    spi2_write(wdata)
end sub

sub procedure SPI_Write_Data16(dim wdata as word)
    wdata=wdata xor TFT_Invers16
    TFT_RS=1
    spi2_write(wdata >>8)
    spi2_write(wdata)
end sub

sub procedure SPI_Write_Data8(dim wdata as byte)
    TFT_RS=1
    spi2_write(wdata xor TFT_Invers8)
end sub

sub procedure HXwritecommand(dim c as byte)
    #ifdef 405RG
       #ifdef VG then
    if TFT_Type>4 then
       Parallel_Set_Index(c)
    else
        SPI_Set_Index(c)
    end if
       #else
    SPI_Set_Index(c)
       #endif
    #endif
    #ifdef 407mini then
    SPI_Set_Index(c)
    #endif
    #ifdef 407ZG then
    if TFT_Type>4 then
       Parallel_Set_Index(c)
    else
        SPI_Set_Index(c)
    end if
    #endif
    #ifdef 411 then
    SPI_Set_Index(c)
    #endif
end sub

sub procedure HXwritedata(dim c as byte)
    #ifdef 405RG
       #ifdef VG then
    if TFT_Type>4 then
       Parallel_Write_Command(c)
    else
        SPI_Write_Command(c)
    end if
       #else
    SPI_Write_Command(c)
       #endif
    #endif
    #ifdef 407mini then
    SPI_Write_Command(c)
    #endif
    #ifdef 407ZG then
    if TFT_Type>4 then
       Parallel_Write_Command(c)
    else
        SPI_Write_Command(c)
    end if
    #endif
    #ifdef 411 then
    SPI_Write_Command(c)
    #endif
end sub

