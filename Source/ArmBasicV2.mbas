#ifndef 411 then
sub procedure x0_service() iv IVT_INT_EXTI0 ics ICS_AUTO                       ' EXT-Int (Eingang 1 - Interrupt)
    EXTI_PR.0 = 1
    if input_resistors.0 xor diginput.0 then
       if inputdelay0 = 0 then
          EXTI_IMR.0 = 0
          int_helper(0)
          EXTI_IMR.0 = 1
       else
          if inputdelay_tme[0] > 44 then
             inputdelay_tme[0] = 0
          end if
          if inputdelay_tme[0] < 1 then
             inputdelay_tme[0] = 3
             EXTI_IMR.0 = 0                                                    ' wird in Timer3-Interrupt wieder aktiviert
             if x0_char then  
                put_char_in_buffer(x0_char,konsole_uart)
             else
                 int_helper(0)
             end if
          end if
       end if
    end if
end sub

sub procedure x1_service() iv  IVT_INT_EXTI1 ics ICS_AUTO                      ' EXT-Int (Eingang 2 - Interrupt)
    EXTI_PR.1 = 1
    if input_resistors.1 xor diginput.1 then                                   ' Eingang nicht in Ruheposition?
       if inputdelay1 = 0 then
          EXTI_IMR.1 = 0                                                       ' eigenen Interrupt sperren
          int_helper(1)                                                        ' Service ausführen
          EXTI_IMR.1 = 1                                                       ' Interrupt wieder freigeben
       else
           if inputdelay_tme[1] > 44 then                                      ' Totzeit abgelaufen?
              inputdelay_tme[1] = 0                                            ' Totzeit-Timer starten
           end if
           if inputdelay_tme[1] < 1 then                                       ' noch keine 5ms?
              inputdelay_tme[1] = 3                                            ' dann vorstellen, damit nicht nochmal ausgelöst wird
              EXTI_IMR.1 = 0                                                   ' eigenen Interrupt sperren - wird in Timer3-Interrupt wieder aktiviert
              if x1_char then  
                 put_char_in_buffer(x1_char,konsole_uart)
              else
                  int_helper(1)                                                ' Service ausführen
              end if
           end if
       end if
    end if
end sub

sub procedure x2_service() iv IVT_INT_EXTI2 ics ICS_AUTO                       ' EXT-Int (Eingang 3 - Interrupt)
    EXTI_PR.2 = 1
    if input_resistors.2 xor diginput.2 then
       if inputdelay2 = 0 then
          EXTI_IMR.2 = 0
          int_helper(2)
          EXTI_IMR.2 = 1
       else
           if inputdelay_tme[2] > 44 then
              inputdelay_tme[2] = 0
           end if
           if inputdelay_tme[2] < 1  then
              inputdelay_tme[2] = 3
              EXTI_IMR.2 = 0                                                   ' wird in Timer3-Interrupt wieder aktiviert
              if x2_char then  
                 put_char_in_buffer(x2_char,konsole_uart)
              else
                  int_helper(2)
              end if
           end if
       end if
     end if
end sub
#endif

