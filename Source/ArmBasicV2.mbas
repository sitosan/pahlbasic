           uwtnl("RTC_BKP5R.29")  print_format(testbit(RTC_BKP5R,29),8) if testbit(RTC_BKP5R,29) then uwt("  GPS on")  else  uwt("  GPS off")  end if
           uwtnl("RTC_BKP5R.30")  print_format(testbit(RTC_BKP5R,30),8) if testbit(RTC_BKP5R,30) then uwt("  Load from internal ROM")  else  uwt("  Load from Serial Flash")  end if
           uwtnl("RTC_BKP5R.31")  print_format(testbit(RTC_BKP5R,31),8) if testbit(RTC_BKP5R,31) then uwt("  Save to internal ROM")  else  uwt("  Save to Serial Flash")  end if
           unl
           uwtnl("RTC_CR.18   ")  print_format(testbit(RTC_CR,18),8)    if testbit(RTC_CR,18)    then uwt("  Summertime active")  else  uwt("  Wintertime active")  end if
           unl
           uwtnl("RTC_BKP6R   ")  print_hex(RTC_BKP6R,8)     uwt("  Opendrain/Relays after Reset")
           uwtnl("RTC_BKP7R   ")  print_hex(RTC_BKP7R,8)     uwt("  Pullups/Inputs after Reset")
           unl
           uwtnl("RTC_BKP8R.0...3     ")                     uwt("  Console Interface Nbr: ")  upr(RTC_BKP8R and 15)
           unl
           uwtnl("RTC_BKP8R.4 ")  print_format(testbit(RTC_BKP8R,4),8)  if testbit(RTC_BKP8R,4)  then uwt("  Matrix Piano Keyboard")  else  uwt("  Matrix Computer Keyboard")  end if
           uwtnl("RTC_BKP8R.6...9     ")                     uwt("  Matrix Nbr: ")  upr((RTC_BKP8R>>6) and 15)
           uwtnl("RTC_BKP8R.10")  print_format(testbit(RTC_BKP8R,10),8) if testbit(RTC_BKP8R,10) then uwt("  Matrix active high")  else  uwt("  Matrix active low")    end if
           uwtnl("RTC_BKP8R.11")  print_format(testbit(RTC_BKP8R,11),8) if testbit(RTC_BKP8R,11) then uwt("  Matrix Table in RAM") else  uwt("  Matrix Table in ROM")  end if
           uwtnl("RTC_BKP8R.16")  print_format(testbit(RTC_BKP8R,16),8) if testbit(RTC_BKP8R,16) then uwt("  Matrix Console switched on")  else  uwt("  Matrix Console switched off") end if
           uwtnl("RTC_BKP14R  ")  print_format((RTC_BKP14R>>10) and 127,8)   uwt("  Start_Key")  if ((RTC_BKP14R>>10) and 127)=0  then  uwt(": 0") end if
           uwtnl("RTC_BKP8R.28")  print_format(testbit(RTC_BKP8R,28),8) if testbit(RTC_BKP8R,28) then uwt("  play intern") else  uwt("  play extern")  end if
           uwtnl("RTC_BKP8R.5 ")  print_format(testbit(RTC_BKP8R,5),8)  if testbit(RTC_BKP8R,5)  then uwt("  Velocity ad1")        else  uwt("  Velocity constant")    end if
           uwtnl("RTC_BKP8R.29")  print_format(testbit(RTC_BKP8R,29),8) if testbit(RTC_BKP8R,29) then uwt("  Matrix active") else  uwt("  Matrix inactive")  end if
           unl
           uwtnl("RTC_BKP9R   ")  print_hex(RTC_BKP9R,8)     uwt("  Recognized I2C-Sensors: ")
           if RTC_BKP9R = 0 then
              uwt("none")
           else
               mm=0
               for nn=0 to 31
                   if testbit(RTC_BKP9R, nn) then
                      inc(mm)
                   end if
               next nn
               upr(mm)  uwt("     *) =extra support")
               for nn=0 to 31
                   if testbit(RTC_BKP9R, nn) then
                      select case nn
                        case 0    unl  uwt("RTC_BKP9R.0 ")  print_format(testbit(RTC_BKP9R,0),8)   uwt("  HTU31     *)")
                        case 1    unl  uwt("RTC_BKP9R.1 ")  print_format(testbit(RTC_BKP9R,1),8)
                                  if BME_ID = 0x60 then uwt("  BME280    *)")  end if
                                  if BME_ID = 0x58 then uwt("  BMP280    *)")  end if
                        case 2    unl  uwt("RTC_BKP9R.2 ")  print_format(testbit(RTC_BKP9R,2),8)   uwt("  SCD40/41")
                        case 31   unl  uwt("RTC_BKP9R.31")  print_format(testbit(RTC_BKP9R,31),8)  uwt("  24CXX")
                      end select
                   end if
               next nn
           end if
           unl
           uwtnl("RTC_BKP10R  ")  print_format(RTC_BKP10R,8)   uwt("  PWM-Frequency")         if RTC_BKP10R=0 then  uwt(": 1000Hz") else  uwt(" (Hz)")  end if
           uwtnl("RTC_BKP11R  ")  print_format(RTC_BKP11R,8)   uwt("  PWM1-Value at Start")   if RTC_BKP11R=0 then  uwt(": ")  upr(ratio/2) end if
           uwtnl("RTC_BKP12R  ")  print_format(RTC_BKP12R,8)   uwt("  PWM2-Value at Start")   if RTC_BKP12R=0 then  uwt(": ")  upr(ratio/2) end if
           uwtnl("RTC_BKP13R  ")  print_format(RTC_BKP13R,8)   uwt("  PWM3-Value at Start")   if RTC_BKP13R=0 then  uwt(": ")  upr(ratio/2) end if
           #ifndef 407mini then  ' einziges Board ohne PWM4
           uwtnl("RTC_BKP15R  ")  print_format(RTC_BKP15R,8)   uwt("  PWM4-Value at Start")   if RTC_BKP15R=0 then  uwt(": ")  upr(ratio/2) end if
           #endif
           unl
           uwtnl("RTC_BKP14R  ")  print_format(RTC_BKP14R and 511,8)   uwt("  Number of WS2812B LEDs")  if (RTC_BKP14R and 511)=0 then  uwt(": 256") end if
           unl
           uwtnl("RTC_BKP4R   ")  print_format(RTC_BKP4R,8)    uwt("  Baud com1 Speed")    if RTC_BKP4R =0 then  uwt(": 115200") end if
           #ifndef 405RG then  ' 407ZG
           uwtnl("RTC_BKP17R  ")  print_format(RTC_BKP17R,8)   uwt("  Baud com2 Speed")    if RTC_BKP17R=0 then  uwt(": 9600") else  print_format(bkpram_read_byte(0),4) uwt(" D_Bytes ")  print_format(bkpram_read_byte(1),4) uwt(" Parity ")  print_format(bkpram_read_byte(2),4) uwt(" Stop Bits") end if
           #else
             #ifndef VG then  ' WeAct / PyBoard
             uwtnl("RTC_BKP17R  ")  print_format(RTC_BKP17R,8)   if RTC_BKP17R=0 then  uwt("  com2 not active") else  uwt("  Baud com2 Speed")  print_format(bkpram_read_byte(0),4) uwt(" D_Bytes ")  print_format(bkpram_read_byte(1),4) uwt(" Parity ")  print_format(bkpram_read_byte(2),4) uwt(" Stop Bits") end if
             #else  ' 407miniBoard mit VG Firmware
             uwtnl("RTC_BKP17R  ")  print_format(RTC_BKP17R,8)   uwt("  Baud com2 Speed")    if RTC_BKP17R=0 then  uwt(": 9600") else  print_format(bkpram_read_byte(0),4) uwt(" D_Bytes ")  print_format(bkpram_read_byte(1),4) uwt(" Parity ")  print_format(bkpram_read_byte(2),4) uwt(" Stop Bits") end if
             #endif
           #endif
           uwtnl("RTC_BKP18R  ")  print_format(RTC_BKP18R,8)   uwt("  Baud com3 Speed")    if RTC_BKP18R=0 then  uwt(": 9600") else  print_format(bkpram_read_byte(3),4) uwt(" D_Bytes ")  print_format(bkpram_read_byte(4),4) uwt(" Parity ")  print_format(bkpram_read_byte(5),4) uwt(" Stop Bits") end if
           uwtnl("RTC_BKP16R  ")  print_format(RTC_BKP16R,8)   uwt("  Baud com4 Speed")    if RTC_BKP16R=0 then  uwt(": 9600") else  print_format(bkpram_read_byte(6),4) uwt(" D_Bytes ")  print_format(bkpram_read_byte(7),4) uwt(" Parity ")  print_format(bkpram_read_byte(8),4) uwt(" Stop Bits") end if
           unl
           'uwtnl("RTC_BKP19R  ")  print_hex(RTC_BKP19R,8)  uwt("  CCS881-Baseline")      'RTC_BKP19R  ist frei !!!!!!!!!!!!!!!!!!!
           uwtnl("factory settings: all values = 0 (i.e. not configured but have a default value)")   'unl

      case "9"
           uwtnl("                                Übersicht sys()-Funktion")
           uwtnl("---------------------------------------------------------------------------------------------")
           uwtnl("sys(0)  :  Task-Nummer,  0=Kommando-Modus  1=Hauptprogramm  2=erste Prozedur oder Funktion...")
           uwtnl("sys(1)  :  gosub-Stapel-Ebenen-Zähler")
           uwtnl("sys(2)  :  Rechen-Stapel-Ebenen-Zähler")
           uwtnl("sys(3)  :  Frequenz des Signals am Digital-Eingang 6")
           uwtnl("           Eingang 6 muss zuvor mit 'set diginp 6 as fcount' umgeschaltet werden")
           uwtnl("sys(4)  :  Anzahl der Impulse am Digitalen Eingang 6, löscht den Zähler nach der Abfrage")
           uwtnl("           Eingang 6 muss zuvor mit 'set diginp 6 as icount1' (oder 2) umgeschaltet werden")
           uwtnl("sys(5)  :  Print-Position auf dem LCD, untere 16Bit = Zeile, obere 16Bit = Spalte")
