             case "1"
                  ADC2_Init()   ALIGN_ADC2_CR2_bit=1   EOCIE_ADC2_CR1_bit=1
                  'GPIO_Digital_Input(@GPIOC_BASE, _GPIO_PINMASK_0 or _GPIO_PINMASK_1 or _GPIO_PINMASK_2 or _GPIO_PINMASK_3)
                  GPIO_Analog_Input(@GPIOA_BASE, _GPIO_PINMASK_6)
                  'while rec_pointer[0] = 0
                        for nn=0 to 7
                            print_format(nn,6)
                        next nn
