sub procedure Init_ser4_ivt(dim speed as longword, dim bits, pari, stopbits as byte)   ' com4 Empfang starten / usart3
dim d_bits, d_pari, d_stopbits as word volatile

    d_bits=0  d_pari=0  d_stopbits=0
    if bits    =8  then d_bits     = _UART_8_BIT_DATA   end if
    if bits    =9  then d_bits     = _UART_9_BIT_DATA   end if
    if pari    =1  then d_pari     = _UART_ODDPARITY    end if
    if pari    =2  then d_pari     = _UART_EVENPARITY   end if
    if stopbits=1  then d_stopbits = _UART_ONE_STOPBIT  end if
    if stopbits=2  then d_stopbits = _UART_TWO_STOPBITS end if
    if stopbits=5  then d_stopbits = _UART_HALF_STOPBIT end if
    if stopbits=15 then d_stopbits = _UART_ONE_AND_A_HALF_STOPBITS end if
