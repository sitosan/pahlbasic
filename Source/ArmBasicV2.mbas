sub procedure InitTimer9(dim mode as byte)                                     ' Frequenz-Zähler
    RCC_APB2ENR.TIM9EN = 1                                                     ' Saft einschalten
    CEN_TIM9_CR1_bit=0                                                         ' Timer aus, sonst keine Konfiguration
    if mode=1 then
       TIM9_PSC = (Get_Fosc_kHz()/1000) -1                                     ' für alle Prozessoren
    end if
    if mode=0 then
       TIM9_PSC=0
    end if
    TIM9_CCMR1_Input=1                                                         ' Compare Channel 1 as Input
    if mode=0 then
       TIM9_SMCR = 1 + 2 + 4 + 16 + 64                                         ' externer Zähleingang, Inp1-Filter-getriggert
    end if
    if mode=1 then
       TIM9_SMCR = 1 + 4 + 16 + 64                                             ' externer Gate-Eingang
    end if
    TIM9_ARR = 65535
    TIM9_CCR1 = 65535
    TIM1_DIER.UIE     = 0
    URS_TIM9_CR1_bit  = 1
    UDIS_TIM9_CR1_bit = 0
    UIE_TIM9_DIER_bit = 1
    CEN_TIM9_CR1_bit  = 1                                                      ' Timer an
    #ifdef 407mini then
    set_pull_up_down(4,5,0,1)                                                  ' Pulldown Resistor on PE5
    GPIO_Alternate_Function_Enable(@_GPIO_MODULE_TIM9_CH1_PE5)                 ' diginput E5 wird Impuls-Längen-Zähler-Eingang
    #endif
    #ifdef 407ZG then
    set_pull_up_down(4,5,0,1)                                                  ' Pulldown Resistor on PE5
    GPIO_Alternate_Function_Enable(@_GPIO_MODULE_TIM9_CH1_PE5)                 ' diginput E5 wird Impuls-Längen-Zähler-Eingang
    #endif
    #ifdef 411 then
    GPIO_Digital_Input(@GPIOA_BASE, _GPIO_PINMASK_2)                           ' PWM2 zu Eingang machen
    set_pull_up_down(0,2,0,1)                                                  ' Pulldown Resistor on PA2
    GPIO_Alternate_Function_Enable(@_GPIO_MODULE_TIM9_CH1_PA2)                 ' PWM-Ausgang A2 wird Impuls-Längen-Zähler-Eingang
    #endif
    #ifdef 405RG then
    GPIO_Digital_Input(@GPIOA_BASE, _GPIO_PINMASK_2)                           ' PWM2 zu Eingang machen
    set_pull_up_down(0,2,0,1)                                                  ' Pulldown Resistor on PA2
    GPIO_Alternate_Function_Enable(@_GPIO_MODULE_TIM9_CH1_PA2)                 ' PWM-Ausgang A2 wird Impuls-Längen-Zähler-Eingang
    #endif
    TIM9_CNT=0
    counter1=0
    frequency_counter=0
    TIM9_EGR.0 = 1
    NVIC_IntEnable(IVT_INT_TIM1_BRK_TIM9)
end sub

sub procedure InitTimer10                                                      ' Impulstimer für alle Prozessoren
    TIM1EN_bit   = 0
    TIM10EN_bit  = 1
    CEN_TIM10_CR1_bit = 0
    #ifndef 411 then
    set_timerx_speed(timer_10, 4000)                                           ' 4000Hz=250us
    #else
    set_timerx_speed(timer_10, 4000)
    #endif
    relaynumber1       = 16
    relaynumber2       = 16
    relaynumber3       = 16
    relaynumber4       = 16
    tim101max          = 10
    tim102max          = 10
    tim103max          = 10
    tim104max          = 10
    URS_TIM10_CR1_bit  = 01
    UDIS_TIM10_CR1_bit = 00
    UIE_TIM10_DIER_bit = 01
    NVIC_IntEnable(IVT_INT_TIM1_UP_TIM10)
    CEN_TIM10_CR1_bit  = 01
end sub

