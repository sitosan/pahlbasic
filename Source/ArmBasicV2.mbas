#ifdef 407ZG then
sub function init_SD_Card as short
const GET_DIR=0
dim   dumy as short volatile

    SD_timeout.cmd_timeout  = 100000
    SD_timeout.spi_timeout  = 1000000
    SD_timeout.init_timeout = 10000000
    Mmc_SetTimeoutCallback(SD_timeout, @Mmc_TimeoutCallback)
    delay01
    ' SDIO_CK frequency must be less than 400 kHz in identification mode
    SDIO_Init(_SDIO_CFG_POWER_SAVE_DISABLE or _SDIO_CFG_4_WIDE_BUS_MODE or _SDIO_CFG_CLOCK_BYPASS_DISABLE or _SDIO_CFG_CLOCK_RISING_EDGE or _SDIO_CFG_HW_FLOW_ENABLE, 120, @_GPIO_MODULE_SDIO_D0_D3)
    'GPIOD_PUPDR = GPIOD_PUPDR or 0x10                                         ' Pullups auf der Platine
    'GPIOC_PUPDR = GPIOC_PUPDR or 0x550000                                     ' Pullups auf der Platine
    Mmc_Set_Interface(_MMC_INTERFACE_SDIO)                                     ' Set SDIO interface
    SDIO_Reset()
    Delay15
    int2_off  result = FAT32_Init()  int2_on                                   ' Init SD-Card
    if result<0 then  clearbit(SD_Card_started,0) exit end if
    SDIO_CLKCR = SDIO_CLKCR and not longword(0xff)                             ' SD card is initialized, SDIO speed (SDIO_CK) can be increased
    SDIO_CLKCR = SDIO_CLKCR or longword(0x2)
    setbit(SD_Card_started,0)
    int2_off  result = FAT32_GetFreeSpace(@freeClusts, @bytesPerCluster)  int2_on
    delay01
    dumy=SD_Card_set_time
    SD_Set_Path_Get_Dir(GET_DIR)
    SD_Drive=1
    SD_Dir_Counter=0
end sub

sub function init_SD_Card2 as short
const GET_DIR=0
dim   dumy as short volatile

    SD_timeout.cmd_timeout  = 1000
    SD_timeout.spi_timeout  = 1000000
    SD_timeout.init_timeout = 10000000
    Mmc_SetTimeoutCallback(SD_timeout, @Mmc_TimeoutCallback)
    delay01
    spi2_speed(64)
    SPI_Set_Active(@SPI2_Read, @SPI2_Write)
    Mmc_Set_Interface(_MMC_INTERFACE_SPI)                                      ' Set SPI interface
    int2_off  result = FAT32_Init()  int2_on
    delay01
    TFT_SPI_Speed=16
    spi2_speed(TFT_SPI_Speed)
    if result<0 then  
       clearbit(SD_Card_started,1) 
       exit
    end if
    setbit(SD_Card_started,1)
    int2_off  result = FAT32_GetFreeSpace(@freeClusts, @bytesPerCluster)  int2_on
    delay01
    dumy=SD_Card_set_time
    SD_Set_Path_Get_Dir(GET_DIR)
    SD_Drive=2
    SD_Dir_Counter=0
end sub
#endif

sub function SD_Card_present as word
    result=0
    select case SD_Drive
      case 1    if testbit(SD_Card_started,0)=0 then  perror=19  sys(sd_not_ready,0)  exit end if
      case 2    if testbit(SD_Card_started,1)=0 then  perror=19  sys(sd_not_ready,0)  exit end if
      case else                                       perror=19  sys(sd_not_ready,0)  exit
    end select
    result=65535
end sub

sub procedure get_filename(dim pos as word)
dim lgpstr as word volatile

    if progline[pos]<>34 then  perror=3  exit  end if
    select_str(pos,0)
    if perror then  exit end if
    lgpstr = length(pstr)
    if lgpstr=0  then  exit  end if
    if lgpstr>40 then  perror=13  sys("filename too long",0)  exit  end if
end sub

sub procedure instr_format                                                     ' SD-Card formatieren
dim charpointer as ^char volatile
dim error       as short volatile

    select_str(2,0)  pstr[20]=0
    if perror then  exit end if
    error = init_SD_Card
    if error<0 then  perror=19  sys(sd_not_ready,0)  pr(FAT32_GetError,5)  exit  end if
    sys("formatting media, all Data will be lost",0)
    if over_write_quest(0)=0 then  exit end if
    sys("please wait a minute or two ...",0)
    spi2_speed(64)
    int2_off  error = FAT32_Format(@pstr)  int2_on
    if error<0 then  perror=19  sys("formatting Error ",0)  pr(FAT32_GetError,5)  exit  end if
    error = init_SD_Card
    if error<0 then  perror=19  sys(sd_not_ready,0)         pr(FAT32_GetError,5)  exit  end if
    sys("formatting OK",0)
    int2_off  error = FAT32_GetFreeSpace(@freeClusts, @bytespercluster)  int2_on
    if error<0 then  perror=19  sys(sd_not_ready,0)  pr(FAT32_GetError,5)  exit  end if
    prn(freeClusts)  sys(" free Clusters, with ",3)  pr(bytespercluster,5)  sys(" bytes per Cluster",3)
    charpointer = FAT32_GetCurrentPath
    sys(charpointer,0)
end sub

sub procedure instr_erase
dim error as short volatile

    if SD_Card_present=0 then  No_SD_Card exit end if
    select_str(2,0)
    if perror then  exit end if
    pstr[20]=0
    SPI_Set_Active(@SPI2_Read, @SPI2_Write)
    int2_off  error = FAT32_Exists(@pstr)  int2_on
    if error=0 then  perror=18  exit end if
    if error<0 then  perror=19  sys(sd_read_err,0)  pr(FAT32_GetError,5)  exit end if
    if pmode=0 then
       sys("File will be deleted!!",9)
       if over_write_quest(0)=0 then exit  end if
    end if
    int2_off  error = FAT32_Delete(@pstr)
              error = FAT32_Exists(@pstr)  int2_on
    if error=0 then  exit end if
    if error<0 then  perror=19  sys(sd_write_err,0)  pr(FAT32_GetError,5)  exit end if
end sub

sub procedure SD_Card_Print_Path(dim modus as word)
const 
    GET_DIR=0
dim charpointer as ^char volatile

    if modus=1 then
       if freeClusts>481788 then  sys("SDHC-Card: ",9)  else  sys("SD-Card: ",9)  end if
       pr(freeClusts,5)  sys(" free Clusters, with ",3)  pr(bytespercluster,5)  sys(" bytes per Cluster",3)
    end if
    charpointer = FAT32_GetCurrentPath
    sys(charpointer,0)
    SD_Set_Path_Get_Dir(GET_DIR)
end sub

sub procedure instr_cd                                                         ' change dir, change drive
const 
    Print_Clusters   =1
    Print_No_Clusters=0
    Drive1=1
    Drive2=2
    Set_Path=3
dim test  as longword  volatile
dim error as short     volatile

    if progline[2]=0 then
       #ifdef 405RG then
       select case SD_Drive
         case 0,1  error = init_SD_Card    current_path(Drive1)
         case 2    error = init_SD_Card2   current_path(Drive2)
       end select
       #endif
       #ifdef 411 then
       error = init_SD_Card   current_path(Drive1)
       #endif
       #ifdef 407mini then
       error = init_SD_Card   current_path(Drive1)
       #endif
       #ifdef 407ZG then
       select case SD_Drive
         case 0,1  error = init_SD_Card    current_path(Drive1)
         case 2    error = init_SD_Card2   current_path(Drive2)
       end select
       #endif
       if error<0 then  perror=19  sys(sd_not_ready,0)  pr(FAT32_GetError,5)  exit end if
       SD_Card_Print_Path(Print_Clusters)
       exit
    end if
    if progline[2] = "1" then
       if SD_Drive=2 then  current_path(Drive2) end if                         ' Wechsel?
       error = init_SD_Card
       if error<0 then perror=19  sys(sd_not_ready,0)  pr(FAT32_GetError,5)  exit end if
       error = SD_Set_Path_Get_Dir(Drive1)
       SD_Card_Print_Path(Print_Clusters)
       exit
    end if
    #ifdef 405RG then
    if progline[2] = "2" then
       if SD_Drive=1 then  current_path(Drive1) end if                         ' Wechsel?
       error = init_SD_Card2
       if error<0 then  perror=19  sys(sd_not_ready,0)  pr(FAT32_GetError,5)  exit end if
       error = SD_Set_Path_Get_Dir(Drive2)
       SD_Card_Print_Path(Print_Clusters)
       exit
    end if
    #endif
    #ifdef 407ZG then
    if progline[2] = "2" then
       if SD_Drive=1 then  current_path(Drive1) end if                         ' Wechsel?
       error = init_SD_Card2
       if error<0 then  perror=19  sys(sd_not_ready,0)  pr(FAT32_GetError,5)  exit end if
       error = SD_Set_Path_Get_Dir(Drive2)
       SD_Card_Print_Path(Print_Clusters)
       exit
    end if
    #endif
    if progline[2] = "." then
       pstr = ".."
    else
        if progline[2] = "\" then
           pstr = "\"
        else
            select_str(2,0)
            if perror then  exit end if
        end if
    end if
    SPI_Set_Active(@SPI2_Read, @SPI2_Write)
    test=strchr(pstr, "\")     'prn(test)    cwtnl(pstr)
    if (test=true) or ((test=0) and (pstr[1]=0)) then                          ' kein slash oder slash an erster Position?
       pstr[30]=0
       int2_off  error = FAT32_ChangeDir(@pstr)  int2_on
    else
        pstr[79]=0
        error = SD_Set_Path_Get_Dir(Set_Path)
    end if
    if error<0 then  perror=19  sys("Directory?? ",0)  pr(FAT32_GetError,5)  exit end if
    current_path(SD_Drive)
    SD_Card_Print_Path(print_no_clusters)
end sub

sub procedure instr_md                                                         ' make dir
dim charpointer as ^char volatile
dim error       as short volatile

    if SD_Card_present=0  then  No_SD_Card exit end if
    if SD_Card_set_time<0 then  perror=19  sys("FAT-System Time Problem",0) exit end if
    select_str(2,0)
    if perror then  exit end if
    pstr[30]=0
    SPI_Set_Active(@SPI2_Read, @SPI2_Write)
    int2_off  error = FAT32_Exists(@pstr)  int2_on
    if error=1 then  perror=23  sys(sd_write_err,0)  pr(FAT32_GetError,5)   exit end if
    int2_off  error = FAT32_MakeDir(@pstr)  charpointer = FAT32_GetCurrentPath  int2_on
    if error<0 then  perror=19  sys(sd_not_ready,0)  pr(FAT32_GetError,5)   exit end if
    sys(charpointer,0)
end sub

sub procedure instr_rd                                                         ' remove dir
dim error as short volatile

    if SD_Card_present=0 then  No_SD_Card exit end if
    select_str(2,0)
    if perror then  exit end if
    pstr[32]=0
    SPI_Set_Active(@SPI2_Read, @SPI2_Write)
    int2_off  error = FAT32_Exists(@pstr)  int2_on
    if error>0 then                                                            ' File existiert
       if pmode=0 then
          sys("Directory/File will be deleted!!",0)
          if over_write_quest(0)=0 then  exit  end if
       end if
       int2_off  error = FAT32_DeleteRec(@pstr)
                 error = FAT32_Exists(@pstr)  int2_on
       if error=0 then  exit end if
       if error<0 then  perror=19  sys(sd_write_err,0)  pr(FAT32_GetError,5)  exit end if
    else                                                                       ' File existiert nicht
        if error<0 then  perror=19  sys(sd_write_err,0)  pr(FAT32_GetError,5)  exit end if
        if error=0 then  perror=13  sys("Directory does not exist",1)          exit end if
    end if
end sub

sub procedure SD_Dir                                                           ' SD-Card Directory
dim error as short volatile

    if SD_Card_present=0 then  No_SD_Card exit end if
    SPI_Set_Active(@SPI2_Read, @SPI2_Write)
    error = SD_Card_set_time
    if error<0 then  perror=19  sys(sd_not_ready,0)  pr(FAT32_GetError,5) exit end if
    sys("SD Card Drive: ",0)  pr(SD_Drive,3)
    TFT_redirect_cls(1)
    set_uart_color(2,0,0)
    TFT_Umbruch=1
    error = FAT32_Dir()
    TFT_Umbruch=0   pipe=0
    if error<0 then  perror=19  sys(sd_not_ready,0)  pr(FAT32_GetError,5) exit end if
end sub

#ifndef Pyboard then
sub procedure init_I2C(dim speed as longword)                                  ' I2C1 Starten für alle Prozessoren!!
    set_pull_up_down(Port_B,8,0,1)   set_pull_up_down(Port_B,9,0,1)            ' internal Pulldowns auf PortB, Pins 8 und 9 (nur für den Test)
    if (GPIOB_IDR.8=0) or (GPIOB_IDR.9=0) then  inc(hwfault)  sys("Sensor Bus Pullups missing", 9) end if  ' Test auf externe Pullups
    I2C1_Init_Advanced(speed, @_GPIO_MODULE_I2C1_PB89)                         ' reset_i2c
    set_pull_up_down(Port_B,8,1,0)  set_pull_up_down(Port_B,9,1,0)             ' nun Pullups für I2C-Startbedingung (B.8 / B.9)
    sys("started Sensor Bus with ",9)  pr(speed,5)  sys("Hz",3)
    I2C1_SetTimeoutCallback(100000, @I2C1_TimeoutCallback)
end sub
#else
sub procedure init_I2C(dim speed as longword)                                  ' I2C1 Starten für alle Prozessoren!!
    set_pull_up_down(Port_B,6,0,1)   set_pull_up_down(Port_B,7,0,1)            ' internal Pulldowns auf PortB, Pins 8 und 9 (nur für den Test)
    if (GPIOB_IDR.6=0) or (GPIOB_IDR.7=0) then  inc(hwfault)  sys("Sensor Bus Pullups missing", 9) end if  ' Test auf externe Pullups
    I2C1_Init_Advanced(speed, @_GPIO_MODULE_I2C1_PB67)                         ' reset_i2c
    set_pull_up_down(Port_B,6,1,0)  set_pull_up_down(Port_B,7,1,0)             ' nun Pullups für I2C-Startbedingung (B.8 / B.9)
    sys("started Sensor Bus with ",9)  pr(speed,5)  sys("Hz",3)
    I2C1_SetTimeoutCallback(100000, @I2C1_TimeoutCallback)
end sub
#endif

#ifdef 405RG then
sub procedure init_pwms(dim freq as word)
    InitTimer5(freq)   'prn(ratio)
    if testbit(RTC_BKP16R,0) then
       GPIO_Digital_Output(@GPIOA_BASE, _GPIO_PINMASK_0)                       ' relay 1
       setbit(relayMask,0)
    else
        GPIO_Alternate_Function_Enable(@_GPIO_MODULE_TIM5_CH1_PA0)             ' pwm1
        clearbit(relayMask,0)
    end if
    #ifndef VG then
    if testbit(RTC_BKP16R,1) then
       GPIO_Digital_Output(@GPIOA_BASE, _GPIO_PINMASK_1)
       setbit(relayMask,1)
    else
        GPIO_Alternate_Function_Enable(@_GPIO_MODULE_TIM5_CH2_PA1)
        clearbit(relayMask,1)
    end if
    #else
    clearbit(relayMask,1)                                                      ' Lebenslicht!
    #endif
    #ifndef VG then
    if RTC_BKP17R=0 then                                                       ' com2 nicht konfiguriert ?
       setbit(relayMask,2)   setbit(relayMask,3)
       if testbit(RTC_BKP16R,2) then                                           ' dann PWM oder Relay
          GPIO_Digital_Output(@GPIOA_BASE, _GPIO_PINMASK_2)
          setbit(relayMask,2)
       else
           GPIO_Alternate_Function_Enable(@_GPIO_MODULE_TIM5_CH3_PA2)
           clearbit(relayMask,2)
       end if
       if testbit(RTC_BKP16R,3) then
          GPIO_Digital_Output(@GPIOA_BASE, _GPIO_PINMASK_3)
          setbit(relayMask,3)
       else
           GPIO_Alternate_Function_Enable(@_GPIO_MODULE_TIM5_CH4_PA3)
           clearbit(relayMask,3)
       end if
       if testbit(RTC_BKP16R,4) then  GPIO_Digital_Input(@GPIOA_BASE, _GPIO_PINMASK_2)  clearbit(relayMask,2) end if  ' PA2 = Messeingang
    else
        GPIO_Alternate_Function_Enable(@_GPIO_MODULE_USART2_PA23)
        clearbit(relayMask,2)   clearbit(relayMask,3)
    end if
    #else
    if testbit(RTC_BKP16R,2) then
       GPIO_Digital_Output(@GPIOA_BASE, _GPIO_PINMASK_2)
       setbit(relayMask,2)
    else
        GPIO_Alternate_Function_Enable(@_GPIO_MODULE_TIM5_CH3_PA2)
        clearbit(relayMask,2)
    end if
    if testbit(RTC_BKP16R,3) then
       GPIO_Digital_Output(@GPIOA_BASE, _GPIO_PINMASK_3)
       setbit(relayMask,3)
    else
        GPIO_Alternate_Function_Enable(@_GPIO_MODULE_TIM5_CH4_PA3)
        clearbit(relayMask,3)
    end if
    if testbit(RTC_BKP16R,4) then                                              ' PA2 = Messeingang ?
       GPIO_Digital_Input(@GPIOA_BASE, _GPIO_PINMASK_2)  
       clearbit(relayMask,2) 
    end if
    #endif
    TIM5_CCER=0x1111   TIM5_CCMR1_Output=0x6060    TIM5_CCMR2_Output=0x6060
    if RTC_BKP11R=0 then  pwm1 = ratio/2 else  pwm1 = RTC_BKP11R  end if
    if RTC_BKP12R=0 then  pwm2 = ratio/2 else  pwm2 = RTC_BKP12R  end if
    if RTC_BKP13R=0 then  pwm3 = ratio/2 else  pwm3 = RTC_BKP13R  end if
    if RTC_BKP15R=0 then  pwm4 = ratio/2 else  pwm4 = RTC_BKP15R  end if
    TIM5_CCR1=pwm1   TIM5_CCR2=pwm2   TIM5_CCR3=pwm3   TIM5_CCR4=pwm4
end sub
#endif

#ifdef 407mini  then
sub procedure init_pwms(dim freq as word)
    InitTimer5(freq)   'prn(ratio)
    GPIO_Alternate_Function_Enable(@_GPIO_MODULE_TIM5_CH1_PA0)
    'GPIO_Alternate_Function_Enable(@_GPIO_MODULE_TIM5_CH2_PA1)                ' Lebenslicht!
    GPIO_Alternate_Function_Enable(@_GPIO_MODULE_TIM5_CH3_PA2)
    GPIO_Alternate_Function_Enable(@_GPIO_MODULE_TIM5_CH4_PA3)
    TIM5_CCER=0x1111   TIM5_CCMR1_Output=0x6060    TIM5_CCMR2_Output=0x6060
    if RTC_BKP11R = 0 then  pwm1 = ratio/2 else  pwm1 = RTC_BKP11R  end if
    if RTC_BKP12R = 0 then  pwm2 = ratio/2 else  pwm2 = RTC_BKP12R  end if
    if RTC_BKP13R = 0 then  pwm3 = ratio/2 else  pwm3 = RTC_BKP13R  end if
    if RTC_BKP15R = 0 then  pwm4 = ratio/2 else  pwm4 = RTC_BKP15R  end if
    TIM5_CCR1=pwm1   TIM5_CCR3=pwm2   TIM5_CCR4=pwm3
end sub
#endif

