'Start Timers                                                                   --------------------------------------------------------------------------
sub procedure InitTimer2()                                                     ' Millisekundenzähler freilaufend
    timerint           = 0
    RCC_APB1ENR.B0     = 1
    TIM2_CR1.B0        = 0                                                     ' Timer aus
    TIM2_ARR           = true
    TIM2_CCR1          = true
    #ifndef 411 then
    TIM2_PSC           = Get_Fosc_kHz()/4 -1                             ' 500us   0,5 millisec    Frequency/2000
    #else
    TIM2_PSC           = Get_Fosc_kHz()/2 -1                             ' 500us    0,5 millisec  Frequency/2000
    #endif
    TIM2_EGR.0         = 1
    TIM2_CR1.B0        = 1
    TIM2_CNT           = 0
    TIM2_EGR.0         = 1
end sub

sub procedure InitTimer3()                                                     ' Systemuhr Time starten
    timerint           = 0                                                     ' On Time-Interrupt aus
    RCC_APB1ENR.TIM3EN = 1                                                     ' Power auf den Timer
    TIM3_CR1.CEN       = 0                                                     ' Timer aus
    set_timerx_speed(Timer_3, 200)                                             ' 200Hz (5ms)
    NVIC_IntEnable(IVT_INT_TIM3)
    adc_channel        = 10                                                    ' ADC-Start-Kanal
    TIM3_DIER.UIE      = 1
    TIM3_CR1.CEN       = 1
    tacks              = 0                                                     ' 5 Milli-Sekunden-Zähler / Teiler erzeugt Sekunden
end sub

