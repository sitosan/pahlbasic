program ArmBasicV2
'a mcs51 like tiny basic interpreter with hardware support for TFT lcd, 4(2) x adc, 3(4) x pwm, multiple 1wire-thermo-sensors,
'gps, frequency and impuls (length) counting, spi-flash (eeprom), 16 digital Outputs and 12(16) digital inputs,
'I2C- , SPI-, Modbus-Busses, SD-Card, Sound (with internal and external Hardware), USB-Konsole, USB-, Matrix- und On-Screen-Keyboard

' This Program was written by a Non-Programmer. Just for fun and for the little grey cells.

'Boards:
'======================================
#define 407ZG                                                                  ' alternativ
'#define 429IG                                                                  ' alternativ
'#define 407mini                                                                ' alternativ
'#define 405RG                                                                  ' alternativ
'#define VG   ' for the 407mini-Board but with 405RG-Software                   ' zusätzlich zu 405RG (405er Firmware auf F407VG)
'#define PyBoard                                                                ' zusätzlich zu 405RG (405er Firmware auf PyBoard)
'#define WeAct                                                                  ' zusätzlich zu 405RG (405er Firmware auf WeAct Studio Board)
'#define 411                                                                    ' alternativ
'#define 401                                                                    ' zusätzlich zu 411   (411er Firmware auf F401)
'======================================

'Non-Standart Libs
include "ser_flash"
include "fonts"
include __Lib_Stdint


#ifdef 407ZG then                                                              ' Board mit STM32F407ZG
include "OSK_driver2.mbas"
include "MP3_Driver.mbas"
#endif

#ifdef VG then                                                                 ' Board mit STM32F407VG und 405er Firmware
include "OSK_driver2.mbas"
include "MP3_Driver.mbas"
#endif

#ifdef 407IG then                                                              ' Board mit STM32F407IG  / Future
include "OSK_driver2.mbas"
#endif

#ifdef 407mini then
include "MP3_Driver.mbas"
#endif

'Deklarationen
'################################################################################################################################################

const   stringlen    = 256                                                     ' Zeichenkettenlänge

'1.) Typen   ====================================================================================================================================
typedef errorelement        as string[20]                                      ' Fehlermeldungs-Strings
typedef keyelement          as string[07]                                      ' 1 Byte-Token Keywords mit 7 Zeichen
typedef key2element         as string[08]                                      ' 2 Byte-Token keywords mit 8 Zeichen / Extender1 128 oder 129
typedef key3element         as string[09]
typedef dowelement          as string[12]                                      ' Wochentag-Strings
typedef note_element        as string[04]                                      ' NotenNamen
typedef shortstring         as string[05]
typedef color_palette_names as string[10]                                      ' Farbnamen
typedef varname_string      as string[16]                                      ' VariablenNamen
typedef key_string          as string[32]                                      ' Texte für Funktionstasten 9...12
typedef mediumstring        as string[64]
typedef laststring          as string[128]

'2.) Konstanten   ==============================================================================================================================
' USB-Start-Adress
#ifdef 407mini then
const usb_start_adr =0x300
#endif

#ifdef 407ZG then
const usb_start_adr =0x300
#endif

#ifdef 405RG then
   #ifdef WeAct then
   const usb_start_adr =0x300                                                  ' WeAct  F405RG
   #endif
   #ifdef Pyboard then
   const usb_start_adr =0x300                                                  ' PyBoard
   #endif
   #ifdef VG then
   const usb_start_adr =0x300                                                  ' F407mini mit 405er Firmware
   #endif
#endif

'Memory Adresses
#ifdef 405RG then
const
  memory_start    =  0x00000000
  sector7_adres   =  0x00060000                                                ' Startadresse Sector 7   F407
  sector8_adres   =  0x00080000                                                ' Startadresse Sector 8   F407
  sector9_adres   =  0x000A0000                                                ' Startadresse Sector 9   F407
  sector10_adres  =  0x000C0000                                                ' Startadresse Sector 10  F407
  sector10_end    =  0x000DFFFF                                                ' Endadresse   Sector 10  F407
  sector11_adres1 =  0x000E0000                                                ' Startadresse Sector 11  F407
  sector11_end1   =  0x000FFFFF
  sector11_adres2 =  0x080E0000
  sector11_end2   =  0x080FFFFF
  mlp_adres1      =  sector10_adres                                            ' Machine Language Program Adress1
  mlp_adres2      =  sector10_adres + 0x4000                                   ' Machine Language Program Adress2
  mlp_adres3      =  sector10_adres + 0x8000                                   ' Machine Language Program Adress3
  mlp_adres4      =  sector10_adres + 0xC000                                   ' Machine Language Program Adress4
  #ifdef WeAct then
  board  =  5
  #endif
  #ifdef VG then
  board  =  6
  #endif
  #ifdef PyBoard then
  board  =  7
  #endif
#endif

#ifdef 407mini then
const
  memory_start    =  0x00000000
  sector7_adres   =  0x00060000                                                ' Startadresse Sector 7   F407
  sector8_adres   =  0x00080000                                                ' Startadresse Sector 8   F407
  sector9_adres   =  0x000A0000                                                ' Startadresse Sector 9   F407
  sector10_adres  =  0x000C0000                                                ' Startadresse Sector 10  F407
  sector10_end    =  0x000DFFFF                                                ' Endadresse   Sector 10  F407
  sector11_adres1 =  0x000E0000                                                ' Startadresse Sector 11  F407
  sector11_end1   =  0x000FFFFF
  sector11_adres2 =  0x080E0000
  sector11_end2   =  0x080FFFFF
  mlp_adres1      =  sector10_adres                                            ' Machine Language Program Adress1
  mlp_adres2      =  sector10_adres + 0x4000                                   ' Machine Language Program Adress2
  mlp_adres3      =  sector10_adres + 0x8000                                   ' Machine Language Program Adress3
  mlp_adres4      =  sector10_adres + 0xC000                                   ' Machine Language Program Adress4
  board           =  1
#endif

#ifdef 407ZG then
const
  memory_start    =  0x00000000
  sector7_adres   =  0x00060000                                                ' Startadresse Sector 7   F407
  sector8_adres   =  0x00080000                                                ' Startadresse Sector 8   F407
  sector9_adres   =  0x000A0000                                                ' Startadresse Sector 9   F407
  sector10_adres  =  0x000C0000                                                ' Startadresse Sector 10  F407
  sector10_end    =  0x000DFFFF                                                ' Endadresse   Sector 10  F407
  sector11_adres1 =  0x000E0000                                                ' Startadresse Sector 11  F407
  sector11_end1   =  0x000FFFFF
  sector11_adres2 =  0x080E0000
  sector11_end2   =  0x080FFFFF
  mlp_adres1      =  sector10_adres                                            ' Machine Language Program Adress1
  mlp_adres2      =  sector10_adres + 0x4000                                   ' Machine Language Program Adress2
  mlp_adres3      =  sector10_adres + 0x8000                                   ' Machine Language Program Adress3
  mlp_adres4      =  sector10_adres + 0xC000                                   ' Machine Language Program Adress4
  board           =  2
#endif

#ifdef 411 then
const
  memory_start     =  0x00000000
  sector7_adres1   =  0x00060000                                               ' Startadresse Sector 7   F411
  sector7_end1     =  0x0007FFFF                                               ' Endadresse   Sector 7   F411
  sector7_adres2   =  0x08060000                                               ' Startadresse Sector 7   F411
  sector7_end2     =  0x0807FFFF                                               ' Endadresse   Sector 7   F411
#endif

'System frequencies
#ifdef 411 then
       #ifdef 401 then
       const
         frequency    = 84000000                                               ' Systemfrequenz 411
         sysfrequency = 84000000                                               ' CPU-Frequenz
         board        = 4
       #else
       const
         frequency    = 108000000                                               ' Systemfrequenz 411
         sysfrequency = 108000000                                               ' CPU-Frequenz
         board        = 3
       #endif
#else
const
  frequency    =  54000000                                                     ' Systemfrequenz 407
  sysfrequency = 216000000                                                     ' CPU-Frequenz
  
  'frequency    =  60000000                                                     ' Systemfrequenz 407
  'sysfrequency = 240000000                                                     ' CPU-Frequenz
#endif

'Video, System, Variables, Program
const
  tru          = extended(true)                                                ' Konstante für 32 Bit true als Extended
  maxfloat     =  18446744073709551615.0
  minfloat     = -18446744073709551615.0
  TFT80_max_z  = 29                                                            ' max. TFT-Printposition y  (Zeile)    für 800x480
  TFT80_max_s  = 89                                                            ' max. TFT-Printposition x  (Spalte)   für 800x480
  TFT48_max_z  = 19                                                            ' max. TFT-Printposition y  (Zeile)    für 480x320
  TFT48_max_s  = 53                                                            ' max. TFT-Printposition x  (Spalte)   für 480x320
  TFT32_max_z  = 14                                                            ' max. TFT-Printposition y  (Zeile)    für 320x240
  TFT32_max_s  = 35                                                            ' max. TFT-Printposition x  (Spalte)   für 320x240
  strmax       = 10                                                            ' max. Anzahl Stringvariablen
  str_start    = 193                                                           ' Startposition für String tokens
  varmax       = 27                                                            ' max. Anzahl Fliesskomma-Variablen
  #ifndef 411 then
     #ifdef 407ZG then
     progmax      = 62003                                                      ' max. Programmlänge 407VG/ZG
     #else
     progmax      = 62003                                                      ' max. Programmlänge mini407/F405
     #endif
  #else
       #ifndef 401 then
       progmax = 32003                                                         ' max. Programmlänge F411
       #else
       progmax = 32003                                                         ' max. Programmlänge F401
       #endif
  #endif
  funcmax      = 6                                                             ' max. Anzahl Funktionen (5 +1)
  taskmax      = 10                                                            ' max. Anzahl Tasks
  intmax       = 32                                                            ' max. Anzahl Interruptebenen
  callmax      = 16                                                            ' max. Anzahl call-Ebenen
  prozessmax   = 4                                                             ' max. Anzahl Prozesse
  #ifndef 411 then
  textmax      = 16384                                                         ' max. Anzahl Bytes für Text
  #else
  textmax      = 0
  #endif
  paramax      = 32                                                            ' max. Anzahl Parameter
  argmax       = 16                                                            ' max. Anzahl Argumente
  palettemax   = 24                                                            ' Anzahl der Systemfarben
  palettemax_min1 = palettemax -1
  colormax     = 64                                                            ' Grösse der Farbpalette
  colormax_min1 = colormax -1
  voicemax     = 6                                                             ' max. Anzahl Stimmen
  voicemax_min1 = voicemax -1
  filemax      = 11                                                            ' max. Anzahl geöffneter Dateien auf dem Flash-Chip
  in_build     = 18                                                            ' Anzahl eingebauter Funktionen
  textlines    = 128                                                           ' Anzahl Textzeilen im Text-Array
  textlineslen = textmax / textlines                                           ' Länge der Text-Array-Strings
  listmax      = 10
  
'RAM, ROM
const
  Backup_RAM_Start    =  0x40024000                                            ' Adresse des Backup-RAMs
  backup_ram_end      =  0x40024FFF                                            ' Ende des Backup-RAMs
  CCM_RAM_Start       =  0x10000000                                            ' Adresse des CCM-RAMs = Start des Text-Arrays
  ccm_ram_end         =  0x1000FFFF                                            ' Ende des CCM-RAMs
  Text_Array_Start    =  ccm_ram_start
  text_array_end      =  0x10003FFF                                            ' Ende des Textarrays (16KBytes)
  Array_RAM_Start     =  0x10004000                                            ' Adresse des Array-Speichers
  array_ram_ende      =  0x1000DC3F                                            ' Ende des Array-Speichers
  array_max           =  500                                                   ' Anzahl extended Array-Elemente
  array_max_min1      =  array_max -1                                          ' "          "        "
  array_max_bytes     =  array_max * 8                                         ' Bytes je Array
  Var_Ram_Start       =  0x1000DC40                                            ' Adresse der 32 NamensVariablen
  var_ram_end         =  0x1000DD40                                            ' Ende der 32 NamensVariablen
  MX_Decoder          =  backup_ram_start + (400*8)                            ' Adresse des Tastaturdecoders
  in_RAM              =  1                                                     ' wo läuft das Programm?
  in_ROM              =  2                                                     ' wo läuft das Programm?
  notouch             =  0                                                     ' kein Touch
  resistive           =  1                                                     ' resistiver Touch
  capacitive          =  2                                                     ' kapazitiver Touch
  
const
  bufferz   = 256                                                              ' Laenge der Programmzeile
  fifo1     = 128                                                              ' Fifo-Grösse der Uarts
  fifo2     = 64                                                               ' MIDI Fifo
  fifo3     = 128                                                              ' GPS  Fifo
  fifo4     = 64                                                               ' ser4-Fifo
  usbfifo   = 128                                                              ' USB  Fifo
  fifo8     = 128                                                              ' Matrix Fifo
  loopdepth = 30                                                               ' Loop-Tiefe
  maxerror  = 32                                                               ' Anzahl Fehlermeldungen
  half = stringlen / 2                                                         ' Stringoffset für input#
  const cl_blue2   = 0x1F                                                      ' TFT-Farben
  const cl_red2    = 0xF800
  const cl_yellow2 = 0xFFE0
  const cl_green2  = 0x07E0
  const cl_purple2 = 0xB817
  
#ifndef 411 then
