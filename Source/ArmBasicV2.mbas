'Stringarray
typedef strelement as string[stringlen]                                        ' max. Grösse der Strings

'3.) globale Variablen =======================================================================================================================================================================================
#ifdef 405RG then    ' ===========================================================================405RG========================================
'MP3                                                                            -------------405RG---------------------------------------------
#ifdef VG then
dim MP3_RST             as sbit at GPIOD_ODR.B8
    MP3_CS              as sbit at GPIOD_ODR.B3
    BSYNC               as sbit at GPIOD_ODR.B7
    DREQ                as sbit at GPIOD_IDR.B4
    sound_card          as word
#endif

'SD_Card                                                                        --------------405RG--------------------------------------------
dim totalClusts,
    freeClusts,
    badClusts           as uint32_t
    tm                  as __TIME
    sc                  as __SECTOR
    fileHandle          as __HANDLE[4]
    filesize            as longword
    file_attrib         as byte
    bytespercluster     as word
    Start_Sector        as longword[FAT32_MAX_FILES]
    SD_Float            as extended                                            ' wandelt die ersten 8 Bytes in extended um
    SD_Card_buffer      as char[8] at SD_Float
    SD_timeout          as MMC_timeout_values
    SD_Card_Error       as short
    SD_Card_started     as word
    SD_Drive            as word                                                ' Nummer des aktuellen Drives
    SD_Dir_Counter      as longword                                            ' Nummer des Directory-Eintrags
    MMC_chip_select     as sbit at GPIOB_ODR.0                                 ' für 2. SD-Card Drive
    dir_string          as string[32]                                          ' aktuelles Verzeichnis
    Drive1_Path_String  as string[128]
    Drive2_Path_String  as string[128]

'USB                                                                            ---------------405RG-------------------------------------------
dim usb_r_buffer        as byte[64]
    usb0_started        as longword
    usb1_started        as longword
    usb_wait_counter    as word
    usb1_char           as byte
    USB_ID              as sbit at GPIOA_ODR.10
    USB_PW              as sbit at GPIOA_ODR.9
    USBHost_HIDHandler  as TUSBHostHIDHandler
    USBHost_HIDHandlerPtr as ^TUSBHostHIDHandler

'Soft_I2C                                                                       ---------------405RG-------------------------------------------
#ifdef Pyboard then
dim Soft_I2C_Scl_Input  as sbit at GPIOB_IDR.B6
    Soft_I2C_Sda_Input  as sbit at GPIOB_IDR.B7
    Soft_I2C_Scl_Output as sbit at GPIOB_ODR.B6
    Soft_I2C_Sda_Output as sbit at GPIOB_ODR.B7
#else
dim Soft_I2C_Scl_Input  as sbit at GPIOB_IDR.B8
    Soft_I2C_Sda_Input  as sbit at GPIOB_IDR.B9
    Soft_I2C_Scl_Output as sbit at GPIOB_ODR.B8
    Soft_I2C_Sda_Output as sbit at GPIOB_ODR.B9
#endif

'TFT Anschlüsse                                                                 -----405RG-----------------------------------------------------
    #ifdef VG then
dim
    TFT_DataPort as word  at GPIOE_ODR  sfr
    #else
dim 
    bummy        as byte  sfr
    TFT_DataPort as char  at bummy
    #endif
    #ifdef WeAct then
dim
       TFT_RST      as sbit  at GPIOB_ODR.3
       TFT_BLED     as sbit  at GPIOB_ODR.4
       TFT_RS       as sbit  at GPIOB_ODR.5
       TFT_CS       as sbit  at GPIOB_ODR.1
    #endif
    #ifdef Pyboard then
dim
       TFT_RST      as sbit  at GPIOB_ODR.3
       TFT_BLED     as sbit  at GPIOD_ODR.11  ' gibt es nicht auf dem PyBoard also keine Funktion
       TFT_RS       as sbit  at GPIOB_ODR.9
       TFT_CS       as sbit  at GPIOB_ODR.8
    #endif
    #ifdef VG then
dim
       TFT_RST      as sbit  at GPIOD_ODR.12
       TFT_BLED     as sbit  at GPIOD_ODR.11
       TFT_RS       as sbit  at GPIOD_ODR.10
       TFT_CS       as sbit  at GPIOD_ODR.9
    #endif
dim
    TFT_RD       as sbit  at GPIOD_ODR.13
    TFT_WR       as sbit  at GPIOD_ODR.14
    
'XPT2046 Anschlüsse                                                             ------405RG----------------------------------------------------
DIM
    T_CS         as sbit  at GPIOB_ODR.12
    #ifdef VG then
    T_IRRPT      as sbit  at GPIOD_IDR.15
    #else
    T_IRRPT      as sbit  at GPIOA_IDR.15
    #endif

'User_LED, SerialFlash CS, WS2812 LED Outputs                                   ------405RG----------------------------------------------------
DIM
    #ifdef VG then                                                             ' 407mini Board mit 405er Firmware
    USER_LED     as sbit  at GPIOA_ODR.01                                      ' Lebenslicht
    sf_cs        as sbit  at GPIOC_ODR.15                                      ' serial Flash Chip Select
    led_out      as sbit  at GPIOB_ODR.01                                      ' WS2812 Anschluss
    RTS1         as sbit  at GPIOA_ODR.09                                      ' RS485 Ready_to_Send 1
    RTS2         as sbit  at GPIOA_ODR.10                                      ' RS485 Ready_to_Send 2
    #endif
    #ifdef Pyboard then
    USER_LED     as sbit  at GPIOA_ODR.14                                      ' Lebenslicht/PyBoard
    sf_cs        as sbit  at GPIOA_ODR.01                                      ' ser. Flash-Chip CS
    led_out      as sbit  at GPIOC_ODR.13                                      ' WS2812 Anschluss
    RTS1         as sbit  at GPIOA_ODR.13                                      ' RS485 Ready_to_Send
    #endif
    #ifdef WeAct then
    USER_LED     as sbit  at GPIOB_ODR.02                                      ' Lebenslicht
    sf_cs        as sbit  at GPIOA_ODR.10                                      ' ser. Flash-Chip CS
    led_out      as sbit  at GPIOC_ODR.13                                      ' WS2812 Anschluss
    RTS1         as sbit  at GPIOA_ODR.09                                      ' RS485 Ready_to_Send
    #endif

'Relays, Impuls, USB-Power, GPS-Power                                           ----------405RG------------------------------------------------
DIM
    relay        as word  at GPIOA_ODR                                         ' 4 Relays
    opendrain    as word  at GPIOA_OTYPER                                      ' 4 Opendrain
    mrelay       as word  at GPIOA_IDR                                         ' 4 Relays zurücklesen
    diginput     as word  at GPIOC_IDR                                         ' Digitaleingänge
    #ifdef WeAct then
    USB_Power    as sbit  at GPIOC_ODR.5                                       ' USB Powerswitch
    #endif
    #ifdef VG then
    USB_Power    as sbit  at GPIOC_ODR.5                                       ' USB Powerswitch
    #endif
    #ifdef Pyboard then
    USB_Power    as sbit  at GPIOB_ODR.4                                       ' USB Powerswitch/PyBoard
    #endif

#endif      '==============================================================================================ENDE 405RG================================


#ifdef 407mini then
'MP3                                                                            ---------------407Mini-----------------------------------------
dim MP3_RST             as sbit at GPIOA_ODR.9
    MP3_CS              as sbit at GPIOA_ODR.10
    BSYNC               as sbit at GPIOA_ODR.8
    DREQ                as sbit at GPIOC_IDR.9
    Soundcard           as word

'SD_Card                                                                        ---------------407Mini-----------------------------------------
dim totalClusts,
    freeClusts,
    badClusts           as uint32_t
    tm                  as __TIME
    sc                  as __SECTOR
    fileHandle          as __HANDLE[4]
    filesize            as longword
    file_attrib         as byte
    bytespercluster     as word
    Start_Sector        as longword[FAT32_MAX_FILES]
    SD_Float            as extended                                            ' wandelt die ersten 8 Bytes in extended um
    SD_Card_buffer      as char[8] at SD_Float
    SD_timeout          as MMC_timeout_values
    SD_Card_Error       as short
    SD_Card_started     as word
    SD_Drive            as word
    SD_Dir_Counter      as longword
    MMC_chip_select     as sbit at GPIOB_ODR.0
    dir_string          as string[32]                                          ' aktuelles Verzeichnis
    Drive1_Path_String  as string[128]

'USB                                                                            ----------------407Mini----------------------------------------
dim usb_r_buffer        as byte[64]
    usb0_started        as longword
    usb1_started        as longword
    usb_wait_counter    as word
    usb1_char           as byte
    USB_ID              as sbit at GPIOA_ODR.10
    USB_PW              as sbit at GPIOA_ODR.9
    USBHost_HIDHandler  as TUSBHostHIDHandler
    USBHost_HIDHandlerPtr as ^TUSBHostHIDHandler

'Soft_I2C                                                                       -----------------407Mini---------------------------------------
dim Soft_I2C_Scl_Input  as sbit at GPIOB_IDR.B8
    Soft_I2C_Sda_Input  as sbit at GPIOB_IDR.B9
    Soft_I2C_Scl_Output as sbit at GPIOB_ODR.B8
    Soft_I2C_Sda_Output as sbit at GPIOB_ODR.B9

'TFT Anschlüsse                                                                 ------------407Mini--------------------------------------------
dim bummy        as byte  sfr
dim TFT_DataPort as char  at bummy
    TFT_RST      as sbit  at GPIOB_ODR.01
    TFT_BLED     as sbit  at GPIOE_ODR.12
    TFT_RS       as sbit  at GPIOE_ODR.13
    TFT_CS       as sbit  at GPIOE_ODR.14
    TFT_RD       as sbit  at bummy.4
    TFT_WR       as sbit  at bummy.5

'XPT2046 Anschlüsse                                                             ---------407Mini-----------------------------------------------
DIM
    T_CS         as sbit  at GPIOB_ODR.12
    T_IRRPT      as sbit  at GPIOE_IDR.15

'User_LED, SerialFlash CS, WS2812 LED Outputs                                   ---------407Mini-----------------------------------------------
DIM
    USER_LED     as sbit  at GPIOA_ODR.01                                      ' Lebenslicht
    sf_cs        as sbit  at GPIOA_ODR.15                                      ' serial Flash Chip Select
    led_out      as sbit  at GPIOC_ODR.8                                       ' WS2812 Anschluss
    RTS1         as sbit  at GPIOC_ODR.05                                      ' RS485 Ready_to_Send

'Relays, Impuls, USB-Power                                                      ----------407Mini----------------------------------------------
DIM
    relay        as word  at GPIOD_ODR                                         ' 16 Relays
    opendrain    as word  at GPIOD_OTYPER                                      ' 16 Opendrain
    mrelay       as word  at GPIOD_IDR                                         ' 16 Relays zurücklesen
    diginput     as word  at GPIOE_IDR                                         ' Digitaleingänge
    USB_Power    as sbit  at GPIOC_ODR.12                                      ' USB Powerswitch
    fzg          as word                                                       ' F407ZG Prozessor
#endif       '======================================================================================ENDE 407Mini====================================


#ifdef 407ZG then    ' ===========================================================================407ZG=============================================
'MP3                                                                            -------------407ZG---------------------------------------------
dim MP3_RST             as sbit at GPIOA_ODR.9
    BSYNC               as sbit at GPIOA_ODR.8
    MP3_CS              as sbit at GPIOA_ODR.10
    DREQ                as sbit at GPIOC_IDR.13
    soundcard           as word

'SD_Card                                                                        --------------407ZG--------------------------------------------
dim totalClusts,
    freeClusts,
    badClusts           as uint32_t
    tm                  as __TIME
    sc                  as __SECTOR
    fileHandle          as __HANDLE[4]
    filesize            as longword
    file_attrib         as byte
