'Timer Interrupts:                                                              --------------------------------------------------------------------------
sub procedure Timer3_interrupt() iv IVT_INT_TIM3                               ' Systemuhr
    TIM3_SR.UIF=0
    inc(tacks)  inc(ticks)                                                     ' Millisekundenzähler
    'relay.0=not relay.0
    #ifndef 411 then
    if usb0_started    then  USBHost_Main() end if                             ' USB-Keyboard-Stack abarbeiten
      #ifdef 407mini then
    if keyboard_active then  MX_scan_key(0) end if                             ' Matrix-Keyboard scannen
      #endif
      #ifdef 407ZG then
    if keyboard_active then  MX_scan_key(0) end if                             ' Matrix-Keyboard scannen
      #endif
    #endif
    ADC1_SQR3=adc_channel   SWSTART_Bit=1  inc(adc_channel)                    ' ADC Start Conversion
    #ifndef 411 then
    if adc_channel>13 then  adc_channel=10 end if
    #else
    if adc_channel>09 then  adc_channel=08 end if
    #endif
    #ifndef 411 then
    if inputdelay0 then  if inputdelay_tme[0] <60 then  inc(inputdelay_tme[0]) else  setbit(EXTI_IMR,0)  end if  end if
    if inputdelay1 then  if inputdelay_tme[1] <60 then  inc(inputdelay_tme[1]) else  setbit(EXTI_IMR,1)  end if  end if
    if inputdelay2 then  if inputdelay_tme[2] <60 then  inc(inputdelay_tme[2]) else  setbit(EXTI_IMR,2)  end if  end if
    #endif
    if inputdelay3 then  if inputdelay_tme[3] <60 then  inc(inputdelay_tme[3]) else  setbit(EXTI_IMR,3)  end if  end if   ' alle Chips
    if inputdelay4 then  if inputdelay_tme[4] <60 then  inc(inputdelay_tme[4]) else  setbit(EXTI_IMR,4)  end if  end if   ' alle Chips
    #ifndef 405RG then
    if inputdelay5 then  if inputdelay_tme[5] <60 then  inc(inputdelay_tme[5]) else  setbit(EXTI_IMR,5)  end if  end if
    #endif
    if tacks>199   then                                                        ' 200x5ms = 1sek  time
       tacks=0
       USER_LED =  not USER_LED                                                ' USER LED blink
       inc(timecount)                                                          ' Systemuhr-timer
       #ifndef 411 then
       if usb1_started=1 then  if USBDev_GetDeviceState<>32 then  usb1_started=2  end if  end if    ' USB unterbrochen?
       if usb1_started=2 then  USER_LED=0  if USBDev_GetDeviceState=32 then  USBDev_CDCSetReceiveBuffer(@usb_r_buffer)  usb1_started=1  uart(usb1_char) end if end if   ' USB wieder da?
       #endif
       if timerint       then  if timecount=alarmtime       then  int_helper(5)   end if  end if    ' on time?
    end if
end sub

#ifndef 411 then
sub procedure Timer4_interrupt() iv IVT_INT_TIM4 ics ICS_AUTO                  ' Sound play
    'relay.0=not relay.0
    TIM4_SR.UIF=0
    sound_phase[0]=sound_phase[0] + sound_offset[0]                            ' links
    sound_phase[2]=sound_phase[2] + sound_offset[2]
    sound_phase[4]=sound_phase[4] + sound_offset[4]
    sound_phase[1]=sound_phase[1] + sound_offset[1]                            ' rechts
    sound_phase[3]=sound_phase[3] + sound_offset[3]
    sound_phase[5]=sound_phase[5] + sound_offset[5]
    samplel = (soundbuffer[sound_phase[0] >> 22] * v_modulator[0]) + (soundbuffer[sound_phase[2] >> 22] * v_modulator[2]) + (soundbuffer[sound_phase[4] >> 22] * v_modulator[4])
    sampler = (soundbuffer[sound_phase[1] >> 22] * v_modulator[1]) + (soundbuffer[sound_phase[3] >> 22] * v_modulator[3]) + (soundbuffer[sound_phase[5] >> 22] * v_modulator[5])
    DAC_DHR12R1 = integer(samplel * g_modulator) + null_line
    DAC_DHR12R2 = Integer(sampler * g_modulator) + null_line
end sub
#else
sub procedure Timer4_interrupt() iv IVT_INT_TIM4                               ' 1 Sekundeninterrupt für Frequenz-Zähler (F411/F401)
    TIM4_SR.UIF=0   counter2 = TIM9_CNT   TIM9_CNT=0
    frequency_counter = (counter1 <<16) + counter2
    counter1=0
    'relay.0=not relay.0
end sub
#endif

'Timer5 ist PWM-Erzeuger - hat keinen Interrupt

#ifndef 411 then
sub procedure Timer6_interrupt() iv IVT_INT_TIM6_DAC                           ' 1 Sekundeninterrupt für Frequenz-Zähler
    TIM6_SR.UIF=0   counter2 = TIM9_CNT   TIM9_CNT=0
    frequency_counter = (counter1 <<16) + counter2
    counter1=0
    'relay.0=not relay.0
end sub

sub procedure Timer7_interrupt() iv IVT_INT_TIM7  ics ICS_AUTO                 ' ADSR Generator / Sequenzer
     TIM7_SR.UIF=0                                                             ' voice7 steht für voice_timer7
     'relay.0=not relay.0
     for voice7=0 to voicemax_min1
         select case phase[voice7]
           case 0
                if s_modulator[voice7] < 1.0 then
                   s_modulator[voice7] = s_modulator[voice7] * attack_factor
                else
                   phase[voice7]=1
                end if
           case 1
                if s_modulator[voice7] > sustain_level then
                   s_modulator[voice7] = s_modulator[voice7] * decay_factor
                else
                    phase[voice7]=2
                end if
           case 2
                if note_counter[voice7] > note_time[voice7] then
                   phase[voice7]=3
                end if
           case 3
                if s_modulator[voice7] > (1.0/4096.0) then
                   s_modulator[voice7] = s_modulator[voice7] * release_factor
                else
                    phase[voice7]=4
                end if
         end select
         v_modulator[voice7] = s_modulator[voice7] * midi_modulator[voice7]
         if note_counter[voice7] <640000 then
            inc(note_counter[voice7])
         end if
     next voice7
end sub

#endif

sub procedure Timer9_interrupt() iv IVT_INT_TIM1_BRK_TIM9 ics ICS_AUTO         ' Frequenz/Impuls-Zähler
    'if UIF_TIM9_SR_bit=1 then
    UIF_TIM9_SR_bit=0
    inc(counter1)                                                              ' 32Bit-Erweiterung
       'relay.0=not relay.0
    'end if
end sub

sub procedure Timer10_interrupt() iv IVT_INT_TIM1_UP_TIM10 ics ICS_AUTO        ' ImpulsTimer
    'if UIF_TIM10_SR_bit=1 then
    UIF_TIM10_SR_bit=0
        'relay.0=not relay.0
    'end if
        if tim101<tim101max then                                               ' ImpulsTimer 1
           inc(tim101)
           if tim101=tim101max then
              inc(tim101)
              if onadres[20] then
                 int_helper(20)
                 onadres[20]=0
              else
                  relay.relaynumber1 = not relay.relaynumber1
              end if
              relaynumber1=16
           end if
        end if
        if tim102<tim102max then                                               ' ImpulsTimer 2
           inc(tim102)
           if tim102=tim102max then
              inc(tim102)
              if onadres[21] then
                 int_helper(21)
                 onadres[21]=0
              else
                  relay.relaynumber2 = not relay.relaynumber2
              end if
              relaynumber2=16
           end if
        end if
        if tim103<tim103max then                                               ' ImpulsTimer 3
           inc(tim103)
           if tim103=tim103max then
              inc(tim103)
              if onadres[22] then
                 int_helper(22)
                 onadres[22]=0
              else
                  relay.relaynumber3 = not relay.relaynumber3
              end if
              relaynumber3=16
            end if
        end if
        if tim104<tim104max then                                               ' ImpulsTimer 4
           inc(tim104)
           if tim104=tim104max then
              inc(tim104)
              if onadres[23] then
                 int_helper(23)
                 onadres[23]=0
              else
                  relay.relaynumber4 = not relay.relaynumber4
              end if
              relaynumber4=16
           end if
        end if
end sub

sub procedure Timer11_interrupt() iv IVT_INT_TIM1_TRG_COM_TIM11 ics ICS_AUTO   ' on milli 1-4 Timer   für F407/F411/F401
    'if UIF_TIM11_SR_bit=1 then
    UIF_TIM11_SR_bit=0
       'relay.0=not relay.0
    'end if
    if milli_int1 then
       inc(milli1_timer)
       if milli1_timer = milli1_time  then
          milli1_timer=0   milli_int1=0
          int_helper(9)    milli_int1=1                                        ' Interrupt-Nr. 9
       end if
    end if
    if milli_int2 then
       inc(milli2_timer)
       if milli2_timer = milli2_time  then
          milli2_timer=0   milli_int2=0
          int_helper(12)   milli_int2=1                                        ' Interrupt-Nr. 12
       end if
    end if
    if milli_int3 then
       inc(milli3_timer)
       if milli3_timer = milli3_time  then
          milli3_timer=0   milli_int3=0
          int_helper(13)   milli_int3=1                                        ' Interrupt-Nr. 13
       end if
    end if
    if milli_int4 then
       inc(milli4_timer)
       if milli4_timer = milli4_time  then
          milli4_timer=0   milli_int4=0
          int_helper(24)   milli_int4=1                                        ' Interrupt-Nr. 24
       end if
    end if
end sub

#ifndef 411 then
sub procedure Timer12_interrupt() iv IVT_INT_TIM8_BRK_TIM12 ics ICS_AUTO       ' spielt wave files ab / nimmt wave files auf    für F405/7
    'if UIF_TIM12_SR_bit=1 then
    UIF_TIM12_SR_bit=0
    'end if
    if play_record then                                                        ' Aufnahme --------------------------------------------
       record_ptr = record_base + wave_counter                                 ' Zeiger auf record-Puffer
       SWSTART_ADC2_CR2_bit=1                                                  ' Wandlung anstossen (mono)
    else                                                                       ' Wiedergabe?  ----------------------------------------
        play_pointer_l = play_base + wave_counter                              ' Zeiger auf play-Puffer
        play_pointer_r = play_pointer_l + p_p                                  ' p_p=2 für Stereo, p_p=0 für Mono
        play_l=play_pointer_l^                                                 ' niederwertige Bytes (links)
        play_r=play_pointer_r^                                                 '                     (rechts)
        inc(play_pointer_l)    inc(play_pointer_r)                             ' Zeiger auf höherwertige Bytes
        play_l=play_l or word(play_pointer_l^ <<8)                             ' zu Worten zusammensetzen  (links)
        play_r=play_r or word(play_pointer_r^ <<8)                             '                           (rechts)
        samplel=integer(play_l)
        sampler=integer(play_r)
        DAC_DHR12L2 = word(float(samplel) * g_modulator + 32768.495)
        DAC_DHR12L1 = word(float(sampler) * g_modulator + 32768.495)
        wave_counter=(wave_counter + v_c) and 16383                            ' 14Bit-Zähler 4 bzw 2 weiter (stereo/mono)
    end if
end sub

sub procedure Timer13_interrupt() iv IVT_INT_TIM8_UP_TIM13 ics ICS_AUTO        ' DDS
    TIM13_SR.UIF=0
    phase_accu1=phase_accu1 + phase_offset1
    phase_accu2=phase_accu2 + phase_offset2
    if audio_on then
       DAC_DHR12R1 = soundbuffer[phase_accu1 >> 22] + 2048
       DAC_DHR12R2 = soundbuffer[phase_accu2 >> 22] + 2048
       exit
    end if
    g_modulator = tr_modulator * (1.0 + sinus[phase_accu1 >> 22] * tremolo)
    arr4_min    = longword(vb_modulator * (1.0 + sinus[phase_accu2 >> 22] * vibrato))
    if arr4_min>2 then                                                         ' Timer4 'Stolpergrenze'
       TIM4_ARR    = arr4_min
    end if
end sub

sub procedure Timer14_interrupt() iv IVT_INT_TIM8_TRG_COM_TIM14 ics ICS_AUTO   ' frei  für F407
    'if UIF_TIM14_SR_bit=1 then
    UIF_TIM14_SR_bit=0
    'end if
end sub
#endif

'receive interrupt routines                                                     --------------------------------------------------------------------------
sub procedure receive() iv IVT_INT_USART1  ics ICS_AUTO                        ' com1 Interrupt Service    -UART1
    mvar1 = USART1_DR
    stat1 = USART1_SR                                                          ' nach Überlauf muss Statusregister gelesen werden
    recstr1[ser1_zeiger] = mvar1                                               ' lifo
    if ser1_zeiger < fifo1  then
       inc(ser1_zeiger)
    end if
    if (konsole_uart=1) or (konsole_uart=7) or (konsole_uart=31) then          ' Konsole auf com1?
       mvar = mvar1
       ser_zeiger = ser1_zeiger
       if mvar=3 then  perror=maxerror  get_one_byte end if
    end if
    if onbuf1=1 then                                                           ' on buf1?
       int_helper(6)                                                           ' Interrupt-Nr. 6
    end if
end sub

#ifdef 411 then
sub procedure receive_gps_midi() iv IVT_INT_USART2  ics ICS_AUTO               ' MIDI Interrupt Service / com2   -UART2
    mvar2 = USART2_DR
    stat2 = USART2_SR                                                          ' nach Überlauf muss Statusregister gelesen werden
    if gps_on=1 then
       if mvar2=13 then
          recstr2[ser2_zeiger]=0
          if recstr2[0] = "$" then
             if recstr2[1] = "G" then
                if (recstr2[2] = "P") or (recstr2[2] = "N") then
                   if recstr2[3] = gps_sentence[0] then
                      if recstr2[4] = gps_sentence[1] then
                         if recstr2[5] = gps_sentence[2] then
                            gps_string = recstr2
                            gps_new=1
                            NVIC_IntDisable(IVT_INT_USART2)
                         else
                             ser2_zeiger=0
                         end if
                      else
                          ser2_zeiger=0
                      end if
                   else
                       ser2_zeiger=0
                   end if
                else
                    ser2_zeiger=0
                end if
             else
                 ser2_zeiger=0
             end if
          else
              ser2_zeiger=0
          end if
       end if
       if (mvar2>31) and (mvar2<91) then
          recstr2[ser2_zeiger] = mvar2
          inc(ser2_zeiger)
       end if
    else
        recstr2[ser2_zeiger] = mvar2                                           ' lifo
        if ser2_zeiger < fifo2 then  inc(ser2_zeiger)  end if
        if konsole_uart=2 then                                                 ' Konsole auf com2?
           mvar = mvar2
           ser_zeiger = ser2_zeiger
           if mvar=3 then  perror = maxerror  get_one_midi_byte end if
        end if
        if onbuf2=1 then
           int_helper(10)                                                      ' Interrupt-Nr.
        end if
    end if
end sub
#endif
    
