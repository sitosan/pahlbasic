sub function IsInsideObject (dim X, Y as word, dim Left_, Top, Width, Height as word) as byte ' static
    if ( (Left_<= X) and (Left_+ Width - 1 >= X) and
       (Top <= Y)  and (Top + Height - 1 >= Y) ) then
       Result = 1
    else
        Result = 0
    end if
end sub

sub function GetRoundButton (dim index as byte) as ^TButton_Round ' static
dim objPtr as ^ const code ^TButton_Round   volatile

    objPtr = CurrentScreen^.Buttons_Round + index
    Result = objPtr^
end sub



sub procedure DrawRoundButton(dim Around_button as ^TButton_Round)
dim ALeft, ATop as word  volatile

  'if (Around_button^.Visible <> 0) then
    if (object_pressed = 1) then
      object_pressed = 0
      TFT_Set_Brush(1, CurrentScreen^.Press_Color, CurrentScreen^.Gradient, CurrentScreen^.Gradient_Orientation,
                    CurrentScreen^.Gradient_End_Color, CurrentScreen^.Gradient_Start_Color)
    else
      TFT_Set_Brush(1, CurrentScreen^.Button_Color, CurrentScreen^.Gradient, CurrentScreen^.Gradient_Orientation,
                    CurrentScreen^.Gradient_Start_Color, CurrentScreen^.Gradient_End_Color)
    end if
    TFT_Set_Pen(CurrentScreen^.Pen_Color, CurrentScreen^.Pen_Width)
    TFT_Rectangle_Round_Edges(Around_button^.Left_ + 1, Around_button^.Top + 1,
                              Around_button^.Left_ + Around_button^.Width - 2,
                              Around_button^.Top + Around_button^.Height - 2, CurrentScreen^.Corner_Radius)
    TFT_Set_Font(CurrentScreen^.FontName, CurrentScreen^.Font_Color, FO_HORIZONTAL)
    TFT_Write_Text_Return_Pos(Around_button^.Caption, Around_button^.Left_, Around_button^.Top)
    if (CurrentScreen^.TextAlign = _taLeft) then
      ALeft = Around_button^.Left_ + 4
      else if (CurrentScreen^.TextAlign = _taCenter) then
        ALeft = Around_button^.Left_ + (Around_button^.Width - caption_length) div 2
        else if (CurrentScreen^.TextAlign = _taRight) then
          ALeft = Around_button^.Left_ + Around_button^.Width - caption_length - 4
        end if
      end if
    end if

    if (CurrentScreen^.TextAlignVertical = _tavTop) then
      ATop = Around_button^.Top + 3
      else if (CurrentScreen^.TextAlignVertical = _tavMiddle) then
        ATop = Around_button^.Top + (Around_button^.Height - caption_height) div 2
        else if (CurrentScreen^.TextAlignVertical = _tavBottom) then
          ATop = Around_button^.Top + Around_button^.Height - caption_height - 4
        end if
      end if
    end if

    TFT_Write_Text(Around_button^.Caption, ALeft, ATop)
    set_font  ' TFT_Backcol=0
  'end if
end sub

sub procedure DrawScreen(dim aScreen as ^TScreen)
dim order as word  volatile
dim round_button_idx as byte  volatile

    local_round_button as ^TButton_Round
    object_pressed = 0
    order = 0
    round_button_idx = 0
    CurrentScreen = aScreen
    if (display_width <> CurrentScreen^.Width) or (display_height <> CurrentScreen^.Height) then
       tft_clear_screen(CurrentScreen^.Color)
       display_width = CurrentScreen^.Width
       display_height = CurrentScreen^.Height
    else
        tft_clear_screen(CurrentScreen^.Color)
    end if
    while (order < CurrentScreen^.ObjectsCount)
          if (round_button_idx < CurrentScreen^.Buttons_RoundCount) then
             local_round_button = GetRoundButton(round_button_idx)
             if (order = local_round_button^.Order) then
                Inc(round_button_idx)
                Inc(order)
                DrawRoundButton(local_round_button)
             end if
          end if
    wend
end sub

sub procedure Get_Object(dim X as word, dim Y as word)
dim counter as integer  volatile

    round_button_order  = -1
    '  Buttons with Round Edges
    counter = CurrentScreen^.Buttons_RoundCount
    for _object_count = 0 to counter - 1
        local_round_button = GetRoundButton(_object_count)
        if (local_round_button^.Active <> 0) then
           if IsInsideObject(X, Y, local_round_button^.Left_, local_round_button^.Top,
              local_round_button^.Width, local_round_button^.Height) = 1 then
              round_button_order = local_round_button^.Order
              exec_round_button = local_round_button
           end if
        end if
    next _object_count

    _object_count = -1
    if (round_button_order >  _object_count ) then
       _object_count = round_button_order
    end if
end sub

sub procedure Process_TP_Up(dim X as word, dim Y as word) ' static
    select case PressedObjectType
    ' Round Button
      case 1
           if (PressedObject <> 0) then
              exec_round_button = ^TButton_Round(PressedObject)
              if (exec_round_button^.OwnerScreenAddress = ^byte(CurrentScreen)) then
                 DrawRoundButton(exec_round_button)
              end if
           end if
    end select
    Get_Object(X, Y)
    if (_object_count <> -1) then
       ' Buttons with Round Edges
       if (_object_count = round_button_order) then
          if (exec_round_button^.Active <> 0) then
             if PressedObject = TBytePtr(exec_round_button) then
                if (exec_round_button^.OnClickPtr <> 0) then
                   exec_round_button^.OnClickPtr^()
                end if
             end if
             PressedObject = 0
             PressedObjectType = -1
             key_released=_object_count   key_newest=0   key_ctrl=0
             exit
          end if
       end if
    end if
    PressedObject = 0
    PressedObjectType = -1
end sub

sub procedure execute_shift
    if ashift=0 then
       ashift=1
       InitializeObjects()
       display_width = Screen2.Width
       display_height = Screen2.Height
       DrawScreen(@Screen2)
       InitializeTouchPanel()
    else
        Start_TP
    end if
end sub

sub procedure execute_AltGr
    if aaltgr=0 then
       aaltgr=1
       InitializeObjects()
       display_width = Screen4.Width
       display_height = Screen4.Height
       DrawScreen(@Screen4)
       InitializeTouchPanel()
    else
        Start_TP
    end if
end sub

sub procedure execute_ctrl
    if actrl=0 then
       actrl=1
       InitializeObjects()
       display_width = Screen1.Width
       display_height = Screen1.Height
       Screen1.Color=0x5AEB
       DrawScreen(@Screen1)
       InitializeTouchPanel()
    end if
end sub

sub procedure execute_fn
    if afn=0 then
       afn=1
       InitializeObjects()
       display_width = Screen1.Width
       display_height = Screen1.Height
       DrawScreen(@Screen1)
       InitializeTouchPanel()
    else
        Start_TP
    end if
end sub

sub procedure extra_off
    schar=0   ashift=0   afn=0    aaltgr=0   actrl=0
    Screen1.Color = 0x1310
    DrawScreen(@Screen1)
end sub

sub procedure Process_TP_Down(dim X as word, dim Y as word) ' static
    object_pressed      = 0
    exec_round_button   = 0
    Get_Object(X, Y)
    if (_object_count <> -1) then
       if (_object_count = round_button_order) then
          if (exec_round_button^.Active <> 0) then
             object_pressed = 1
             DrawRoundButton(exec_round_button)
             PressedObject = TBytePtr(exec_round_button)
             PressedObjectType = 1
             key_pressed=_object_count  key_newest=key_pressed
             if (exec_round_button^.OnDownPtr <> 0) then
                exec_round_button^.OnDownPtr^()
                exit
             end if
             if (exec_round_button^.OnClickPtr = 0) then
                if (exec_round_button^.OnPressPtr = 0) then
                   schar=byte(exec_round_button^.Caption^)
                   if actrl then
                      if (schar>96) and (schar<123) then
                         put_char_in_buffer(schar -96, konsole_uart)
                         extra_off
                      end if
                   else
                       if schar>0 then
                          put_char_in_buffer(schar, konsole_uart)
                          'if ashift or aaltgr then
'                             extra_off
'                          end if
                          if aaltgr then
                             extra_off
                          end if
                       end if
                   end if
                else
                    schar=byte(exec_round_button^.OnPressPtr)
                    if schar>200 then
                       fn_key(schar-143, konsole_uart)
                       put_char_in_buffer(126, konsole_uart)
                       afn=0
                       InitializeObjects()
                       extra_off
                    else
                        if (schar>48) and (schar<127) then
                           esc_sequence(schar, konsole_uart)
                           key_ctrl=1
                        else
                            if schar>0 then
                               put_char_in_buffer(schar, konsole_uart)
                               if aaltgr then
                                  extra_off
                               end if
                            end if
                        end if
                    end if
                    schar=0
                end if
             end if
          end if
       end if
    end if
end sub

sub procedure Check_TP()
    if T_IRRPT=0 then
       if PenDown = 0 then
          PenDown = 1
          x_raw=0  y_raw=0  xalt=1  yalt=1
          while (xalt<>x_raw) or (yalt<>y_raw)
                xalt=x_raw    yalt=y_raw
                get_coord_raw
          wend
          Xcoord=word(float(x_raw) * X_factor) + x_offset
          Ycoord=word(float(y_raw) * Y_factor) + y_offset
          if Xcoord >= display_width  then  Xcoord = display_width  -1  end if
          if Ycoord >= display_height then  Ycoord = display_height -1  end if
          Process_TP_Down(Xcoord, Ycoord)
       end if
    else
        if PenDown = 1 then
           PenDown = 0
           Process_TP_Up(Xcoord, Ycoord)
        end if
    end if
end sub

sub procedure Start_TP() 
    ashift=0   afn=0    aaltgr=0   actrl=0
    InitializeObjects()
    display_width = Screen1.Width
    display_height = Screen1.Height
    DrawScreen(@Screen1)
    InitializeTouchPanel()
end sub

end.