implements                                                                      '--------------------------------------------------------------------

sub procedure execute_shift  forward
sub procedure execute_fn     forward
sub procedure execute_altgr  forward
sub procedure execute_ctrl   forward

sub procedure tft_clear_screen(dim coleur as word)
    TFT_Set_Pen(coleur, 1)
    TFT_Set_Brush(1, coleur, 0, 0, 0, 0)
    TFT_Rectangle(0, 241, 799, 479)
end sub


sub procedure InitializeTouchPanel() ' static
  PenDown = 0
  PressedObject = 0
  PressedObjectType = -1
end sub

sub procedure InitializeObjects()    ' static
  Screen1.Color                     = 0x1310
  Screen1.Width                     = 800
  Screen1.Height                    = 480
  Screen1.Buttons_RoundCount        = 64
  Screen1.Buttons_Round             = @Screen1_Buttons_Round
  Screen1.ObjectsCount              = 64
  Screen1.Pen_Width                 = 1
  Screen1.Pen_Color                 = 0x0000
  Screen1.TextAlign                 = _taCenter
  Screen1.TextAlignVertical         = _tavMiddle
  Screen1.FontName                  = @Arial16x19_Bold   '@Tahoma11x13_Regular
  Screen1.Font_Color                = 0x0000
  Screen1.Gradient                  = 1
  Screen1.Gradient_Orientation      = 0
  Screen1.Gradient_Start_Color      = 0xFFFF
  Screen1.Gradient_End_Color        = 0x5C57
  Screen1.Button_Color              = 0x5C57
  Screen1.Press_Color               = 0xE71C
  Screen1.Corner_Radius             = 3

  Screen2.Color                     = 0x1310  '0x5AEB
  Screen2.Width                     = 800
  Screen2.Height                    = 480
  Screen2.Buttons_RoundCount        = 64
  Screen2.Buttons_Round             = @Screen2_Buttons_Round
  Screen2.ObjectsCount              = 64
  Screen2.Pen_Width                 = 1
