  Screen2.Gradient_End_Color        = 0x5C57
  Screen2.Button_Color              = 0x5C57
  Screen2.Press_Color               = 0xE71C
  Screen2.Corner_Radius             = 3

  Screen4.Color                     = 0x1310  '0x5AEB
